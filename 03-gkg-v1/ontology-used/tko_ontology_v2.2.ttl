### Intent-to-Preference Axioms ###
# These axioms state that if a trip belongs to one of the classes
# defined above, it implies a certain route preference.

# Healthcare Axioms
tko:HospitalVisitTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:FastestRoute 
] .

tko:DoctorVisitTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:FastestRoute 
] .

tko:DentistVisitTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:ShortestRoute 
] .

