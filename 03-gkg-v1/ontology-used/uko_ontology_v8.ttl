uko:isTollRoad rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Toll road"@en .

### Sidewalk Properties ###
uko:sidewalkWidth rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Sidewalk ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Sidewalk width in meters"@en .

uko:sidewalkCondition rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Sidewalk ;
    rdfs:range xsd:string ;
    rdfs:comment "Sidewalk condition"@en .

uko:hasCurbRamp rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Sidewalk ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Has curb ramps"@en .

uko:hasTactilePaving rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Sidewalk ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Has tactile paving"@en .

### Distance Properties ###
uko:distanceInMeters rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Distance in meters"@en .

uko:walkingTimeMinutes rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Walking time in minutes"@en .

uko:drivingTimeMinutes rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Driving time in minutes"@en .

uko:transitTimeMinutes rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Transit time in minutes"@en .

uko:distanceToTransit rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Distance to nearest transit"@en .

uko:transitAccessibility rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Transit accessibility score (0-1)"@en .

### GTFS Properties ###
uko:gtfsAgencyId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitAgency ;
    rdfs:range xsd:string ;
    rdfs:comment "GTFS agency_id"@en .

uko:gtfsRouteId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range xsd:string ;
    rdfs:comment "GTFS route_id"@en .

uko:gtfsTripId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitTrip ;
    rdfs:range xsd:string ;
    rdfs:comment "GTFS trip_id"@en .

uko:gtfsStopId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range xsd:string ;
    rdfs:comment "GTFS stop_id"@en .

uko:gtfsServiceId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:string ;
    rdfs:comment "GTFS service_id"@en .

uko:routeShortName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range xsd:string ;
    rdfs:comment "Short route name"@en .

uko:routeLongName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range xsd:string ;
    rdfs:comment "Long route name"@en .

uko:routeType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range xsd:integer ;
    rdfs:comment "GTFS route_type"@en .

uko:routeColor rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range xsd:string ;
    rdfs:comment "Route color"@en .

uko:stopName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range xsd:string ;
    rdfs:comment "Stop name"@en .

uko:stopCode rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range xsd:string ;
    rdfs:comment "Stop code"@en .

uko:transitNetwork rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range xsd:string ;
    rdfs:label "transit network"@en ;
    rdfs:comment "Transit network name (e.g., BART, MUNI, Caltrain, Amtrak, AC Transit)"@en .

uko:transitOperator rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range xsd:string ;
    rdfs:label "transit operator"@en ;
    rdfs:comment "Transit operator organization name"@en .

uko:arrivalTime rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:StopTime ;
    rdfs:range xsd:time ;
    rdfs:comment "Arrival time"@en .

uko:departureTime rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:StopTime ;
    rdfs:range xsd:time ;
    rdfs:comment "Departure time"@en .

uko:stopSequence rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:StopTime ;
    rdfs:range xsd:integer ;
    rdfs:comment "Stop sequence"@en .

uko:serviceMonday rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Service on Mondays"@en .

uko:serviceTuesday rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Service on Tuesdays"@en .

uko:serviceWednesday rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Service on Wednesdays"@en .

uko:serviceThursday rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Service on Thursdays"@en .

uko:serviceFriday rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Service on Fridays"@en .

uko:serviceSaturday rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Service on Saturdays"@en .

uko:serviceSunday rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Service on Sundays"@en .

uko:startDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:date ;
    rdfs:comment "Start date"@en .

uko:endDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range xsd:date ;
    rdfs:comment "End date"@en .

uko:isTOD rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Is Transit-Oriented Development"@en .
#################################################################
#    PART 9: DATA PROVENANCE
#################################################################

### Data Source Classes ###
uko:DataSource rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A source of data for the knowledge graph"@en ;
    rdfs:label "Data Source"@en .

uko:OSMDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "OpenStreetMap data source"@en ;
    rdfs:label "OSM Data Source"@en .

uko:LLMDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "Large Language Model derived data"@en ;
    rdfs:label "LLM Data Source"@en .

uko:GTFSDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "GTFS feed data source"@en ;
    rdfs:label "GTFS Data Source"@en .

uko:CensusDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "Census data source"@en ;
    rdfs:label "Census Data Source"@en .

uko:GovernmentDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "Government data source"@en ;
    rdfs:label "Government Data Source"@en .

uko:UserContributedDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "User-contributed data"@en ;
    rdfs:label "User Contributed Data Source"@en .

uko:CommercialDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "Commercial data source"@en ;
    rdfs:label "Commercial Data Source"@en .

### Data Quality Classes ###
uko:DataQualityAssessment rdf:type owl:Class ;
    rdfs:comment "Assessment of data quality"@en ;
    rdfs:label "Data Quality Assessment"@en .

uko:HighConfidence rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "High confidence data"@en .

uko:MediumConfidence rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "Medium confidence data"@en .

uko:LowConfidence rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "Low confidence data"@en .

uko:Verified rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "Verified data"@en .

uko:Inferred rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "Inferred/derived data"@en .

### Provenance Object Properties ###
uko:hasDataSource rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:DataSource ;
    rdfs:comment "Links feature to data source"@en .

uko:hasQualityAssessment rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:DataQualityAssessment ;
    rdfs:comment "Links feature to quality assessment"@en .

uko:derivedFrom rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature derived from another"@en .

uko:extractedFrom rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:DataSource ;
    rdfs:comment "Feature extracted from source"@en .

uko:inferredBy rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:LLMDataSource ;
    rdfs:comment "Feature inferred by LLM"@en .

### Provenance Data Properties ###
uko:sourceTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Source data timestamp"@en .

uko:lastUpdated rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Last update timestamp"@en .

uko:confidenceScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Confidence score (0-1)"@en .

uko:llmModel rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LLMDataSource ;
    rdfs:range xsd:string ;
    rdfs:comment "LLM model name"@en .

uko:llmPrompt rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LLMDataSource ;
    rdfs:range xsd:string ;
    rdfs:comment "Prompt used to generate data"@en .

uko:osmVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:OSMDataSource ;
    rdfs:range xsd:integer ;
    rdfs:comment "OSM data version"@en .

uko:osmChangeset rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:OSMDataSource ;
    rdfs:range xsd:integer ;
    rdfs:comment "OSM changeset ID"@en .

### GTFS Feed Info ###
uko:GTFSFeedInfo rdf:type owl:Class ;
    rdfs:subClassOf uko:GTFSDataSource ;
    rdfs:comment "GTFS feed metadata"@en ;
    rdfs:label "GTFS Feed Info"@en .

uko:publisherName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:string ;
    rdfs:comment "Feed publisher name"@en .

uko:publisherUrl rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "Publisher URL"@en .

uko:feedLang rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:string ;
    rdfs:comment "Feed language"@en .

uko:feedStartDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:date ;
    rdfs:comment "Feed start date"@en .

uko:feedEndDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:date ;
    rdfs:comment "Feed end date"@en .

uko:feedVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:string ;
    rdfs:comment "Feed version"@en .

#################################################################
#    PART 10: GTFS OBJECT PROPERTIES
#################################################################

uko:gtfsOperatedBy rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range uko:TransitAgency ;
    rdfs:comment "Route operated by agency"@en .

uko:operatesRoute rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:gtfsOperatedBy ;
    rdfs:domain uko:TransitAgency ;
    rdfs:range uko:TransitRoute .

uko:belongsToRoute rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitTrip ;
    rdfs:range uko:TransitRoute ;
    rdfs:comment "Trip belongs to route"@en .

uko:hasTrip rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:belongsToRoute ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range uko:TransitTrip .

uko:hasStopTime rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitTrip ;
    rdfs:range uko:StopTime ;
    rdfs:comment "Trip has stop time"@en .

uko:atStop rdf:type owl:ObjectProperty ;
    rdfs:domain uko:StopTime ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Stop time at stop"@en .

uko:servesStop rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Route serves stop"@en .

uko:parentStation rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range uko:TransitStation ;
    rdfs:comment "Parent station"@en .

uko:hasChildStop rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:parentStation ;
    rdfs:domain uko:TransitStation ;
    rdfs:range uko:TransitStop .

uko:hasServiceCalendar rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitTrip ;
    rdfs:range uko:ServiceCalendar ;
    rdfs:comment "Trip has service calendar"@en .

uko:hasServiceException rdf:type owl:ObjectProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range uko:ServiceException ;
    rdfs:comment "Calendar has exception"@en .

uko:nearestTransitStop rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Nearest transit stop"@en .

uko:hasServiceArea rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range uko:ServiceArea ;
    rdfs:comment "Route service area"@en .

uko:anchorStation rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitOrientedDevelopment ;
    rdfs:range uko:TransitStation ;
    rdfs:comment "Anchor transit station for TOD"@en .

### END OF UKO v6.0 ONTOLOGY ###
###############################################################################
#
#    Urban Knowledge Ontology (UKO) Extension
#    Districts and Neighborhoods Module
#    Version 6.1.0
#
#    Purpose: Define classes and properties for formal and informal
#    geographic areas including neighborhoods and functional districts.
#
#    This file should be imported into the main UKO ontology or
#    merged with uko_ontology_v6.ttl
#
#    Synapse Partners, LLC
###############################################################################

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uko: <urn:urban-kg:> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <https://schema.org/> .

###############################################################################
#    NEIGHBORHOOD CLASSES
###############################################################################

uko:Neighborhood a owl:Class ;
    rdfs:subClassOf uko:GeographicArea ;
    rdfs:label "Neighborhood" ;
    rdfs:comment "A geographic area within a city or town that has a distinct identity, character, or community. May be officially designated or informally recognized." .

uko:OfficialNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Official Neighborhood" ;
    rdfs:comment "A neighborhood with legally designated boundaries recognized by local government, census bureau, or official planning documents." .

uko:InformalNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Informal Neighborhood" ;
    rdfs:comment "A community-recognized neighborhood without official government designation. Boundaries may be approximate or contested." .

uko:HistoricNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Historic Neighborhood" ;
    rdfs:comment "A neighborhood with historical significance, often with protected status or listed on historic registries." .

uko:HistoricDistrict a owl:Class ;
    rdfs:subClassOf uko:HistoricNeighborhood ;
    rdfs:label "Historic District" ;
    rdfs:comment "An officially designated historic area with legal protections for historic preservation." .

uko:GatedCommunity a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Gated Community" ;
    rdfs:comment "A residential neighborhood with controlled access, typically with walls or fences and entry gates." .

uko:PlannedCommunity a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Planned Community" ;
    rdfs:comment "A neighborhood designed and built as a unified development with coordinated planning." .

###############################################################################
#    DISTRICT CLASSES - FORMAL
###############################################################################

uko:District a owl:Class ;
    rdfs:subClassOf uko:GeographicArea ;
    rdfs:label "District" ;
    rdfs:comment "A defined area within a city serving a specific administrative, commercial, or functional purpose." .

uko:AdministrativeDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Administrative District" ;
    rdfs:comment "A district defined for governmental or administrative purposes." .

uko:BusinessImprovementDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Business Improvement District" ;
    rdfs:comment "A defined area where businesses pay additional taxes or fees for improvements and services." ;
    owl:equivalentClass uko:BID .

uko:BID a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "BID" ;
    rdfs:comment "Business Improvement District (abbreviation)." .

uko:SpecialPurposeDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Special Purpose District" ;
    rdfs:comment "A district created for a specific governmental function like water, fire, or schools." .

uko:ZoningDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Zoning District" ;
    rdfs:comment "An area with specific land use regulations and restrictions." .

uko:RedevelopmentDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Redevelopment District" ;
    rdfs:comment "An area designated for urban renewal or redevelopment with special incentives or regulations." .

uko:OpportunityZone a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Opportunity Zone" ;
    rdfs:comment "A federally designated economically-distressed community with tax incentives for investment." .

###############################################################################
#    DISTRICT CLASSES - INFORMAL/FUNCTIONAL
###############################################################################

uko:InformalDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Informal District" ;
    rdfs:comment "A district recognized by common usage or community consensus rather than official designation." .

uko:FunctionalDistrict a owl:Class ;
    rdfs:subClassOf uko:InformalDistrict ;
    rdfs:label "Functional District" ;
    rdfs:comment "An area characterized by concentration of similar businesses or activities, often informally named." .

# Commercial/Retail Functional Districts
uko:ShoppingDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Shopping District" ;
    rdfs:comment "An area with a high concentration of retail stores and shopping destinations." .

uko:AutoRow a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Auto Row" ;
    rdfs:comment "A stretch of road or area with multiple car dealerships and automotive businesses." .

uko:RestaurantRow a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Restaurant Row" ;
    rdfs:comment "An area with a high concentration of restaurants and dining establishments." .

uko:FoodDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Food District" ;
    rdfs:comment "An area known for diverse food establishments including restaurants, food halls, and specialty food shops." .

# Professional/Creative Functional Districts
uko:DesignDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Design District" ;
    rdfs:comment "An area with concentration of design-related businesses: architects, interior designers, furniture showrooms." .

uko:ArtDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Art District" ;
    rdfs:comment "An area with concentration of art galleries, artist studios, and creative businesses." .

uko:FashionDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Fashion District" ;
    rdfs:comment "An area with concentration of clothing manufacturers, wholesalers, and fashion-related businesses." .

uko:JewelryDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Jewelry District" ;
    rdfs:comment "An area with concentration of jewelry stores, wholesalers, and gem dealers." .

# Technology/Business Functional Districts
uko:TechCorridor a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Tech Corridor" ;
    rdfs:comment "An area with concentration of technology companies and startups." .

uko:FinancialDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Financial District" ;
    rdfs:comment "An area with concentration of banks, financial services, and corporate headquarters." .

uko:MedicalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Medical District" ;
    rdfs:comment "An area with concentration of hospitals, clinics, and medical offices." .

uko:LegalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Legal District" ;
    rdfs:comment "An area near courthouses with concentration of law offices and legal services." .

# Entertainment/Nightlife Functional Districts
uko:EntertainmentDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Entertainment District" ;
    rdfs:comment "An area with concentration of entertainment venues: theaters, music venues, nightclubs." .

uko:NightlifeDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Nightlife District" ;
    rdfs:comment "An area known for bars, clubs, and late-night entertainment." .

uko:TheaterDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Theater District" ;
    rdfs:comment "An area with concentration of theaters and performing arts venues." .

# Cultural/Ethnic Functional Districts
uko:CulturalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Cultural District" ;
    rdfs:comment "An area with concentration of cultural institutions: museums, galleries, performance spaces." .

uko:EthnicEnclave a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Ethnic Enclave" ;
    rdfs:comment "An area with concentration of businesses and residents from a particular ethnic or cultural background." .

uko:Chinatown a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Chinatown" ;
    rdfs:comment "An urban area with significant Chinese population and Chinese-owned businesses." .

uko:LittleItaly a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Little Italy" ;
    rdfs:comment "An urban area historically associated with Italian immigrants and Italian-American culture." .

uko:Koreatown a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Koreatown" ;
    rdfs:comment "An urban area with significant Korean population and Korean-owned businesses." .

uko:LittleTokyo a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Little Tokyo" ;
    rdfs:comment "An urban area with significant Japanese population and Japanese-owned businesses." .

uko:LatinQuarter a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Latin Quarter" ;
    rdfs:comment "An urban area with significant Latino/Hispanic population and Latino-owned businesses." .

# Industrial/Warehouse Functional Districts
uko:IndustrialDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Industrial District" ;
    rdfs:comment "An area with concentration of manufacturing, warehouses, and industrial businesses." .

uko:WarehouseDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Warehouse District" ;
    rdfs:comment "An area dominated by warehouses, often converted to lofts, galleries, or creative spaces." .

uko:PortDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Port District" ;
    rdfs:comment "An area around a port with shipping, logistics, and maritime businesses." .

# Civic/Institutional Functional Districts
uko:CivicCenter a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Civic Center" ;
    rdfs:comment "An area with concentration of government buildings and civic institutions." .

uko:UniversityDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "University District" ;
    rdfs:comment "An area surrounding a university with student-oriented businesses and housing." .

uko:HospitalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Hospital District" ;
    rdfs:comment "An area surrounding a major hospital with medical offices and health services." .

###############################################################################
#    DOWNTOWN AND CENTRAL BUSINESS AREAS
###############################################################################

uko:Downtown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Downtown" ;
    rdfs:comment "The central business district or commercial heart of a city." .

uko:CentralBusinessDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Central Business District" ;
    rdfs:comment "The main commercial and business center of a city." ;
    owl:equivalentClass uko:CBD .

uko:CBD a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "CBD" ;
    rdfs:comment "Central Business District (abbreviation)." .

uko:Uptown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Uptown" ;
    rdfs:comment "An area of a city typically north of or away from downtown, often more residential or affluent." .

uko:Midtown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Midtown" ;
    rdfs:comment "An area between downtown and uptown, often with mixed commercial and residential use." .

uko:OldTown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Old Town" ;
    rdfs:comment "The historic core of a city, often with preserved historic buildings." .

###############################################################################
#    PROPERTIES FOR NEIGHBORHOODS AND DISTRICTS
###############################################################################

# Official Status Properties
uko:hasOfficialStatus a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:boolean ;
    rdfs:label "has official status" ;
    rdfs:comment "Indicates whether the neighborhood has official government recognition." .

uko:recognizedBy a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:Organization ;
    rdfs:label "recognized by" ;
    rdfs:comment "The organization that officially recognizes or designates this area." .

uko:designationDate a owl:DatatypeProperty ;
    rdfs:domain uko:District ;
    rdfs:range xsd:date ;
    rdfs:label "designation date" ;
    rdfs:comment "The date when the district was officially designated." .

uko:designationAuthority a owl:DatatypeProperty ;
    rdfs:domain uko:District ;
    rdfs:range xsd:string ;
    rdfs:label "designation authority" ;
    rdfs:comment "The governmental body that designated this district." .

# Boundary and Source Properties
uko:hasBoundarySource a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "has boundary source" ;
    rdfs:comment "Source of boundary data: 'census', 'city_planning', 'community_consensus', 'llm_inferred', 'computed'" .

uko:boundaryConfidence a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:decimal ;
    rdfs:label "boundary confidence" ;
    rdfs:comment "Confidence level (0-1) in the accuracy of the boundary." .

uko:approximateBoundary a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "approximate boundary" ;
    rdfs:comment "Textual description of approximate boundaries for informal areas." .

uko:boundaryDisputed a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:boolean ;
    rdfs:label "boundary disputed" ;
    rdfs:comment "Indicates if the boundaries of this area are contested or unclear." .

# Functional District Properties
uko:dominantFunction a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:string ;
    rdfs:label "dominant function" ;
    rdfs:comment "The primary business or activity type that characterizes this district." .

uko:characterizedBy a owl:ObjectProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "characterized by" ;
    rdfs:comment "POIs that define the character of this functional district." .

uko:poiConcentration a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:integer ;
    rdfs:label "POI concentration" ;
    rdfs:comment "Number of characteristic POIs within this district." .

uko:clusterScore a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:decimal ;
    rdfs:label "cluster score" ;
    rdfs:comment "Statistical measure of POI clustering that defines this district." .

# Neighborhood Character Properties
uko:neighborhoodCharacter a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:string ;
    rdfs:label "neighborhood character" ;
    rdfs:comment "Description of the neighborhood's character: 'residential', 'mixed-use', 'commercial', etc." .

uko:predominantHousingType a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:string ;
    rdfs:label "predominant housing type" ;
    rdfs:comment "The most common type of housing: 'single-family', 'apartment', 'townhouse', etc." .

uko:walkabilityScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "walkability score" ;
    rdfs:comment "Walk Score or similar walkability metric (0-100)." .

uko:transitScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "transit score" ;
    rdfs:comment "Transit Score or similar transit accessibility metric (0-100)." .

uko:bikeScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "bike score" ;
    rdfs:comment "Bike Score or similar cycling friendliness metric (0-100)." .

# Naming Properties
uko:informalName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "informal name" ;
    rdfs:comment "Colloquial or informal name used by locals." .

uko:historicName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "historic name" ;
    rdfs:comment "Historical name no longer in common use." .

uko:alternativeName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "alternative name" ;
    rdfs:comment "Alternative name or spelling for this area." .

# Containment and Relationship Properties
uko:inNeighborhood a owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:Neighborhood ;
    rdfs:label "in neighborhood" ;
    rdfs:comment "The neighborhood containing this feature." ;
    owl:inverseOf uko:containsFeature .

uko:containsFeature a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:GeographicFeature ;
    rdfs:label "contains feature" ;
    rdfs:comment "A geographic feature contained within this neighborhood." .

uko:inDistrict a owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:District ;
    rdfs:label "in district" ;
    rdfs:comment "The district containing this feature." .

uko:adjacentNeighborhood a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:Neighborhood ;
    rdfs:label "adjacent neighborhood" ;
    rdfs:comment "A neighboring neighborhood that shares a boundary." ;
    rdf:type owl:SymmetricProperty .

uko:overlapsDistrict a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:District ;
    rdfs:label "overlaps district" ;
    rdfs:comment "A district that overlaps with this neighborhood." ;
    rdf:type owl:SymmetricProperty .

# Data Provenance Properties
uko:discoveryMethod a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "discovery method" ;
    rdfs:comment "How this area was discovered: 'osm', 'llm_query', 'poi_clustering', 'web_search', 'manual'" .

uko:verificationSource a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "verification source" ;
    rdfs:comment "Source used to verify this area's existence: URL, document reference, etc." .

uko:lastVerified a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:dateTime ;
    rdfs:label "last verified" ;
    rdfs:comment "Date when this area's information was last verified." .

###############################################################################
#    END OF DISTRICTS AND NEIGHBORHOODS EXTENSION
###############################################################################
###############################################################################
#
#    Urban Knowledge Ontology (UKO) Extension
#    Districts and Neighborhoods Module
#    Version 6.1.0
#
#    Purpose: Define classes and properties for formal and informal
#    geographic areas including neighborhoods and functional districts.
#
#    This file should be imported into the main UKO ontology or
#    merged with uko_ontology_v6.ttl
#
#    Synapse Partners, LLC
###############################################################################

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uko: <urn:urban-kg:> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <https://schema.org/> .

###############################################################################
#    NEIGHBORHOOD CLASSES
###############################################################################

uko:Neighborhood a owl:Class ;
    rdfs:subClassOf uko:GeographicArea ;
    rdfs:label "Neighborhood" ;
    rdfs:comment "A geographic area within a city or town that has a distinct identity, character, or community. May be officially designated or informally recognized." .

uko:OfficialNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Official Neighborhood" ;
    rdfs:comment "A neighborhood with legally designated boundaries recognized by local government, census bureau, or official planning documents." .

uko:InformalNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Informal Neighborhood" ;
    rdfs:comment "A community-recognized neighborhood without official government designation. Boundaries may be approximate or contested." .

uko:HistoricNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Historic Neighborhood" ;
    rdfs:comment "A neighborhood with historical significance, often with protected status or listed on historic registries." .

uko:HistoricDistrict a owl:Class ;
    rdfs:subClassOf uko:HistoricNeighborhood ;
    rdfs:label "Historic District" ;
    rdfs:comment "An officially designated historic area with legal protections for historic preservation." .

uko:GatedCommunity a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Gated Community" ;
    rdfs:comment "A residential neighborhood with controlled access, typically with walls or fences and entry gates." .

uko:PlannedCommunity a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Planned Community" ;
    rdfs:comment "A neighborhood designed and built as a unified development with coordinated planning." .

###############################################################################
#    DISTRICT CLASSES - FORMAL
###############################################################################

uko:District a owl:Class ;
    rdfs:subClassOf uko:GeographicArea ;
    rdfs:label "District" ;
    rdfs:comment "A defined area within a city serving a specific administrative, commercial, or functional purpose." .

uko:AdministrativeDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Administrative District" ;
    rdfs:comment "A district defined for governmental or administrative purposes." .

uko:BusinessImprovementDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Business Improvement District" ;
    rdfs:comment "A defined area where businesses pay additional taxes or fees for improvements and services." ;
    owl:equivalentClass uko:BID .

uko:BID a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "BID" ;
    rdfs:comment "Business Improvement District (abbreviation)." .

uko:SpecialPurposeDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Special Purpose District" ;
    rdfs:comment "A district created for a specific governmental function like water, fire, or schools." .

uko:ZoningDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Zoning District" ;
    rdfs:comment "An area with specific land use regulations and restrictions." .

uko:RedevelopmentDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Redevelopment District" ;
    rdfs:comment "An area designated for urban renewal or redevelopment with special incentives or regulations." .

uko:OpportunityZone a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Opportunity Zone" ;
    rdfs:comment "A federally designated economically-distressed community with tax incentives for investment." .

###############################################################################
#    DISTRICT CLASSES - INFORMAL/FUNCTIONAL
###############################################################################

uko:InformalDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Informal District" ;
    rdfs:comment "A district recognized by common usage or community consensus rather than official designation." .

uko:FunctionalDistrict a owl:Class ;
    rdfs:subClassOf uko:InformalDistrict ;
    rdfs:label "Functional District" ;
    rdfs:comment "An area characterized by concentration of similar businesses or activities, often informally named." .

# Commercial/Retail Functional Districts
uko:ShoppingDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Shopping District" ;
    rdfs:comment "An area with a high concentration of retail stores and shopping destinations." .

uko:AutoRow a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Auto Row" ;
    rdfs:comment "A stretch of road or area with multiple car dealerships and automotive businesses." .

uko:RestaurantRow a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Restaurant Row" ;
    rdfs:comment "An area with a high concentration of restaurants and dining establishments." .

uko:FoodDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Food District" ;
    rdfs:comment "An area known for diverse food establishments including restaurants, food halls, and specialty food shops." .

# Professional/Creative Functional Districts
uko:DesignDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Design District" ;
    rdfs:comment "An area with concentration of design-related businesses: architects, interior designers, furniture showrooms." .

uko:ArtDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Art District" ;
    rdfs:comment "An area with concentration of art galleries, artist studios, and creative businesses." .

uko:FashionDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Fashion District" ;
    rdfs:comment "An area with concentration of clothing manufacturers, wholesalers, and fashion-related businesses." .

uko:JewelryDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Jewelry District" ;
    rdfs:comment "An area with concentration of jewelry stores, wholesalers, and gem dealers." .

# Technology/Business Functional Districts
uko:TechCorridor a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Tech Corridor" ;
    rdfs:comment "An area with concentration of technology companies and startups." .

uko:FinancialDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Financial District" ;
    rdfs:comment "An area with concentration of banks, financial services, and corporate headquarters." .

uko:MedicalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Medical District" ;
    rdfs:comment "An area with concentration of hospitals, clinics, and medical offices." .

uko:LegalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Legal District" ;
    rdfs:comment "An area near courthouses with concentration of law offices and legal services." .

# Entertainment/Nightlife Functional Districts
uko:EntertainmentDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Entertainment District" ;
    rdfs:comment "An area with concentration of entertainment venues: theaters, music venues, nightclubs." .

uko:NightlifeDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Nightlife District" ;
    rdfs:comment "An area known for bars, clubs, and late-night entertainment." .

uko:TheaterDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Theater District" ;
    rdfs:comment "An area with concentration of theaters and performing arts venues." .

# Cultural/Ethnic Functional Districts
uko:CulturalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Cultural District" ;
    rdfs:comment "An area with concentration of cultural institutions: museums, galleries, performance spaces." .

uko:EthnicEnclave a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Ethnic Enclave" ;
    rdfs:comment "An area with concentration of businesses and residents from a particular ethnic or cultural background." .

uko:Chinatown a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Chinatown" ;
    rdfs:comment "An urban area with significant Chinese population and Chinese-owned businesses." .

uko:LittleItaly a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Little Italy" ;
    rdfs:comment "An urban area historically associated with Italian immigrants and Italian-American culture." .

uko:Koreatown a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Koreatown" ;
    rdfs:comment "An urban area with significant Korean population and Korean-owned businesses." .

uko:LittleTokyo a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Little Tokyo" ;
    rdfs:comment "An urban area with significant Japanese population and Japanese-owned businesses." .

uko:LatinQuarter a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Latin Quarter" ;
    rdfs:comment "An urban area with significant Latino/Hispanic population and Latino-owned businesses." .

# Industrial/Warehouse Functional Districts
uko:IndustrialDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Industrial District" ;
    rdfs:comment "An area with concentration of manufacturing, warehouses, and industrial businesses." .

uko:WarehouseDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Warehouse District" ;
    rdfs:comment "An area dominated by warehouses, often converted to lofts, galleries, or creative spaces." .

uko:PortDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Port District" ;
    rdfs:comment "An area around a port with shipping, logistics, and maritime businesses." .

# Civic/Institutional Functional Districts
uko:CivicCenter a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Civic Center" ;
    rdfs:comment "An area with concentration of government buildings and civic institutions." .

uko:UniversityDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "University District" ;
    rdfs:comment "An area surrounding a university with student-oriented businesses and housing." .

uko:HospitalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Hospital District" ;
    rdfs:comment "An area surrounding a major hospital with medical offices and health services." .

###############################################################################
#    DOWNTOWN AND CENTRAL BUSINESS AREAS
###############################################################################

uko:Downtown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Downtown" ;
    rdfs:comment "The central business district or commercial heart of a city." .

uko:CentralBusinessDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Central Business District" ;
    rdfs:comment "The main commercial and business center of a city." ;
    owl:equivalentClass uko:CBD .

uko:CBD a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "CBD" ;
    rdfs:comment "Central Business District (abbreviation)." .

uko:Uptown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Uptown" ;
    rdfs:comment "An area of a city typically north of or away from downtown, often more residential or affluent." .

uko:Midtown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Midtown" ;
    rdfs:comment "An area between downtown and uptown, often with mixed commercial and residential use." .

uko:OldTown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Old Town" ;
    rdfs:comment "The historic core of a city, often with preserved historic buildings." .

###############################################################################
#    PROPERTIES FOR NEIGHBORHOODS AND DISTRICTS
###############################################################################

# Official Status Properties
uko:hasOfficialStatus a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:boolean ;
    rdfs:label "has official status" ;
    rdfs:comment "Indicates whether the neighborhood has official government recognition." .

uko:recognizedBy a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:Organization ;
    rdfs:label "recognized by" ;
    rdfs:comment "The organization that officially recognizes or designates this area." .

uko:designationDate a owl:DatatypeProperty ;
    rdfs:domain uko:District ;
    rdfs:range xsd:date ;
    rdfs:label "designation date" ;
    rdfs:comment "The date when the district was officially designated." .

uko:designationAuthority a owl:DatatypeProperty ;
    rdfs:domain uko:District ;
    rdfs:range xsd:string ;
    rdfs:label "designation authority" ;
    rdfs:comment "The governmental body that designated this district." .

# Boundary and Source Properties
uko:hasBoundarySource a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "has boundary source" ;
    rdfs:comment "Source of boundary data: 'census', 'city_planning', 'community_consensus', 'llm_inferred', 'computed'" .

uko:boundaryConfidence a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:decimal ;
    rdfs:label "boundary confidence" ;
    rdfs:comment "Confidence level (0-1) in the accuracy of the boundary." .

uko:approximateBoundary a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "approximate boundary" ;
    rdfs:comment "Textual description of approximate boundaries for informal areas." .

uko:boundaryDisputed a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:boolean ;
    rdfs:label "boundary disputed" ;
    rdfs:comment "Indicates if the boundaries of this area are contested or unclear." .

# Functional District Properties
uko:dominantFunction a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:string ;
    rdfs:label "dominant function" ;
    rdfs:comment "The primary business or activity type that characterizes this district." .

uko:characterizedBy a owl:ObjectProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "characterized by" ;
    rdfs:comment "POIs that define the character of this functional district." .

uko:poiConcentration a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:integer ;
    rdfs:label "POI concentration" ;
    rdfs:comment "Number of characteristic POIs within this district." .

uko:clusterScore a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:decimal ;
    rdfs:label "cluster score" ;
    rdfs:comment "Statistical measure of POI clustering that defines this district." .

# Neighborhood Character Properties
uko:neighborhoodCharacter a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:string ;
    rdfs:label "neighborhood character" ;
    rdfs:comment "Description of the neighborhood's character: 'residential', 'mixed-use', 'commercial', etc." .

uko:predominantHousingType a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:string ;
    rdfs:label "predominant housing type" ;
    rdfs:comment "The most common type of housing: 'single-family', 'apartment', 'townhouse', etc." .

uko:walkabilityScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "walkability score" ;
    rdfs:comment "Walk Score or similar walkability metric (0-100)." .

uko:transitScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "transit score" ;
    rdfs:comment "Transit Score or similar transit accessibility metric (0-100)." .

uko:bikeScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "bike score" ;
    rdfs:comment "Bike Score or similar cycling friendliness metric (0-100)." .

# Naming Properties
uko:informalName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "informal name" ;
    rdfs:comment "Colloquial or informal name used by locals." .

uko:historicName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "historic name" ;
    rdfs:comment "Historical name no longer in common use." .

uko:alternativeName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "alternative name" ;
    rdfs:comment "Alternative name or spelling for this area." .

# Containment and Relationship Properties
uko:inNeighborhood a owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:Neighborhood ;
    rdfs:label "in neighborhood" ;
    rdfs:comment "The neighborhood containing this feature." ;
    owl:inverseOf uko:containsFeature .

uko:containsFeature a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:GeographicFeature ;
    rdfs:label "contains feature" ;
    rdfs:comment "A geographic feature contained within this neighborhood." .

uko:inDistrict a owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:District ;
    rdfs:label "in district" ;
    rdfs:comment "The district containing this feature." .

uko:adjacentNeighborhood a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:Neighborhood ;
    rdfs:label "adjacent neighborhood" ;
    rdfs:comment "A neighboring neighborhood that shares a boundary." ;
    rdf:type owl:SymmetricProperty .

uko:overlapsDistrict a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:District ;
    rdfs:label "overlaps district" ;
    rdfs:comment "A district that overlaps with this neighborhood." ;
    rdf:type owl:SymmetricProperty .

# Data Provenance Properties
uko:discoveryMethod a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "discovery method" ;
    rdfs:comment "How this area was discovered: 'osm', 'llm_query', 'poi_clustering', 'web_search', 'manual'" .

uko:verificationSource a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "verification source" ;
    rdfs:comment "Source used to verify this area's existence: URL, document reference, etc." .

uko:lastVerified a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:dateTime ;
    rdfs:label "last verified" ;
    rdfs:comment "Date when this area's information was last verified." .

###############################################################################
#    END OF DISTRICTS AND NEIGHBORHOODS EXTENSION
###############################################################################
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uko: <urn:urban-kg:> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# UKO Safety Extension v1.0
# High Injury Networks, Safety Concerns, Vulnerable Populations
# =============================================================================
#
# This extension adds classes and properties for:
# 1. High Injury Networks (HIN) - road segments with elevated crash rates
# 2. Pedestrian Priority Areas (PPA) - designated safety zones
# 3. Vulnerable Population Facilities - nursing homes, senior centers, etc.
# 4. Community-Reported Safety Concerns
# 5. Vision Zero concepts and metrics
#
# Based on CCTSAP (Contra Costa Transportation Safety Action Plan) data
# Compatible with FHWA safety analysis frameworks
#
# Copyright (c) 2025 Synapse Partners, LLC
# =============================================================================

<urn:urban-kg:ontology/safety>
    rdf:type owl:Ontology ;
    rdfs:label "UKO Safety Extension"@en ;
    rdfs:comment "Extension for transportation safety analysis including High Injury Networks, safety concerns, and vulnerable populations."@en ;
    owl:versionInfo "1.0" ;
    dcterms:created "2025-01-05"^^xsd:date ;
    dcterms:creator "Synapse Partners, LLC" .


# =============================================================================
# SECTION 1: HIGH INJURY NETWORKS
# =============================================================================

# -----------------------------------------------------------------------------
# Core HIN Classes
# -----------------------------------------------------------------------------

uko:HighInjuryNetwork
    rdf:type owl:Class ;
    rdfs:subClassOf uko:TransportationSafetyFeature ;
    rdfs:label "High Injury Network"@en ;
    rdfs:comment "Road network segments with disproportionately high rates of traffic injuries and fatalities. Typically represents 5-10% of roads but 50%+ of serious injuries."@en .

uko:HighInjuryNetworkBike
    rdf:type owl:Class ;
    rdfs:subClassOf uko:HighInjuryNetwork ;
    rdfs:label "High Injury Network - Bicycle"@en ;
    rdfs:comment "Road segments with elevated bicycle-involved crash rates."@en .

uko:HighInjuryNetworkPedestrian
    rdf:type owl:Class ;
    rdfs:subClassOf uko:HighInjuryNetwork ;
    rdfs:label "High Injury Network - Pedestrian"@en ;
    rdfs:comment "Road segments with elevated pedestrian-involved crash rates."@en .

uko:HighInjuryNetworkVehicle
    rdf:type owl:Class ;
    rdfs:subClassOf uko:HighInjuryNetwork ;
    rdfs:label "High Injury Network - Vehicle"@en ;
    rdfs:comment "Road segments with elevated vehicle-only crash rates."@en .

uko:HighInjuryNetworkMotorcycle
    rdf:type owl:Class ;
    rdfs:subClassOf uko:HighInjuryNetwork ;
    rdfs:label "High Injury Network - Motorcycle"@en ;
    rdfs:comment "Road segments with elevated motorcycle-involved crash rates."@en .

# -----------------------------------------------------------------------------
# Safety Zones
# -----------------------------------------------------------------------------

uko:TransportationSafetyFeature
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpatialEntity ;
    rdfs:label "Transportation Safety Feature"@en ;
    rdfs:comment "Any feature related to transportation safety analysis."@en .

uko:SafetyZone
    rdf:type owl:Class ;
    rdfs:subClassOf uko:TransportationSafetyFeature ;
    rdfs:label "Safety Zone"@en ;
    rdfs:comment "A designated area with specific safety considerations or treatments."@en .

uko:PedestrianPriorityArea
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyZone ;
    rdfs:label "Pedestrian Priority Area"@en ;
    rdfs:comment "Area designated for prioritized pedestrian safety improvements, typically around transit, schools, and commercial centers."@en .

uko:VisionZeroCorridorArea
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyZone ;
    rdfs:label "Vision Zero Corridor Area"@en ;
    rdfs:comment "Corridor identified for Vision Zero safety interventions."@en .

uko:SchoolSafetyZone
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyZone ;
    rdfs:label "School Safety Zone"@en ;
    rdfs:comment "Area around schools with enhanced safety requirements."@en .

uko:SeniorSafetyZone
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyZone ;
    rdfs:label "Senior Safety Zone"@en ;
    rdfs:comment "Area around senior facilities with enhanced safety considerations."@en .

# -----------------------------------------------------------------------------
# HIN Properties
# -----------------------------------------------------------------------------

uko:inHighInjuryNetwork
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "in High Injury Network"@en ;
    rdfs:comment "Indicates this entity is located within or part of a High Injury Network segment."@en .

uko:hinSegmentOf
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range uko:Road ;
    rdfs:label "HIN segment of"@en ;
    rdfs:comment "Links a High Injury Network segment to the road it overlays."@en .

uko:overlapsHIN
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:HighInjuryNetwork ;
    owl:inverseOf uko:hinSegmentOf ;
    rdfs:label "overlaps HIN"@en ;
    rdfs:comment "Indicates this road segment overlaps with a High Injury Network."@en .

uko:hinDataPeriod
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:string ;
    rdfs:label "HIN data period"@en ;
    rdfs:comment "Time period for crash data used to define HIN (e.g., '2018-2022')."@en .

uko:fatalCount
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:integer ;
    rdfs:label "fatal count"@en ;
    rdfs:comment "Number of fatal crashes in the HIN segment during data period."@en .

uko:severeInjuryCount
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:integer ;
    rdfs:label "severe injury count"@en ;
    rdfs:comment "Number of severe injury crashes in the HIN segment during data period."@en .

uko:crashRate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:decimal ;
    rdfs:label "crash rate"@en ;
    rdfs:comment "Crash rate per million vehicle miles traveled or per mile."@en .

uko:injurySeverityScore
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:decimal ;
    rdfs:label "injury severity score"@en ;
    rdfs:comment "Composite score weighting fatal and severe injuries."@en .


# =============================================================================
# SECTION 2: VULNERABLE POPULATIONS
# =============================================================================

# -----------------------------------------------------------------------------
# Vulnerable Population Facility Classes
# -----------------------------------------------------------------------------

uko:VulnerablePopulationFacility
    rdf:type owl:Class ;
    rdfs:subClassOf uko:PointOfInterest ;
    rdfs:label "Vulnerable Population Facility"@en ;
    rdfs:comment "Facility serving populations with elevated traffic safety risks: seniors, children, people with disabilities."@en .

uko:SeniorFacility
    rdf:type owl:Class ;
    rdfs:subClassOf uko:VulnerablePopulationFacility ;
    rdfs:label "Senior Facility"@en ;
    rdfs:comment "Facility primarily serving senior citizens."@en .

uko:NursingHome
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Nursing Home"@en ;
    rdfs:comment "Skilled nursing facility providing 24-hour care."@en .

uko:AssistedLivingFacility
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Assisted Living Facility"@en ;
    rdfs:comment "Residential facility providing assistance with daily activities."@en .

uko:SeniorCenter
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Senior Center"@en ;
    rdfs:comment "Community center providing programs and services for seniors."@en .

uko:IndependentLivingFacility
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Independent Living Facility"@en ;
    rdfs:comment "Senior housing community for independent adults."@en .

uko:MemoryCareFacility
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Memory Care Facility"@en ;
    rdfs:comment "Facility specialized for residents with dementia or Alzheimer's."@en .

uko:ChildFacility
    rdf:type owl:Class ;
    rdfs:subClassOf uko:VulnerablePopulationFacility ;
    rdfs:label "Child Facility"@en ;
    rdfs:comment "Facility primarily serving children."@en .

uko:Daycare
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ChildFacility ;
    rdfs:label "Daycare"@en ;
    rdfs:comment "Childcare facility for young children."@en .

uko:Preschool
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ChildFacility ;
    rdfs:label "Preschool"@en ;
    rdfs:comment "Early childhood education facility."@en .

uko:DisabilityFacility
    rdf:type owl:Class ;
    rdfs:subClassOf uko:VulnerablePopulationFacility ;
    rdfs:label "Disability Facility"@en ;
    rdfs:comment "Facility serving people with disabilities."@en .

# -----------------------------------------------------------------------------
# Vulnerable Population Properties
# -----------------------------------------------------------------------------

uko:residentCapacity
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:VulnerablePopulationFacility ;
    rdfs:range xsd:integer ;
    rdfs:label "resident capacity"@en ;
    rdfs:comment "Maximum number of residents the facility can accommodate."@en .

uko:bedCount
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:VulnerablePopulationFacility ;
    rdfs:range xsd:integer ;
    rdfs:label "bed count"@en ;
    rdfs:comment "Number of beds in the facility."@en .

uko:currentPopulation
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:VulnerablePopulationFacility ;
    rdfs:range xsd:integer ;
    rdfs:label "current population"@en ;
    rdfs:comment "Current number of residents or participants."@en .

uko:vulnerablePopulationType
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:VulnerablePopulationFacility ;
    rdfs:range xsd:string ;
    rdfs:label "vulnerable population type"@en ;
    rdfs:comment "Type of vulnerable population served (senior, child, disabled)."@en .

uko:hasVulnerablePopulationNearby
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:VulnerablePopulationFacility ;
    rdfs:label "has vulnerable population nearby"@en ;
    rdfs:comment "Indicates a vulnerable population facility is nearby (within safety buffer distance)."@en .

uko:nearVulnerablePopulation
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:VulnerablePopulationFacility ;
    rdfs:label "near vulnerable population"@en ;
    rdfs:comment "Road segment is near a vulnerable population facility."@en .


# =============================================================================
# SECTION 3: SAFETY CONCERNS
# =============================================================================

# -----------------------------------------------------------------------------
# Safety Concern Classes
# -----------------------------------------------------------------------------

uko:SafetyConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:TransportationSafetyFeature ;
    rdfs:label "Safety Concern"@en ;
    rdfs:comment "A reported or identified transportation safety concern at a specific location."@en .

uko:BicycleSafetyConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Bicycle Safety Concern"@en ;
    rdfs:comment "Safety concern related to bicycle infrastructure or cyclist safety."@en .

uko:PedestrianSafetyConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Pedestrian Safety Concern"@en ;
    rdfs:comment "Safety concern related to pedestrian infrastructure or walker safety."@en .

uko:SpeedingConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Speeding Concern"@en ;
    rdfs:comment "Safety concern related to vehicle speeding."@en .

uko:IntersectionSafetyConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Intersection Safety Concern"@en ;
    rdfs:comment "Safety concern at or related to an intersection."@en .

uko:VisibilityConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Visibility Concern"@en ;
    rdfs:comment "Safety concern related to sight lines, obstructions, or visibility."@en .

uko:LightingConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Lighting Concern"@en ;
    rdfs:comment "Safety concern related to inadequate street lighting."@en .

uko:SignalViolationConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Signal Violation Concern"@en ;
    rdfs:comment "Safety concern related to red light or stop sign violations."@en .

uko:UnsafeRouteToSchool
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Unsafe Route to School"@en ;
    rdfs:comment "Safety concern about a route used by children walking or biking to school."@en .

uko:ModeSeparationConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Mode Separation Concern"@en ;
    rdfs:comment "Safety concern about insufficient separation between travel modes (cars, bikes, pedestrians)."@en .

uko:PavementConditionConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Pavement Condition Concern"@en ;
    rdfs:comment "Safety concern related to poor pavement conditions (potholes, cracks, etc.)."@en .

uko:LargeTruckConcern
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Large Truck Concern"@en ;
    rdfs:comment "Safety concern related to large truck traffic."@en .

uko:UnsafeHazard
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Unsafe Hazard"@en ;
    rdfs:comment "General safety hazard not otherwise categorized."@en .

# -----------------------------------------------------------------------------
# Safety Concern Properties
# -----------------------------------------------------------------------------

uko:concernType
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "concern type"@en ;
    rdfs:comment "Category of safety concern."@en .

uko:concernDescription
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "concern description"@en ;
    rdfs:comment "Detailed description of the safety concern."@en .

uko:reportedDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:dateTime ;
    rdfs:label "reported date"@en ;
    rdfs:comment "Date the safety concern was reported."@en .

uko:reportSource
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "report source"@en ;
    rdfs:comment "Source of the safety concern report (community, agency, survey)."@en .

uko:communitySentiment
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "community sentiment"@en ;
    rdfs:comment "Sentiment analysis of the concern (POSITIVE, NEGATIVE, MIXED, NEUTRAL)."@en .

uko:upvoteCount
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:integer ;
    rdfs:label "upvote count"@en ;
    rdfs:comment "Number of community upvotes supporting this concern."@en .

uko:concernStatus
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "concern status"@en ;
    rdfs:comment "Status of the concern (open, reviewed, addressed, closed)."@en .

uko:concernPriority
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "concern priority"@en ;
    rdfs:comment "Priority level assigned to the concern (high, medium, low)."@en .

uko:affectsRoad
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range uko:Road ;
    rdfs:label "affects road"@en ;
    rdfs:comment "Road segment affected by this safety concern."@en .

uko:affectsIntersection
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range uko:Intersection ;
    rdfs:label "affects intersection"@en ;
    rdfs:comment "Intersection affected by this safety concern."@en .

uko:hasSafetyConcern
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:SafetyConcern ;
    rdfs:label "has safety concern"@en ;
    rdfs:comment "Links an entity to a safety concern at or near its location."@en .


# =============================================================================
# SECTION 4: VISION ZERO CONCEPTS
# =============================================================================

uko:VisionZeroStatus
    rdf:type owl:Class ;
    rdfs:label "Vision Zero Status"@en ;
    rdfs:comment "Status classification for Vision Zero planning and implementation."@en .

uko:visionZeroClassification
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "Vision Zero classification"@en ;
    rdfs:comment "Classification under Vision Zero framework (priority corridor, target area, etc.)."@en .

uko:safetyTreatmentApplied
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "safety treatment applied"@en ;
    rdfs:comment "Safety countermeasures applied to this road segment."@en .

uko:plannedSafetyTreatment
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "planned safety treatment"@en ;
    rdfs:comment "Planned safety countermeasures for this road segment."@en .


# =============================================================================
# SECTION 5: POLITICAL/ADMINISTRATIVE BOUNDARIES FOR SAFETY ANALYSIS
# =============================================================================

uko:SupervisorDistrict
    rdf:type owl:Class ;
    rdfs:subClassOf uko:AdministrativeArea ;
    rdfs:label "Supervisor District"@en ;
    rdfs:comment "County supervisor district boundary."@en .

uko:districtNumber
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SupervisorDistrict ;
    rdfs:range xsd:integer ;
    rdfs:label "district number"@en ;
    rdfs:comment "Numeric identifier for the supervisor district."@en .

uko:supervisorName
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SupervisorDistrict ;
    rdfs:range xsd:string ;
    rdfs:label "supervisor name"@en ;
    rdfs:comment "Name of the district supervisor."@en .

uko:inSupervisorDistrict
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:SupervisorDistrict ;
    rdfs:label "in supervisor district"@en ;
    rdfs:comment "Indicates the supervisor district containing this entity."@en .


# =============================================================================
# SECTION 6: SAFETY METRICS AND SCORING
# =============================================================================

uko:SafetyScore
    rdf:type owl:Class ;
    rdfs:label "Safety Score"@en ;
    rdfs:comment "Composite safety score for a location or route."@en .

uko:hasSafetyScore
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:SafetyScore ;
    rdfs:label "has safety score"@en .

uko:overallSafetyScore
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "overall safety score"@en ;
    rdfs:comment "Composite safety score (0-100, higher is safer)."@en .

uko:pedestrianSafetyScore
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "pedestrian safety score"@en ;
    rdfs:comment "Safety score for pedestrians (0-100)."@en .

uko:bicycleSafetyScore
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "bicycle safety score"@en ;
    rdfs:comment "Safety score for cyclists (0-100)."@en .

uko:childSafetyScore
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "child safety score"@en ;
    rdfs:comment "Safety score considering child vulnerability (0-100)."@en .

uko:seniorSafetyScore
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "senior safety score"@en ;
    rdfs:comment "Safety score considering senior vulnerability (0-100)."@en .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uko: <urn:urban-kg:> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# UKO ADAS Extension v1.0
# Advanced Driver Assistance Systems and Autonomous Vehicle Support
# =============================================================================
#
# This extension adds classes and properties for:
# 1. ADAS Features - speed limits, lane topology, e-horizon
# 2. HD Map Concepts - lane-level detail for autonomous navigation
# 3. Regulatory Compliance - ISA, NCAP requirements
# 4. Real-time Update Infrastructure - freshness, update frequency
# 5. Navigation Context - landmarks, waypoints, decision points
#
# Inspired by HERE Technologies and Mapbox MapGPT innovations
# Compatible with OpenDRIVE and NDS standards conceptually
#
# Copyright (c) 2025 Synapse Partners, LLC
# =============================================================================

<urn:urban-kg:ontology/adas>
    rdf:type owl:Ontology ;
    rdfs:label "UKO ADAS Extension"@en ;
    rdfs:comment "Extension for Advanced Driver Assistance Systems and autonomous vehicle support, including HD mapping concepts and regulatory compliance."@en ;
    owl:versionInfo "1.0" ;
    dcterms:created "2025-01-05"^^xsd:date ;
    dcterms:creator "Synapse Partners, LLC" .


# =============================================================================
# SECTION 1: ADAS FEATURES
# =============================================================================

# -----------------------------------------------------------------------------
# Core ADAS Classes
# -----------------------------------------------------------------------------

uko:ADASFeature
    rdf:type owl:Class ;
    rdfs:subClassOf uko:RoadFeature ;
    rdfs:label "ADAS Feature"@en ;
    rdfs:comment "Feature relevant to Advanced Driver Assistance Systems operation."@en .

uko:SpeedRegulation
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "Speed Regulation"@en ;
    rdfs:comment "Speed-related regulatory information for ADAS."@en .

uko:PostedSpeedLimit
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "Posted Speed Limit"@en ;
    rdfs:comment "Official posted speed limit sign location and value."@en .

uko:VariableSpeedLimit
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "Variable Speed Limit"@en ;
    rdfs:comment "Speed limit that changes based on conditions (time, weather, traffic)."@en .

uko:AdvisorySpeedLimit
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "Advisory Speed Limit"@en ;
    rdfs:comment "Recommended speed for curves, ramps, or hazardous conditions."@en .

uko:SchoolZoneSpeedLimit
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "School Zone Speed Limit"@en ;
    rdfs:comment "Reduced speed limit in school zones during active hours."@en .

# -----------------------------------------------------------------------------
# Traffic Control for ADAS
# -----------------------------------------------------------------------------

uko:ADASTrafficControl
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "ADAS Traffic Control"@en ;
    rdfs:comment "Traffic control device relevant to ADAS operation."@en .

uko:TrafficSignalTiming
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASTrafficControl ;
    rdfs:label "Traffic Signal Timing"@en ;
    rdfs:comment "Signal phase and timing information for signal priority/preemption."@en .

uko:StopSignLocation
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASTrafficControl ;
    rdfs:label "Stop Sign Location"@en ;
    rdfs:comment "Precise location of stop signs for ADAS recognition."@en .

uko:YieldSignLocation
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASTrafficControl ;
    rdfs:label "Yield Sign Location"@en ;
    rdfs:comment "Precise location of yield signs for ADAS recognition."@en .

# -----------------------------------------------------------------------------
# Speed Limit Properties
# -----------------------------------------------------------------------------

uko:speedLimitValue
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:integer ;
    rdfs:label "speed limit value"@en ;
    rdfs:comment "Speed limit value in the local unit (typically mph or km/h)."@en .

uko:speedLimitUnit
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:string ;
    rdfs:label "speed limit unit"@en ;
    rdfs:comment "Unit for speed limit (mph, km/h)."@en .

uko:speedLimitCondition
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:string ;
    rdfs:label "speed limit condition"@en ;
    rdfs:comment "Condition when speed limit applies (always, school_hours, when_flashing, wet_conditions)."@en .

uko:effectiveTimeStart
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:time ;
    rdfs:label "effective time start"@en ;
    rdfs:comment "Start time when conditional speed limit is in effect."@en .

uko:effectiveTimeEnd
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:time ;
    rdfs:label "effective time end"@en ;
    rdfs:comment "End time when conditional speed limit is no longer in effect."@en .


# =============================================================================
# SECTION 2: HD MAP / LANE-LEVEL CONCEPTS
# =============================================================================

# -----------------------------------------------------------------------------
# Lane Topology Classes
# -----------------------------------------------------------------------------

uko:LaneTopology
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "Lane Topology"@en ;
    rdfs:comment "Lane-level road topology for HD mapping and autonomous navigation."@en .

uko:LaneGroup
    rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Group"@en ;
    rdfs:comment "Group of lanes traveling in the same direction."@en .

uko:LaneBoundary
    rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Boundary"@en ;
    rdfs:comment "Boundary line between lanes with marking type."@en .

uko:LaneConnector
    rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Connector"@en ;
    rdfs:comment "Connection between lanes at intersections or merges."@en .

uko:LaneTransition
    rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Transition"@en ;
    rdfs:comment "Lane addition, drop, merge, or split point."@en .

# -----------------------------------------------------------------------------
# Lane Properties
# -----------------------------------------------------------------------------

uko:laneNumber
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:integer ;
    rdfs:label "lane number"@en ;
    rdfs:comment "Lane number from right edge (1 = rightmost lane)."@en .

uko:laneWidth
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:decimal ;
    rdfs:label "lane width"@en ;
    rdfs:comment "Width of lane in meters."@en .

uko:laneType
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:string ;
    rdfs:label "lane type"@en ;
    rdfs:comment "Type of lane (driving, parking, bike, bus, hov, turn, shoulder)."@en .

uko:laneDirection
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:string ;
    rdfs:label "lane direction"@en ;
    rdfs:comment "Travel direction of lane (forward, backward, bidirectional)."@en .

uko:laneBoundaryType
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LaneBoundary ;
    rdfs:range xsd:string ;
    rdfs:label "lane boundary type"@en ;
    rdfs:comment "Type of lane marking (solid_white, dashed_white, solid_yellow, double_yellow, etc.)."@en .

uko:laneCrossable
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LaneBoundary ;
    rdfs:range xsd:boolean ;
    rdfs:label "lane crossable"@en ;
    rdfs:comment "Whether vehicles can legally cross this lane boundary."@en .

uko:turnRestriction
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:string ;
    rdfs:label "turn restriction"@en ;
    rdfs:comment "Turn restrictions for this lane (left_only, right_only, straight_only, no_left, no_right, no_uturn)."@en .

uko:connectsToLane
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:LaneConnector ;
    rdfs:range uko:Lane ;
    rdfs:label "connects to lane"@en ;
    rdfs:comment "Lane that this connector leads to."@en .

uko:connectsFromLane
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:LaneConnector ;
    rdfs:range uko:Lane ;
    rdfs:label "connects from lane"@en ;
    rdfs:comment "Lane that this connector originates from."@en .


# =============================================================================
# SECTION 3: E-HORIZON CONCEPTS
# =============================================================================

uko:EHorizonFeature
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "E-Horizon Feature"@en ;
    rdfs:comment "Feature visible in the electronic horizon (ahead of vehicle sensor range)."@en .

uko:eHorizonFeatureOf
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:EHorizonFeature ;
    rdfs:label "e-horizon feature of"@en ;
    rdfs:comment "Road features visible in e-horizon for this road segment."@en .

uko:anticipationDistance
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:EHorizonFeature ;
    rdfs:range xsd:decimal ;
    rdfs:label "anticipation distance"@en ;
    rdfs:comment "Distance at which this feature should be anticipated (meters)."@en .

uko:curvatureAhead
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:decimal ;
    rdfs:label "curvature ahead"@en ;
    rdfs:comment "Road curvature in the upcoming segment (1/radius in meters)."@en .

uko:gradeAhead
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:decimal ;
    rdfs:label "grade ahead"@en ;
    rdfs:comment "Road grade/slope in the upcoming segment (percentage)."@en .

uko:hazardAhead
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:SafetyConcern ;
    rdfs:label "hazard ahead"@en ;
    rdfs:comment "Known hazard in the upcoming road segment."@en .


# =============================================================================
# SECTION 4: REGULATORY COMPLIANCE
# =============================================================================

# -----------------------------------------------------------------------------
# Compliance Classes
# -----------------------------------------------------------------------------

uko:RegulatoryCompliance
    rdf:type owl:Class ;
    rdfs:label "Regulatory Compliance"@en ;
    rdfs:comment "Compliance status with regulatory requirements."@en .

uko:ISACompliance
    rdf:type owl:Class ;
    rdfs:subClassOf uko:RegulatoryCompliance ;
    rdfs:label "ISA Compliance"@en ;
    rdfs:comment "Compliance with Intelligent Speed Assistance mandate."@en .

uko:NCAPCompliance
    rdf:type owl:Class ;
    rdfs:subClassOf uko:RegulatoryCompliance ;
    rdfs:label "NCAP Compliance"@en ;
    rdfs:comment "Compliance with New Car Assessment Program requirements."@en .

# -----------------------------------------------------------------------------
# Compliance Properties
# -----------------------------------------------------------------------------

uko:isaCompliant
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "ISA compliant"@en ;
    rdfs:comment "Road has complete data for ISA compliance (speed limits, sign locations)."@en .

uko:ncapCompliant
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "NCAP compliant"@en ;
    rdfs:comment "Road has complete data for NCAP safety assessment."@en .

uko:complianceRegion
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RegulatoryCompliance ;
    rdfs:range xsd:string ;
    rdfs:label "compliance region"@en ;
    rdfs:comment "Geographic region for compliance (EU, US, APAC)."@en .

uko:complianceDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RegulatoryCompliance ;
    rdfs:range xsd:date ;
    rdfs:label "compliance date"@en ;
    rdfs:comment "Date compliance was verified."@en .


# =============================================================================
# SECTION 5: REAL-TIME UPDATE INFRASTRUCTURE
# =============================================================================

# -----------------------------------------------------------------------------
# Update Tracking
# -----------------------------------------------------------------------------

uko:lastUpdated
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:dateTime ;
    rdfs:label "last updated"@en ;
    rdfs:comment "Timestamp of most recent data update."@en .

uko:updateFrequency
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "update frequency"@en ;
    rdfs:comment "Expected update frequency (real-time, daily, weekly, monthly)."@en .

uko:dataSource
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "data source"@en ;
    rdfs:comment "Source of the data (OSM, probe, survey, aerial, LiDAR)."@en .

uko:dataFreshness
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "data freshness"@en ;
    rdfs:comment "Freshness classification (current, recent, stale, unknown)."@en .

uko:verificationStatus
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "verification status"@en ;
    rdfs:comment "Data verification status (verified, unverified, disputed)."@en .

uko:verificationDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:date ;
    rdfs:label "verification date"@en ;
    rdfs:comment "Date of last verification."@en .

uko:verificationMethod
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "verification method"@en ;
    rdfs:comment "Method used for verification (imagery, ground_truth, probe_data, user_report)."@en .


# =============================================================================
# SECTION 6: NAVIGATION CONTEXT (MapGPT-inspired)
# =============================================================================

# -----------------------------------------------------------------------------
# Landmark and Context Classes
# -----------------------------------------------------------------------------

uko:NavigationLandmark
    rdf:type owl:Class ;
    rdfs:subClassOf uko:PointOfInterest ;
    rdfs:label "Navigation Landmark"@en ;
    rdfs:comment "Visually distinctive feature useful for navigation reference."@en .

uko:DecisionPoint
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpatialEntity ;
    rdfs:label "Decision Point"@en ;
    rdfs:comment "Location requiring navigation decision (turn, exit, lane change)."@en .

uko:NavigationContext
    rdf:type owl:Class ;
    rdfs:label "Navigation Context"@en ;
    rdfs:comment "Contextual information for natural language navigation."@en .

# -----------------------------------------------------------------------------
# Navigation Properties
# -----------------------------------------------------------------------------

uko:landmarkVisibility
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:NavigationLandmark ;
    rdfs:range xsd:string ;
    rdfs:label "landmark visibility"@en ;
    rdfs:comment "Visibility conditions (day_only, night_illuminated, all_conditions)."@en .

uko:landmarkDescription
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:NavigationLandmark ;
    rdfs:range xsd:string ;
    rdfs:label "landmark description"@en ;
    rdfs:comment "Natural language description for voice navigation."@en .

uko:decisionType
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range xsd:string ;
    rdfs:label "decision type"@en ;
    rdfs:comment "Type of navigation decision (turn, exit, merge, lane_change, roundabout)."@en .

uko:decisionComplexity
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range xsd:string ;
    rdfs:label "decision complexity"@en ;
    rdfs:comment "Complexity of the decision point (simple, moderate, complex)."@en .

uko:nearbyLandmark
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range uko:NavigationLandmark ;
    rdfs:label "nearby landmark"@en ;
    rdfs:comment "Landmark near this decision point useful for orientation."@en .

uko:voicePrompt
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range xsd:string ;
    rdfs:label "voice prompt"@en ;
    rdfs:comment "Suggested voice navigation prompt for this decision point."@en .


# =============================================================================
# SECTION 7: AUTONOMOUS DRIVING LEVELS
# =============================================================================

uko:autonomyLevel
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "autonomy level"@en ;
    rdfs:comment "Maximum supported SAE autonomy level (L1, L2, L2+, L3, L4, L5)."@en .

uko:autonomyRestriction
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "autonomy restriction"@en ;
    rdfs:comment "Restrictions on autonomous operation (weather, time_of_day, construction)."@en .

uko:geoFenced
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "geo-fenced"@en ;
    rdfs:comment "Road is within an autonomous vehicle operational design domain (ODD) geofence."@en .

uko:oddClassification
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "ODD classification"@en ;
    rdfs:comment "Operational Design Domain classification for autonomous vehicles."@en .


#################################################################
#    EXTENSION: DISTRICTS & NEIGHBORHOODS
#################################################################

###############################################################################
#
#    Urban Knowledge Ontology (UKO) Extension
#    Districts and Neighborhoods Module
#    Version 6.1.0
#
#    Purpose: Define classes and properties for formal and informal
#    geographic areas including neighborhoods and functional districts.
#
#    This file should be imported into the main UKO ontology or
#    merged with uko_ontology_v6.ttl
#
#    Synapse Partners, LLC
###############################################################################

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uko: <urn:urban-kg:> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <https://schema.org/> .

###############################################################################
#    NEIGHBORHOOD CLASSES
###############################################################################

uko:Neighborhood a owl:Class ;
    rdfs:subClassOf uko:GeographicArea ;
    rdfs:label "Neighborhood" ;
    rdfs:comment "A geographic area within a city or town that has a distinct identity, character, or community. May be officially designated or informally recognized." .

uko:OfficialNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Official Neighborhood" ;
    rdfs:comment "A neighborhood with legally designated boundaries recognized by local government, census bureau, or official planning documents." .

uko:InformalNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Informal Neighborhood" ;
    rdfs:comment "A community-recognized neighborhood without official government designation. Boundaries may be approximate or contested." .

uko:HistoricNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Historic Neighborhood" ;
    rdfs:comment "A neighborhood with historical significance, often with protected status or listed on historic registries." .

uko:HistoricDistrict a owl:Class ;
    rdfs:subClassOf uko:HistoricNeighborhood ;
    rdfs:label "Historic District" ;
    rdfs:comment "An officially designated historic area with legal protections for historic preservation." .

uko:GatedCommunity a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Gated Community" ;
    rdfs:comment "A residential neighborhood with controlled access, typically with walls or fences and entry gates." .

uko:PlannedCommunity a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Planned Community" ;
    rdfs:comment "A neighborhood designed and built as a unified development with coordinated planning." .

###############################################################################
#    DISTRICT CLASSES - FORMAL
###############################################################################

uko:District a owl:Class ;
    rdfs:subClassOf uko:GeographicArea ;
    rdfs:label "District" ;
    rdfs:comment "A defined area within a city serving a specific administrative, commercial, or functional purpose." .

uko:AdministrativeDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Administrative District" ;
    rdfs:comment "A district defined for governmental or administrative purposes." .

uko:BusinessImprovementDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Business Improvement District" ;
    rdfs:comment "A defined area where businesses pay additional taxes or fees for improvements and services." ;
    owl:equivalentClass uko:BID .

uko:BID a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "BID" ;
    rdfs:comment "Business Improvement District (abbreviation)." .

uko:SpecialPurposeDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Special Purpose District" ;
    rdfs:comment "A district created for a specific governmental function like water, fire, or schools." .

uko:ZoningDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Zoning District" ;
    rdfs:comment "An area with specific land use regulations and restrictions." .

uko:RedevelopmentDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Redevelopment District" ;
    rdfs:comment "An area designated for urban renewal or redevelopment with special incentives or regulations." .

uko:OpportunityZone a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Opportunity Zone" ;
    rdfs:comment "A federally designated economically-distressed community with tax incentives for investment." .

###############################################################################
#    DISTRICT CLASSES - INFORMAL/FUNCTIONAL
###############################################################################

uko:InformalDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Informal District" ;
    rdfs:comment "A district recognized by common usage or community consensus rather than official designation." .

uko:FunctionalDistrict a owl:Class ;
    rdfs:subClassOf uko:InformalDistrict ;
    rdfs:label "Functional District" ;
    rdfs:comment "An area characterized by concentration of similar businesses or activities, often informally named." .

# Commercial/Retail Functional Districts
uko:ShoppingDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Shopping District" ;
    rdfs:comment "An area with a high concentration of retail stores and shopping destinations." .

uko:AutoRow a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Auto Row" ;
    rdfs:comment "A stretch of road or area with multiple car dealerships and automotive businesses." .

uko:RestaurantRow a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Restaurant Row" ;
    rdfs:comment "An area with a high concentration of restaurants and dining establishments." .

uko:FoodDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Food District" ;
    rdfs:comment "An area known for diverse food establishments including restaurants, food halls, and specialty food shops." .

# Professional/Creative Functional Districts
uko:DesignDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Design District" ;
    rdfs:comment "An area with concentration of design-related businesses: architects, interior designers, furniture showrooms." .

uko:ArtDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Art District" ;
    rdfs:comment "An area with concentration of art galleries, artist studios, and creative businesses." .

uko:FashionDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Fashion District" ;
    rdfs:comment "An area with concentration of clothing manufacturers, wholesalers, and fashion-related businesses." .

uko:JewelryDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Jewelry District" ;
    rdfs:comment "An area with concentration of jewelry stores, wholesalers, and gem dealers." .

# Technology/Business Functional Districts
uko:TechCorridor a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Tech Corridor" ;
    rdfs:comment "An area with concentration of technology companies and startups." .

uko:FinancialDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Financial District" ;
    rdfs:comment "An area with concentration of banks, financial services, and corporate headquarters." .

uko:MedicalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Medical District" ;
    rdfs:comment "An area with concentration of hospitals, clinics, and medical offices." .

uko:LegalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Legal District" ;
    rdfs:comment "An area near courthouses with concentration of law offices and legal services." .

# Entertainment/Nightlife Functional Districts
uko:EntertainmentDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Entertainment District" ;
    rdfs:comment "An area with concentration of entertainment venues: theaters, music venues, nightclubs." .

uko:NightlifeDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Nightlife District" ;
    rdfs:comment "An area known for bars, clubs, and late-night entertainment." .

uko:TheaterDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Theater District" ;
    rdfs:comment "An area with concentration of theaters and performing arts venues." .

# Cultural/Ethnic Functional Districts
uko:CulturalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Cultural District" ;
    rdfs:comment "An area with concentration of cultural institutions: museums, galleries, performance spaces." .

uko:EthnicEnclave a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Ethnic Enclave" ;
    rdfs:comment "An area with concentration of businesses and residents from a particular ethnic or cultural background." .

uko:Chinatown a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Chinatown" ;
    rdfs:comment "An urban area with significant Chinese population and Chinese-owned businesses." .

uko:LittleItaly a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Little Italy" ;
    rdfs:comment "An urban area historically associated with Italian immigrants and Italian-American culture." .

uko:Koreatown a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Koreatown" ;
    rdfs:comment "An urban area with significant Korean population and Korean-owned businesses." .

uko:LittleTokyo a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Little Tokyo" ;
    rdfs:comment "An urban area with significant Japanese population and Japanese-owned businesses." .

uko:LatinQuarter a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Latin Quarter" ;
    rdfs:comment "An urban area with significant Latino/Hispanic population and Latino-owned businesses." .

# Industrial/Warehouse Functional Districts
uko:IndustrialDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Industrial District" ;
    rdfs:comment "An area with concentration of manufacturing, warehouses, and industrial businesses." .

uko:WarehouseDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Warehouse District" ;
    rdfs:comment "An area dominated by warehouses, often converted to lofts, galleries, or creative spaces." .

uko:PortDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Port District" ;
    rdfs:comment "An area around a port with shipping, logistics, and maritime businesses." .

# Civic/Institutional Functional Districts
uko:CivicCenter a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Civic Center" ;
    rdfs:comment "An area with concentration of government buildings and civic institutions." .

uko:UniversityDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "University District" ;
    rdfs:comment "An area surrounding a university with student-oriented businesses and housing." .

uko:HospitalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Hospital District" ;
    rdfs:comment "An area surrounding a major hospital with medical offices and health services." .

###############################################################################
#    DOWNTOWN AND CENTRAL BUSINESS AREAS
###############################################################################

uko:Downtown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Downtown" ;
    rdfs:comment "The central business district or commercial heart of a city." .

uko:CentralBusinessDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Central Business District" ;
    rdfs:comment "The main commercial and business center of a city." ;
    owl:equivalentClass uko:CBD .

uko:CBD a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "CBD" ;
    rdfs:comment "Central Business District (abbreviation)." .

uko:Uptown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Uptown" ;
    rdfs:comment "An area of a city typically north of or away from downtown, often more residential or affluent." .

uko:Midtown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Midtown" ;
    rdfs:comment "An area between downtown and uptown, often with mixed commercial and residential use." .

uko:OldTown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Old Town" ;
    rdfs:comment "The historic core of a city, often with preserved historic buildings." .

###############################################################################
#    PROPERTIES FOR NEIGHBORHOODS AND DISTRICTS
###############################################################################

# Official Status Properties
uko:hasOfficialStatus a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:boolean ;
    rdfs:label "has official status" ;
    rdfs:comment "Indicates whether the neighborhood has official government recognition." .

uko:recognizedBy a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:Organization ;
    rdfs:label "recognized by" ;
    rdfs:comment "The organization that officially recognizes or designates this area." .

uko:designationDate a owl:DatatypeProperty ;
    rdfs:domain uko:District ;
    rdfs:range xsd:date ;
    rdfs:label "designation date" ;
    rdfs:comment "The date when the district was officially designated." .

uko:designationAuthority a owl:DatatypeProperty ;
    rdfs:domain uko:District ;
    rdfs:range xsd:string ;
    rdfs:label "designation authority" ;
    rdfs:comment "The governmental body that designated this district." .

# Boundary and Source Properties
uko:hasBoundarySource a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "has boundary source" ;
    rdfs:comment "Source of boundary data: 'census', 'city_planning', 'community_consensus', 'llm_inferred', 'computed'" .

uko:boundaryConfidence a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:decimal ;
    rdfs:label "boundary confidence" ;
    rdfs:comment "Confidence level (0-1) in the accuracy of the boundary." .

uko:approximateBoundary a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "approximate boundary" ;
    rdfs:comment "Textual description of approximate boundaries for informal areas." .

uko:boundaryDisputed a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:boolean ;
    rdfs:label "boundary disputed" ;
    rdfs:comment "Indicates if the boundaries of this area are contested or unclear." .

# Functional District Properties
uko:dominantFunction a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:string ;
    rdfs:label "dominant function" ;
    rdfs:comment "The primary business or activity type that characterizes this district." .

uko:characterizedBy a owl:ObjectProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "characterized by" ;
    rdfs:comment "POIs that define the character of this functional district." .

uko:poiConcentration a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:integer ;
    rdfs:label "POI concentration" ;
    rdfs:comment "Number of characteristic POIs within this district." .

uko:clusterScore a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:decimal ;
    rdfs:label "cluster score" ;
    rdfs:comment "Statistical measure of POI clustering that defines this district." .

# Neighborhood Character Properties
uko:neighborhoodCharacter a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:string ;
    rdfs:label "neighborhood character" ;
    rdfs:comment "Description of the neighborhood's character: 'residential', 'mixed-use', 'commercial', etc." .

uko:predominantHousingType a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:string ;
    rdfs:label "predominant housing type" ;
    rdfs:comment "The most common type of housing: 'single-family', 'apartment', 'townhouse', etc." .

uko:walkabilityScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "walkability score" ;
    rdfs:comment "Walk Score or similar walkability metric (0-100)." .

uko:transitScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "transit score" ;
    rdfs:comment "Transit Score or similar transit accessibility metric (0-100)." .

uko:bikeScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "bike score" ;
    rdfs:comment "Bike Score or similar cycling friendliness metric (0-100)." .

# Naming Properties
uko:informalName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "informal name" ;
    rdfs:comment "Colloquial or informal name used by locals." .

uko:historicName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "historic name" ;
    rdfs:comment "Historical name no longer in common use." .

uko:alternativeName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "alternative name" ;
    rdfs:comment "Alternative name or spelling for this area." .

# Containment and Relationship Properties
uko:inNeighborhood a owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:Neighborhood ;
    rdfs:label "in neighborhood" ;
    rdfs:comment "The neighborhood containing this feature." ;
    owl:inverseOf uko:containsFeature .

uko:containsFeature a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:GeographicFeature ;
    rdfs:label "contains feature" ;
    rdfs:comment "A geographic feature contained within this neighborhood." .

uko:inDistrict a owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:District ;
    rdfs:label "in district" ;
    rdfs:comment "The district containing this feature." .

uko:adjacentNeighborhood a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:Neighborhood ;
    rdfs:label "adjacent neighborhood" ;
    rdfs:comment "A neighboring neighborhood that shares a boundary." ;
    rdf:type owl:SymmetricProperty .

uko:overlapsDistrict a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:District ;
    rdfs:label "overlaps district" ;
    rdfs:comment "A district that overlaps with this neighborhood." ;
    rdf:type owl:SymmetricProperty .

# Data Provenance Properties
uko:discoveryMethod a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "discovery method" ;
    rdfs:comment "How this area was discovered: 'osm', 'llm_query', 'poi_clustering', 'web_search', 'manual'" .

uko:verificationSource a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "verification source" ;
    rdfs:comment "Source used to verify this area's existence: URL, document reference, etc." .

uko:lastVerified a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:dateTime ;
    rdfs:label "last verified" ;
    rdfs:comment "Date when this area's information was last verified." .

###############################################################################
#    END OF DISTRICTS AND NEIGHBORHOODS EXTENSION
###############################################################################


#################################################################
#    EXTENSION: ADAS/SAFETY FEATURES
#################################################################

uko:ADASFeature
    rdf:type owl:Class ;
    rdfs:subClassOf uko:RoadFeature ;
    rdfs:label "ADAS Feature"@en ;
    rdfs:comment "Feature relevant to Advanced Driver Assistance Systems operation."@en .

uko:SpeedRegulation
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "Speed Regulation"@en ;
    rdfs:comment "Speed-related regulatory information for ADAS."@en .

uko:PostedSpeedLimit
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "Posted Speed Limit"@en ;
    rdfs:comment "Official posted speed limit sign location and value."@en .

uko:VariableSpeedLimit
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "Variable Speed Limit"@en ;
    rdfs:comment "Speed limit that changes based on conditions (time, weather, traffic)."@en .

uko:AdvisorySpeedLimit
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "Advisory Speed Limit"@en ;
    rdfs:comment "Recommended speed for curves, ramps, or hazardous conditions."@en .

uko:SchoolZoneSpeedLimit
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "School Zone Speed Limit"@en ;
    rdfs:comment "Reduced speed limit in school zones during active hours."@en .

# -----------------------------------------------------------------------------
# Traffic Control for ADAS
# -----------------------------------------------------------------------------

uko:ADASTrafficControl
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "ADAS Traffic Control"@en ;
    rdfs:comment "Traffic control device relevant to ADAS operation."@en .

uko:TrafficSignalTiming
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASTrafficControl ;
    rdfs:label "Traffic Signal Timing"@en ;
    rdfs:comment "Signal phase and timing information for signal priority/preemption."@en .

uko:StopSignLocation
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASTrafficControl ;
    rdfs:label "Stop Sign Location"@en ;
    rdfs:comment "Precise location of stop signs for ADAS recognition."@en .

uko:YieldSignLocation
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASTrafficControl ;
    rdfs:label "Yield Sign Location"@en ;
    rdfs:comment "Precise location of yield signs for ADAS recognition."@en .

# -----------------------------------------------------------------------------
# Speed Limit Properties
# -----------------------------------------------------------------------------

uko:speedLimitValue
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:integer ;
    rdfs:label "speed limit value"@en ;
    rdfs:comment "Speed limit value in the local unit (typically mph or km/h)."@en .

uko:speedLimitUnit
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:string ;
    rdfs:label "speed limit unit"@en ;
    rdfs:comment "Unit for speed limit (mph, km/h)."@en .

uko:speedLimitCondition
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:string ;
    rdfs:label "speed limit condition"@en ;
    rdfs:comment "Condition when speed limit applies (always, school_hours, when_flashing, wet_conditions)."@en .

uko:effectiveTimeStart
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:time ;
    rdfs:label "effective time start"@en ;
    rdfs:comment "Start time when conditional speed limit is in effect."@en .

uko:effectiveTimeEnd
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:time ;
    rdfs:label "effective time end"@en ;
    rdfs:comment "End time when conditional speed limit is no longer in effect."@en .


# =============================================================================
# SECTION 2: HD MAP / LANE-LEVEL CONCEPTS
# =============================================================================

# -----------------------------------------------------------------------------
# Lane Topology Classes
# -----------------------------------------------------------------------------

uko:LaneTopology
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "Lane Topology"@en ;
    rdfs:comment "Lane-level road topology for HD mapping and autonomous navigation."@en .

uko:LaneGroup
    rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Group"@en ;
    rdfs:comment "Group of lanes traveling in the same direction."@en .

uko:LaneBoundary
    rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Boundary"@en ;
    rdfs:comment "Boundary line between lanes with marking type."@en .

uko:LaneConnector
    rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Connector"@en ;
    rdfs:comment "Connection between lanes at intersections or merges."@en .

uko:LaneTransition
    rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Transition"@en ;
    rdfs:comment "Lane addition, drop, merge, or split point."@en .

# -----------------------------------------------------------------------------
# Lane Properties
# -----------------------------------------------------------------------------

uko:laneNumber
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:integer ;
    rdfs:label "lane number"@en ;
    rdfs:comment "Lane number from right edge (1 = rightmost lane)."@en .

uko:laneWidth
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:decimal ;
    rdfs:label "lane width"@en ;
    rdfs:comment "Width of lane in meters."@en .

uko:laneType
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:string ;
    rdfs:label "lane type"@en ;
    rdfs:comment "Type of lane (driving, parking, bike, bus, hov, turn, shoulder)."@en .

uko:laneDirection
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:string ;
    rdfs:label "lane direction"@en ;
    rdfs:comment "Travel direction of lane (forward, backward, bidirectional)."@en .

uko:laneBoundaryType
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LaneBoundary ;
    rdfs:range xsd:string ;
    rdfs:label "lane boundary type"@en ;
    rdfs:comment "Type of lane marking (solid_white, dashed_white, solid_yellow, double_yellow, etc.)."@en .

uko:laneCrossable
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LaneBoundary ;
    rdfs:range xsd:boolean ;
    rdfs:label "lane crossable"@en ;
    rdfs:comment "Whether vehicles can legally cross this lane boundary."@en .

uko:turnRestriction
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:string ;
    rdfs:label "turn restriction"@en ;
    rdfs:comment "Turn restrictions for this lane (left_only, right_only, straight_only, no_left, no_right, no_uturn)."@en .

uko:connectsToLane
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:LaneConnector ;
    rdfs:range uko:Lane ;
    rdfs:label "connects to lane"@en ;
    rdfs:comment "Lane that this connector leads to."@en .

uko:connectsFromLane
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:LaneConnector ;
    rdfs:range uko:Lane ;
    rdfs:label "connects from lane"@en ;
    rdfs:comment "Lane that this connector originates from."@en .


# =============================================================================
# SECTION 3: E-HORIZON CONCEPTS
# =============================================================================

uko:EHorizonFeature
    rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "E-Horizon Feature"@en ;
    rdfs:comment "Feature visible in the electronic horizon (ahead of vehicle sensor range)."@en .

uko:eHorizonFeatureOf
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:EHorizonFeature ;
    rdfs:label "e-horizon feature of"@en ;
    rdfs:comment "Road features visible in e-horizon for this road segment."@en .

uko:anticipationDistance
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:EHorizonFeature ;
    rdfs:range xsd:decimal ;
    rdfs:label "anticipation distance"@en ;
    rdfs:comment "Distance at which this feature should be anticipated (meters)."@en .

uko:curvatureAhead
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:decimal ;
    rdfs:label "curvature ahead"@en ;
    rdfs:comment "Road curvature in the upcoming segment (1/radius in meters)."@en .

uko:gradeAhead
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:decimal ;
    rdfs:label "grade ahead"@en ;
    rdfs:comment "Road grade/slope in the upcoming segment (percentage)."@en .

uko:hazardAhead
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:SafetyConcern ;
    rdfs:label "hazard ahead"@en ;
    rdfs:comment "Known hazard in the upcoming road segment."@en .


# =============================================================================
# SECTION 4: REGULATORY COMPLIANCE
# =============================================================================

# -----------------------------------------------------------------------------
# Compliance Classes
# -----------------------------------------------------------------------------

uko:RegulatoryCompliance
    rdf:type owl:Class ;
    rdfs:label "Regulatory Compliance"@en ;
    rdfs:comment "Compliance status with regulatory requirements."@en .

uko:ISACompliance
    rdf:type owl:Class ;
    rdfs:subClassOf uko:RegulatoryCompliance ;
    rdfs:label "ISA Compliance"@en ;
    rdfs:comment "Compliance with Intelligent Speed Assistance mandate."@en .

uko:NCAPCompliance
    rdf:type owl:Class ;
    rdfs:subClassOf uko:RegulatoryCompliance ;
    rdfs:label "NCAP Compliance"@en ;
    rdfs:comment "Compliance with New Car Assessment Program requirements."@en .

# -----------------------------------------------------------------------------
# Compliance Properties
# -----------------------------------------------------------------------------

uko:isaCompliant
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "ISA compliant"@en ;
    rdfs:comment "Road has complete data for ISA compliance (speed limits, sign locations)."@en .

uko:ncapCompliant
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "NCAP compliant"@en ;
    rdfs:comment "Road has complete data for NCAP safety assessment."@en .

uko:complianceRegion
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RegulatoryCompliance ;
    rdfs:range xsd:string ;
    rdfs:label "compliance region"@en ;
    rdfs:comment "Geographic region for compliance (EU, US, APAC)."@en .

uko:complianceDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RegulatoryCompliance ;
    rdfs:range xsd:date ;
    rdfs:label "compliance date"@en ;
    rdfs:comment "Date compliance was verified."@en .


# =============================================================================
# SECTION 5: REAL-TIME UPDATE INFRASTRUCTURE
# =============================================================================

# -----------------------------------------------------------------------------
# Update Tracking
# -----------------------------------------------------------------------------

uko:lastUpdated
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:dateTime ;
    rdfs:label "last updated"@en ;
    rdfs:comment "Timestamp of most recent data update."@en .

uko:updateFrequency
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "update frequency"@en ;
    rdfs:comment "Expected update frequency (real-time, daily, weekly, monthly)."@en .

uko:dataSource
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "data source"@en ;
    rdfs:comment "Source of the data (OSM, probe, survey, aerial, LiDAR)."@en .

uko:dataFreshness
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "data freshness"@en ;
    rdfs:comment "Freshness classification (current, recent, stale, unknown)."@en .

uko:verificationStatus
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "verification status"@en ;
    rdfs:comment "Data verification status (verified, unverified, disputed)."@en .

uko:verificationDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:date ;
    rdfs:label "verification date"@en ;
    rdfs:comment "Date of last verification."@en .

uko:verificationMethod
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "verification method"@en ;
    rdfs:comment "Method used for verification (imagery, ground_truth, probe_data, user_report)."@en .


# =============================================================================
# SECTION 6: NAVIGATION CONTEXT (MapGPT-inspired)
# =============================================================================

# -----------------------------------------------------------------------------
# Landmark and Context Classes
# -----------------------------------------------------------------------------

uko:NavigationLandmark
    rdf:type owl:Class ;
    rdfs:subClassOf uko:PointOfInterest ;
    rdfs:label "Navigation Landmark"@en ;
    rdfs:comment "Visually distinctive feature useful for navigation reference."@en .

uko:DecisionPoint
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpatialEntity ;
    rdfs:label "Decision Point"@en ;
    rdfs:comment "Location requiring navigation decision (turn, exit, lane change)."@en .

uko:NavigationContext
    rdf:type owl:Class ;
    rdfs:label "Navigation Context"@en ;
    rdfs:comment "Contextual information for natural language navigation."@en .

# -----------------------------------------------------------------------------
# Navigation Properties
# -----------------------------------------------------------------------------

uko:landmarkVisibility
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:NavigationLandmark ;
    rdfs:range xsd:string ;
    rdfs:label "landmark visibility"@en ;
    rdfs:comment "Visibility conditions (day_only, night_illuminated, all_conditions)."@en .

uko:landmarkDescription
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:NavigationLandmark ;
    rdfs:range xsd:string ;
    rdfs:label "landmark description"@en ;
    rdfs:comment "Natural language description for voice navigation."@en .

uko:decisionType
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range xsd:string ;
    rdfs:label "decision type"@en ;
    rdfs:comment "Type of navigation decision (turn, exit, merge, lane_change, roundabout)."@en .

uko:decisionComplexity
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range xsd:string ;
    rdfs:label "decision complexity"@en ;
    rdfs:comment "Complexity of the decision point (simple, moderate, complex)."@en .

uko:nearbyLandmark
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range uko:NavigationLandmark ;
    rdfs:label "nearby landmark"@en ;
    rdfs:comment "Landmark near this decision point useful for orientation."@en .

uko:voicePrompt
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range xsd:string ;
    rdfs:label "voice prompt"@en ;
    rdfs:comment "Suggested voice navigation prompt for this decision point."@en .


# =============================================================================
# SECTION 7: AUTONOMOUS DRIVING LEVELS
# =============================================================================

uko:autonomyLevel
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "autonomy level"@en ;
    rdfs:comment "Maximum supported SAE autonomy level (L1, L2, L2+, L3, L4, L5)."@en .

uko:autonomyRestriction
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "autonomy restriction"@en ;
    rdfs:comment "Restrictions on autonomous operation (weather, time_of_day, construction)."@en .

uko:geoFenced
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "geo-fenced"@en ;
    rdfs:comment "Road is within an autonomous vehicle operational design domain (ODD) geofence."@en .

uko:oddClassification
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "ODD classification"@en ;
    rdfs:comment "Operational Design Domain classification for autonomous vehicles."@en .


#################################################################
#    EXTENSION: CENSUS DEMOGRAPHICS
#################################################################

uko:CensusGeography
    rdf:type owl:Class ;
    rdfs:subClassOf uko:AdministrativeArea ;
    rdfs:label "Census Geography"@en ;
    rdfs:comment "A geographic area defined by the US Census Bureau for statistical data collection and tabulation."@en .

# -----------------------------------------------------------------------------
# Census Tract (enhanced from minimal v7 definition)
# -----------------------------------------------------------------------------

uko:CensusTract
    rdf:type owl:Class ;
    rdfs:subClassOf uko:CensusGeography ;
    rdfs:label "Census Tract"@en ;
    rdfs:comment "A small, relatively permanent statistical subdivision of a county designed to be relatively homogeneous with respect to population characteristics, economic status, and living conditions. Census tracts generally contain between 1,200 and 8,000 people, with an optimum size of 4,000 people."@en .

# -----------------------------------------------------------------------------
# Census Block Group
# -----------------------------------------------------------------------------

uko:CensusBlockGroup
    rdf:type owl:Class ;
    rdfs:subClassOf uko:CensusGeography ;
    rdfs:label "Census Block Group"@en ;
    rdfs:comment "A cluster of census blocks within a census tract. Block groups generally contain between 600 and 3,000 people. Block groups are the smallest geographic unit for which the Census Bureau tabulates sample data."@en .

# -----------------------------------------------------------------------------
# Census Block
# -----------------------------------------------------------------------------

uko:CensusBlock
    rdf:type owl:Class ;
    rdfs:subClassOf uko:CensusGeography ;
    rdfs:label "Census Block"@en ;
    rdfs:comment "The smallest geographic unit used by the Census Bureau for tabulation of 100-percent data (data collected from all households). Census blocks are bounded by visible features such as streets, roads, streams, and railroad tracks, and by nonvisible boundaries such as city, town, township, and county limits."@en .

# -----------------------------------------------------------------------------
# Census County Subdivision
# -----------------------------------------------------------------------------

uko:CensusCountySubdivision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:CensusGeography ;
    rdfs:label "Census County Subdivision"@en ;
    rdfs:comment "Primary division of a county, which may be a Minor Civil Division (MCD) or Census County Division (CCD) depending on the state."@en .

# =============================================================================
# SECTION 2: CENSUS IDENTIFIERS
# =============================================================================

uko:geoid
    rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:string ;
    rdfs:label "GEOID"@en ;
    rdfs:comment "Geographic identifier assigned by the Census Bureau. For census tracts, this is a concatenation of state FIPS code (2 digits), county FIPS code (3 digits), and tract code (6 digits). Example: '06013302100' for tract 3021 in Contra Costa County, California."@en .

uko:tractCode
    rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:string ;
    rdfs:label "tract code"@en ;
    rdfs:comment "Census tract number, a 6-digit code with an implied decimal between the 4th and 5th digits. Example: '302100' represents tract 3021.00."@en .

uko:blockGroupCode
    rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain uko:CensusBlockGroup ;
    rdfs:range xsd:string ;
    rdfs:label "block group code"@en ;
    rdfs:comment "Single digit (1-9) identifying the block group within a census tract."@en .

uko:blockCode
    rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain uko:CensusBlock ;
    rdfs:range xsd:string ;
    rdfs:label "block code"@en ;
    rdfs:comment "4-digit code identifying the census block within a block group."@en .

uko:statefp
    rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:string ;
    rdfs:label "state FIPS code"@en ;
    rdfs:comment "2-digit Federal Information Processing Standards (FIPS) code for the state. Example: '06' for California."@en .

uko:countyfp
    rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:string ;
    rdfs:label "county FIPS code"@en ;
    rdfs:comment "3-digit FIPS code for the county within the state. Example: '013' for Contra Costa County."@en .

# =============================================================================
# SECTION 3: DEMOGRAPHIC PROPERTIES (from American Community Survey)
# =============================================================================

# -----------------------------------------------------------------------------
# Population
# -----------------------------------------------------------------------------

uko:totalPopulation
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "total population"@en ;
    rdfs:comment "Total population count from the Census or American Community Survey (ACS table B01003_001E)."@en .

uko:population65AndOver
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "population 65 and over"@en ;
    rdfs:comment "Population aged 65 years and older. Relevant for vulnerable population analysis and senior services planning."@en .

uko:populationUnder18
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "population under 18"@en ;
    rdfs:comment "Population under 18 years of age. Relevant for school planning and child safety analysis."@en .

uko:populationWithDisability
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "population with disability"@en ;
    rdfs:comment "Population with one or more disabilities. Relevant for accessibility planning."@en .

# -----------------------------------------------------------------------------
# Age
# -----------------------------------------------------------------------------

uko:medianAge
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:decimal ;
    rdfs:label "median age"@en ;
    rdfs:comment "Median age of the population in years (ACS table B01002_001E)."@en .

# -----------------------------------------------------------------------------
# Income and Poverty
# -----------------------------------------------------------------------------

uko:medianHouseholdIncome
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "median household income"@en ;
    rdfs:comment "Median household income in the past 12 months in dollars (ACS table B19013_001E)."@en .

uko:perCapitaIncome
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "per capita income"@en ;
    rdfs:comment "Per capita income in the past 12 months in dollars."@en .

uko:povertyRate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:decimal ;
    rdfs:label "poverty rate"@en ;
    rdfs:comment "Percentage of population with income below the poverty level in the past 12 months."@en .

# -----------------------------------------------------------------------------
# Housing
# -----------------------------------------------------------------------------

uko:housingUnits
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "housing units"@en ;
    rdfs:comment "Total number of housing units (ACS table B25001_001E)."@en .

uko:occupiedHousingUnits
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "occupied housing units"@en ;
    rdfs:comment "Number of occupied housing units."@en .

uko:vacancyRate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:decimal ;
    rdfs:label "vacancy rate"@en ;
    rdfs:comment "Percentage of housing units that are vacant."@en .

uko:medianHomeValue
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "median home value"@en ;
    rdfs:comment "Median value of owner-occupied housing units in dollars."@en .

uko:medianRent
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "median rent"@en ;
    rdfs:comment "Median gross rent in dollars."@en .

# -----------------------------------------------------------------------------
# Transportation and Commuting
# -----------------------------------------------------------------------------

uko:workersCommuting
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "workers commuting"@en ;
    rdfs:comment "Number of workers 16 years and over who commute to work."@en .

uko:meanCommuteTIme
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:decimal ;
    rdfs:label "mean commute time"@en ;
    rdfs:comment "Mean travel time to work in minutes for workers 16 years and over."@en .

uko:vehiclesAvailable
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "vehicles available"@en ;
    rdfs:comment "Total vehicles available to occupied housing units. Relevant for mobility analysis."@en .

uko:householdsWithNoVehicle
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:integer ;
    rdfs:label "households with no vehicle"@en ;
    rdfs:comment "Number of occupied housing units with no vehicle available. Indicates transit dependency."@en .

uko:droveAlonePercent
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:decimal ;
    rdfs:label "drove alone percent"@en ;
    rdfs:comment "Percentage of workers who drove alone to work."@en .

uko:carpooledPercent
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:decimal ;
    rdfs:label "carpooled percent"@en ;
    rdfs:comment "Percentage of workers who carpooled to work."@en .

uko:publicTransitPercent
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:decimal ;
    rdfs:label "public transit percent"@en ;
    rdfs:comment "Percentage of workers who used public transportation to work."@en .

uko:walkedPercent
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:decimal ;
    rdfs:label "walked percent"@en ;
    rdfs:comment "Percentage of workers who walked to work."@en .

uko:workedFromHomePercent
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:decimal ;
    rdfs:label "worked from home percent"@en ;
    rdfs:comment "Percentage of workers who worked from home."@en .

# =============================================================================
# SECTION 4: CENSUS RELATIONSHIPS
# =============================================================================

uko:inCensusTract
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:CensusTract ;
    rdfs:label "in census tract"@en ;
    rdfs:comment "Indicates this entity is geographically located within the specified census tract."@en .

uko:inBlockGroup
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:CensusBlockGroup ;
    rdfs:label "in block group"@en ;
    rdfs:comment "Indicates this entity is located within the specified census block group."@en .

uko:tractInCity
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range uko:City ;
    rdfs:label "tract in city"@en ;
    rdfs:comment "Indicates this census tract is primarily within the boundaries of the specified city. Note: Tract boundaries may not align perfectly with city boundaries."@en .

uko:tractInCounty
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range uko:County ;
    rdfs:label "tract in county"@en ;
    rdfs:comment "Indicates this census tract is within the specified county."@en .

uko:hasBlockGroup
    rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:blockGroupInTract ;
    rdfs:domain uko:CensusTract ;
    rdfs:range uko:CensusBlockGroup ;
    rdfs:label "has block group"@en ;
    rdfs:comment "Indicates this census tract contains the specified block group."@en .

uko:blockGroupInTract
    rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain uko:CensusBlockGroup ;
    rdfs:range uko:CensusTract ;
    rdfs:label "block group in tract"@en ;
    rdfs:comment "Indicates this block group is within the specified census tract."@en .

uko:adjacentTract
    rdf:type owl:ObjectProperty ;
    rdf:type owl:SymmetricProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range uko:CensusTract ;
    rdfs:label "adjacent tract"@en ;
    rdfs:comment "Indicates two census tracts share a boundary."@en .

# =============================================================================
# SECTION 5: DATA PROVENANCE
# =============================================================================

uko:censusYear
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:gYear ;
    rdfs:label "census year"@en ;
    rdfs:comment "Year of the decennial census from which geographic boundaries are derived (e.g., 2020 for 2020 Census boundaries)."@en .

uko:acsYear
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:string ;
    rdfs:label "ACS year"@en ;
    rdfs:comment "Year range of American Community Survey estimates (e.g., '2018-2022' for 5-year estimates). ACS data is based on samples and represents estimates rather than complete counts."@en .

uko:censusDataRetrievalDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusGeography ;
    rdfs:range xsd:date ;
    rdfs:label "census data retrieval date"@en ;
    rdfs:comment "Date when census data was retrieved from the Census Bureau API."@en .

# =============================================================================
# END OF CENSUS EXTENSION
# =============================================================================


#################################################################
#    EXTENSION: TRAFFIC COLLISIONS
#################################################################

uko:Collision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:SpatialEntity ;
    rdfs:label "Collision"@en ;
    rdfs:comment "A traffic collision event involving one or more vehicles, pedestrians, or cyclists. Each collision has a specific location, date/time, and involves parties who may sustain injuries."@en .

# -----------------------------------------------------------------------------
# Collision Types by Primary Mode Involved
# -----------------------------------------------------------------------------

uko:PedestrianCollision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:Collision ;
    rdfs:label "Pedestrian Collision"@en ;
    rdfs:comment "A collision involving at least one pedestrian. These are prioritized in Vision Zero safety analysis."@en .

uko:BicycleCollision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:Collision ;
    rdfs:label "Bicycle Collision"@en ;
    rdfs:comment "A collision involving at least one bicyclist."@en .

uko:MotorcycleCollision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:Collision ;
    rdfs:label "Motorcycle Collision"@en ;
    rdfs:comment "A collision involving at least one motorcyclist."@en .

uko:VehicleOnlyCollision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:Collision ;
    rdfs:label "Vehicle-Only Collision"@en ;
    rdfs:comment "A collision involving only motor vehicles (no pedestrians, bicyclists, or motorcyclists)."@en .

uko:SingleVehicleCollision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:Collision ;
    rdfs:label "Single Vehicle Collision"@en ;
    rdfs:comment "A collision involving only one vehicle (e.g., ran off road, hit fixed object)."@en .

# -----------------------------------------------------------------------------
# Collision Types by Severity
# -----------------------------------------------------------------------------

uko:FatalCollision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:Collision ;
    rdfs:label "Fatal Collision"@en ;
    rdfs:comment "A collision resulting in at least one fatality."@en .

uko:SevereInjuryCollision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:Collision ;
    rdfs:label "Severe Injury Collision"@en ;
    rdfs:comment "A collision resulting in at least one severe (incapacitating) injury but no fatalities."@en .

uko:InjuryCollision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:Collision ;
    rdfs:label "Injury Collision"@en ;
    rdfs:comment "A collision resulting in injuries (visible or complaint of pain)."@en .

uko:PropertyDamageOnlyCollision
    rdf:type owl:Class ;
    rdfs:subClassOf uko:Collision ;
    rdfs:label "Property Damage Only Collision"@en ;
    rdfs:comment "A collision with no injuries, only property damage."@en .

# =============================================================================
# SECTION 2: COLLISION PROPERTIES
# =============================================================================

# -----------------------------------------------------------------------------
# Location Properties
# -----------------------------------------------------------------------------

uko:onRoad
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:string ;
    rdfs:label "on road"@en ;
    rdfs:comment "The primary road on which the collision occurred."@en .

uko:atIntersectionWith
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:string ;
    rdfs:label "at intersection with"@en ;
    rdfs:comment "The secondary/cross road at an intersection collision."@en .

uko:collisionRoadSegment
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range uko:Road ;
    rdfs:label "collision road segment"@en ;
    rdfs:comment "Link to the road segment entity where the collision occurred."@en .

uko:collisionIntersection
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range uko:Intersection ;
    rdfs:label "collision intersection"@en ;
    rdfs:comment "Link to the intersection entity where the collision occurred."@en .

# -----------------------------------------------------------------------------
# Temporal Properties
# -----------------------------------------------------------------------------

uko:collisionDate
    rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:date ;
    rdfs:label "collision date"@en ;
    rdfs:comment "The date when the collision occurred."@en .

uko:collisionTime
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:time ;
    rdfs:label "collision time"@en ;
    rdfs:comment "The time of day when the collision occurred."@en .

uko:collisionDayOfWeek
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:string ;
    rdfs:label "collision day of week"@en ;
    rdfs:comment "Day of week (Monday-Sunday) when the collision occurred."@en .

# -----------------------------------------------------------------------------
# Severity Properties
# -----------------------------------------------------------------------------

uko:collisionSeverity
    rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:string ;
    rdfs:label "collision severity"@en ;
    rdfs:comment "Severity classification: 'fatal', 'severe_injury', 'other_visible_injury', 'complaint_of_pain', 'property_damage_only'."@en .

uko:fatalitiesCount
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:integer ;
    rdfs:label "fatalities count"@en ;
    rdfs:comment "Number of fatalities in the collision."@en .

uko:injuriesCount
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:integer ;
    rdfs:label "injuries count"@en ;
    rdfs:comment "Total number of injuries (all severity levels) in the collision."@en .

uko:severeInjuriesCount
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:integer ;
    rdfs:label "severe injuries count"@en ;
    rdfs:comment "Number of severe/incapacitating injuries in the collision."@en .

# -----------------------------------------------------------------------------
# Contributing Factors
# -----------------------------------------------------------------------------

uko:alcoholInvolved
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:boolean ;
    rdfs:label "alcohol involved"@en ;
    rdfs:comment "Whether alcohol was a factor in the collision."@en .

uko:drugInvolved
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:boolean ;
    rdfs:label "drug involved"@en ;
    rdfs:comment "Whether drugs were a factor in the collision."@en .

uko:speedingInvolved
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:boolean ;
    rdfs:label "speeding involved"@en ;
    rdfs:comment "Whether speeding was a factor in the collision."@en .

uko:distractedDriving
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:boolean ;
    rdfs:label "distracted driving"@en ;
    rdfs:comment "Whether distracted driving was a factor in the collision."@en .

uko:hitAndRun
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:boolean ;
    rdfs:label "hit and run"@en ;
    rdfs:comment "Whether the collision was a hit-and-run incident."@en .

uko:primaryCollisionFactor
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:string ;
    rdfs:label "primary collision factor"@en ;
    rdfs:comment "The primary factor that caused or contributed to the collision (SWITRS PCF code)."@en .

# -----------------------------------------------------------------------------
# Environmental Conditions
# -----------------------------------------------------------------------------

uko:lightingCondition
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:string ;
    rdfs:label "lighting condition"@en ;
    rdfs:comment "Lighting at time of collision: 'daylight', 'dusk_dawn', 'dark_street_lights', 'dark_no_street_lights'."@en .

uko:weatherCondition
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:string ;
    rdfs:label "weather condition"@en ;
    rdfs:comment "Weather at time of collision: 'clear', 'cloudy', 'raining', 'fog', 'other'."@en .

uko:roadCondition
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range xsd:string ;
    rdfs:label "road condition"@en ;
    rdfs:comment "Road surface condition: 'dry', 'wet', 'snowy_icy', 'other'."@en .

# =============================================================================
# SECTION 3: SAFETY SUMMARY CLASS
# =============================================================================

uko:SafetySummary
    rdf:type owl:Class ;
    rdfs:label "Safety Summary"@en ;
    rdfs:comment "Aggregate safety statistics for a geographic area or time period."@en .

uko:totalCollisions
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetySummary ;
    rdfs:range xsd:integer ;
    rdfs:label "total collisions"@en ;
    rdfs:comment "Total number of collisions in the summary period/area."@en .

uko:pedestrianCollisions
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetySummary ;
    rdfs:range xsd:integer ;
    rdfs:label "pedestrian collisions"@en ;
    rdfs:comment "Number of pedestrian-involved collisions."@en .

uko:bicycleCollisions
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetySummary ;
    rdfs:range xsd:integer ;
    rdfs:label "bicycle collisions"@en ;
    rdfs:comment "Number of bicycle-involved collisions."@en .

uko:hinSegmentCount
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetySummary ;
    rdfs:range xsd:integer ;
    rdfs:label "HIN segment count"@en ;
    rdfs:comment "Number of High Injury Network segments identified."@en .

uko:generatedAt
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetySummary ;
    rdfs:range xsd:dateTime ;
    rdfs:label "generated at"@en ;
    rdfs:comment "Timestamp when the safety summary was generated."@en .

# =============================================================================
# SECTION 4: RELATIONSHIPS
# =============================================================================

uko:hasCollision
    rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:collisionOnRoad ;
    rdfs:domain uko:Road ;
    rdfs:range uko:Collision ;
    rdfs:label "has collision"@en ;
    rdfs:comment "Links a road segment to collisions that occurred on it."@en .

uko:collisionNearFacility
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "collision near facility"@en ;
    rdfs:comment "Links a collision to nearby facilities (schools, senior centers, etc.)."@en .

uko:collisionInHIN
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "collision in HIN"@en ;
    rdfs:comment "Links a collision to the HIN segment it contributes to."@en .

uko:inCity
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range uko:City ;
    rdfs:label "in city"@en ;
    rdfs:comment "The city where the collision occurred."@en .

# =============================================================================
# END OF COLLISION EXTENSION
# =============================================================================


#################################################################
#    EXTENSION: CROSS-DOMAIN RELATIONSHIPS
#################################################################

uko:nearHighInjuryNetwork
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "near high injury network"@en ;
    rdfs:comment "POI is located near (within 200m) a High Injury Network segment. Critical for school safety analysis."@en .

uko:onHighInjuryNetwork
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "on high injury network"@en ;
    rdfs:comment "POI is directly on a High Injury Network segment (e.g., business fronting dangerous road)."@en .

uko:hasNearbyCollision
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:Collision ;
    rdfs:label "has nearby collision"@en ;
    rdfs:comment "A collision occurred within 100m of this POI."@en .

uko:schoolNearHIN
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:nearHighInjuryNetwork ;
    rdfs:domain uko:School ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "school near HIN"@en ;
    rdfs:comment "School located near a high injury network - priority for Safe Routes to School."@en .

uko:seniorFacilityNearHIN
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:nearHighInjuryNetwork ;
    rdfs:domain uko:VulnerablePopulationFacility ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "senior facility near HIN"@en ;
    rdfs:comment "Senior/vulnerable population facility near high injury network."@en .

uko:transitStopInHIN
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "transit stop in HIN"@en ;
    rdfs:comment "Transit stop located within a High Injury Network segment - pedestrian safety concern."@en .

# =============================================================================
# SECTION 2: POI ↔ CENSUS RELATIONSHIPS  
# =============================================================================
# These connect POIs to demographic context

uko:inCensusTract
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:CensusTract ;
    rdfs:label "in census tract"@en ;
    rdfs:comment "POI is located within this census tract."@en .

uko:servesPopulation
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:CensusTract ;
    rdfs:label "serves population"@en ;
    rdfs:comment "POI serves the population of this census tract (broader than physical location)."@en .

uko:transitStopServesLowIncome
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range uko:CensusTract ;
    rdfs:label "transit stop serves low income"@en ;
    rdfs:comment "Transit stop serves a census tract with below-median household income."@en .

uko:transitStopServesCarFree
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range uko:CensusTract ;
    rdfs:label "transit stop serves car-free households"@en ;
    rdfs:comment "Transit stop serves a census tract with high percentage of zero-vehicle households."@en .

uko:facilityInUnderservedArea
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:CensusTract ;
    rdfs:label "facility in underserved area"@en ;
    rdfs:comment "Essential facility (healthcare, grocery) in a census tract identified as underserved."@en .

# =============================================================================
# SECTION 3: INFRASTRUCTURE ↔ SAFETY RELATIONSHIPS
# =============================================================================
# These connect roads/sidewalks to safety data

uko:roadInHIN
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "road in HIN"@en ;
    rdfs:comment "This road segment is part of the High Injury Network."@en .

uko:roadHasCollision
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:Collision ;
    rdfs:label "road has collision"@en ;
    rdfs:comment "A collision occurred on this road segment."@en .

uko:intersectionHasCollision
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Intersection ;
    rdfs:range uko:Collision ;
    rdfs:label "intersection has collision"@en ;
    rdfs:comment "A collision occurred at this intersection."@en .

uko:sidewalkAlongHIN
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Sidewalk ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "sidewalk along HIN"@en ;
    rdfs:comment "Sidewalk runs along a High Injury Network segment."@en .

uko:crossingOnHIN
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Crossing ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "crossing on HIN"@en ;
    rdfs:comment "Pedestrian crossing is on a High Injury Network segment - high priority for improvements."@en .

uko:roadLacksSidewalk
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "road lacks sidewalk"@en ;
    rdfs:comment "Road segment has no adjacent sidewalk (pedestrian safety gap)."@en .

uko:hinLacksSidewalk
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:boolean ;
    rdfs:label "HIN lacks sidewalk"@en ;
    rdfs:comment "High Injury Network segment has inadequate sidewalk coverage - critical safety gap."@en .

# =============================================================================
# SECTION 4: INFRASTRUCTURE ↔ CENSUS RELATIONSHIPS
# =============================================================================
# These connect infrastructure to demographics

uko:roadInTract
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:CensusTract ;
    rdfs:label "road in tract"@en ;
    rdfs:comment "Road segment is located within this census tract."@en .

uko:sidewalkInTract
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Sidewalk ;
    rdfs:range uko:CensusTract ;
    rdfs:label "sidewalk in tract"@en ;
    rdfs:comment "Sidewalk is located within this census tract."@en .

uko:tractHasSidewalkGap
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range uko:Road ;
    rdfs:label "tract has sidewalk gap"@en ;
    rdfs:comment "Census tract contains roads without adequate sidewalk coverage."@en .

uko:tractSidewalkCoverage
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:decimal ;
    rdfs:label "tract sidewalk coverage"@en ;
    rdfs:comment "Percentage of roads in tract with sidewalk coverage (0.0-1.0)."@en .

# =============================================================================
# SECTION 5: AREA/NEIGHBORHOOD ↔ OTHER DOMAIN RELATIONSHIPS
# =============================================================================
# These connect neighborhoods/districts to other data

uko:neighborhoodContainsPOI
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "neighborhood contains POI"@en ;
    rdfs:comment "Neighborhood contains this point of interest."@en .

uko:neighborhoodOverlapsTract
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:CensusTract ;
    rdfs:label "neighborhood overlaps tract"@en ;
    rdfs:comment "Neighborhood boundary overlaps with this census tract."@en .

uko:neighborhoodHasHIN
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "neighborhood has HIN"@en ;
    rdfs:comment "Neighborhood contains High Injury Network segments."@en .

uko:districtContainsPOI
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "district contains POI"@en ;
    rdfs:comment "Functional district contains this POI."@en .

uko:poiInNeighborhood
    rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:neighborhoodContainsPOI ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:Neighborhood ;
    rdfs:label "POI in neighborhood"@en ;
    rdfs:comment "POI is located within this neighborhood."@en .

uko:poiInDistrict
    rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:districtContainsPOI ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:FunctionalDistrict ;
    rdfs:label "POI in district"@en ;
    rdfs:comment "POI is located within this functional district."@en .

# =============================================================================
# SECTION 6: SAFETY ↔ CENSUS RELATIONSHIPS
# =============================================================================
# These connect safety data to demographics

uko:collisionInTract
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Collision ;
    rdfs:range uko:CensusTract ;
    rdfs:label "collision in tract"@en ;
    rdfs:comment "Collision occurred within this census tract."@en .

uko:hinInTract
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range uko:CensusTract ;
    rdfs:label "HIN in tract"@en ;
    rdfs:comment "High Injury Network segment is in this census tract."@en .

uko:tractCollisionRate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:decimal ;
    rdfs:label "tract collision rate"@en ;
    rdfs:comment "Collisions per 1000 population in this tract."@en .

uko:tractPedestrianCollisionRate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:decimal ;
    rdfs:label "tract pedestrian collision rate"@en ;
    rdfs:comment "Pedestrian collisions per 1000 population in this tract."@en .

uko:tractHasHIN
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:boolean ;
    rdfs:label "tract has HIN"@en ;
    rdfs:comment "Census tract contains at least one High Injury Network segment."@en .

# =============================================================================
# SECTION 7: TRANSIT ↔ MULTI-DOMAIN RELATIONSHIPS
# =============================================================================
# Transit is a key connector across domains

uko:transitStopNearSchool
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range uko:School ;
    rdfs:label "transit stop near school"@en ;
    rdfs:comment "Transit stop is within walking distance (400m) of a school."@en .

uko:transitStopNearHealthcare
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range uko:HealthcareFacility ;
    rdfs:label "transit stop near healthcare"@en ;
    rdfs:comment "Transit stop is within walking distance of a healthcare facility."@en .

uko:transitStopNearSeniorFacility
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range uko:VulnerablePopulationFacility ;
    rdfs:label "transit stop near senior facility"@en ;
    rdfs:comment "Transit stop is within walking distance of a senior/vulnerable population facility."@en .

uko:transitRouteServesHIN
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "transit route serves HIN"@en ;
    rdfs:comment "Transit route has stops along High Injury Network segments."@en .

uko:transitAccessibleFromPOI
    rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:transitStopNearSchool ;  # Generalized inverse
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:TransitStop ;
    rdfs:label "transit accessible from POI"@en ;
    rdfs:comment "POI has transit access within walking distance."@en .

# =============================================================================
# SECTION 8: SIMILARITY & COMPARISON RELATIONSHIPS
# =============================================================================
# For embedding-based similarity reasoning

uko:similarInfrastructureTo
    rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "similar infrastructure to"@en ;
    rdfs:comment "POIs have similar surrounding infrastructure (sidewalks, crossings, transit)."@en .

uko:similarSafetyProfileTo
    rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:Road ;
    rdfs:label "similar safety profile to"@en ;
    rdfs:comment "Roads have similar safety characteristics (crash rates, HIN status, infrastructure)."@en .

uko:similarDemographicProfileTo
    rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range uko:CensusTract ;
    rdfs:label "similar demographic profile to"@en ;
    rdfs:comment "Census tracts have similar demographic characteristics."@en .

uko:comparableTo
    rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:label "comparable to"@en ;
    rdfs:comment "Entities are comparable for analysis (same type, similar context)."@en .

# =============================================================================
# SECTION 9: ACCESSIBILITY & WALKABILITY RELATIONSHIPS
# =============================================================================
# For pedestrian/accessibility analysis

uko:walkableFrom
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "walkable from"@en ;
    rdfs:comment "POI is walkable (safe pedestrian route exists) from another POI."@en .

uko:hasSafeRouteFrom
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "has safe route from"@en ;
    rdfs:comment "A safe pedestrian route exists between POIs (avoids HIN without crossings)."@en .

uko:requiresHINCrossing
    rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "requires HIN crossing"@en ;
    rdfs:comment "Accessing this POI requires crossing a High Injury Network segment."@en .

uko:accessibleBySidewalk
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range xsd:boolean ;
    rdfs:label "accessible by sidewalk"@en ;
    rdfs:comment "POI can be reached via continuous sidewalk network."@en .

uko:pedestrianLevelOfService
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "pedestrian level of service"@en ;
    rdfs:comment "Pedestrian infrastructure quality rating: A (excellent) to F (poor/none)."@en .

# =============================================================================
# SECTION 10: EQUITY & PRIORITY RELATIONSHIPS
# =============================================================================
# For equity-focused planning analysis

uko:equityPriorityArea
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:boolean ;
    rdfs:label "equity priority area"@en ;
    rdfs:comment "Census tract is identified as equity priority based on demographics + infrastructure gaps."@en .

uko:safetyPriorityScore
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:decimal ;
    rdfs:label "safety priority score"@en ;
    rdfs:comment "Composite score combining crash history, vulnerable users, infrastructure gaps (0-100)."@en .

uko:infrastructureNeedScore
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:decimal ;
    rdfs:label "infrastructure need score"@en ;
    rdfs:comment "Score indicating infrastructure investment need based on gaps and demographics (0-100)."@en .

uko:underservedByTransit
    rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:boolean ;
    rdfs:label "underserved by transit"@en ;
    rdfs:comment "Tract has high transit need (low car ownership) but poor transit access."@en .

# =============================================================================
# END OF CROSS-DOMAIN RELATIONSHIPS EXTENSION
# =============================================================================
