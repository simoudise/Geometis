    rdfs:comment "Connection between routes"@en ;
    rdfs:label "Transfer"@en .

### Real-Time Classes ###
uko:VehiclePosition rdf:type owl:Class ;
    rdfs:comment "Real-time vehicle position"@en ;
    rdfs:label "Vehicle Position"@en .

uko:TripUpdate rdf:type owl:Class ;
    rdfs:comment "Real-time trip update"@en ;
    rdfs:label "Trip Update"@en .

uko:ServiceAlert rdf:type owl:Class ;
    rdfs:comment "Service alert"@en ;
    rdfs:label "Service Alert"@en .

