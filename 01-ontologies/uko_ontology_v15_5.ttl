uko:AdministrativeArea rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:comment "An area with administrative boundaries"@en ;
    rdfs:label "Administrative Area"@en .

uko:Country rdf:type owl:Class ;
    rdfs:subClassOf uko:AdministrativeArea ;
    rdfs:comment "A country"@en ;
    rdfs:label "Country"@en .

uko:State rdf:type owl:Class ;
    rdfs:subClassOf uko:AdministrativeArea ;
    rdfs:comment "A state or province"@en ;
    rdfs:label "State"@en .

uko:County rdf:type owl:Class ;
    rdfs:subClassOf uko:AdministrativeArea ;
    rdfs:comment "A county"@en ;
    rdfs:label "County"@en .

uko:City rdf:type owl:Class ;
    rdfs:subClassOf uko:AdministrativeArea ;
    rdfs:comment "A city"@en ;
    rdfs:label "City"@en .

uko:Town rdf:type owl:Class ;
    rdfs:subClassOf uko:AdministrativeArea ;
    rdfs:comment "A town"@en ;
    rdfs:label "Town"@en .

uko:Neighborhood rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:comment "A neighborhood"@en ;
    rdfs:label "Neighborhood"@en .

uko:District rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:comment "A district"@en ;
    rdfs:label "District"@en .

uko:CommercialDistrict rdf:type owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:comment "A commercial district"@en ;
    rdfs:label "Commercial District"@en .

uko:DowntownArea rdf:type owl:Class ;
    rdfs:subClassOf uko:CommercialDistrict ;
    rdfs:comment "A downtown area"@en ;
    rdfs:label "Downtown Area"@en .

uko:IndustrialDistrict rdf:type owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:comment "An industrial district"@en ;
    rdfs:label "Industrial District"@en .

uko:ResidentialDistrict rdf:type owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:comment "A residential district"@en ;
    rdfs:label "Residential District"@en .

uko:HistoricDistrict rdf:type owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:comment "A historic district"@en ;
    rdfs:label "Historic District"@en .

uko:CityBlock rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:comment "A city block"@en ;
    rdfs:label "City Block"@en .

uko:CensusTract rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:comment "A census tract"@en ;
    rdfs:label "Census Tract"@en .

uko:ZipCode rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:comment "A ZIP code area"@en ;
    rdfs:label "ZIP Code"@en .

uko:SchoolDistrict rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:comment "A school district"@en ;
    rdfs:label "School District"@en .

uko:ServiceArea rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:comment "A service area"@en ;
    rdfs:label "Service Area"@en .

uko:WalkShedArea rdf:type owl:Class ;
    rdfs:subClassOf uko:ServiceArea ;
    rdfs:comment "Area within walking distance of transit"@en ;
    rdfs:label "Walk Shed Area"@en .

### WalkShedArea Extension for UNA Framework (v15.4.0) ###
uko:walkshedOrigin rdf:type owl:ObjectProperty ;
    rdfs:domain uko:WalkShedArea ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "The origin point (e.g., transit stop or POI) from which this walkshed is computed."@en .

uko:walkshedDistanceThreshold rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WalkShedArea ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The maximum distance threshold (in meters) for this walkshed."@en .

uko:walkshedDecayMethod rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WalkShedArea ;
    rdfs:range xsd:string ;
    rdfs:comment "The mathematical decay function used (e.g., 'exponential', 'power', 'linear')."@en .

uko:walkshedBeta rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WalkShedArea ;
    rdfs:range xsd:decimal ;
    rdfs:comment "The beta (exponent or coefficient) used in the distance decay function."@en .
### End WalkShedArea Extension ###

uko:TransitOrientedDevelopment rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:comment "Transit-oriented development area"@en ;
    rdfs:label "Transit-Oriented Development"@en .

#################################################################
#    PART 6: SPATIAL RELATIONSHIPS
#################################################################

### Generic Spatial Relationships ###
uko:near rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A is near Feature B"@en ;
    rdfs:label "near"@en .

uko:veryNear rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:near ;
    rdfs:comment "Feature A is very near Feature B (within ~50m)"@en ;
    rdfs:label "very near"@en .

uko:within rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A is within Feature B"@en ;
    rdfs:label "within"@en .

uko:contains rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:within ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A contains Feature B"@en ;
    rdfs:label "contains"@en .

uko:adjacentTo rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A shares a boundary with Feature B"@en ;
    rdfs:label "adjacent to"@en .

uko:touches rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A touches Feature B"@en ;
    rdfs:label "touches"@en .

uko:overlaps rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A overlaps with Feature B"@en ;
    rdfs:label "overlaps"@en .

uko:intersects rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A intersects Feature B"@en ;
    rdfs:label "intersects"@en .

uko:crosses rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:intersects ;
    rdfs:domain uko:LinearFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Linear feature A crosses Feature B"@en ;
    rdfs:label "crosses"@en .

### Directional Relationships ###
uko:northOf rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A is north of Feature B"@en ;
    rdfs:label "north of"@en .

uko:southOf rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:northOf ;
    rdfs:comment "Feature A is south of Feature B"@en ;
    rdfs:label "south of"@en .

uko:eastOf rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A is east of Feature B"@en ;
    rdfs:label "east of"@en .

uko:westOf rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:eastOf ;
    rdfs:comment "Feature A is west of Feature B"@en ;
    rdfs:label "west of"@en .

uko:acrossFrom rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature A is across from Feature B"@en ;
    rdfs:label "across from"@en .

### Category 1 (Buildings) Spatial Relationships ###
uko:sharesBuildingWith rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Building ;
    rdfs:comment "Two businesses share the same building"@en ;
    rdfs:label "shares building with"@en .

uko:sharesWallWith rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:subPropertyOf uko:adjacentTo ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Building ;
    rdfs:comment "Two buildings share a wall"@en ;
    rdfs:label "shares wall with"@en .

uko:insideMall rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:within ;
    rdfs:domain uko:Building ;
    rdfs:range uko:ShoppingMall ;
    rdfs:comment "Business is inside a mall"@en ;
    rdfs:label "inside mall"@en .

uko:onSameBlock rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Building ;
    rdfs:comment "Buildings are on the same block"@en ;
    rdfs:label "on same block"@en .

### Category 2 (Transportation) Spatial Relationships ###
uko:intersectsRoad rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:subPropertyOf uko:intersects ;
    rdfs:domain uko:Road ;
    rdfs:range uko:Road ;
    rdfs:comment "Road A intersects Road B"@en ;
    rdfs:label "intersects road"@en .

uko:parallelTo rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:LinearFeature ;
    rdfs:range uko:LinearFeature ;
    rdfs:comment "Feature A runs parallel to Feature B"@en ;
    rdfs:label "parallel to"@en .

uko:mergesInto rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:Road ;
    rdfs:comment "Road A merges into Road B"@en ;
    rdfs:label "merges into"@en .

uko:branchesFrom rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:mergesInto ;
    rdfs:comment "Road A branches from Road B"@en ;
    rdfs:label "branches from"@en .

uko:continuesAs rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:Road ;
    rdfs:comment "Road A continues as Road B"@en ;
    rdfs:label "continues as"@en .

uko:crossesOver rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:Road ;
    rdfs:comment "Road A crosses over Road B"@en ;
    rdfs:label "crosses over"@en .

uko:crossesUnder rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:crossesOver ;
    rdfs:comment "Road A crosses under Road B"@en ;
    rdfs:label "crosses under"@en .

### Sidewalk-Road Relationships ###
uko:alongsideOf rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Sidewalk ;
    rdfs:range uko:Road ;
    rdfs:comment "Sidewalk runs alongside a road"@en ;
    rdfs:label "alongside of"@en .

uko:onNorthSideOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:alongsideOf ;
    rdfs:comment "Sidewalk is on north side of road"@en ;
    rdfs:label "on north side of"@en .

uko:onSouthSideOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:alongsideOf ;
    rdfs:comment "Sidewalk is on south side of road"@en ;
    rdfs:label "on south side of"@en .

uko:onEastSideOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:alongsideOf ;
    rdfs:comment "Sidewalk is on east side of road"@en ;
    rdfs:label "on east side of"@en .

uko:onWestSideOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:alongsideOf ;
    rdfs:comment "Sidewalk is on west side of road"@en ;
    rdfs:label "on west side of"@en .

uko:segmentBetween rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SidewalkSegment ;
    rdfs:range uko:Road ;
    rdfs:comment "Sidewalk segment between two cross streets"@en ;
    rdfs:label "segment between"@en .

### Category 3 (Common Spaces) Spatial Relationships ###
uko:bordersNaturalArea rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:adjacentTo ;
    rdfs:domain uko:CommonSpace ;
    rdfs:range uko:NaturalArea ;
    rdfs:comment "Common space borders natural area"@en ;
    rdfs:label "borders natural area"@en .

uko:hasTrailConnection rdf:type owl:ObjectProperty ;
    rdfs:domain uko:CommonSpace ;
    rdfs:range uko:Trail ;
    rdfs:comment "Common space has trail connection"@en ;
    rdfs:label "has trail connection"@en .

#################################################################
#    PART 7: FUNCTIONAL RELATIONSHIPS
#################################################################

### Category 1 (Buildings) Functional Relationships ###
uko:complementaryTo rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Building ;
    rdfs:comment "Building A offers complementary services to Building B"@en ;
    rdfs:label "complementary to"@en .

uko:synergisticWith rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:complementaryTo ;
    rdfs:comment "Strong complementary relationship (e.g., hotel near airport)"@en ;
    rdfs:label "synergistic with"@en .

uko:competitiveWith rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Building ;
    rdfs:comment "Building A competes with Building B"@en ;
    rdfs:label "competitive with"@en .

uko:directCompetitor rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:competitiveWith ;
    rdfs:comment "Direct competitor (same business type)"@en ;
    rdfs:label "direct competitor"@en .

uko:dependsOn rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Building depends on another feature"@en ;
    rdfs:label "depends on"@en .

uko:requiresAccessTo rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:dependsOn ;
    rdfs:comment "Building requires access to a feature"@en ;
    rdfs:label "requires access to"@en .

uko:ownedBy rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Organization ;
    rdfs:comment "Building is owned by organization"@en ;
    rdfs:label "owned by"@en .

uko:operatedByOrg rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Organization ;
    rdfs:comment "Building is operated by organization"@en ;
    rdfs:label "operated by organization"@en .

uko:franchiseOf rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Organization ;
    rdfs:comment "Building is a franchise"@en ;
    rdfs:label "franchise of"@en .

uko:partOfChain rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Organization ;
    rdfs:comment "Building is part of a chain"@en ;
    rdfs:label "part of chain"@en .

uko:anchorTenant rdf:type owl:ObjectProperty ;
    rdfs:domain uko:ShoppingCenter ;
    rdfs:range uko:Building ;
    rdfs:comment "Anchor tenant of shopping center"@en ;
    rdfs:label "anchor tenant"@en .

### Category 2 (Transportation) Functional Relationships ###
uko:connectsTo rdf:type owl:ObjectProperty ;
    rdfs:domain uko:RoadInfrastructure ;
    rdfs:range uko:RoadInfrastructure ;
    rdfs:comment "Infrastructure connects to another"@en ;
    rdfs:label "connects to"@en .

uko:providesAccessTo rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Road provides access to feature"@en ;
    rdfs:label "provides access to"@en .

uko:servesAsMainAccess rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:providesAccessTo ;
    rdfs:comment "Road is main access"@en ;
    rdfs:label "serves as main access"@en .

uko:servesAsEmergencyAccess rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:providesAccessTo ;
    rdfs:comment "Road is emergency access"@en ;
    rdfs:label "serves as emergency access"@en .

uko:feedsInto rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:Road ;
    rdfs:comment "Road feeds traffic into another"@en ;
    rdfs:label "feeds into"@en .

uko:distributesTo rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:feedsInto ;
    rdfs:comment "Road distributes traffic"@en ;
    rdfs:label "distributes to"@en .

uko:connectsToTransit rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Road connects to transit"@en ;
    rdfs:label "connects to transit"@en .

uko:hasTransferTo rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Transit stop has transfer"@en ;
    rdfs:label "has transfer to"@en .

### Category 3 (Common Spaces) Functional Relationships ###
uko:providesRecreationFor rdf:type owl:ObjectProperty ;
    rdfs:domain uko:CommonSpace ;
    rdfs:range uko:ConceptualArea ;
    rdfs:comment "Provides recreation for area"@en ;
    rdfs:label "provides recreation for"@en .

uko:servesNeighborhood rdf:type owl:ObjectProperty ;
    rdfs:domain uko:CommonSpace ;
    rdfs:range uko:Neighborhood ;
    rdfs:comment "Serves a neighborhood"@en ;
    rdfs:label "serves neighborhood"@en .

### Between-Category Relationships ###
uko:accessibleBy rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:RoadInfrastructure ;
    rdfs:comment "Building accessible by infrastructure"@en ;
    rdfs:label "accessible by"@en .

uko:hasStreetAddress rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Road ;
    rdfs:comment "Building has address on road"@en ;
    rdfs:label "has street address"@en .

uko:frontageOn rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Road ;
    rdfs:comment "Building has frontage on road"@en ;
    rdfs:label "frontage on"@en .

uko:hasParking rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:ParkingFacility ;
    rdfs:comment "Building has parking"@en ;
    rdfs:label "has parking"@en .

uko:nearTransitStop rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:near ;
    rdfs:domain uko:Building ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Building near transit stop"@en ;
    rdfs:label "near transit stop"@en .

uko:hasTransitAccess rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Building has transit access"@en ;
    rdfs:label "has transit access"@en .

uko:accessibleBySidewalk rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Sidewalk ;
    rdfs:comment "Building accessible by sidewalk"@en ;
    rdfs:label "accessible by sidewalk"@en .

uko:accessibleByBikeLane rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:Cycleway ;
    rdfs:comment "Building accessible by bike lane"@en ;
    rdfs:label "accessible by bike lane"@en .

uko:overlooksCommonSpace rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:CommonSpace ;
    rdfs:comment "Building overlooks common space"@en ;
    rdfs:label "overlooks common space"@en .

uko:adjacentToCommonSpace rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:adjacentTo ;
    rdfs:domain uko:Building ;
    rdfs:range uko:CommonSpace ;
    rdfs:comment "Building adjacent to common space"@en ;
    rdfs:label "adjacent to common space"@en .

uko:hasAccessToCommonSpace rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Building ;
    rdfs:range uko:CommonSpace ;
    rdfs:comment "Building has access to common space"@en ;
    rdfs:label "has access to common space"@en .

uko:bordersCommonSpace rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:CommonSpace ;
    rdfs:comment "Road borders common space"@en ;
    rdfs:label "borders common space"@en .

uko:crossesThroughCommonSpace rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:crosses ;
    rdfs:domain uko:Road ;
    rdfs:range uko:CommonSpace ;
    rdfs:comment "Road crosses through common space"@en ;
    rdfs:label "crosses through common space"@en .

uko:pathThroughCommonSpace rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PedestrianInfrastructure ;
    rdfs:range uko:CommonSpace ;
    rdfs:comment "Path goes through common space"@en ;
    rdfs:label "path through common space"@en .

