#################################################################
#
#    Urban Knowledge Ontology (UKO)
#    Version 15.5.0 - Neurosymbolic Urban Mobility System
#
#    Purpose: Comprehensive geospatial knowledge base integrating:
#    - OSM infrastructure (roads, sidewalks, crossings, buildings)
#    - Points of Interest (schools, healthcare, transit, businesses)
#    - US Census demographics (tracts, income, commute patterns)
#    - Traffic safety (SWITRS collisions, High Injury Network)
#    - Cross-domain relationships for multi-hop reasoning
#    - Transit performance metrics (Alameda CTC + WestCAT TDA)
#    - HIN/PSN scoring methodology (Alameda CTC)
#    - Temporal classification for school safety analysis
#    - Causal reasoning support for neurosymbolic AI
#
#    Synapse Partners, LLC
#
#    Change Log:
#    - v15.5.0: Coordinated release 2026-06-10 (release set: UKO v15.5.0, TKO v8.3.0,
#               FKO v1.2.0, MLO v1.6.0, REO v1.6.0). Major additions:
#               (1) Causal Effect Library effect-attribute complement (Section 9.9 of
#                   Architecture V12): InfrastructureInterventionType taxonomy with six
#                   named individuals, EntitySet linkage classes, and the effect-size /
#                   confidence-interval / provenance datatype properties on
#                   uko:InfrastructureEffect. Subgraph 3 is now fully ontology-generated.
#               (2) Analysis Product classes (HINSegmentSet, HINIntersectionSet,
#                   SegmentRiskProfile, VulnerableExposureProfile, EquityImpactScore)
#                   formalizing the Knowledge Agent Registry output schema references.
#               (3) uko:vulnerableRoadUserConflictFraction convenience property.
#               (4) Equity and air-quality bundle: jobAccessibility (LEHD/LODES),
#                   pm25Concentration (CARB), zeroVehicleHouseholdDensity,
#                   vulnerabilityIndex, htAffordabilityIndex (CNT H+T), plus
#                   withinCensusTract and hasJurisdiction relations.
#               (5) RoadFunctionalClassification named-individual taxonomy
#                   (constraint-vocabulary grounding for uko:PRINCIPAL_ARTERIAL etc.).
#               (6) Active-mobility safety: streetlightCoverage added;
#                   hasStreetLighting and LightingConcern DEPRECATED in its favor.
#               (7) Shared-mobility (GBFS/MDS): SharedMobilitySystem,
#                   SharedMobilityStation, MobilityPolicyZone, vehicle-type taxonomy,
#                   GBFS/MDS identifier and availability properties.
#               (8) GTFS Pathways (StationPathway on the pedestrian multiplex) and
#                   GTFS Fares v2 (FareProduct) extensions.
#               (9) uko:effectiveOnTimePerformance blended transit OTP property.
#               (10) Stage-3 join properties formalized: elevationGradient,
#                    dedicatedLane, speedDistributionByHour (values remain
#                    analytics-pass outputs; see property notes).
#               (11) uko:gersId Overture GERS external-reference property.
#               (12) Fold-in of the v15.4.1 patch: OperationalRoutingConstraint and
#                    WeatherConditionalOperationalConstraint (R1/R2/R3 tier vocabulary),
#                    resolving the dangling chain-control reference from REO.
#               Version-pin policy adopted: owl:imports across the stack pin to the
#               versions shipped in the same coordinated release.
#    - v15.4.0: Added Causal Effect classes for Subgraph 3 and promoted stable physical 
#network properties from contracted analytics to formal UKO schema.
#    - v15.3.0: UNA Integration. Extended uko:WalkShedArea with decay parameters.
#               Introduced Multiplex Graph alignment via uko:AccessPoint and
#               uko:PedestrianNetworkNode. Added uko:PedestrianNetworkEdge superclass.
#    - v15.2.0: Cleaned ontology to remove duplicated module concatenations.
#               Downgraded compoundConditionRiskMap keys to 2D format to align 
#               with TLP Stage 3 logic.
#    - v15.1.0: Adds CargoTheftHotspotZone for OHR R7 (Security/Theft Risk) coverage.
#    - v13.0: Added Route Event Ontology (REO) companion reference; event-segment
#             traversal delegated to reo:affectsSegment.
#    - v12.0: Added Trip Intelligence Pipeline support.
#
#################################################################

@prefix : <urn:urban-kg:> .
@prefix uko: <urn:urban-kg:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:urban-kg:> rdf:type owl:Ontology ;
    owl:versionIRI <urn:urban-kg:15.5.0> ;
    dcterms:title "Urban Knowledge Ontology (UKO) v15.5.0"@en ;
    dcterms:description "Comprehensive neurosymbolic ontology for urban geospatial knowledge graphs. Companion ontologies: TKO v8.4, MLO v1.7, REO v1.6.1, FKO v1.2.1 (coordinated release 2026-09-19). UKO is the foundational ontology and has no imports. Event-to-segment links are defined in REO via reo:affectsSegment to maintain an acyclic ontology import graph."@en ;
    rdfs:comment "Version 15.5.0 delivers the Causal Effect Library effect-attribute complement (making GKG Subgraph 3 fully ontology-generated), the equity/air-quality and shared-mobility (GBFS/MDS) extensions, GTFS Pathways and Fares v2 support, and folds in the v15.4.1 weather-conditional operational constraint patch. Version 15.4.0 integrated Sevtsuk/Basu Urban Network Analysis (UNA) requirements, establishing a Multiplex Graph architecture connecting pedestrian and vehicular layers. Building on v15.2.0 which removed the erroneous import of <urn:synapse:tko:>, removed redundant file concatenations, and downgraded compoundConditionRiskMap keys to a 2D format."@en .

#################################################################
#    PART 1: FOUNDATIONAL CLASSES
#################################################################

uko:GeographicFeature rdf:type owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:comment "Base class for all geographic features in the urban environment"@en ;
    rdfs:label "Geographic Feature"@en .

uko:PointOfInterest rdf:type owl:Class ;
    rdfs:subClassOf uko:GeographicFeature ;
    rdfs:comment "A location or entity of interest in the urban environment"@en ;
    rdfs:label "Point of Interest"@en .

uko:PhysicalStructure rdf:type owl:Class ;
    rdfs:subClassOf uko:GeographicFeature ;
    rdfs:comment "A built or constructed physical entity"@en ;
    rdfs:label "Physical Structure"@en .

uko:ConceptualArea rdf:type owl:Class ;
    rdfs:subClassOf uko:GeographicFeature ;
    rdfs:comment "An area defined by conceptual or administrative boundaries"@en ;
    rdfs:label "Conceptual Area"@en .

uko:LinearFeature rdf:type owl:Class ;
    rdfs:subClassOf uko:GeographicFeature ;
    rdfs:comment "A feature with primarily linear geometry"@en ;
    rdfs:label "Linear Feature"@en .

uko:ArealFeature rdf:type owl:Class ;
    rdfs:subClassOf uko:GeographicFeature ;
    rdfs:comment "A feature with primarily polygonal/areal geometry"@en ;
    rdfs:label "Areal Feature"@en .

uko:Organization rdf:type owl:Class ;
    rdfs:comment "An organization operating in the urban environment"@en ;
    rdfs:label "Organization"@en .

#################################################################
#    PART 2: CATEGORY 1 - BUILDINGS AND POI CLASSES
#################################################################

uko:Building rdf:type owl:Class ;
    rdfs:subClassOf uko:PhysicalStructure, uko:PointOfInterest ;
    rdfs:comment "A roofed structure with walls"@en ;
    rdfs:label "Building"@en .

