#################################################################
#    PART 2b: MULTIPLEX GRAPH ALIGNMENT NODES
#################################################################

uko:PedestrianNetworkNode rdf:type owl:Class ;
    rdfs:subClassOf uko:GeographicFeature ;
    rdfs:label "Pedestrian Network Node"@en ;
    rdfs:comment "A node within the pedestrian mobility graph, distinct from vehicular intersection nodes to reflect urban reality."@en .

uko:AccessPoint rdf:type owl:Class ;
    rdfs:subClassOf uko:GeographicFeature ;
    rdfs:label "Access Point"@en ;
    rdfs:comment "An explicit linkage point (e.g., transit stop, curbside parking zone) connecting the pedestrian network layer to the vehicular road layer in a multiplex graph."@en .

uko:hasAccessPoint rdf:type owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf ( uko:RoadSegment uko:IntersectionNode uko:PedestrianNetworkNode uko:PedestrianNetworkEdge ) ] ;
    rdfs:range uko:AccessPoint ;
    rdfs:label "has access point"@en ;
    rdfs:comment "Links pedestrian or vehicular entities to an inter-layer access point in the multiplex graph."@en .

#################################################################
#    PART 3: CATEGORY 2 - TRANSPORTATION INFRASTRUCTURE
#################################################################

uko:RoadInfrastructure rdf:type owl:Class ;
    rdfs:subClassOf uko:LinearFeature, uko:PhysicalStructure ;
