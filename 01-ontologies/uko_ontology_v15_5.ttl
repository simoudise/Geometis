uko:hasStreetLighting rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    owl:deprecated "true"^^xsd:boolean ;
    dcterms:isReplacedBy uko:streetlightCoverage ;
    rdfs:comment "DEPRECATED at v15.5.0 in favor of the quantitative uko:streetlightCoverage (continuous coverage fraction). Retained for backward compatibility with materialized graphs built against v15.4 and earlier; new ingestion MUST populate streetlightCoverage. A boolean view remains derivable as (streetlightCoverage > 0)."@en .

uko:isTollRoad rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Toll road"@en .

