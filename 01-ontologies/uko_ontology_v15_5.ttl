#################################################################
#    PART 9: DATA PROVENANCE
#################################################################

### Data Source Classes ###
uko:DataSource rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A source of data for the knowledge graph"@en ;
    rdfs:label "Data Source"@en .

uko:OSMDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "OpenStreetMap data source"@en ;
    rdfs:label "OSM Data Source"@en .

uko:LLMDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "Large Language Model derived data"@en ;
    rdfs:label "LLM Data Source"@en .

uko:GTFSDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "GTFS feed data source"@en ;
    rdfs:label "GTFS Data Source"@en .

uko:CensusDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "Census data source"@en ;
    rdfs:label "Census Data Source"@en .

uko:GovernmentDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "Government data source"@en ;
    rdfs:label "Government Data Source"@en .

uko:UserContributedDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "User-contributed data"@en ;
    rdfs:label "User Contributed Data Source"@en .

uko:CommercialDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:comment "Commercial data source"@en ;
    rdfs:label "Commercial Data Source"@en .

### Data Quality Classes ###
uko:DataQualityAssessment rdf:type owl:Class ;
    rdfs:comment "Assessment of data quality"@en ;
    rdfs:label "Data Quality Assessment"@en .

uko:HighConfidence rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "High confidence data"@en .

uko:MediumConfidence rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "Medium confidence data"@en .

uko:LowConfidence rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "Low confidence data"@en .

uko:Verified rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "Verified data"@en .

uko:Inferred rdf:type owl:Class ;
    rdfs:subClassOf uko:DataQualityAssessment ;
    rdfs:comment "Inferred/derived data"@en .

### Provenance Object Properties ###
uko:hasDataSource rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:DataSource ;
    rdfs:comment "Links feature to data source"@en .

uko:hasQualityAssessment rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:DataQualityAssessment ;
    rdfs:comment "Links feature to quality assessment"@en .

uko:derivedFrom rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:GeographicFeature ;
    rdfs:comment "Feature derived from another"@en .

uko:extractedFrom rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:DataSource ;
    rdfs:comment "Feature extracted from source"@en .

uko:inferredBy rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:LLMDataSource ;
    rdfs:comment "Feature inferred by LLM"@en .

### Provenance Data Properties ###
uko:sourceTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Source data timestamp"@en .

uko:lastUpdated rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Last update timestamp"@en .

uko:confidenceScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Confidence score (0-1)"@en .

uko:llmModel rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LLMDataSource ;
    rdfs:range xsd:string ;
    rdfs:comment "LLM model name"@en .

uko:llmPrompt rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LLMDataSource ;
    rdfs:range xsd:string ;
    rdfs:comment "Prompt used to generate data"@en .

uko:osmVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:OSMDataSource ;
    rdfs:range xsd:integer ;
    rdfs:comment "OSM data version"@en .

uko:osmChangeset rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:OSMDataSource ;
    rdfs:range xsd:integer ;
    rdfs:comment "OSM changeset ID"@en .

### GTFS Feed Info ###
uko:GTFSFeedInfo rdf:type owl:Class ;
    rdfs:subClassOf uko:GTFSDataSource ;
    rdfs:comment "GTFS feed metadata"@en ;
    rdfs:label "GTFS Feed Info"@en .

uko:publisherName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:string ;
    rdfs:comment "Feed publisher name"@en .

uko:publisherUrl rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "Publisher URL"@en .

uko:feedLang rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:string ;
    rdfs:comment "Feed language"@en .

uko:feedStartDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:date ;
    rdfs:comment "Feed start date"@en .

uko:feedEndDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:date ;
    rdfs:comment "Feed end date"@en .

uko:feedVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GTFSFeedInfo ;
    rdfs:range xsd:string ;
    rdfs:comment "Feed version"@en .

#################################################################
#    PART 10: GTFS OBJECT PROPERTIES
#################################################################

uko:gtfsOperatedBy rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range uko:TransitAgency ;
    rdfs:comment "Route operated by agency"@en .

uko:operatesRoute rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:gtfsOperatedBy ;
    rdfs:domain uko:TransitAgency ;
    rdfs:range uko:TransitRoute .

uko:belongsToRoute rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitTrip ;
    rdfs:range uko:TransitRoute ;
    rdfs:comment "Trip belongs to route"@en .

uko:hasTrip rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:belongsToRoute ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range uko:TransitTrip .

uko:hasStopTime rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitTrip ;
    rdfs:range uko:StopTime ;
    rdfs:comment "Trip has stop time"@en .

uko:atStop rdf:type owl:ObjectProperty ;
    rdfs:domain uko:StopTime ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Stop time at stop"@en .

uko:servesStop rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Route serves stop"@en .

uko:parentStation rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitStop ;
    rdfs:range uko:TransitStation ;
    rdfs:comment "Parent station"@en .

uko:hasChildStop rdf:type owl:ObjectProperty ;
    owl:inverseOf uko:parentStation ;
    rdfs:domain uko:TransitStation ;
    rdfs:range uko:TransitStop .

uko:hasServiceCalendar rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitTrip ;
    rdfs:range uko:ServiceCalendar ;
    rdfs:comment "Trip has service calendar"@en .

uko:hasServiceException rdf:type owl:ObjectProperty ;
    rdfs:domain uko:ServiceCalendar ;
    rdfs:range uko:ServiceException ;
    rdfs:comment "Calendar has exception"@en .

uko:nearestTransitStop rdf:type owl:ObjectProperty ;
    rdfs:domain uko:PointOfInterest ;
    rdfs:range uko:TransitStop ;
    rdfs:comment "Nearest transit stop"@en .

uko:hasServiceArea rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitRoute ;
    rdfs:range uko:ServiceArea ;
    rdfs:comment "Route service area"@en .

uko:anchorStation rdf:type owl:ObjectProperty ;
    rdfs:domain uko:TransitOrientedDevelopment ;
    rdfs:range uko:TransitStation ;
    rdfs:comment "Anchor transit station for TOD"@en .

###############################################################################
#
#    Urban Knowledge Ontology (UKO) Extension
#    Districts and Neighborhoods Module
#    Version 6.1.0
#
#    Purpose: Define classes and properties for formal and informal
#    geographic areas including neighborhoods and functional districts.
#
###############################################################################

###############################################################################
#    NEIGHBORHOOD CLASSES
###############################################################################

uko:Neighborhood a owl:Class ;
    rdfs:subClassOf uko:GeographicArea ;
    rdfs:label "Neighborhood" ;
    rdfs:comment "A geographic area within a city or town that has a distinct identity, character, or community. May be officially designated or informally recognized." .

uko:OfficialNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Official Neighborhood" ;
    rdfs:comment "A neighborhood with legally designated boundaries recognized by local government, census bureau, or official planning documents." .

uko:InformalNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Informal Neighborhood" ;
    rdfs:comment "A community-recognized neighborhood without official government designation. Boundaries may be approximate or contested." .

uko:HistoricNeighborhood a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Historic Neighborhood" ;
    rdfs:comment "A neighborhood with historical significance, often with protected status or listed on historic registries." .

uko:HistoricDistrict a owl:Class ;
    rdfs:subClassOf uko:HistoricNeighborhood ;
    rdfs:label "Historic District" ;
    rdfs:comment "An officially designated historic area with legal protections for historic preservation." .

uko:GatedCommunity a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Gated Community" ;
    rdfs:comment "A residential neighborhood with controlled access, typically with walls or fences and entry gates." .

uko:PlannedCommunity a owl:Class ;
    rdfs:subClassOf uko:Neighborhood ;
    rdfs:label "Planned Community" ;
    rdfs:comment "A neighborhood designed and built as a unified development with coordinated planning." .

###############################################################################
#    DISTRICT CLASSES - FORMAL
###############################################################################

uko:District a owl:Class ;
    rdfs:subClassOf uko:GeographicArea ;
    rdfs:label "District" ;
    rdfs:comment "A defined area within a city serving a specific administrative, commercial, or functional purpose." .

uko:AdministrativeDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Administrative District" ;
    rdfs:comment "A district defined for governmental or administrative purposes." .

uko:BusinessImprovementDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Business Improvement District" ;
    rdfs:comment "A defined area where businesses pay additional taxes or fees for improvements and services." ;
    owl:equivalentClass uko:BID .

uko:BID a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "BID" ;
    rdfs:comment "Business Improvement District (abbreviation)." .

uko:SpecialPurposeDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Special Purpose District" ;
    rdfs:comment "A district created for a specific governmental function like water, fire, or schools." .

uko:ZoningDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Zoning District" ;
    rdfs:comment "An area with specific land use regulations and restrictions." .

uko:RedevelopmentDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Redevelopment District" ;
    rdfs:comment "An area designated for urban renewal or redevelopment with special incentives or regulations." .

uko:OpportunityZone a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Opportunity Zone" ;
    rdfs:comment "A federally designated economically-distressed community with tax incentives for investment." .

###############################################################################
#    DISTRICT CLASSES - INFORMAL/FUNCTIONAL
###############################################################################

uko:InformalDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Informal District" ;
    rdfs:comment "A district recognized by common usage or community consensus rather than official designation." .

uko:FunctionalDistrict a owl:Class ;
    rdfs:subClassOf uko:InformalDistrict ;
    rdfs:label "Functional District" ;
    rdfs:comment "An area characterized by concentration of similar businesses or activities, often informally named." .

# Commercial/Retail Functional Districts
uko:ShoppingDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Shopping District" ;
    rdfs:comment "An area with a high concentration of retail stores and shopping destinations." .

uko:AutoRow a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Auto Row" ;
    rdfs:comment "A stretch of road or area with multiple car dealerships and automotive businesses." .

uko:RestaurantRow a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Restaurant Row" ;
    rdfs:comment "An area with a high concentration of restaurants and dining establishments." .

uko:FoodDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Food District" ;
    rdfs:comment "An area known for diverse food establishments including restaurants, food halls, and specialty food shops." .

# Professional/Creative Functional Districts
uko:DesignDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Design District" ;
    rdfs:comment "An area with concentration of design-related businesses: architects, interior designers, furniture showrooms." .

uko:ArtDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Art District" ;
    rdfs:comment "An area with concentration of art galleries, artist studios, and creative businesses." .

uko:FashionDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Fashion District" ;
    rdfs:comment "An area with concentration of clothing manufacturers, wholesalers, and fashion-related businesses." .

uko:JewelryDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Jewelry District" ;
    rdfs:comment "An area with concentration of jewelry stores, wholesalers, and gem dealers." .

# Technology/Business Functional Districts
uko:TechCorridor a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Tech Corridor" ;
    rdfs:comment "An area with concentration of technology companies and startups." .

uko:FinancialDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Financial District" ;
    rdfs:comment "An area with concentration of banks, financial services, and corporate headquarters." .

uko:MedicalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Medical District" ;
    rdfs:comment "An area with concentration of hospitals, clinics, and medical offices." .

uko:LegalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Legal District" ;
    rdfs:comment "An area near courthouses with concentration of law offices and legal services." .

# Entertainment/Nightlife Functional Districts
uko:EntertainmentDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Entertainment District" ;
    rdfs:comment "An area with concentration of entertainment venues: theaters, music venues, nightclubs." .

uko:NightlifeDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Nightlife District" ;
    rdfs:comment "An area known for bars, clubs, and late-night entertainment." .

uko:TheaterDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Theater District" ;
    rdfs:comment "An area with concentration of theaters and performing arts venues." .

# Cultural/Ethnic Functional Districts
uko:CulturalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Cultural District" ;
    rdfs:comment "An area with concentration of cultural institutions: museums, galleries, performance spaces." .

uko:EthnicEnclave a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Ethnic Enclave" ;
    rdfs:comment "An area with concentration of businesses and residents from a particular ethnic or cultural background." .

uko:Chinatown a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Chinatown" ;
    rdfs:comment "An urban area with significant Chinese population and Chinese-owned businesses." .

uko:LittleItaly a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Little Italy" ;
    rdfs:comment "An urban area historically associated with Italian immigrants and Italian-American culture." .

uko:Koreatown a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Koreatown" ;
    rdfs:comment "An urban area with significant Korean population and Korean-owned businesses." .

uko:LittleTokyo a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Little Tokyo" ;
    rdfs:comment "An urban area with significant Japanese population and Japanese-owned businesses." .

uko:LatinQuarter a owl:Class ;
    rdfs:subClassOf uko:EthnicEnclave ;
    rdfs:label "Latin Quarter" ;
    rdfs:comment "An urban area with significant Latino/Hispanic population and Latino-owned businesses." .

# Industrial/Warehouse Functional Districts
uko:IndustrialDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Industrial District" ;
    rdfs:comment "An area with concentration of manufacturing, warehouses, and industrial businesses." .

uko:WarehouseDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Warehouse District" ;
    rdfs:comment "An area dominated by warehouses, often converted to lofts, galleries, or creative spaces." .

uko:PortDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Port District" ;
    rdfs:comment "An area around a port with shipping, logistics, and maritime businesses." .

# Civic/Institutional Functional Districts
uko:CivicCenter a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Civic Center" ;
    rdfs:comment "An area with concentration of government buildings and civic institutions." .

uko:UniversityDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "University District" ;
    rdfs:comment "An area surrounding a university with student-oriented businesses and housing." .

uko:HospitalDistrict a owl:Class ;
    rdfs:subClassOf uko:FunctionalDistrict ;
    rdfs:label "Hospital District" ;
    rdfs:comment "An area surrounding a major hospital with medical offices and health services." .

###############################################################################
#    DOWNTOWN AND CENTRAL BUSINESS AREAS
###############################################################################

uko:Downtown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Downtown" ;
    rdfs:comment "The central business district or commercial heart of a city." .

uko:CentralBusinessDistrict a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Central Business District" ;
    rdfs:comment "The main commercial and business center of a city." ;
    owl:equivalentClass uko:CBD .

uko:CBD a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "CBD" ;
    rdfs:comment "Central Business District (abbreviation)." .

uko:Uptown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Uptown" ;
    rdfs:comment "An area of a city typically north of or away from downtown, often more residential or affluent." .

uko:Midtown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Midtown" ;
    rdfs:comment "An area between downtown and uptown, often with mixed commercial and residential use." .

uko:OldTown a owl:Class ;
    rdfs:subClassOf uko:District ;
    rdfs:label "Old Town" ;
    rdfs:comment "The historic core of a city, often with preserved historic buildings." .

###############################################################################
#    PROPERTIES FOR NEIGHBORHOODS AND DISTRICTS
###############################################################################

uko:hasOfficialStatus a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:boolean ;
    rdfs:label "has official status" ;
    rdfs:comment "Indicates whether the neighborhood has official government recognition." .

uko:recognizedBy a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:Organization ;
    rdfs:label "recognized by" ;
    rdfs:comment "The organization that officially recognizes or designates this area." .

uko:designationDate a owl:DatatypeProperty ;
    rdfs:domain uko:District ;
    rdfs:range xsd:date ;
    rdfs:label "designation date" ;
    rdfs:comment "The date when the district was officially designated." .

uko:designationAuthority a owl:DatatypeProperty ;
    rdfs:domain uko:District ;
    rdfs:range xsd:string ;
    rdfs:label "designation authority" ;
    rdfs:comment "The governmental body that designated this district." .

uko:hasBoundarySource a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "has boundary source" ;
    rdfs:comment "Source of boundary data: 'census', 'city_planning', 'community_consensus', 'llm_inferred', 'computed'" .

uko:boundaryConfidence a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:decimal ;
    rdfs:label "boundary confidence" ;
    rdfs:comment "Confidence level (0-1) in the accuracy of the boundary." .

uko:approximateBoundary a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "approximate boundary" ;
    rdfs:comment "Textual description of approximate boundaries for informal areas." .

uko:boundaryDisputed a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:boolean ;
    rdfs:label "boundary disputed" ;
    rdfs:comment "Indicates if the boundaries of this area are contested or unclear." .

uko:dominantFunction a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:string ;
    rdfs:label "dominant function" ;
    rdfs:comment "The primary business or activity type that characterizes this district." .

uko:characterizedBy a owl:ObjectProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "characterized by" ;
    rdfs:comment "POIs that define the character of this functional district." .

uko:poiConcentration a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:integer ;
    rdfs:label "POI concentration" ;
    rdfs:comment "Number of characteristic POIs within this district." .

uko:clusterScore a owl:DatatypeProperty ;
    rdfs:domain uko:FunctionalDistrict ;
    rdfs:range xsd:decimal ;
    rdfs:label "cluster score" ;
    rdfs:comment "Statistical measure of POI clustering that defines this district." .

uko:neighborhoodCharacter a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:string ;
    rdfs:label "neighborhood character" ;
    rdfs:comment "Description of the neighborhood's character: 'residential', 'mixed-use', 'commercial', etc." .

uko:predominantHousingType a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:string ;
    rdfs:label "predominant housing type" ;
    rdfs:comment "The most common type of housing: 'single-family', 'apartment', 'townhouse', etc." .

uko:walkabilityScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "walkability score" ;
    rdfs:comment "Walk Score or similar walkability metric (0-100)." .

uko:transitScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "transit score" ;
    rdfs:comment "Transit Score or similar transit accessibility metric (0-100)." .

uko:bikeScore a owl:DatatypeProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range xsd:integer ;
    rdfs:label "bike score" ;
    rdfs:comment "Bike Score or similar cycling friendliness metric (0-100)." .

uko:informalName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "informal name" ;
    rdfs:comment "Colloquial or informal name used by locals." .

uko:historicName a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "historic name" ;
    rdfs:comment "Historical name no longer in common use." .

uko:inNeighborhood a owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:Neighborhood ;
    rdfs:label "in neighborhood" ;
    rdfs:comment "The neighborhood containing this feature." ;
    owl:inverseOf uko:containsFeature .

uko:containsFeature a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:GeographicFeature ;
    rdfs:label "contains feature" ;
    rdfs:comment "A geographic feature contained within this neighborhood." .

uko:inDistrict a owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:District ;
    rdfs:label "in district" ;
    rdfs:comment "The district containing this feature." .

uko:adjacentNeighborhood a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:Neighborhood ;
    rdfs:label "adjacent neighborhood" ;
    rdfs:comment "A neighboring neighborhood that shares a boundary." ;
    rdf:type owl:SymmetricProperty .

uko:overlapsDistrict a owl:ObjectProperty ;
    rdfs:domain uko:Neighborhood ;
    rdfs:range uko:District ;
    rdfs:label "overlaps district" ;
    rdfs:comment "A district that overlaps with this neighborhood." ;
    rdf:type owl:SymmetricProperty .

uko:discoveryMethod a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "discovery method" ;
    rdfs:comment "How this area was discovered: 'osm', 'llm_query', 'poi_clustering', 'web_search', 'manual'" .

uko:verificationSource a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:string ;
    rdfs:label "verification source" ;
    rdfs:comment "Source used to verify this area's existence: URL, document reference, etc." .

uko:lastVerified a owl:DatatypeProperty ;
    rdfs:domain uko:GeographicArea ;
    rdfs:range xsd:dateTime ;
    rdfs:label "last verified" ;
    rdfs:comment "Date when this area's information was last verified." .

# =============================================================================
# UKO Safety Extension
# =============================================================================

uko:HighInjuryNetwork rdf:type owl:Class ;
    rdfs:subClassOf uko:TransportationSafetyFeature ;
    rdfs:label "High Injury Network"@en ;
    rdfs:comment "Road network segments with disproportionately high rates of traffic injuries and fatalities. Typically represents 5-10% of roads but 50%+ of serious injuries."@en .

uko:HighInjuryNetworkBike rdf:type owl:Class ;
    rdfs:subClassOf uko:HighInjuryNetwork ;
    rdfs:label "High Injury Network - Bicycle"@en ;
    rdfs:comment "Road segments with elevated bicycle-involved crash rates."@en .

uko:HighInjuryNetworkPedestrian rdf:type owl:Class ;
    rdfs:subClassOf uko:HighInjuryNetwork ;
    rdfs:label "High Injury Network - Pedestrian"@en ;
    rdfs:comment "Road segments with elevated pedestrian-involved crash rates."@en .

uko:HighInjuryNetworkVehicle rdf:type owl:Class ;
    rdfs:subClassOf uko:HighInjuryNetwork ;
    rdfs:label "High Injury Network - Vehicle"@en ;
    rdfs:comment "Road segments with elevated vehicle-only crash rates."@en .

uko:HighInjuryNetworkMotorcycle rdf:type owl:Class ;
    rdfs:subClassOf uko:HighInjuryNetwork ;
    rdfs:label "High Injury Network - Motorcycle"@en ;
    rdfs:comment "Road segments with elevated motorcycle-involved crash rates."@en .

uko:TransportationSafetyFeature rdf:type owl:Class ;
    rdfs:subClassOf uko:SpatialEntity ;
    rdfs:label "Transportation Safety Feature"@en ;
    rdfs:comment "Any feature related to transportation safety analysis."@en .

uko:SafetyZone rdf:type owl:Class ;
    rdfs:subClassOf uko:TransportationSafetyFeature ;
    rdfs:label "Safety Zone"@en ;
    rdfs:comment "A designated area with specific safety considerations or treatments."@en .

uko:PedestrianPriorityArea rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyZone ;
    rdfs:label "Pedestrian Priority Area"@en ;
    rdfs:comment "Area designated for prioritized pedestrian safety improvements, typically around transit, schools, and commercial centers."@en .

uko:VisionZeroCorridorArea rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyZone ;
    rdfs:label "Vision Zero Corridor Area"@en ;
    rdfs:comment "Corridor identified for Vision Zero safety interventions."@en .

uko:SchoolSafetyZone rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyZone ;
    rdfs:label "School Safety Zone"@en ;
    rdfs:comment "Area around schools with enhanced safety requirements."@en .

uko:SeniorSafetyZone rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyZone ;
    rdfs:label "Senior Safety Zone"@en ;
    rdfs:comment "Area around senior facilities with enhanced safety considerations."@en .

uko:inHighInjuryNetwork rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "in High Injury Network"@en ;
    rdfs:comment "Indicates this entity is located within or part of a High Injury Network segment."@en .

uko:hinSegmentOf rdf:type owl:ObjectProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range uko:Road ;
    rdfs:label "HIN segment of"@en ;
    rdfs:comment "Links a High Injury Network segment to the road it overlays."@en .

uko:overlapsHIN rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:HighInjuryNetwork ;
    owl:inverseOf uko:hinSegmentOf ;
    rdfs:label "overlaps HIN"@en ;
    rdfs:comment "Indicates this road segment overlaps with a High Injury Network."@en .

uko:hinDataPeriod rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:string ;
    rdfs:label "HIN data period"@en ;
    rdfs:comment "Time period for crash data used to define HIN (e.g., '2018-2022')."@en .

uko:fatalCount rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:integer ;
    rdfs:label "fatal count"@en ;
    rdfs:comment "Number of fatal crashes in the HIN segment during data period."@en .

uko:severeInjuryCount rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:integer ;
    rdfs:label "severe injury count"@en ;
    rdfs:comment "Number of severe injury crashes in the HIN segment during data period."@en .

uko:crashRate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:decimal ;
    rdfs:label "crash rate"@en ;
    rdfs:comment "Crash rate per million vehicle miles traveled or per mile."@en .

uko:injurySeverityScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HighInjuryNetwork ;
    rdfs:range xsd:decimal ;
    rdfs:label "injury severity score"@en ;
    rdfs:comment "Composite score weighting fatal and severe injuries."@en .

uko:VulnerablePopulationFacility rdf:type owl:Class ;
    rdfs:subClassOf uko:PointOfInterest ;
    rdfs:label "Vulnerable Population Facility"@en ;
    rdfs:comment "Facility serving populations with elevated traffic safety risks: seniors, children, people with disabilities."@en .

uko:SeniorFacility rdf:type owl:Class ;
    rdfs:subClassOf uko:VulnerablePopulationFacility ;
    rdfs:label "Senior Facility"@en ;
    rdfs:comment "Facility primarily serving senior citizens."@en .

uko:NursingHome rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Nursing Home"@en ;
    rdfs:comment "Skilled nursing facility providing 24-hour care."@en .

uko:AssistedLivingFacility rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Assisted Living Facility"@en ;
    rdfs:comment "Residential facility providing assistance with daily activities."@en .

uko:SeniorCenter rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Senior Center"@en ;
    rdfs:comment "Community center providing programs and services for seniors."@en .

uko:IndependentLivingFacility rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Independent Living Facility"@en ;
    rdfs:comment "Senior housing community for independent adults."@en .

uko:MemoryCareFacility rdf:type owl:Class ;
    rdfs:subClassOf uko:SeniorFacility ;
    rdfs:label "Memory Care Facility"@en ;
    rdfs:comment "Facility specialized for residents with dementia or Alzheimer's."@en .

uko:ChildFacility rdf:type owl:Class ;
    rdfs:subClassOf uko:VulnerablePopulationFacility ;
    rdfs:label "Child Facility"@en ;
    rdfs:comment "Facility primarily serving children."@en .

uko:Daycare rdf:type owl:Class ;
    rdfs:subClassOf uko:ChildFacility ;
    rdfs:label "Daycare"@en ;
    rdfs:comment "Childcare facility for young children."@en .

uko:Preschool rdf:type owl:Class ;
    rdfs:subClassOf uko:ChildFacility ;
    rdfs:label "Preschool"@en ;
    rdfs:comment "Early childhood education facility."@en .

uko:DisabilityFacility rdf:type owl:Class ;
    rdfs:subClassOf uko:VulnerablePopulationFacility ;
    rdfs:label "Disability Facility"@en ;
    rdfs:comment "Facility serving people with disabilities."@en .

uko:residentCapacity rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:VulnerablePopulationFacility ;
    rdfs:range xsd:integer ;
    rdfs:label "resident capacity"@en ;
    rdfs:comment "Maximum number of residents the facility can accommodate."@en .

uko:bedCount rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:VulnerablePopulationFacility ;
    rdfs:range xsd:integer ;
    rdfs:label "bed count"@en ;
    rdfs:comment "Number of beds in the facility."@en .

uko:currentPopulation rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:VulnerablePopulationFacility ;
    rdfs:range xsd:integer ;
    rdfs:label "current population"@en ;
    rdfs:comment "Current number of residents or participants."@en .

uko:vulnerablePopulationType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:VulnerablePopulationFacility ;
    rdfs:range xsd:string ;
    rdfs:label "vulnerable population type"@en ;
    rdfs:comment "Type of vulnerable population served (senior, child, disabled)."@en .

uko:hasVulnerablePopulationNearby rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:VulnerablePopulationFacility ;
    rdfs:label "has vulnerable population nearby"@en ;
    rdfs:comment "Indicates a vulnerable population facility is nearby (within safety buffer distance)."@en .

uko:nearVulnerablePopulation rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:VulnerablePopulationFacility ;
    rdfs:label "near vulnerable population"@en ;
    rdfs:comment "Road segment is near a vulnerable population facility."@en .

uko:SafetyConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:TransportationSafetyFeature ;
    rdfs:label "Safety Concern"@en ;
    rdfs:comment "A reported or identified transportation safety concern at a specific location."@en .

uko:BicycleSafetyConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Bicycle Safety Concern"@en ;
    rdfs:comment "Safety concern related to bicycle infrastructure or cyclist safety."@en .

uko:PedestrianSafetyConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Pedestrian Safety Concern"@en ;
    rdfs:comment "Safety concern related to pedestrian infrastructure or walker safety."@en .

uko:SpeedingConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Speeding Concern"@en ;
    rdfs:comment "Safety concern related to vehicle speeding."@en .

uko:IntersectionSafetyConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Intersection Safety Concern"@en ;
    rdfs:comment "Safety concern at or related to an intersection."@en .

uko:VisibilityConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Visibility Concern"@en ;
    rdfs:comment "Safety concern related to sight lines, obstructions, or visibility."@en .

uko:LightingConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    owl:deprecated "true"^^xsd:boolean ;
    dcterms:isReplacedBy uko:streetlightCoverage ;
    rdfs:label "Lighting Concern (DEPRECATED)"@en ;
    rdfs:comment "DEPRECATED at v15.5.0. Inadequate-lighting conditions are now expressed quantitatively via uko:streetlightCoverage on the affected RoadSegment or PedestrianNetworkEdge (a lighting concern corresponds to a low coverage fraction relative to the facility class threshold) rather than as a reified concern instance. Retained for backward compatibility; no new instances should be minted."@en .

uko:SignalViolationConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Signal Violation Concern"@en ;
    rdfs:comment "Safety concern related to red light or stop sign violations."@en .

uko:UnsafeRouteToSchool rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Unsafe Route to School"@en ;
    rdfs:comment "Safety concern about a route used by children walking or biking to school."@en .

uko:ModeSeparationConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Mode Separation Concern"@en ;
    rdfs:comment "Safety concern about insufficient separation between travel modes (cars, bikes, pedestrians)."@en .

uko:PavementConditionConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Pavement Condition Concern"@en ;
    rdfs:comment "Safety concern related to poor pavement conditions (potholes, cracks, etc.)."@en .

uko:LargeTruckConcern rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Large Truck Concern"@en ;
    rdfs:comment "Safety concern related to large truck traffic."@en .

uko:UnsafeHazard rdf:type owl:Class ;
    rdfs:subClassOf uko:SafetyConcern ;
    rdfs:label "Unsafe Hazard"@en ;
    rdfs:comment "General safety hazard not otherwise categorized."@en .

uko:concernType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "concern type"@en ;
    rdfs:comment "Category of safety concern."@en .

uko:concernDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "concern description"@en ;
    rdfs:comment "Detailed description of the safety concern."@en .

uko:reportedDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:dateTime ;
    rdfs:label "reported date"@en ;
    rdfs:comment "Date the safety concern was reported."@en .

uko:reportSource rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "report source"@en ;
    rdfs:comment "Source of the safety concern report (community, agency, survey)."@en .

uko:communitySentiment rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "community sentiment"@en ;
    rdfs:comment "Sentiment analysis of the concern (POSITIVE, NEGATIVE, MIXED, NEUTRAL)."@en .

uko:upvoteCount rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:integer ;
    rdfs:label "upvote count"@en ;
    rdfs:comment "Number of community upvotes supporting this concern."@en .

uko:concernStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "concern status"@en ;
    rdfs:comment "Status of the concern (open, reviewed, addressed, closed)."@en .

uko:concernPriority rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range xsd:string ;
    rdfs:label "concern priority"@en ;
    rdfs:comment "Priority level assigned to the concern (high, medium, low)."@en .

uko:affectsRoad rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range uko:Road ;
    rdfs:label "affects road"@en ;
    rdfs:comment "Road segment affected by this safety concern."@en .

uko:affectsIntersection rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SafetyConcern ;
    rdfs:range uko:Intersection ;
    rdfs:label "affects intersection"@en ;
    rdfs:comment "Intersection affected by this safety concern."@en .

uko:hasSafetyConcern rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:SafetyConcern ;
    rdfs:label "has safety concern"@en ;
    rdfs:comment "Links an entity to a safety concern at or near its location."@en .

uko:VisionZeroStatus rdf:type owl:Class ;
    rdfs:label "Vision Zero Status"@en ;
    rdfs:comment "Status classification for Vision Zero planning and implementation."@en .

uko:visionZeroClassification rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "Vision Zero classification"@en ;
    rdfs:comment "Classification under Vision Zero framework (priority corridor, target area, etc.)."@en .

uko:safetyTreatmentApplied rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "safety treatment applied"@en ;
    rdfs:comment "Safety countermeasures applied to this road segment."@en .

uko:plannedSafetyTreatment rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "planned safety treatment"@en ;
    rdfs:comment "Planned safety countermeasures for this road segment."@en .

uko:SupervisorDistrict rdf:type owl:Class ;
    rdfs:subClassOf uko:AdministrativeArea ;
    rdfs:label "Supervisor District"@en ;
    rdfs:comment "County supervisor district boundary."@en .

uko:districtNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SupervisorDistrict ;
    rdfs:range xsd:integer ;
    rdfs:label "district number"@en ;
    rdfs:comment "Numeric identifier for the supervisor district."@en .

uko:supervisorName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SupervisorDistrict ;
    rdfs:range xsd:string ;
    rdfs:label "supervisor name"@en ;
    rdfs:comment "Name of the district supervisor."@en .

uko:inSupervisorDistrict rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:SupervisorDistrict ;
    rdfs:label "in supervisor district"@en ;
    rdfs:comment "Indicates the supervisor district containing this entity."@en .

uko:SafetyScore rdf:type owl:Class ;
    rdfs:label "Safety Score"@en ;
    rdfs:comment "Composite safety score for a location or route."@en .

uko:hasSafetyScore rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range uko:SafetyScore ;
    rdfs:label "has safety score"@en .

uko:overallSafetyScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "overall safety score"@en ;
    rdfs:comment "Composite safety score (0-100, higher is safer)."@en .

uko:pedestrianSafetyScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "pedestrian safety score"@en ;
    rdfs:comment "Safety score for pedestrians (0-100)."@en .

uko:bicycleSafetyScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "bicycle safety score"@en ;
    rdfs:comment "Safety score for cyclists (0-100)."@en .

uko:childSafetyScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "child safety score"@en ;
    rdfs:comment "Safety score considering child vulnerability (0-100)."@en .

uko:seniorSafetyScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:decimal ;
    rdfs:label "senior safety score"@en ;
    rdfs:comment "Safety score considering senior vulnerability (0-100)."@en .

# =============================================================================
# UKO ADAS Extension
# =============================================================================

uko:ADASFeature rdf:type owl:Class ;
    rdfs:subClassOf uko:RoadFeature ;
    rdfs:label "ADAS Feature"@en ;
    rdfs:comment "Feature relevant to Advanced Driver Assistance Systems operation."@en .

uko:SpeedRegulation rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "Speed Regulation"@en ;
    rdfs:comment "Speed-related regulatory information for ADAS."@en .

uko:PostedSpeedLimit rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "Posted Speed Limit"@en ;
    rdfs:comment "Official posted speed limit sign location and value."@en .

uko:VariableSpeedLimit rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "Variable Speed Limit"@en ;
    rdfs:comment "Speed limit that changes based on conditions (time, weather, traffic)."@en .

uko:AdvisorySpeedLimit rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "Advisory Speed Limit"@en ;
    rdfs:comment "Recommended speed for curves, ramps, or hazardous conditions."@en .

uko:SchoolZoneSpeedLimit rdf:type owl:Class ;
    rdfs:subClassOf uko:SpeedRegulation ;
    rdfs:label "School Zone Speed Limit"@en ;
    rdfs:comment "Reduced speed limit in school zones during active hours."@en .

uko:ADASTrafficControl rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "ADAS Traffic Control"@en ;
    rdfs:comment "Traffic control device relevant to ADAS operation."@en .

uko:TrafficSignalTiming rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASTrafficControl ;
    rdfs:label "Traffic Signal Timing"@en ;
    rdfs:comment "Signal phase and timing information for signal priority/preemption."@en .

uko:StopSignLocation rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASTrafficControl ;
    rdfs:label "Stop Sign Location"@en ;
    rdfs:comment "Precise location of stop signs for ADAS recognition."@en .

uko:YieldSignLocation rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASTrafficControl ;
    rdfs:label "Yield Sign Location"@en ;
    rdfs:comment "Precise location of yield signs for ADAS recognition."@en .

uko:speedLimitValue rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:integer ;
    rdfs:label "speed limit value"@en ;
    rdfs:comment "Speed limit value in the local unit (typically mph or km/h)."@en .

uko:speedLimitUnit rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:string ;
    rdfs:label "speed limit unit"@en ;
    rdfs:comment "Unit for speed limit (mph, km/h)."@en .

uko:speedLimitCondition rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:string ;
    rdfs:label "speed limit condition"@en ;
    rdfs:comment "Condition when speed limit applies (always, school_hours, when_flashing, wet_conditions)."@en .

uko:effectiveTimeStart rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:time ;
    rdfs:label "effective time start"@en ;
    rdfs:comment "Start time when conditional speed limit is in effect."@en .

uko:effectiveTimeEnd rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpeedRegulation ;
    rdfs:range xsd:time ;
    rdfs:label "effective time end"@en ;
    rdfs:comment "End time when conditional speed limit is no longer in effect."@en .

uko:LaneTopology rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "Lane Topology"@en ;
    rdfs:comment "Lane-level road topology for HD mapping and autonomous navigation."@en .

uko:LaneGroup rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Group"@en ;
    rdfs:comment "Group of lanes traveling in the same direction."@en .

uko:LaneBoundary rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Boundary"@en ;
    rdfs:comment "Boundary line between lanes with marking type."@en .

uko:LaneConnector rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Connector"@en ;
    rdfs:comment "Connection between lanes at intersections or merges."@en .

uko:LaneTransition rdf:type owl:Class ;
    rdfs:subClassOf uko:LaneTopology ;
    rdfs:label "Lane Transition"@en ;
    rdfs:comment "Lane addition, drop, merge, or split point."@en .

uko:laneNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:integer ;
    rdfs:label "lane number"@en ;
    rdfs:comment "Lane number from right edge (1 = rightmost lane)."@en .

uko:laneWidth rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:decimal ;
    rdfs:label "lane width"@en ;
    rdfs:comment "Width of lane in meters."@en .

uko:laneType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:string ;
    rdfs:label "lane type"@en ;
    rdfs:comment "Type of lane (driving, parking, bike, bus, hov, turn, shoulder)."@en .

uko:laneDirection rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:string ;
    rdfs:label "lane direction"@en ;
    rdfs:comment "Travel direction of lane (forward, backward, bidirectional)."@en .

uko:laneBoundaryType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LaneBoundary ;
    rdfs:range xsd:string ;
    rdfs:label "lane boundary type"@en ;
    rdfs:comment "Type of lane marking (solid_white, dashed_white, solid_yellow, double_yellow, etc.)."@en .

uko:laneCrossable rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:LaneBoundary ;
    rdfs:range xsd:boolean ;
    rdfs:label "lane crossable"@en ;
    rdfs:comment "Whether vehicles can legally cross this lane boundary."@en .

uko:turnRestriction rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Lane ;
    rdfs:range xsd:string ;
    rdfs:label "turn restriction"@en ;
    rdfs:comment "Turn restrictions for this lane (left_only, right_only, straight_only, no_left, no_right, no_uturn)."@en .

uko:connectsToLane rdf:type owl:ObjectProperty ;
    rdfs:domain uko:LaneConnector ;
    rdfs:range uko:Lane ;
    rdfs:label "connects to lane"@en ;
    rdfs:comment "Lane that this connector leads to."@en .

uko:connectsFromLane rdf:type owl:ObjectProperty ;
    rdfs:domain uko:LaneConnector ;
    rdfs:range uko:Lane ;
    rdfs:label "connects from lane"@en ;
    rdfs:comment "Lane that this connector originates from."@en .

uko:EHorizonFeature rdf:type owl:Class ;
    rdfs:subClassOf uko:ADASFeature ;
    rdfs:label "E-Horizon Feature"@en ;
    rdfs:comment "Feature visible in the electronic horizon (ahead of vehicle sensor range)."@en .

uko:eHorizonFeatureOf rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:EHorizonFeature ;
    rdfs:label "e-horizon feature of"@en ;
    rdfs:comment "Road features visible in e-horizon for this road segment."@en .

uko:anticipationDistance rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:EHorizonFeature ;
    rdfs:range xsd:decimal ;
    rdfs:label "anticipation distance"@en ;
    rdfs:comment "Distance at which this feature should be anticipated (meters)."@en .

uko:curvatureAhead rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:decimal ;
    rdfs:label "curvature ahead"@en ;
    rdfs:comment "Road curvature in the upcoming segment (1/radius in meters)."@en .

uko:gradeAhead rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:decimal ;
    rdfs:label "grade ahead"@en ;
    rdfs:comment "Road grade/slope in the upcoming segment (percentage)."@en .

uko:hazardAhead rdf:type owl:ObjectProperty ;
    rdfs:domain uko:Road ;
    rdfs:range uko:SafetyConcern ;
    rdfs:label "hazard ahead"@en ;
    rdfs:comment "Known hazard in the upcoming road segment."@en .

uko:RegulatoryCompliance rdf:type owl:Class ;
    rdfs:label "Regulatory Compliance"@en ;
    rdfs:comment "Compliance status with regulatory requirements."@en .

uko:ISACompliance rdf:type owl:Class ;
    rdfs:subClassOf uko:RegulatoryCompliance ;
    rdfs:label "ISA Compliance"@en ;
    rdfs:comment "Compliance with Intelligent Speed Assistance mandate."@en .

uko:NCAPCompliance rdf:type owl:Class ;
    rdfs:subClassOf uko:RegulatoryCompliance ;
    rdfs:label "NCAP Compliance"@en ;
    rdfs:comment "Compliance with New Car Assessment Program requirements."@en .

uko:isaCompliant rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "ISA compliant"@en ;
    rdfs:comment "Road has complete data for ISA compliance (speed limits, sign locations)."@en .

uko:ncapCompliant rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "NCAP compliant"@en ;
    rdfs:comment "Road has complete data for NCAP safety assessment."@en .

uko:complianceRegion rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RegulatoryCompliance ;
    rdfs:range xsd:string ;
    rdfs:label "compliance region"@en ;
    rdfs:comment "Geographic region for compliance (EU, US, APAC)."@en .

uko:complianceDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RegulatoryCompliance ;
    rdfs:range xsd:date ;
    rdfs:label "compliance date"@en ;
    rdfs:comment "Date compliance was verified."@en .

uko:updateFrequency rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "update frequency"@en ;
    rdfs:comment "Expected update frequency (real-time, daily, weekly, monthly)."@en .

uko:dataSource rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "data source"@en ;
    rdfs:comment "Source of the data (OSM, probe, survey, aerial, LiDAR)."@en .

uko:dataFreshness rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "data freshness"@en ;
    rdfs:comment "Freshness classification (current, recent, stale, unknown)."@en .

uko:verificationStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "verification status"@en ;
    rdfs:comment "Data verification status (verified, unverified, disputed)."@en .

uko:verificationDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:date ;
    rdfs:label "verification date"@en ;
    rdfs:comment "Date of last verification."@en .

uko:verificationMethod rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SpatialEntity ;
    rdfs:range xsd:string ;
    rdfs:label "verification method"@en ;
    rdfs:comment "Method used for verification (imagery, ground_truth, probe_data, user_report)."@en .

uko:NavigationLandmark rdf:type owl:Class ;
    rdfs:subClassOf uko:PointOfInterest ;
    rdfs:label "Navigation Landmark"@en ;
    rdfs:comment "Visually distinctive feature useful for navigation reference."@en .

uko:DecisionPoint rdf:type owl:Class ;
    rdfs:subClassOf uko:SpatialEntity ;
    rdfs:label "Decision Point"@en ;
    rdfs:comment "Location requiring navigation decision (turn, exit, lane change)."@en .

uko:NavigationContext rdf:type owl:Class ;
    rdfs:label "Navigation Context"@en ;
    rdfs:comment "Contextual information for natural language navigation."@en .

uko:landmarkVisibility rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:NavigationLandmark ;
    rdfs:range xsd:string ;
    rdfs:label "landmark visibility"@en ;
    rdfs:comment "Visibility conditions (day_only, night_illuminated, all_conditions)."@en .

uko:landmarkDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:NavigationLandmark ;
    rdfs:range xsd:string ;
    rdfs:label "landmark description"@en ;
    rdfs:comment "Natural language description for voice navigation."@en .

uko:decisionType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range xsd:string ;
    rdfs:label "decision type"@en ;
    rdfs:comment "Type of navigation decision (turn, exit, merge, lane_change, roundabout)."@en .

uko:decisionComplexity rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range xsd:string ;
    rdfs:label "decision complexity"@en ;
    rdfs:comment "Complexity of the decision point (simple, moderate, complex)."@en .

uko:nearbyLandmark rdf:type owl:ObjectProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range uko:NavigationLandmark ;
    rdfs:label "nearby landmark"@en ;
    rdfs:comment "Landmark near this decision point useful for orientation."@en .

uko:voicePrompt rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:DecisionPoint ;
    rdfs:range xsd:string ;
    rdfs:label "voice prompt"@en ;
    rdfs:comment "Suggested voice navigation prompt for this decision point."@en .

uko:autonomyLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "autonomy level"@en ;
    rdfs:comment "Maximum supported SAE autonomy level (L1, L2, L2+, L3, L4, L5)."@en .

uko:autonomyRestriction rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "autonomy restriction"@en ;
    rdfs:comment "Restrictions on autonomous operation (weather, time_of_day, construction)."@en .

uko:geoFenced rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:boolean ;
    rdfs:label "geo-fenced"@en ;
    rdfs:comment "Road is within an autonomous vehicle operational design domain (ODD) geofence."@en .

uko:oddClassification rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:Road ;
    rdfs:range xsd:string ;
    rdfs:label "ODD classification"@en ;
    rdfs:comment "Operational Design Domain classification for autonomous vehicles."@en .


# =============================================================================
# Part 7: Historical Incident Analytics (With 2D Key Fixes)
# =============================================================================

uko:IntersectionNode rdf:type owl:Class ;
    rdfs:label "Intersection Node"@en ;
    rdfs:comment "A named road intersection within the GKG road network, representing the physical point where two or more road segments meet."@en ;
    rdfs:isDefinedBy <urn:urban-kg:> .

uko:adjacentSegment rdf:type owl:ObjectProperty ;
    rdfs:domain uko:IntersectionNode ;
    rdfs:range uko:RoadSegment ;
    rdfs:label "adjacent segment"@en ;
    rdfs:comment "Links an intersection node to a road segment that begins or ends at the intersection."@en .

uko:intersectionNodeId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionNode ;
    rdfs:range xsd:string ;
    rdfs:label "intersection node ID"@en ;
    rdfs:comment "URN-based stable identifier for the intersection node."@en .

uko:cnnIntersectionKey rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionNode ;
    rdfs:range xsd:string ;
    rdfs:label "CNN intersection key"@en ;
    rdfs:comment "San Francisco Centerline Network (CNN) intersection foreign key."@en .

uko:primaryRoadName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionNode ;
    rdfs:range xsd:string ;
    rdfs:label "primary road name"@en ;
    rdfs:comment "The primary road name at this intersection."@en .

uko:secondaryRoadName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionNode ;
    rdfs:range xsd:string ;
    rdfs:label "secondary road name"@en ;
    rdfs:comment "The cross-street name at this intersection."@en .

uko:IntersectionRiskProfile rdf:type owl:Class ;
    rdfs:label "Intersection Risk Profile"@en ;
    rdfs:comment "An aggregated incident analytics object linked to a uko:IntersectionNode."@en ;
    rdfs:isDefinedBy <urn:urban-kg:> .

uko:hasIntersectionRiskProfile rdf:type owl:ObjectProperty ;
    rdfs:domain uko:IntersectionNode ;
    rdfs:range uko:IntersectionRiskProfile ;
    rdfs:label "has intersection risk profile"@en ;
    rdfs:comment "Links an intersection node to its aggregated incident risk profile."@en .

uko:intersectionIncidentCount rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:integer ;
    rdfs:label "intersection incident count"@en ;
    rdfs:comment "Total number of police-reported collisions at this intersection."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "integer"^^xsd:string ;
    uko:featureGroup "intersection_risk"^^xsd:string .

uko:intersectionIncidentDensityScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:decimal ;
    rdfs:label "intersection incident density score"@en ;
    rdfs:comment "Normalized incident frequency score for this intersection."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "numeric"^^xsd:string ;
    uko:featureGroup "intersection_risk"^^xsd:string .

uko:intersectionCollisionTypeDistribution rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:string ;
    rdfs:label "intersection collision type distribution"@en ;
    rdfs:comment "JSON map of collision type to fraction of total incidents at this intersection."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "intersection_risk"^^xsd:string .

uko:intersectionTimePattern rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:string ;
    rdfs:label "intersection time pattern"@en ;
    rdfs:comment "JSON map of time-of-day category to fraction of total incidents."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "intersection_risk"^^xsd:string .

uko:intersectionPCFDistribution rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:string ;
    rdfs:label "intersection PCF distribution"@en ;
    rdfs:comment "JSON map of California Vehicle Code primary collision factor group to fraction of incidents."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "intersection_risk"^^xsd:string .

uko:intersectionVehicleConflictDistribution rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:string ;
    rdfs:label "intersection vehicle conflict distribution"@en ;
    rdfs:comment "JSON map of collision group to fraction of incidents at this intersection."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "intersection_risk"^^xsd:string .

uko:intersectionCompoundConditionRiskMap rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:string ;
    rdfs:label "intersection compound condition risk map"@en ;
    rdfs:comment "JSON map encoding how weather and road surface conditions modulate the baseline accident rate at this intersection. Key format: '{weather_1}::{road_surface}'. Value: rate multiplier relative to baseline (Clear::Dry = 1.0). Example: {\"Raining::Wet\": 2.8, \"Clear::Wet\": 1.6}. Downgraded from 3D to 2D in v15.2.0."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "intersection_risk"^^xsd:string .

uko:intersectionSeverityDistribution rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:string ;
    rdfs:label "intersection severity distribution"@en ;
    rdfs:comment "JSON map of collision severity category to fraction of incidents."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "intersection_risk"^^xsd:string .

uko:intersectionIncidentDataLastUpdated rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:dateTime ;
    rdfs:label "intersection incident data last updated"@en ;
    rdfs:comment "Timestamp of the most recent data refresh."@en .

uko:intersectionIncidentRecordYearRange rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionRiskProfile ;
    rdfs:range xsd:string ;
    rdfs:label "intersection incident record year range"@en ;
    rdfs:comment "String encoding the year range covered by the incident records."@en .

uko:midblockIncidentCount rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:integer ;
    rdfs:label "midblock incident count"@en ;
    rdfs:comment "Total number of police-reported midblock collisions on this segment."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "integer"^^xsd:string ;
    uko:featureGroup "segment_incident_analytics"^^xsd:string .

uko:incidentDensityScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "incident density score"@en ;
    rdfs:comment "Normalized midblock incident frequency score (0.0–1.0)."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "numeric"^^xsd:string ;
    uko:featureGroup "segment_incident_analytics"^^xsd:string .

uko:compoundConditionRiskMap rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "compound condition risk map"@en ;
    rdfs:comment "JSON map encoding the historically-observed accident rate multiplier for each compound condition combination on this segment. Key format: '{weather_1}::{road_surface}'. Value: decimal multiplier relative to baseline. Example: {\"Raining::Wet\": 2.4, \"Clear::Wet\": 1.5, \"Raining::Dry\": 1.8}. Downgraded from 3D to 2D in v15.2.0."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "segment_incident_analytics"^^xsd:string .

uko:segmentIncidentTimePattern rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "segment incident time pattern"@en ;
    rdfs:comment "JSON map of SWITRS time_cat value to fraction of total midblock incidents."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "segment_incident_analytics"^^xsd:string .

uko:segmentCollisionTypeDistribution rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "segment collision type distribution"@en ;
    rdfs:comment "JSON map of collision type to fraction of midblock incidents."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "segment_incident_analytics"^^xsd:string .

uko:segmentVehicleConflictDistribution rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "segment vehicle conflict distribution"@en ;
    rdfs:comment "JSON map of dph_col_grp_description to fraction of midblock incidents."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "segment_incident_analytics"^^xsd:string .

uko:segmentPCFDistribution rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "segment PCF distribution"@en ;
    rdfs:comment "JSON map of California Vehicle Code primary collision factor group to fraction of midblock incidents."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "segment_incident_analytics"^^xsd:string .

uko:segmentSeverityDistribution rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "segment severity distribution"@en ;
    rdfs:comment "JSON map of collision_severity category to fraction of midblock incidents."@en ;
    uko:featureExtraction "true"^^xsd:boolean ;
    uko:featureType "json"^^xsd:string ;
    uko:featureGroup "segment_incident_analytics"^^xsd:string .

uko:incidentDataLastUpdated rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "incident data last updated"@en ;
    rdfs:comment "Timestamp of the most recent Historical Incident Data Ingestion Pipeline run."@en .

uko:incidentRecordYearRange rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "incident record year range"@en ;
    rdfs:comment "String encoding the year range of incident records used."@en .

uko:incidentDataSource rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "incident data source"@en ;
    rdfs:comment "Identifier of the collision record data system."@en .

# =============================================================================
# Part 8: Historical Incident Data Ingestion Pipeline Support
# =============================================================================

uko:spatialMatchMethod rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionNode ;
    rdfs:range xsd:string ;
    rdfs:label "spatial match method"@en ;
    rdfs:comment "Method used to match SWITRS collision records to this intersection node."@en .

uko:spatialMatchConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:IntersectionNode ;
    rdfs:range xsd:decimal ;
    rdfs:label "spatial match confidence"@en ;
    rdfs:comment "Confidence score [0.0–1.0] assigned to the spatial match."@en .

uko:segmentSpatialMatchMethod rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "segment spatial match method"@en ;
    rdfs:comment "Method used to match SWITRS midblock collision records."@en .


# =============================================================================
# Part 9: Truck Routing Constraint Layer
# =============================================================================

uko:TruckRoutingConstraint rdf:type owl:Class ;
    rdfs:label "Truck Routing Constraint"@en ;
    rdfs:comment "Root class for all physical, regulatory, and operational constraints that affect the routing eligibility of commercial heavy vehicles."@en ;
    rdfs:isDefinedBy <urn:urban-kg:> .

uko:hasTruckRoutingConstraint rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
        owl:unionOf ( uko:RoadSegment uko:IntersectionNode ) ] ;
    rdfs:range uko:TruckRoutingConstraint ;
    rdfs:label "has truck routing constraint"@en ;
    rdfs:comment "Links a road segment or intersection node to one or more TruckRoutingConstraint instances."@en .

uko:PhysicalInfrastructureConstraint rdf:type owl:Class ;
    rdfs:subClassOf uko:TruckRoutingConstraint ;
    rdfs:label "Physical Infrastructure Constraint"@en ;
    rdfs:comment "A TruckRoutingConstraint arising from the physical characteristics of the road infrastructure."@en .

uko:BridgeHeightConstraint rdf:type owl:Class ;
    rdfs:subClassOf uko:PhysicalInfrastructureConstraint ;
    rdfs:label "Bridge Height Constraint"@en ;
    rdfs:comment "A constraint on the vertical clearance available on a road segment."@en .

uko:verticalClearanceMeters rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:BridgeHeightConstraint ;
    rdfs:range xsd:decimal ;
    rdfs:label "vertical clearance (meters)"@en ;
    rdfs:comment "The minimum vertical clearance available on the constrained segment, in meters."@en .

uko:clearanceDataSource rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:BridgeHeightConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "clearance data source"@en ;
    rdfs:comment "Data source for the vertical clearance value."@en .

uko:nbiStructureNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:BridgeHeightConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "NBI structure number"@en ;
    rdfs:comment "The FHWA National Bridge Inventory 15-character structure number."@en .

uko:WeightConstraint rdf:type owl:Class ;
    rdfs:subClassOf uko:PhysicalInfrastructureConstraint ;
    rdfs:label "Weight Constraint"@en ;
    rdfs:comment "A constraint on the maximum weight that may be applied to a road segment."@en .

uko:maxGrossVehicleWeightKg rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WeightConstraint ;
    rdfs:range xsd:decimal ;
    rdfs:label "maximum gross vehicle weight (kg)"@en ;
    rdfs:comment "Maximum Gross Vehicle Weight (GVW) permitted on this segment, in kilograms."@en .

uko:maxSingleAxleWeightKg rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WeightConstraint ;
    rdfs:range xsd:decimal ;
    rdfs:label "maximum single axle weight (kg)"@en ;
    rdfs:comment "Maximum weight permitted on a single axle, in kilograms."@en .

uko:maxTandemAxleWeightKg rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WeightConstraint ;
    rdfs:range xsd:decimal ;
    rdfs:label "maximum tandem axle weight (kg)"@en ;
    rdfs:comment "Maximum weight permitted on a tandem axle group."@en .

uko:bridgeOperatingRating rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WeightConstraint ;
    rdfs:range xsd:decimal ;
    rdfs:label "bridge operating rating (metric tons)"@en ;
    rdfs:comment "The FHWA bridge operating rating in metric tons."@en .

uko:bridgeInventoryRating rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WeightConstraint ;
    rdfs:range xsd:decimal ;
    rdfs:label "bridge inventory rating (metric tons)"@en ;
    rdfs:comment "The FHWA bridge inventory rating in metric tons."@en .

uko:TunnelConstraint rdf:type owl:Class ;
    rdfs:subClassOf uko:PhysicalInfrastructureConstraint ;
    rdfs:label "Tunnel Constraint"@en ;
    rdfs:comment "A constraint arising from a tunnel structure on a road segment."@en .

uko:tunnelLengthMeters rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TunnelConstraint ;
    rdfs:range xsd:decimal ;
    rdfs:label "tunnel length (meters)"@en ;
    rdfs:comment "Length of the tunnel in meters."@en .

uko:tunnelPortalClearanceMeters rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TunnelConstraint ;
    rdfs:range xsd:decimal ;
    rdfs:label "tunnel portal clearance (meters)"@en ;
    rdfs:comment "Vertical clearance at the tunnel portal (entrance), in meters."@en .

uko:RegulatoryRoutingConstraint rdf:type owl:Class ;
    rdfs:subClassOf uko:TruckRoutingConstraint ;
    rdfs:label "Regulatory Routing Constraint"@en ;
    rdfs:comment "A TruckRoutingConstraint arising from legal or regulatory requirements."@en .

uko:HAZMATRoutingConstraint rdf:type owl:Class ;
    rdfs:subClassOf uko:RegulatoryRoutingConstraint ;
    rdfs:label "HAZMAT Routing Constraint"@en ;
    rdfs:comment "A regulatory constraint restricting or prohibiting the transport of hazardous materials on a road segment."@en .

uko:prohibitedHazmatClasses rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HAZMATRoutingConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "prohibited HAZMAT classes"@en ;
    rdfs:comment "Pipe-delimited list of DOT HAZMAT division codes prohibited on this segment."@en .

uko:hazmatRestrictionScope rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HAZMATRoutingConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "HAZMAT restriction scope"@en ;
    rdfs:comment "Scope of the HAZMAT restriction (e.g., ABSOLUTE, TIME_RESTRICTED)."@en .

uko:hazmatTimeRestrictionSchedule rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HAZMATRoutingConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "HAZMAT time restriction schedule"@en ;
    rdfs:comment "JSON encoding of time windows during which the HAZMAT restriction is active."@en .

uko:hazmatAlternativeRouteRef rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:HAZMATRoutingConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "HAZMAT alternative route reference"@en ;
    rdfs:comment "Reference to the officially designated alternative route for HAZMAT vehicles."@en .

uko:TruckRouteDesignation rdf:type owl:Class ;
    rdfs:subClassOf uko:RegulatoryRoutingConstraint ;
    rdfs:label "Truck Route Designation"@en ;
    rdfs:comment "A designation indicating that a road segment is part of an official truck route network."@en .

uko:truckRouteDesignationType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckRouteDesignation ;
    rdfs:range xsd:string ;
    rdfs:label "truck route designation type"@en ;
    rdfs:comment "Type of truck route designation (e.g., DESIGNATED_TRUCK_ROUTE, TRUCK_PROHIBITED)."@en .

uko:truckWeightThresholdKg rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckRouteDesignation ;
    rdfs:range xsd:decimal ;
    rdfs:label "truck weight threshold (kg)"@en ;
    rdfs:comment "The gross vehicle weight threshold above which the truck route restriction applies."@en .

uko:TimeOfDayWeightRestriction rdf:type owl:Class ;
    rdfs:subClassOf uko:RegulatoryRoutingConstraint ;
    rdfs:label "Time-of-Day Weight Restriction"@en ;
    rdfs:comment "A weight restriction that applies only during specified time windows."@en .

uko:weightRestrictionSchedule rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TimeOfDayWeightRestriction ;
    rdfs:range xsd:string ;
    rdfs:label "weight restriction schedule"@en ;
    rdfs:comment "JSON encoding of the time windows during which the weight restriction is active."@en .

uko:TruckParkingFacility rdf:type owl:Class ;
    rdfs:label "Truck Parking Facility"@en ;
    rdfs:comment "A physical facility providing legal, safe parking for commercial trucks."@en ;
    rdfs:isDefinedBy <urn:urban-kg:> .

uko:hasTruckParkingFacility rdf:type owl:ObjectProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range uko:TruckParkingFacility ;
    rdfs:label "has truck parking facility"@en ;
    rdfs:comment "Links a road segment to a TruckParkingFacility accessible from that segment."@en .

uko:parkingFacilityName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckParkingFacility ;
    rdfs:range xsd:string ;
    rdfs:label "parking facility name"@en ;
    rdfs:comment "Human-readable name of the parking facility."@en .

uko:parkingFacilityType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckParkingFacility ;
    rdfs:range xsd:string ;
    rdfs:label "parking facility type"@en ;
    rdfs:comment "Type of parking facility (e.g., TRUCK_STOP, REST_AREA)."@en .

uko:parkingCapacitySpaces rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckParkingFacility ;
    rdfs:range xsd:integer ;
    rdfs:label "parking capacity (spaces)"@en ;
    rdfs:comment "Total number of commercial truck parking spaces at this facility."@en .

uko:parkingFacilityLatitude rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckParkingFacility ;
    rdfs:range xsd:decimal ;
    rdfs:label "parking facility latitude"@en ;
    rdfs:comment "WGS-84 latitude of the facility entrance or centroid."@en .

uko:parkingFacilityLongitude rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckParkingFacility ;
    rdfs:range xsd:decimal ;
    rdfs:label "parking facility longitude"@en ;
    rdfs:comment "WGS-84 longitude of the facility entrance or centroid."@en .

uko:parkingOperatingHours rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckParkingFacility ;
    rdfs:range xsd:string ;
    rdfs:label "parking operating hours"@en ;
    rdfs:comment "Operating hours of the parking facility."@en .

uko:parkingAmenities rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckParkingFacility ;
    rdfs:range xsd:string ;
    rdfs:label "parking amenities"@en ;
    rdfs:comment "Pipe-delimited list of amenities available at the facility."@en .

uko:parkingDataSource rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:TruckParkingFacility ;
    rdfs:range xsd:string ;
    rdfs:label "parking data source"@en ;
    rdfs:comment "Source of the parking facility data."@en .

uko:hasVerticalClearance rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "has vertical clearance (meters)"@en ;
    rdfs:comment "Convenience property storing the minimum vertical clearance on this segment in meters."@en .

uko:hasMaxGVW rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "has maximum GVW (kg)"@en ;
    rdfs:comment "Convenience property storing the most restrictive maximum Gross Vehicle Weight on this segment in kilograms."@en .

uko:hasHazmatRestriction rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has HAZMAT restriction"@en ;
    rdfs:comment "Boolean convenience flag indicating that this segment carries at least one HAZMATRoutingConstraint."@en .

uko:isTruckRoute rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "is designated truck route"@en ;
    rdfs:comment "True if this segment is part of the officially designated truck route network for its jurisdiction."@en .

uko:isTruckProhibited rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "is truck prohibited"@en ;
    rdfs:comment "True if trucks above the applicable weight threshold are prohibited from this segment."@en .


# =============================================================================
# EXTENSION: CARGO THEFT HOTSPOT ZONE (UKO v15.1)
# =============================================================================

uko:CargoTheftHotspotZone rdf:type owl:Class ;
    rdfs:subClassOf uko:GeographicFeature ;
    rdfs:label "Cargo Theft Hotspot Zone"@en ;
    rdfs:comment "A geographic zone with elevated cargo theft probability for commercial vehicles. Represented as a spatial polygon in the GKG. Populated from FBI UCR crime statistics (annual bulk download), FreightWaves SONAR cargo theft incident feed (subscription), and NICB (National Insurance Crime Bureau) cargo theft reports. Used in the OHR model R7 (Security/Theft Risk) dimension computation: the fraction of a planned route's mileage passing through CargoTheftHotspotZone polygons, weighted by theftRiskIntensity and cargo value tier, is the primary input to R7."@en .

uko:theftRiskIntensity rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CargoTheftHotspotZone ;
    rdfs:range xsd:decimal ;
    rdfs:label "theft risk intensity"@en ;
    rdfs:comment "Normalized cargo theft probability score for this zone [0.0–1.0]. Computed from annual incident density (theft events per square mile per year) normalized to a fleet-population percentile. A score of 0.8 places this zone in the 80th percentile of theft risk across all GKG CargoTheftHotspotZone instances. Updated annually from FBI UCR data and quarterly from FreightWaves SONAR incident feed."@en .

uko:sensitiveCargoClassList rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CargoTheftHotspotZone ;
    rdfs:range xsd:string ;
    rdfs:label "sensitive cargo class list"@en ;
    rdfs:comment "JSON array of FKO commodity class identifiers for which this zone has elevated theft risk beyond the general theftRiskIntensity. Format: '[\"HighValueCargo\", \"HazmatCargo\"]'. Stored as a string literal to avoid a direct UKO→FKO ontology import dependency, consistent with the pattern used for uko:permittedModalities. The OHR R7 computation applies a cargo class sensitivity multiplier when the trip's FKO commodity class appears in this list."@en .

uko:peakTheftStartHour rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CargoTheftHotspotZone ;
    rdfs:range xsd:integer ;
    rdfs:label "peak theft start hour (0–23)"@en ;
    rdfs:comment "Hour of day (UTC, 0–23) at which cargo theft risk begins to peak in this zone based on historical incident timing patterns. Combined with peakTheftEndHour to define a time-of-day risk window. The OHR model applies a time-of-day multiplier to theftRiskIntensity when the truck's projected entry into this zone falls within [peakTheftStartHour, peakTheftEndHour]. Typical values: 22 (late evening) for commercial corridor zones, 2 (early morning) for rest stop adjacency zones."@en .

uko:peakTheftEndHour rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CargoTheftHotspotZone ;
    rdfs:range xsd:integer ;
    rdfs:label "peak theft end hour (0–23)"@en ;
    rdfs:comment "Hour of day (UTC, 0–23) at which cargo theft risk returns to baseline in this zone. Forms the end of the time-of-day risk window with peakTheftStartHour. When peakTheftEndHour < peakTheftStartHour, the window spans midnight (e.g., start=22, end=4 covers 10 PM to 4 AM)."@en .

uko:theftHotspotSourceDataset rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CargoTheftHotspotZone ;
    rdfs:range xsd:string ;
    rdfs:label "theft hotspot source dataset"@en ;
    rdfs:comment "Primary data source(s) used to characterize this theft hotspot zone. Controlled vocabulary (may be combined as comma-separated list): FBI_UCR (FBI Uniform Crime Reporting annual statistics), FREIGHTWAVES_SONAR (FreightWaves SONAR cargo theft incident feed), NICB (National Insurance Crime Bureau cargo theft report), INTERNAL_INCIDENT (fleet operator's own incident history — highest local precision), STATE_PATROL (state law enforcement cargo theft bulletin). Data source affects the confidence weight applied to theftRiskIntensity in the OHR R7 computation."@en .

uko:theftHotspotLastUpdated rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CargoTheftHotspotZone ;
    rdfs:range xsd:date ;
    rdfs:label "theft hotspot last updated"@en ;
    rdfs:comment "Date on which the theftRiskIntensity and sensitiveCargoClassList for this zone were last refreshed from source data. Zones not updated within the past 12 months should be flagged as potentially stale in the OHR feature pipeline and their R7 contribution confidence-discounted accordingly."@en .

uko:hasCargoTheftHotspot rdf:type owl:ObjectProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range uko:CargoTheftHotspotZone ;
    rdfs:label "has cargo theft hotspot"@en ;
    rdfs:comment "Links a uko:RoadSegment to any CargoTheftHotspotZone whose polygon contains or overlaps the segment. Populated during GKG construction by spatial intersection of segment geometries against CargoTheftHotspotZone polygons. Used for rapid R7 corridor exposure computation without requiring polygon intersection at inference time."@en .

uko:segmentTheftRiskScore rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "segment theft risk score"@en ;
    rdfs:comment "Convenience property storing the maximum theftRiskIntensity of any CargoTheftHotspotZone linked to this segment via uko:hasCargoTheftHotspot. Null if no CargoTheftHotspotZone intersects this segment. Enables rapid R7 route-level computation as a weighted sum of segmentTheftRiskScore × segment distance without traversing to CargoTheftHotspotZone instances."@en .
# =============================================================================
# UKO v15.4 CAUSAL EFFECT & EQUITY CLASSES (Subgraph 3 Extension)
# =============================================================================

uko:InfrastructureEffect rdf:type owl:Class ;
    rdfs:label "Infrastructure Effect"@en ;
    rdfs:comment "A quantified impact resulting from an infrastructure modification, used for causal reasoning."@en .

uko:CrashModificationFactor rdf:type owl:Class ;
    rdfs:subClassOf uko:InfrastructureEffect ;
    rdfs:label "Crash Modification Factor (CMF)"@en ;
    rdfs:comment "A multiplicative factor used to compute the expected number of crashes after implementing a countermeasure."@en .

uko:ModeShiftEffect rdf:type owl:Class ;
    rdfs:subClassOf uko:InfrastructureEffect ;
    rdfs:label "Mode Shift Effect"@en ;
    rdfs:comment "The quantified impact of an infrastructure change on mode share (e.g., auto to active transit shift)."@en .

uko:EquityImpact rdf:type owl:Class ;
    rdfs:subClassOf uko:InfrastructureEffect ;
    rdfs:label "Equity Impact"@en ;
    rdfs:comment "The quantified socio-economic or accessibility impact of an infrastructure change on priority equity populations."@en .

# =============================================================================
# UKO v15.4 STABLE PHYSICAL & NETWORK PROPERTIES (Promoted from Contracted)
# =============================================================================

# --- Road geometry and access ---

uko:roadClassification rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "road classification"@en ;
    rdfs:comment "Formal functional classification of the road segment."@en .

uko:permittedModalities rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "permitted modalities"@en ;
    rdfs:comment "Modes of transport legally permitted on this segment (e.g., 'pedestrian, bicycle, auto')."@en .

uko:parkingConfiguration rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "parking configuration"@en ;
    rdfs:comment "Physical configuration of parking (e.g., parallel, diagonal, none)."@en .

# --- Active mobility features ---

uko:bikeFacilityType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "bike facility type"@en .

uko:hasProtectedBikeLane rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has protected bike lane"@en .

uko:bikeLaneWidth rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "bike lane width"@en ;
    rdfs:comment "Width of the bike lane, typically in meters."@en .

uko:hasBuffer rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has buffer"@en ;
    rdfs:comment "Indicates if the bike lane or sidewalk has a physical or painted buffer from vehicle traffic."@en .

uko:bufferWidth rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "buffer width"@en ;
    rdfs:comment "Width of the buffer, typically in meters."@en .

uko:hasSidewalkBothSides rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has sidewalk both sides"@en .

uko:sidewalkCoverage rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "sidewalk coverage"@en ;
    rdfs:comment "Ratio or percentage of the segment length that is covered by sidewalks."@en .

uko:hasCrossing rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has crossing"@en .

uko:hasSignalizedCrossing rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has signalized crossing"@en .

uko:hasCurbRamps rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has curb ramps"@en .

uko:hasPHB rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has PHB"@en ;
    rdfs:comment "Indicates presence of a Pedestrian Hybrid Beacon on the segment."@en .

uko:hasRRFB rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has RRFB"@en ;
    rdfs:comment "Indicates presence of a Rectangular Rapid Flashing Beacon on the segment."@en .

uko:hasOnStreetParking rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "has on-street parking"@en .

# --- Network designations ---

uko:onHIN rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "on high injury network"@en ;
    rdfs:comment "Flag indicating if the segment belongs to the designated High Injury Network (HIN)."@en .

uko:onPSN rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:boolean ;
    rdfs:label "on pedestrian safety network"@en ;
    rdfs:comment "Flag indicating if the segment belongs to the Pedestrian Safety Network (PSN)."@en .

#################################################################
#    UKO v15.5.0 EXTENSIONS (coordinated release 2026-06-10)
#################################################################

# =============================================================================
# UKO v15.5 SECTION A: CAUSAL EFFECT LIBRARY — EFFECT-ATTRIBUTE COMPLEMENT
# (Architecture V12 Section 9.9: completes the v15.4 effect classes so that
#  GKG Subgraph 3 — Causal Effects — is fully ontology-generated. Until this
#  release the effect attributes were carried as a contracted complement
#  against a provisional schema.)
# =============================================================================

### A.1 Intervention type taxonomy ###

uko:InfrastructureInterventionType rdf:type owl:Class ;
    rdfs:label "Infrastructure Intervention Type"@en ;
    rdfs:comment "A countermeasure or infrastructure modification category whose causal effects are cataloged in the Causal Effect Library (GKG Subgraph 3). Members are named individuals so they can serve as TDL constraint vocabulary: every constraint value in a context package must resolve to a named individual, and the Causal Query Agent filters uko:InfrastructureEffect instances by intervention type using these individuals as literal filter values. The initial individual set is the candidate intervention set exercised by the CCTA Vision Zero worked trace (Architecture V12 Section 7); the set is extended by expert curation as the Causal Effect Library grows."@en .

uko:SignalizedPedestrianCrossing rdf:type owl:NamedIndividual, uko:InfrastructureInterventionType ;
    rdfs:label "Signalized Pedestrian Crossing"@en ;
    rdfs:comment "Installation of a signalized pedestrian crossing (full signal, PHB, or equivalent signalized control) at an uncontrolled or inadequately controlled crossing location."@en .

uko:SpeedTable rdf:type owl:NamedIndividual, uko:InfrastructureInterventionType ;
    rdfs:label "Speed Table"@en ;
    rdfs:comment "Installation of a speed table (flat-topped raised traffic-calming device, often combined with a raised crosswalk)."@en .

uko:CurbExtension rdf:type owl:NamedIndividual, uko:InfrastructureInterventionType ;
    rdfs:label "Curb Extension"@en ;
    rdfs:comment "Curb extension / bulb-out narrowing the roadway at a crossing to shorten pedestrian exposure distance and improve sight lines."@en .

uko:LeadingPedestrianInterval rdf:type owl:NamedIndividual, uko:InfrastructureInterventionType ;
    rdfs:label "Leading Pedestrian Interval"@en ;
    rdfs:comment "Signal-timing intervention giving pedestrians a walk indication 3-7 seconds before the parallel vehicular green."@en .

uko:RoadDiet rdf:type owl:NamedIndividual, uko:InfrastructureInterventionType ;
    rdfs:label "Road Diet"@en ;
    rdfs:comment "Roadway reconfiguration reducing the number of through travel lanes (classically 4-to-3 with a two-way left-turn lane), typically reallocating space to bicycle or pedestrian facilities."@en .

uko:EnhancedLighting rdf:type owl:NamedIndividual, uko:InfrastructureInterventionType ;
    rdfs:label "Enhanced Lighting"@en ;
    rdfs:comment "Upgrade of roadway or intersection lighting (new luminaires, higher uniformity, crossing-focused illumination). Post-implementation state is captured quantitatively by uko:streetlightCoverage."@en .

### A.2 Entity sets (effect application scope) ###

uko:EntitySet rdf:type owl:Class ;
    rdfs:label "Entity Set"@en ;
    rdfs:comment "A named, durable collection of GKG entities (typically RoadSegment or IntersectionNode instances) that an analysis identifies and that downstream reasoning treats as a unit - e.g., the set of High Injury Network entities an InfrastructureEffect applies to. EntitySet instances are produced by Knowledge Agents (most commonly the GKG Reasoner Agent) and referenced by uko:affectsEntitySet on InfrastructureEffect and by Working Context entries in the Task Dependency Graph."@en .

uko:hasMemberEntity rdf:type owl:ObjectProperty ;
    rdfs:domain uko:EntitySet ;
    rdfs:range uko:GeographicFeature ;
    rdfs:label "has member entity"@en ;
    rdfs:comment "Links an EntitySet to one of its member entities. Multiple values expected."@en .

uko:entitySetSelectionCriteria rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:EntitySet ;
    rdfs:range xsd:string ;
    rdfs:label "entity set selection criteria"@en ;
    rdfs:comment "Serialized record of the selection criteria that produced this set (constraint vocabulary terms and parameter values, e.g., incidentDensityScore percentile=90, jurisdiction URNs). Stored for provenance so the set is reproducible."@en .

uko:HINSegmentSet rdf:type owl:Class ;
    rdfs:subClassOf uko:EntitySet ;
    rdfs:label "HIN Segment Set"@en ;
    rdfs:comment "An EntitySet whose members are uko:RoadSegment instances identified as High Injury Network members for a given analysis scope (e.g., top-decile incidentDensityScore across the five jurisdictions). Registry output schema type for HIN identification tasks (Architecture V12 Section 7 worked trace, Step 1)."@en .

uko:HINIntersectionSet rdf:type owl:Class ;
    rdfs:subClassOf uko:EntitySet ;
    rdfs:label "HIN Intersection Set"@en ;
    rdfs:comment "An EntitySet whose members are uko:IntersectionNode instances identified as High Injury Network members for a given analysis scope. Registry output schema type for HIN identification tasks."@en .

### A.3 Effect attribute datatype properties (domain: uko:InfrastructureEffect) ###

uko:effectSize rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range xsd:decimal ;
    rdfs:label "effect size"@en ;
    rdfs:comment "The point estimate of the effect. Interpretation is subclass-specific: for CrashModificationFactor this is the multiplicative CMF (expected crashes after = CMF x expected crashes before; values below 1.0 indicate a reduction); for ModeShiftEffect it is the expected mode-share change in percentage points for the mode named in uko:effectTargetDescriptor; for EquityImpact it is the change in the named accessibility or burden metric."@en .

uko:effectStandardError rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range xsd:decimal ;
    rdfs:label "effect standard error"@en ;
    rdfs:comment "Standard error of the effect-size estimate, as reported by the source study or clearinghouse. Null when the source reports only an interval."@en .

uko:confidenceIntervalLow rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range xsd:decimal ;
    rdfs:label "confidence interval low"@en ;
    rdfs:comment "Lower bound of the confidence interval on the effect size, at the level given by uko:confidenceLevel."@en .

uko:confidenceIntervalHigh rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range xsd:decimal ;
    rdfs:label "confidence interval high"@en ;
    rdfs:comment "Upper bound of the confidence interval on the effect size, at the level given by uko:confidenceLevel."@en .

uko:confidenceLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range xsd:decimal ;
    rdfs:label "confidence level"@en ;
    rdfs:comment "Confidence level of the reported interval as a fraction (e.g., 0.95). Defaults to 0.95 when the source does not state it."@en .

uko:effectTargetDescriptor rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range xsd:string ;
    rdfs:label "effect target descriptor"@en ;
    rdfs:comment "Controlled-vocabulary descriptor of what the effect size measures: for CMFs, the collision group and severity scope (e.g., PEDESTRIAN_ALL_SEVERITIES, NIGHTTIME_INJURY); for mode-shift effects, the gaining mode (e.g., MODE_BICYCLE, MODE_WALK, MODE_TRANSIT); for equity impacts, the metric (e.g., JOB_ACCESSIBILITY_TRANSIT_45MIN, PM25_EXPOSURE)."@en .

uko:applicableFacilityContext rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range xsd:string ;
    rdfs:label "applicable facility context"@en ;
    rdfs:comment "The facility conditions under which the effect estimate is valid (functional classification, lane count range, speed range, area type), expressed in constraint vocabulary terms (e.g., PRINCIPAL_ARTERIAL; postedSpeed 30-40 mph; urban). The Causal Query Agent uses this field to reject effect instances whose study context does not match the target entity."@en .

uko:cmfStarRating rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CrashModificationFactor ;
    rdfs:range xsd:integer ;
    rdfs:label "CMF star quality rating"@en ;
    rdfs:comment "FHWA CMF Clearinghouse star quality rating (1-5) for the source study, when the CMF is Clearinghouse-sourced. Used by the Intervention Simulator to weight or filter competing CMF instances."@en .

uko:effectSourceCitation rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range xsd:string ;
    rdfs:label "effect source citation"@en ;
    rdfs:comment "Full citation of the authoritative source (study, clearinghouse record ID, or meta-analysis) from which this effect instance was curated. Required: the Causal Effect Library is populated only by expert curation from authoritative literature (never by the automated Learning Mode cycle), and every effect instance must be auditable to its source. This field is the provenance anchor for the explainability rationale behind public-spending recommendations."@en .

uko:curatedDate rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range xsd:date ;
    rdfs:label "curated date"@en ;
    rdfs:comment "Date this effect instance was last reviewed or updated by expert curation."@en .

### A.4 Effect linkage object properties ###

uko:appliesToInterventionType rdf:type owl:ObjectProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range uko:InfrastructureInterventionType ;
    rdfs:label "applies to intervention type"@en ;
    rdfs:comment "Links an effect instance to the intervention type whose implementation produces it. The (intervention type, entity) pair is the lookup key the Causal Query Agent uses against Subgraph 3."@en .

uko:affectsEntitySet rdf:type owl:ObjectProperty ;
    rdfs:domain uko:InfrastructureEffect ;
    rdfs:range uko:EntitySet ;
    rdfs:label "affects entity set"@en ;
    rdfs:comment "Links an effect instance to the EntitySet of GKG entities to which it has been scoped in an analysis (e.g., the HIN entity set of a Vision Zero study). For library-resident effects not yet scoped to a study, this property is absent and uko:applicableFacilityContext alone governs applicability."@en .

# =============================================================================
# UKO v15.5 SECTION B: ANALYSIS PRODUCT CLASSES
# (Formalizes the Knowledge Agent Registry output schema references used
#  throughout Architecture V12 Sections 5 and 7. Registry entries declare
#  output types as ontology types, e.g., uko:SegmentRiskProfile[]; these
#  classes make those references resolvable.)
# =============================================================================

uko:AnalysisProduct rdf:type owl:Class ;
    rdfs:label "Analysis Product"@en ;
    rdfs:comment "A structured, typed result record produced by a Knowledge Agent and written to the Working Context under a task_id. AnalysisProduct instances are transient relative to the durable GKG: they live in Analysis Threads and episodic memory (PSEM) chains, not in the materialized subgraphs, but their types are ontology-governed so that agent output contracts are formally checkable."@en .

uko:derivedFromEntity rdf:type owl:ObjectProperty ;
    rdfs:domain uko:AnalysisProduct ;
    rdfs:range uko:GeographicFeature ;
    rdfs:label "derived from entity"@en ;
    rdfs:comment "The GKG entity this product record describes (typically a RoadSegment or IntersectionNode)."@en .

uko:computedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:AnalysisProduct ;
    rdfs:range xsd:dateTime ;
    rdfs:label "computed at"@en ;
    rdfs:comment "Timestamp at which the producing agent computed this record."@en .

uko:producingAgentId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:AnalysisProduct ;
    rdfs:range xsd:string ;
    rdfs:label "producing agent id"@en ;
    rdfs:comment "Knowledge Agent Registry identifier of the agent that produced this record, for Working Context provenance."@en .

uko:SegmentRiskProfile rdf:type owl:Class ;
    rdfs:subClassOf uko:AnalysisProduct ;
    rdfs:label "Segment Risk Profile"@en ;
    rdfs:comment "Per-segment risk characterization product: the segment reference plus the risk-relevant attribute bundle (incident density, conflict and PCF distributions, severity distribution, compound-condition risk entries) assembled for a specific analysis scope. Registry output schema type (e.g., uko:SegmentRiskProfile[]) for segment risk characterization tasks."@en .

uko:VulnerableExposureProfile rdf:type owl:Class ;
    rdfs:subClassOf uko:AnalysisProduct ;
    rdfs:label "Vulnerable Exposure Profile"@en ;
    rdfs:comment "Per-entity vulnerable-population exposure product: nearby vulnerable-population POIs (schools, senior centers, hospitals, healthcare facilities) within a buffer distance, joined with the entity's vulnerableRoadUserConflictFraction. Output schema type for vulnerable-exposure retrieval tasks (Architecture V12 Section 7 worked trace, Step 2)."@en .

uko:EquityImpactScore rdf:type owl:Class ;
    rdfs:subClassOf uko:AnalysisProduct ;
    rdfs:label "Equity Impact Score"@en ;
    rdfs:comment "Per-entity equity weighting product computed by the Equity Impact Scorer Agent from census-layer demographic features (zero-vehicle household density, vulnerability index, transit access). Distinct from uko:EquityImpact: EquityImpact is a curated causal-effect class in the Causal Effect Library (the consequence of an intervention), whereas EquityImpactScore is a computed prioritization weight for an entity in an analysis. Output schema type uko:EquityImpactScore[] (Architecture V12 Section 7 worked trace, Step 3)."@en .

uko:equityScoreValue rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:EquityImpactScore ;
    rdfs:range xsd:decimal ;
    rdfs:label "equity score value"@en ;
    rdfs:comment "The computed equity weight (normalized 0.0-1.0 within the analysis scope; higher values indicate higher-priority equity populations)."@en .

# =============================================================================
# UKO v15.5 SECTION C: VULNERABLE ROAD USER CONFLICT FRACTION
# =============================================================================

uko:vulnerableRoadUserConflictFraction rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( uko:IntersectionNode uko:RoadSegment ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "vulnerable road user conflict fraction"@en ;
    rdfs:comment "Convenience property: the fraction (0.0-1.0) of recorded conflicts at this entity that involve a vulnerable road user. Clean derivation: the sum of the Vehicle-Pedestrian and Vehicle-Bicycle fractions of the entity's conflict-distribution map (uko:segmentVehicleConflictDistribution and the intersection conflict distribution). Materialized at Stage 5 alongside its source distributions; declared formally so it can serve as TDL constraint vocabulary and as a registry-referenced retrieval target (Architecture V12 Section 7 worked trace, Step 2)."@en .

# =============================================================================
# UKO v15.5 SECTION D: EQUITY AND AIR-QUALITY BUNDLE
# (Greenfield additions; data sources: LEHD/LODES, CARB air quality
#  monitoring, CNT Housing + Transportation Affordability Index, ACS.)
# =============================================================================

uko:withinCensusTract rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf uko:within ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:CensusTract ;
    rdfs:label "within census tract"@en ;
    rdfs:comment "Containment relation linking a feature to the census tract that contains it (centroid containment for linear features that span tract boundaries, with the dominant-length tract used as the single value). Primary join relation for census-layer feature retrieval and a relation the SPECTRA relational-attention mechanism conditions on when forming tract-context representations."@en .

uko:hasJurisdiction rdf:type owl:ObjectProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range uko:AdministrativeArea ;
    rdfs:label "has jurisdiction"@en ;
    rdfs:comment "Links a feature to the administrative area (typically a uko:City or uko:County) with jurisdictional authority over it. This is the jurisdiction-filter relation the GKG Reasoner Agent applies when a TDL constraint scopes an analysis to named jurisdictions (e.g., the five-cities filter resolving to five uko:City URNs)."@en .

uko:jobAccessibility rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:integer ;
    rdfs:label "job accessibility"@en ;
    rdfs:comment "Number of jobs reachable from the tract within a 45-minute transit travel-time threshold, computed from LEHD/LODES workplace-area employment joined to the transit network. Primary equity metric for the Equity Impact Scorer (Model 4) and a target metric for EquityImpact effect instances (effectTargetDescriptor JOB_ACCESSIBILITY_TRANSIT_45MIN). Refreshed with each LODES vintage by the GKG Updater."@en .

uko:pm25Concentration rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:decimal ;
    rdfs:label "PM2.5 concentration"@en ;
    rdfs:comment "Annual mean PM2.5 concentration in micrograms per cubic meter assigned to the tract from CARB air-quality monitoring (interpolated from monitor sites). Static exposure baseline; episodic elevations (wildfire smoke, regional wind transport into the target geography) are modeled as live reo:AirQualityEvent instances in REO, not as changes to this property."@en .

uko:zeroVehicleHouseholdDensity rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:decimal ;
    rdfs:label "zero-vehicle household density"@en ;
    rdfs:comment "Fraction (0.0-1.0) of households in the tract with no vehicle available (ACS). Demographic feature consumed by the Equity Impact Scorer Agent."@en .

uko:vulnerabilityIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:decimal ;
    rdfs:label "vulnerability index"@en ;
    rdfs:comment "Composite social-vulnerability index for the tract (normalized 0.0-1.0), assembled from income, age, disability, language-isolation, and vehicle-access indicators per the configured index methodology. Demographic feature consumed by the Equity Impact Scorer Agent."@en .

uko:htAffordabilityIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:CensusTract ;
    rdfs:range xsd:decimal ;
    rdfs:label "H+T affordability index"@en ;
    rdfs:comment "CNT Housing and Transportation (H+T) Affordability Index value for the tract: combined housing and transportation costs as a percentage of representative household income. Values above 45 indicate cost-burdened locations. Feeds affordability and equity analyses; GTFS Fares v2 fare products (Section H) provide the transit-fare component for scenario recomputation."@en .

# =============================================================================
# UKO v15.5 SECTION E: ROAD FUNCTIONAL CLASSIFICATION TAXONOMY
# (Constraint-vocabulary grounding. uko:roadClassification remains a string-
#  valued materialized column; these named individuals exist so that TDL
#  constraint fields - which must resolve to named individuals, never free
#  strings - can reference classifications such as uko:PRINCIPAL_ARTERIAL.
#  The controlled vocabulary matches the value set already used by
#  uko:roadClassification and tko:stopSegmentClass.)
# =============================================================================

uko:RoadFunctionalClassification rdf:type owl:Class ;
    rdfs:label "Road Functional Classification"@en ;
    rdfs:comment "Enumeration class for road functional classifications. Members are the named individuals corresponding to the controlled vocabulary of uko:roadClassification."@en .

uko:SURFACE_HIGHWAY rdf:type owl:NamedIndividual, uko:RoadFunctionalClassification ;
    rdfs:label "Surface Highway"@en .

uko:PRINCIPAL_ARTERIAL rdf:type owl:NamedIndividual, uko:RoadFunctionalClassification ;
    rdfs:label "Principal Arterial"@en .

uko:MAJOR_ARTERIAL rdf:type owl:NamedIndividual, uko:RoadFunctionalClassification ;
    rdfs:label "Major Arterial"@en .

uko:MINOR_ARTERIAL rdf:type owl:NamedIndividual, uko:RoadFunctionalClassification ;
    rdfs:label "Minor Arterial"@en .

uko:COLLECTOR rdf:type owl:NamedIndividual, uko:RoadFunctionalClassification ;
    rdfs:label "Collector"@en .

uko:LOCAL rdf:type owl:NamedIndividual, uko:RoadFunctionalClassification ;
    rdfs:label "Local Street"@en .

# =============================================================================
# UKO v15.5 SECTION F: ACTIVE-MOBILITY SAFETY — QUANTITATIVE LIGHTING
# (Sevtsuk/Basu active-mobility safety bundle. Replaces the deprecated
#  boolean uko:hasStreetLighting and the reified uko:LightingConcern.)
# =============================================================================

uko:streetlightCoverage rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( uko:RoadSegment uko:PedestrianNetworkEdge ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "streetlight coverage"@en ;
    rdfs:comment "Fraction (0.0-1.0) of the facility length within the illuminated buffer of a streetlight, computed from municipal streetlight inventories (or OSM lit tags where inventories are unavailable) at Stage 3 pedestrian-multiplex assembly. Replaces the deprecated boolean uko:hasStreetLighting and the deprecated uko:LightingConcern class: presence is derivable as coverage greater than 0, and a lighting concern corresponds to coverage below the facility-class threshold. Primary input to the Active Mobility Safety Score Agent for nighttime pedestrian route safety scoring."@en .

# =============================================================================
# UKO v15.5 SECTION G: SHARED MOBILITY (GBFS / MDS)
# (USDOT multimodal-standards review, June 10, 2026. GBFS supplies station
#  and availability data; MDS supplies provider B2G trip and policy data with
#  the cities as data owners. Feeds the Demand Forecaster - Model 5 - and the
#  Equity Impact Scorer - Model 4 - for first/last-mile and mode-shift
#  analyses. Document-side edits in Sections 9.2/9.3 follow this ontology
#  release per the ontology-first sequencing rule.)
# =============================================================================

### G.1 Systems, stations, and policy zones ###

uko:SharedMobilitySystem rdf:type owl:Class ;
    rdfs:label "Shared Mobility System"@en ;
    rdfs:comment "A shared-mobility service system (bikeshare, e-bike share, scooter share, carshare) operated by a provider within the geofence, as described by a GBFS system_information feed and/or registered as an MDS provider with the jurisdiction."@en .

uko:SharedMobilityStation rdf:type owl:Class ;
    rdfs:subClassOf uko:PointOfInterest ;
    rdfs:label "Shared Mobility Station"@en ;
    rdfs:comment "A docking station, designated parking hub, or virtual station of a shared-mobility system (GBFS station_information). Superclass of the pre-existing uko:BikeShareStation (re-parented at v15.5.0). Stations are multiplex-graph access points in the UNA sense and should carry uko:hasAccessPoint linkage where they mediate pedestrian-to-vehicle layer transfers."@en .

uko:ScooterShareStation rdf:type owl:Class ;
    rdfs:subClassOf uko:SharedMobilityStation ;
    rdfs:label "Scooter Share Station"@en ;
    rdfs:comment "A designated scooter-share parking station or corral."@en .

uko:CarShareStation rdf:type owl:Class ;
    rdfs:subClassOf uko:SharedMobilityStation ;
    rdfs:label "Car Share Station"@en ;
    rdfs:comment "A designated carshare pod or station."@en .

uko:MobilityPolicyZone rdf:type owl:Class ;
    rdfs:subClassOf uko:ConceptualArea ;
    rdfs:label "Mobility Policy Zone"@en ;
    rdfs:comment "A geofenced area subject to a jurisdiction-issued shared-mobility policy published via the MDS Policy API: no-ride zones, slow-ride (speed-cap) zones, no-parking zones, preferred-parking zones, and vehicle-cap distribution zones. Cities are the data owner; zones are ingested from the jurisdiction MDS feed and refreshed by the GKG Updater."@en .

uko:policyZoneType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:MobilityPolicyZone ;
    rdfs:range xsd:string ;
    rdfs:label "policy zone type"@en ;
    rdfs:comment "Controlled vocabulary: NO_RIDE, SLOW_RIDE, NO_PARKING, PREFERRED_PARKING, VEHICLE_CAP."@en .

uko:operatedBySystem rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SharedMobilityStation ;
    rdfs:range uko:SharedMobilitySystem ;
    rdfs:label "operated by system"@en ;
    rdfs:comment "Links a station to the shared-mobility system that operates it."@en .

### G.2 Vehicle-type taxonomy (GBFS vehicle_types form factors) ###

uko:SharedMobilityVehicleType rdf:type owl:Class ;
    rdfs:label "Shared Mobility Vehicle Type"@en ;
    rdfs:comment "Enumeration class for shared-mobility vehicle form factors, aligned with the GBFS vehicle_types form_factor and propulsion_type fields. Named individuals serve as TDL constraint vocabulary for mode-shift and first/last-mile analyses."@en .

uko:SHARED_BICYCLE rdf:type owl:NamedIndividual, uko:SharedMobilityVehicleType ;
    rdfs:label "Shared Bicycle (human propulsion)"@en .

uko:SHARED_EBIKE rdf:type owl:NamedIndividual, uko:SharedMobilityVehicleType ;
    rdfs:label "Shared E-Bike (electric assist)"@en .

uko:SHARED_SCOOTER rdf:type owl:NamedIndividual, uko:SharedMobilityVehicleType ;
    rdfs:label "Shared Standing Scooter (electric)"@en .

uko:SHARED_SEATED_SCOOTER rdf:type owl:NamedIndividual, uko:SharedMobilityVehicleType ;
    rdfs:label "Shared Seated Scooter / Moped"@en .

uko:SHARED_CAR rdf:type owl:NamedIndividual, uko:SharedMobilityVehicleType ;
    rdfs:label "Shared Car (carshare)"@en .

### G.3 GBFS / MDS identifier and availability properties ###

uko:gbfsSystemId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SharedMobilitySystem ;
    rdfs:range xsd:string ;
    rdfs:label "GBFS system id"@en ;
    rdfs:comment "GBFS system_id of the feed describing this system."@en .

uko:mdsProviderId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SharedMobilitySystem ;
    rdfs:range xsd:string ;
    rdfs:label "MDS provider id"@en ;
    rdfs:comment "MDS provider UUID registered with the jurisdiction, joining this system to the city-owned MDS trip and policy feeds."@en .

uko:gbfsStationId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SharedMobilityStation ;
    rdfs:range xsd:string ;
    rdfs:label "GBFS station id"@en ;
    rdfs:comment "GBFS station_id (station_information / station_status join key)."@en .

uko:servesVehicleType rdf:type owl:ObjectProperty ;
    rdfs:domain uko:SharedMobilityStation ;
    rdfs:range uko:SharedMobilityVehicleType ;
    rdfs:label "serves vehicle type"@en ;
    rdfs:comment "Vehicle form factor(s) available at this station. Multiple values permitted."@en .

uko:stationCapacity rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SharedMobilityStation ;
    rdfs:range xsd:integer ;
    rdfs:label "station capacity"@en ;
    rdfs:comment "Total dock or parking capacity of the station (GBFS capacity). Static attribute."@en .

uko:isVirtualStation rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SharedMobilityStation ;
    rdfs:range xsd:boolean ;
    rdfs:label "is virtual station"@en ;
    rdfs:comment "True when the station is a geofenced virtual station (free-floating parking area) rather than a physical dock (GBFS is_virtual_station)."@en .

uko:vehiclesAvailable rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SharedMobilityStation ;
    rdfs:range xsd:integer ;
    rdfs:label "vehicles available"@en ;
    rdfs:comment "Current number of rentable vehicles at the station (GBFS station_status num_vehicles_available). Real-time attribute in the style of the Part 3 real-time transit classes: values are feed-refreshed state, not durable ontology facts; planning analytics consume time-bucketed aggregates materialized by the analytics passes."@en .

uko:docksAvailable rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:SharedMobilityStation ;
    rdfs:range xsd:integer ;
    rdfs:label "docks available"@en ;
    rdfs:comment "Current number of open docks at the station (GBFS station_status num_docks_available). Real-time attribute; see uko:vehiclesAvailable note."@en .

# =============================================================================
# UKO v15.5 SECTION H: GTFS PATHWAYS AND FARES V2 EXTENSIONS
# (USDOT multimodal-standards review. Pathways adds in-station pedestrian
#  transfer edges - direct synergy with the v15.4 UNA pedestrian multiplex.
#  Fares v2 supplies the fare component for affordability and equity work.)
# =============================================================================

### H.1 GTFS Pathways ###

uko:StationPathway rdf:type owl:Class ;
    rdfs:subClassOf uko:PedestrianNetworkEdge ;
    rdfs:label "Station Pathway"@en ;
    rdfs:comment "An in-station pedestrian pathway from GTFS pathways.txt: a traversable edge connecting station sub-locations (platforms, entrances, generic nodes) through walkways, stairs, escalators, elevators, and fare gates. As a PedestrianNetworkEdge subclass, station pathways extend the UNA pedestrian multiplex inside transit stations, closing the gap between street-level uko:AccessPoint linkage and platform-level boarding locations."@en .

uko:gtfsPathwayId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:StationPathway ;
    rdfs:range xsd:string ;
    rdfs:label "GTFS pathway id"@en ;
    rdfs:comment "GTFS pathway_id."@en .

uko:pathwayMode rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:StationPathway ;
    rdfs:range xsd:string ;
    rdfs:label "pathway mode"@en ;
    rdfs:comment "Controlled vocabulary per GTFS pathway_mode: WALKWAY, STAIRS, MOVING_SIDEWALK, ESCALATOR, ELEVATOR, FARE_GATE, EXIT_GATE."@en .

uko:pathwayFromStop rdf:type owl:ObjectProperty ;
    rdfs:domain uko:StationPathway ;
    rdfs:range uko:TransitStop ;
    rdfs:label "pathway from stop"@en ;
    rdfs:comment "Origin stop/platform/entrance node of the pathway (GTFS from_stop_id)."@en .

uko:pathwayToStop rdf:type owl:ObjectProperty ;
    rdfs:domain uko:StationPathway ;
    rdfs:range uko:TransitStop ;
    rdfs:label "pathway to stop"@en ;
    rdfs:comment "Destination stop/platform/entrance node of the pathway (GTFS to_stop_id)."@en .

uko:isBidirectional rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:StationPathway ;
    rdfs:range xsd:boolean ;
    rdfs:label "is bidirectional"@en ;
    rdfs:comment "True when the pathway is traversable in both directions (GTFS is_bidirectional)."@en .

uko:pathwayTraversalTimeSeconds rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:StationPathway ;
    rdfs:range xsd:integer ;
    rdfs:label "pathway traversal time seconds"@en ;
    rdfs:comment "Average traversal time in seconds (GTFS traversal_time), used as the edge weight for in-station pedestrian routing and walkshed computation."@en .

uko:pathwayIsWheelchairAccessible rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:StationPathway ;
    rdfs:range xsd:boolean ;
    rdfs:label "pathway is wheelchair accessible"@en ;
    rdfs:comment "True when the pathway is usable by wheelchair (derived: pathway_mode is not STAIRS, and stair_count/max_slope constraints are satisfied). Supports accessibility-constrained multiplex routing."@en .

### H.2 GTFS Fares v2 ###

uko:FareProduct rdf:type owl:Class ;
    rdfs:label "Fare Product"@en ;
    rdfs:comment "A purchasable fare product from GTFS Fares v2 fare_products.txt (single ride, day pass, monthly pass, reduced-fare variants). Complements the legacy v1 uko:FareAttribute / uko:FareRule classes, which are retained for feeds not yet publishing Fares v2. Fare products supply the transit-cost component of affordability analyses (uko:htAffordabilityIndex scenario recomputation) and equity-fare-burden metrics."@en .

uko:fareProductId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:FareProduct ;
    rdfs:range xsd:string ;
    rdfs:label "fare product id"@en ;
    rdfs:comment "GTFS fare_product_id."@en .

uko:fareProductName rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:FareProduct ;
    rdfs:range xsd:string ;
    rdfs:label "fare product name"@en ;
    rdfs:comment "Rider-facing fare product name (GTFS fare_product_name)."@en .

uko:fareAmount rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:FareProduct ;
    rdfs:range xsd:decimal ;
    rdfs:label "fare amount"@en ;
    rdfs:comment "Cost of the fare product (GTFS amount), in the currency given by uko:fareCurrency."@en .

uko:fareCurrency rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:FareProduct ;
    rdfs:range xsd:string ;
    rdfs:label "fare currency"@en ;
    rdfs:comment "ISO 4217 currency code of the fare amount (GTFS currency)."@en .

uko:fareMediaType rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:FareProduct ;
    rdfs:range xsd:string ;
    rdfs:label "fare media type"@en ;
    rdfs:comment "Fare media on which the product is sold (GTFS fare_media): controlled vocabulary NONE, PAPER_TICKET, TRANSIT_CARD, CONTACTLESS_EMV, MOBILE_APP."@en .

uko:fareProductOfAgency rdf:type owl:ObjectProperty ;
    rdfs:domain uko:FareProduct ;
    rdfs:range uko:TransitAgency ;
    rdfs:label "fare product of agency"@en ;
    rdfs:comment "The transit agency offering this fare product."@en .

# =============================================================================
# UKO v15.5 SECTION I: TRANSIT PERFORMANCE — BLENDED ON-TIME PERFORMANCE
# =============================================================================

uko:effectiveOnTimePerformance rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( uko:TransitStop uko:TransitRoute ) ] ;
    rdfs:range xsd:decimal ;
    rdfs:label "effective on-time performance"@en ;
    rdfs:comment "Blended schedule-adherence metric (0.0-1.0) attached to transit stops and routes in GKG Subgraph 4, combining GTFS-static schedules with observed GTFS-RT adherence over a 28-day rolling window. When the Mosaiq GPTI source is confirmed and enabled, its daily-refreshed on-time performance is blended in as a third component; until then the value blends GTFS-static and GTFS-RT only. Values are refresh-window outputs maintained by the GKG Updater, not durable ontology facts."@en .

# =============================================================================
# UKO v15.5 SECTION J: STAGE-3 JOIN PROPERTIES (FORMALIZED)
# (These three properties were referenced by the TLP Stage 3 GKG property
#  joins - Architecture V12 Section 10.4.1 - without a formal declaration.
#  They are declared here so the NebulaGraph schema generator emits their
#  columns from the ontology. elevationGradient and dedicatedLane are stable
#  physical attributes in the spirit of the v15.4 promotions;
#  speedDistributionByHour is declared for schema-generation completeness but
#  its VALUES remain analytics-pass outputs, exactly as for the nine
#  Appendix A contracted analytics, and must record their producing-stage
#  version.)
# =============================================================================

uko:elevationGradient rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "elevation gradient"@en ;
    rdfs:comment "Serialized elevation profile of the segment: ordered list of (distance-fraction, grade-percent) pairs, with the peak grade recoverable as the maximum absolute grade entry. Source: DEM sampling along the segment geometry at Stage 1. Consumed by Grade Risk Score computations (deferred OHR Model 11) and by energy/effort-aware active-mobility analyses."@en .

uko:dedicatedLane rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "dedicated lane designation"@en ;
    rdfs:comment "Dedicated-lane designation on the segment. Controlled vocabulary: NONE, BUS_ONLY, HOV, BIKE, TRUCK_CLIMBING, SHOULDER_RUNNING. Stable physical attribute materialized at Stage 1 from source tags."@en .

uko:speedDistributionByHour rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "speed distribution by hour"@en ;
    rdfs:comment "Serialized 24-bin hour-of-day map of observed speed distribution summaries (per-bin p15/p50/p85) for the segment. NOTE: like the nine Appendix A contracted analytics, the values of this property are volatile analytics-pass outputs recomputed every refresh and versioned by producing stage; the property is declared formally only so the Stage 3 join column is ontology-emitted. Consumed by the Driver Behavior Risk Scorer speed-variability computations."@en .

# =============================================================================
# UKO v15.5 SECTION K: EXTERNAL ENTITY REFERENCES (OVERTURE GERS)
# =============================================================================

uko:gersId rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:GeographicFeature ;
    rdfs:range xsd:string ;
    rdfs:label "GERS id"@en ;
    rdfs:comment "Overture Maps Global Entity Reference System (GERS) identifier carried by entities sourced or conflated from Overture themes. Stored as a joinable attribute, never as the entity VID: the urn:urban-kg: identifier is immutable while GERS IDs exhibit release-over-release churn on the order of 20 percent. Enables key-join merges of Overture attribute refreshes and GERS-tagged external datasets, re-synced on each Overture release by the GKG Updater. Formalized at v15.5.0 per the Architecture V12 Section 9 deferral note; previously materialized as a contracted attribute."@en .

# =============================================================================
# UKO v15.5 SECTION L: OPERATIONAL ROUTING CONSTRAINTS
# (Fold-in of the v15.4.1 patch, applied at v15.5.0 for ontology integrity.
#  Resolves the dangling reference from REO: reo:ChainControlIssuanceEvent
#  describes itself as the live-event counterpart of
#  uko:WeatherConditionalOperationalConstraint, which was previously
#  undeclared. The constraint classes are primarily exercised by the deferred
#  fleet/OHR workstream; declaring them now keeps the cross-ontology
#  documentation sound and lets Stage 3 compute Chain Control Probability
#  features when fleet ingestion is activated. Tier vocabulary: R1/R2/R3
#  (no hyphens), matching reo:chainControlTier.)
# =============================================================================

uko:OperationalRoutingConstraint rdf:type owl:Class ;
    rdfs:label "Operational Routing Constraint"@en ;
    rdfs:comment "A durable, segment-anchored constraint on vehicle operations that conditions routing feasibility or cost without being a physical dimension limit (contrast uko:BridgeHeightConstraint and the GVW/clearance properties). Operational constraints are static possibilities attached to infrastructure - what CAN be imposed on a segment and under what authority - whereas the corresponding live impositions are REO events. Subclasses partition by triggering condition."@en .

uko:WeatherConditionalOperationalConstraint rdf:type owl:Class ;
    rdfs:subClassOf uko:OperationalRoutingConstraint ;
    rdfs:label "Weather-Conditional Operational Constraint"@en ;
    rdfs:comment "An operational constraint whose imposition is conditioned on weather state: chain control / traction requirements on mountain-pass segments, wind-based high-profile vehicle restrictions on exposed bridges, and seasonal closure regimes. This class models the static possibility (the segment is subject to chain control between November and April under Caltrans authority); the live counterpart recording an actual imposition is the corresponding REO event (for chain control, reo:ChainControlIssuanceEvent - referenced here descriptively only, preserving the acyclic import graph in which UKO imports nothing). Stage 3 feature augmentation uses these constraint instances plus historical imposition frequency to compute Chain Control Probability features for the deferred OHR model."@en .

uko:constrainsSegment rdf:type owl:ObjectProperty ;
    rdfs:domain uko:OperationalRoutingConstraint ;
    rdfs:range uko:RoadSegment ;
    rdfs:label "constrains segment"@en ;
    rdfs:comment "Links the constraint to a road segment it governs. Multiple values expected for corridor-scale constraints (e.g., the full Donner Pass chain-control corridor)."@en .

uko:maxConstraintTier rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WeatherConditionalOperationalConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "max constraint tier"@en ;
    rdfs:comment "The most severe traction tier historically imposed under this constraint. Controlled vocabulary per the California Traction Law tier scheme: R1 (traction devices required on drive axle - snow tires or chains), R2 (chains on all non-exempt vehicles; 4WD/AWD exemption), R3 (chains on ALL vehicles; most passes effectively closed to commercial traffic). Vocabulary intentionally identical to reo:chainControlTier (R1/R2/R3, unhyphenated) so static-constraint features and live-event attributes join without translation."@en .

uko:constraintSeasonStartMonth rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WeatherConditionalOperationalConstraint ;
    rdfs:range xsd:integer ;
    rdfs:label "constraint season start month"@en ;
    rdfs:comment "First month (1-12) of the season during which the constraint can be imposed (e.g., 11 for a November-April chain-control season)."@en .

uko:constraintSeasonEndMonth rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WeatherConditionalOperationalConstraint ;
    rdfs:range xsd:integer ;
    rdfs:label "constraint season end month"@en ;
    rdfs:comment "Last month (1-12) of the season during which the constraint can be imposed (e.g., 4 for a November-April chain-control season). Seasons may wrap the year boundary."@en .

uko:issuingAuthority rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:OperationalRoutingConstraint ;
    rdfs:range xsd:string ;
    rdfs:label "issuing authority"@en ;
    rdfs:comment "The authority empowered to impose the constraint (e.g., Caltrans District 3, NDOT, local jurisdiction)."@en .

uko:historicalImpositionFrequency rdf:type owl:DatatypeProperty ;
    rdfs:domain uko:WeatherConditionalOperationalConstraint ;
    rdfs:range xsd:decimal ;
    rdfs:label "historical imposition frequency"@en ;
    rdfs:comment "Fraction (0.0-1.0) of in-season days on which a tier was imposed under this constraint, over the trailing reference period. Input to Chain Control Probability feature computation at Stage 3."@en .

###############################################################################
#    END OF UKO v15.5.0 ONTOLOGY
###############################################################################
