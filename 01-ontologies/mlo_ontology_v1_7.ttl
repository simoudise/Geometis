###############################################################################
###############################################################################
#
#    MLO v1.2 EXTENSION: OUTCOME LABELS AND RISK TIER LABELS
#    Purpose: Retrospective trip outcome labels serving as the supervision
#             signal for OHR (Over-the-Horizon Risk) model training instances
#             (Instance Types 1 and 2). Per-dimension OHR tier assignments
#             as queryable MLO labels for training batch construction.
#
#    Design note: OutcomeLabel is a distinct subclass of LabelFamily, not a
#    subclass of the existing intent/behavioral label families. Intent labels
#    capture WHAT THE TRIP WAS FOR. Outcome labels capture WHAT ACTUALLY
#    HAPPENED. These are logically independent: a CommuteToWork trip can
#    have incident_occurred = true or false. They must not be conflated.
#
###############################################################################
###############################################################################

# =============================================================================
# Part 1: OutcomeLabel Family
# =============================================================================

mlo:OutcomeLabel rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Outcome Label Family"@en ;
    rdfs:comment "Label family for retrospective trip outcome labels. Outcome labels capture what actually happened during a completed trip and serve as the supervised learning targets (y) for OHR model training. They are distinct from intent labels (which capture trip purpose) and behavioral labels (which capture in-trip driving behavior). Outcome labels are assigned during TLP Stage 5 via the outcome label assignment pipeline, which cross-references ELD records, cargo claim systems, GPS analysis, and FMCSA incident reports."@en ;
    mlo:familyPersonaScope mlo:FleetManagementPersona .

# =============================================================================
# Part 2: OutcomeLabel LabelDefinition instances
# Six labels covering the full OHR supervision signal space.
# =============================================================================

mlo:ld_incident_occurred rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "incident_occurred" ;
    mlo:labelDescription "Binary outcome label. True if any reportable crash, near-miss logged by the driver, roadside inspection resulting in Out-of-Service (OOS) citation, or FMCSA-reportable accident occurred during this trip. This is the primary safety outcome label and the most important supervision signal for R1, R3, and R9 OHR dimensions. Source: FMCSA MCMIS crash query (geo-time join to trip), fleet incident report system, ELD safety event flags. Assigned post-trip by TLP Stage 5 outcome pipeline."@en ;
    mlo:hasLabelFamily mlo:OutcomeLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:boolean" ;
    mlo:pipelineStage "STAGE_5_OUTCOME" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_cargo_damage_loss rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "cargo_damage_loss" ;
    mlo:labelDescription "Binary outcome label. True if a cargo claim was filed for this trip OR if a temperature excursion (ld_temperature_excursion = true) resulted in documented cargo rejection or spoilage. The primary outcome label for R2 (Cargo Integrity Risk). Source: TMS cargo claim records (matched by trip_id and vehicle_id), reefer temperature log review for confirmed excursion-linked rejections. Note: a temperature excursion that did not result in cargo rejection yields ld_temperature_excursion = true but ld_cargo_damage_loss = false — the two labels are related but not equivalent."@en ;
    mlo:hasLabelFamily mlo:OutcomeLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:boolean" ;
    mlo:pipelineStage "STAGE_5_OUTCOME" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_significant_delay rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "significant_delay" ;
    mlo:labelDescription "Binary outcome label. True if the actual trip duration exceeded the planned duration by more than the configured threshold (default: 1.3× planned duration, i.e., 30% overrun). The primary outcome label for R4 (Congestion/Delay Risk) and R8 (Destination Risk). Computed from: actual arrival timestamp (GPS) minus planned arrival timestamp (TMS appointment record). The 1.3× threshold is fleet-configurable; time-sensitive cargo fleets (pharmaceutical, produce) may use 1.15× as their threshold. Source: TMS appointment record and GPS trip end timestamp."@en ;
    mlo:hasLabelFamily mlo:OutcomeLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:boolean" ;
    mlo:pipelineStage "STAGE_5_OUTCOME" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_hos_violation rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "hos_violation" ;
    mlo:labelDescription "Binary outcome label. True if the ELD records for this trip contain a logged Hours-of-Service violation — drive time exceeding the 11-hour limit, on-duty time exceeding the 14-hour window, 30-minute break requirement violated, or 7/8-day cycle exhaustion. The primary outcome label for R6 (Regulatory/Compliance Risk). Source: ELD platform HOS violation log (Motive, Samsara, Omnitracs API), matched to trip by vehicle_id and time window. Note: adverse_driving_condition invocations are recorded separately and do not constitute violations."@en ;
    mlo:hasLabelFamily mlo:OutcomeLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:boolean" ;
    mlo:pipelineStage "STAGE_5_OUTCOME" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "true"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_unplanned_stop_event rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "unplanned_stop_event" ;
    mlo:labelDescription "Binary outcome label. True if the GPS trace contains at least one stop event exceeding 30 minutes at a location that is not: (a) a planned delivery or pickup facility in the TMS route plan, (b) a designated truck parking or rest area (uko:TruckParkingFacility), or (c) a fuel station stop. Unplanned stops are a secondary signal for R9 (Mechanical Risk — potential breakdown) and R3 (Driver Fatigue — impromptu rest). The 30-minute threshold is configurable. Source: GPS stop extraction (TLP Stage 2) cross-referenced against TMS planned stops and GKG POI types."@en ;
    mlo:hasLabelFamily mlo:OutcomeLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:boolean" ;
    mlo:pipelineStage "STAGE_5_OUTCOME" ;
    mlo:requiresGKGLookup "true"^^xsd:boolean ;
    mlo:requiresTelematicsData "true"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_temperature_excursion rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "temperature_excursion" ;
    mlo:labelDescription "Binary outcome label. True if the reefer unit IoT temperature log for this trip records any continuous period exceeding 15 minutes where cargo compartment temperature was outside the declared temperature tolerance band (fko:FreightLoad.temperatureSetpointF ± fko:FreightLoad.temperatureToleranceBandF). This label is cargo-type-specific: it is only applicable when the trip has a tko:CargoProfile with temperatureControlled = true. For trips without temperature-controlled cargo, this label is null (not false). Source: Sensitech/Emerson cold chain IoT log, Thermo King or Carrier Transicold telematics API. Related to but distinct from ld_cargo_damage_loss: an excursion that was brief and corrected before cargo spoilage yields temperature_excursion = true, cargo_damage_loss = false."@en ;
    mlo:hasLabelFamily mlo:OutcomeLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:boolean" ;
    mlo:pipelineStage "STAGE_5_OUTCOME" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "true"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Part 3: RiskTierLabel Family
# Per-dimension OHR tier assignments as queryable MLO labels
# =============================================================================

mlo:RiskTierLabel rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Risk Tier Label Family"@en ;
    rdfs:comment "Label family for per-dimension OHR risk tier assignments on dispatched trips. A RiskTierLabel records the qualitative tier (LOW / MODERATE / ELEVATED / HIGH / CRITICAL) assigned to each of the nine OHR risk dimensions at a given computation point. Storing these as MLO labels makes them queryable through the standard label infrastructure: the same training batch construction queries used for intent and behavioral labels can also filter on risk tier. Used to: (1) construct training subsets stratified by risk tier; (2) generate fleet-level risk tier distribution reports; (3) support dispatcher retrospective review of tier accuracy."@en ;
    mlo:familyPersonaScope mlo:FleetManagementPersona .

mlo:ld_ohr_tier_r1 rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_tier_r1_weather_road" ;
    mlo:labelDescription "Risk tier label for R1 (Weather-Road Risk) on a dispatched trip's TripRiskVector. Values drawn from tko:RiskTier controlled vocabulary: LOW, MODERATE, ELEVATED, HIGH, CRITICAL. Populated by the FDA Standing Agent from the corresponding DimensionScore.dimensionRiskTier at each monitoring cycle. Stored as a trip-level MLO label to enable batch filtering (e.g., 'retrieve all trips where R1 tier was HIGH at departure time') for OHR model training."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:string" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_ohr_tier_r2 rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_tier_r2_cargo_integrity" ;
    mlo:labelDescription "Risk tier label for R2 (Cargo Integrity Risk). Applicable only when trip has tko:CargoProfile.temperatureControlled = true or fko:Commodity subclass includes fko:PerishableCargo or fko:HazmatCargo. Null for dry van standard freight."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:string" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_ohr_tier_r3 rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_tier_r3_driver_fatigue" ;
    mlo:labelDescription "Risk tier label for R3 (Driver Fatigue Risk). Derived from the Compound Fatigue Risk Score (HOS position × circadian time-of-day risk × cumulative duty hours). Particularly significant for night departures and end-of-week trip assignments."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:string" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "true"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_ohr_tier_r4 rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_tier_r4_congestion_delay" ;
    mlo:labelDescription "Risk tier label for R4 (Congestion/Delay Risk)."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:string" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_ohr_tier_r5 rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_tier_r5_infrastructure" ;
    mlo:labelDescription "Risk tier label for R5 (Infrastructure Risk). A CRITICAL tier on R5 indicates a hard constraint (weight, height, or route prohibition) that makes the planned route legally impassable and requires immediate reroute regardless of other risk factors."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:string" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "true"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_ohr_tier_r6 rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_tier_r6_regulatory_compliance" ;
    mlo:labelDescription "Risk tier label for R6 (Regulatory/Compliance Risk). HOS violation risk, weigh station compliance, and permit coverage."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:string" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "true"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_ohr_tier_r7 rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_tier_r7_security_theft" ;
    mlo:labelDescription "Risk tier label for R7 (Security/Theft Risk). Derived from uko:CargoTheftHotspotZone corridor exposure combined with cargo value tier and time-of-day theft probability."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:string" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "true"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_ohr_tier_r8 rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_tier_r8_destination" ;
    mlo:labelDescription "Risk tier label for R8 (Destination Risk). On-Time Delivery Probability, dock wait time forecast, HOS window at destination."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:string" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_ohr_tier_r9 rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_tier_r9_mechanical" ;
    mlo:labelDescription "Risk tier label for R9 (Mechanical Risk). En-route breakdown probability derived from vehicle health indicators: active fault codes, historical breakdown rate, days since last PM, tire pressure deviation."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:string" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "true"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_ohr_ctrs rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ohr_composite_trip_risk_score" ;
    mlo:labelDescription "Numeric label recording the Composite Trip Risk Score (CTRS) at departure time for a dispatched trip. Stored as an MLO label to enable fleet-level risk distribution analytics and model calibration reporting. Value range [0.0, 1.0]. The pre-departure CTRS is the version stored here; in-trip updates are tracked on the TripRiskVector directly."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:decimal" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_dispatcher_override rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "dispatcher_override" ;
    mlo:labelDescription "Binary label. True if the trip's DispatchDecision was a tko:DispatcherOverride instance — the dispatcher selected a route that was not the model recommendation. Used to filter the Instance Type 4 (Dispatcher Override) training dataset from the full trip population. Stored as an MLO label to enable override rate reporting and to surface override patterns to the fleet safety manager."@en ;
    mlo:hasLabelFamily mlo:RiskTierLabel ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:labelDataType "xsd:boolean" ;
    mlo:pipelineStage "STAGE_6_OHR" ;
    mlo:requiresGKGLookup "false"^^xsd:boolean ;
    mlo:requiresTelematicsData "false"^^xsd:boolean ;
    mlo:isDeprecated "false"^^xsd:boolean .

# =============================================================================
# Part 4: Bidirectional link closure for new labels
# =============================================================================

# OutcomeLabel instances are consumed by the OHR model (Instance Type 1 and 2
# training). The AnalyticsModel registry entries for the OHR model will be
# added when the model is formally registered in the SPNSLMAIS Model Registry.
# These bidirectional links will be completed at that time.
# Placeholder annotations are set here for discoverability.

mlo:ld_incident_occurred rdfs:comment "OHR training target for R1, R3, R9 dimensions. Bidirectional AnalyticsModel link to be completed when OHR model is registered."@en .
mlo:ld_cargo_damage_loss rdfs:comment "OHR training target for R2 dimension. Bidirectional AnalyticsModel link pending OHR model registration."@en .
mlo:ld_significant_delay rdfs:comment "OHR training target for R4, R8 dimensions. Bidirectional AnalyticsModel link pending OHR model registration."@en .
mlo:ld_hos_violation rdfs:comment "OHR training target for R6 dimension. Bidirectional AnalyticsModel link pending OHR model registration."@en .
mlo:ld_unplanned_stop_event rdfs:comment "OHR secondary training signal for R3, R9 dimensions. Bidirectional AnalyticsModel link pending OHR model registration."@en .
mlo:ld_temperature_excursion rdfs:comment "OHR training target for R2 dimension (reefer/pharma loads). Bidirectional AnalyticsModel link pending OHR model registration."@en .

#################################################################
#    MLO v1.6.0 EXTENSIONS (coordinated release 2026-06-10)
#################################################################

# =============================================================================
# MLO v1.6 SECTION A: TIME-OF-DAY WINDOW TAXONOMY
# (Architecture V12 Section 7 requires that TDL constraint values resolve to
#  named individuals - never free strings - and explicitly references
#  mlo:AM_PEAK as a member of the time-of-day taxonomy, and SCHOOL_DISMISSAL
#  as a time-window designator. This section makes those designators
#  resolvable. Window bounds are local-time defaults for the deployment
#  geofence; jurisdictions may recalibrate via configuration without
#  ontology change.)
# =============================================================================

mlo:TimeOfDayWindow rdf:type owl:Class ;
    rdfs:label "Time of Day Window"@en ;
    rdfs:comment "Enumeration class for analysis time-of-day windows. Members are named individuals used as TDL constraint vocabulary (e.g., the pair (tko:HEAVY_TRUCK, mlo:AM_PEAK)) and as label-temporality qualifiers. The GKG Reasoner Agent resolves a window individual to its hour bounds when constructing nGQL time filters."@en .

mlo:windowStartLocalTime rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:TimeOfDayWindow ;
    rdfs:range xsd:string ;
    rdfs:label "window start local time"@en ;
    rdfs:comment "Inclusive window start, HH:MM local time."@en .

mlo:windowEndLocalTime rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:TimeOfDayWindow ;
    rdfs:range xsd:string ;
    rdfs:label "window end local time"@en ;
    rdfs:comment "Exclusive window end, HH:MM local time."@en .

mlo:AM_PEAK rdf:type owl:NamedIndividual, mlo:TimeOfDayWindow ;
    rdfs:label "AM Peak"@en ;
    mlo:windowStartLocalTime "06:00" ;
    mlo:windowEndLocalTime "09:00" ;
    rdfs:comment "Morning peak commute window."@en .

mlo:MIDDAY rdf:type owl:NamedIndividual, mlo:TimeOfDayWindow ;
    rdfs:label "Midday"@en ;
    mlo:windowStartLocalTime "09:00" ;
    mlo:windowEndLocalTime "15:00" ;
    rdfs:comment "Midday off-peak window. The window where Mobility-of-Care demand concentrates; midday service levels are the primary lever the purpose-conditioned headway elasticities (tko:headwayElasticity) evaluate."@en .

mlo:SCHOOL_DISMISSAL rdf:type owl:NamedIndividual, mlo:TimeOfDayWindow ;
    rdfs:label "School Dismissal"@en ;
    mlo:windowStartLocalTime "14:00" ;
    mlo:windowEndLocalTime "16:00" ;
    rdfs:comment "School dismissal window, overlapping MIDDAY and PM_PEAK by design: school-adjacent safety analyses (vulnerable-exposure, speed-table and crossing interventions) constrain to this window specifically. Referenced as a constraint designator in Architecture V12 Section 7."@en .

mlo:PM_PEAK rdf:type owl:NamedIndividual, mlo:TimeOfDayWindow ;
    rdfs:label "PM Peak"@en ;
    mlo:windowStartLocalTime "15:00" ;
    mlo:windowEndLocalTime "19:00" ;
    rdfs:comment "Evening peak commute window."@en .

mlo:EVENING rdf:type owl:NamedIndividual, mlo:TimeOfDayWindow ;
    rdfs:label "Evening"@en ;
    mlo:windowStartLocalTime "19:00" ;
    mlo:windowEndLocalTime "23:00" ;
    rdfs:comment "Evening window. Primary window for streetlight-coverage-conditioned active-mobility safety scoring."@en .

mlo:OVERNIGHT rdf:type owl:NamedIndividual, mlo:TimeOfDayWindow ;
    rdfs:label "Overnight"@en ;
    mlo:windowStartLocalTime "23:00" ;
    mlo:windowEndLocalTime "06:00" ;
    rdfs:comment "Overnight window (wraps midnight)."@en .

# =============================================================================
# MLO v1.6 SECTION B: EQUITY & ACCESSIBILITY LABEL FAMILY
# =============================================================================

mlo:EquityAccessibilityFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Equity and Accessibility Labels"@en ;
    rdfs:comment "Labels characterizing equity-relevant exposure and accessibility context: job accessibility, pollutant exposure, affordability, and shared-mobility availability. Primary consumers: Equity Impact Scorer (Model 4) and the transportation-planning persona's Vision Zero and service-equity workflows. Companion UKO v15.5 properties: jobAccessibility, pm25Concentration, zeroVehicleHouseholdDensity, vulnerabilityIndex, htAffordabilityIndex."@en .

# =============================================================================
# MLO v1.6 SECTION C: NEW LABEL DEFINITIONS
# =============================================================================

### C.1 Trip purpose (Mobility-of-Care-aware) ###

mlo:ld_trip_purpose rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "trip_purpose" ;
    mlo:labelDescription "Primary societal demand category the trip serves, per the orthogonal tko:TripPurpose taxonomy introduced in TKO v8.3 - including tko:MOBILITY_OF_CARE as a first-class category. Distinct from intent labels: intent classifies the activity signature (patented Trip Intent Classifier output space); purpose classifies the demand served. Value set: COMMUTE, WORK_RELATED, EDUCATION, MOBILITY_OF_CARE, PERSONAL_BUSINESS, PERSONAL_MEDICAL, SOCIAL_RECREATION, RETURN_HOME, GOODS_MOVEMENT."@en ;
    mlo:hasLabelFamily mlo:TripLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "COMMUTE, WORK_RELATED, EDUCATION, MOBILITY_OF_CARE, PERSONAL_BUSINESS, PERSONAL_MEDICAL, SOCIAL_RECREATION, RETURN_HOME, GOODS_MOVEMENT" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Anchor-activity rule set over the enhanced trip record: destination POI class, dwell pattern, party composition signals, and chaining structure map to a purpose; escort-pattern and household-serving-errand rules assign MOBILITY_OF_CARE. Ambiguous anchors fall through to model-assisted assignment; tko:purposeAssignmentConfidence records the path. Writes tko:hasTripPurpose (primary) and tko:hasSecondaryTripPurpose (chained links)."@en ;
    mlo:gkgDependency "uko:PointOfInterest, uko:School, uko:HealthcareFacility, tko:TripPurpose, tko:hasTripPurpose" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

### C.2 Job accessibility (LEHD/LODES) ###

mlo:ld_job_accessibility rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "job_accessibility" ;
    mlo:labelDescription "Jobs reachable within a 45-minute transit travel-time threshold from the census tract context of the attached entity, from LEHD/LODES joined to the transit network (uko:jobAccessibility). Equity metric and EquityImpact effect target (JOB_ACCESSIBILITY_TRANSIT_45MIN)."@en ;
    mlo:hasLabelFamily mlo:EquityAccessibilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:hasGenerationMechanism mlo:GKG_LOOKUP ;
    mlo:generationDescription "Lookup: resolve the entity's tract via uko:withinCensusTract; read uko:jobAccessibility. Refreshed per LODES vintage by the GKG Updater; label values follow the GKG refresh, no per-trip computation."@en ;
    mlo:gkgDependency "uko:CensusTract, uko:withinCensusTract, uko:jobAccessibility" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "LEHD/LODES workplace-area employment" ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

### C.3 PM2.5 exposure (CARB) ###

mlo:ld_pm25_exposure rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "pm25_exposure" ;
    mlo:labelDescription "Annual-mean PM2.5 exposure baseline (micrograms per cubic meter) of the census tract context, from CARB monitoring (uko:pm25Concentration). Static baseline only; episodic elevations (wildfire smoke, SF-to-Contra-Costa wind transport) are live reo:AirQualityEvent instances, not label changes."@en ;
    mlo:hasLabelFamily mlo:EquityAccessibilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:hasGenerationMechanism mlo:GKG_LOOKUP ;
    mlo:generationDescription "Lookup: resolve tract via uko:withinCensusTract; read uko:pm25Concentration."@en ;
    mlo:gkgDependency "uko:CensusTract, uko:withinCensusTract, uko:pm25Concentration" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "CARB air quality monitoring network" ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

### C.4 Shared-mobility availability (GBFS/MDS) ###

mlo:ld_shared_mobility_availability rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "shared_mobility_availability" ;
    mlo:labelDescription "Time-bucketed shared-mobility availability score (0.0-1.0) for the entity context: station density within walkshed distance weighted by historical vehicle availability per uko:SharedMobilityVehicleType, from GBFS station feeds and city-owned MDS data. First/last-mile feature for the Demand Forecaster (Model 5) and an access dimension for the Equity Impact Scorer (Model 4)."@en ;
    mlo:hasLabelFamily mlo:EquityAccessibilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:hasGenerationMechanism mlo:GEOSPATIAL_AGGREGATION ;
    mlo:generationDescription "Aggregate uko:SharedMobilityStation instances within walkshed distance of the entity; weight by stationCapacity and time-bucketed availability aggregates (materialized from GBFS station_status by the analytics passes - the live vehiclesAvailable/docksAvailable values are real-time state, not label inputs); normalize within the analysis scope."@en ;
    mlo:gkgDependency "uko:SharedMobilityStation, uko:SharedMobilitySystem, uko:stationCapacity, uko:servesVehicleType, uko:MobilityPolicyZone" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "GBFS feeds; jurisdiction MDS provider/policy feeds" ;
    mlo:hasPipelineStage mlo:BATCH_AGGREGATE ;
    mlo:hasTemporality mlo:HISTORICAL_AGGREGATE ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

###############################################################################
#    PART 9: TRAINING CORPUS ADMISSIBILITY
#
#    Added v1.7.0. Which trip provenance classes a model may be trained on,
#    and what the Retraining Pipeline must verify before committing a batch.
###############################################################################

mlo:hasAdmissibleTripDataSource rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range tko:TripDataSource ;
    rdfs:label "has admissible trip data source"@en ;
    rdfs:comment "The trip provenance classes from which this model may draw training data. A model with no assertion of this property is inadmissible to training until one is declared, rather than defaulting to permissive."@en .

mlo:trainingBatchProvenanceHomogeneity rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "training batch provenance homogeneity"@en ;
    rdfs:comment "Whether every record in a training batch for this model must carry the same tko:TripDataSource. True by default in practice: corpora differ in population coverage and identifier semantics, so a mixed batch produces a model whose distribution corresponds to no observable population. Where false, the batch composition by provenance class must be recorded in the Configuration Snapshot. Enforced by the Retraining Pipeline, in the same manner as the SPECTRA version constraint; OWL does not express it."@en .

mlo:requiresRedistributableCorpus rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "requires redistributable corpus"@en ;
    rdfs:comment "True for models whose artifacts are Platform-scoped and therefore distributed to every installation. Such a model may draw only on corpora asserting tko:permitsDerivativeRedistribution true. This is the corpus-side analogue of the client-data constraint on Platform artifacts."@en .

###############################################################################
#    END OF MLO v1.7.0 ONTOLOGY
###############################################################################
