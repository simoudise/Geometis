#################################################################
#
#    Mobility Label Ontology (MLO)
#    Version 1.6.0 - Neurosymbolic Urban Mobility System
#
#    Purpose: Formal taxonomy of mobility labels spanning transportation
#    planning and fleet management use cases. Organizes labels by family,
#    generation mechanism, pipeline stage, GKG dependency, and persona
#    scope. Supports per-user, per-task label activation configuration
#    and multi-tenant access governance.
#
#    Synapse Partners, LLC
#
#    Imports (pin-to-coordinated-release policy, release set 2026-09-19):
#    - TKO v8.4.0 (Trip Knowledge Ontology)
#    - UKO v15.5.0 (Urban Knowledge Ontology)
#    - FKO v1.2.1 (Freight Knowledge Ontology)
#
#    Eight structural pillars:
#    1. LabelDefinition        — schema layer (what a label is)
#    2. LabelAssignment        — instance layer (a value on an entity)
#    3. GenerationMechanism    — named individuals, how labels are computed
#    4. LabelFamily            — organizational hierarchy
#    5. UseCasePersona         — persona taxonomy with fleet verticals
#    6. LabelProfile +
#       LabelActivationEntry   — user-level activation configuration
#    7. AnalyticsModel         — model registry, bidirectional label links
#    8. UserPrincipal +
#       OrganizationalAccount  — identity, roles, access governance
#
#    Change Log:
#    - v1.6.0: Coordinated release 2026-06-10 (release set: UKO v15.5.0, TKO v8.3.0,
#              FKO v1.2.0, MLO v1.6.0, REO v1.6.0).
#              (1) Closes all six OPEN items of the Appendix A.4 naming-drift
#                  register: uko:postedSpeedLimit corrected to uko:speedLimit;
#                  the stray uko:POI alias corrected to uko:PointOfInterest;
#                  the four collision-flag references corrected to the REO
#                  vocabulary (reo:hasCollisionType/reo:CollisionType and the
#                  reo:isPedestrianCollision / reo:isBicycleCollision /
#                  reo:isVulnerableUserCollision booleans formalized in REO v1.6).
#              (2) Adds the TimeOfDayWindow taxonomy (AM_PEAK, MIDDAY, PM_PEAK,
#                  EVENING, OVERNIGHT, SCHOOL_DISMISSAL) so TDL time-window
#                  constraint designators resolve to named individuals.
#              (3) Adds the EquityAccessibilityFamily label family and four new
#                  LabelDefinitions: ld_trip_purpose (Mobility-of-Care-aware,
#                  references tko:TripPurpose), ld_job_accessibility,
#                  ld_pm25_exposure, ld_shared_mobility_availability (GBFS/MDS).
#              (4) Repairs a v1.5.0 Turtle syntax defect (string literal broken
#                  across lines in ld_restricted_road_usage, which also carried
#                  the stale uko:maxHeightMeters name in its description text).
#              (5) Updates all import pins to the coordinated release.
#    - v1.5.0: Corrected semantic drift in mlo:gkgDependency properties to 
#              align with formal UKO and REO IRIs.
#    - v1.4.0: Added mlo:SimulationParameter and its properties to house UNA 
#              macroscopic flow parameters (Huff exponent, decay beta). Added 
#              mlo:model_urban_network_analysis to Model Registry. Added 
#              mlo:ld_predicted_pedestrian_flow label. Updated imports.
#    - v1.3.0: Added import for FKO v1.0.0. Updated ld_temperature_excursion 
#              to reference fko:FreightLoad. Updates imports to TKO v8.1.0 
#              and UKO v15.2.0.
#    - v1.2.0: Adds OutcomeLabel family (retrospective trip outcome labels used as 
#              supervision signal for OHR model training). Adds RiskTierLabel family. 
#    - v1.0.0: Initial release. Transportation Planning and Fleet Management
#              label catalogs from Architecture v5.0.0 Annotation Taxonomy.
#
#################################################################

@prefix :     <urn:mobility-label-kg:> .
@prefix mlo:  <urn:mobility-label-kg:> .
@prefix tko:  <urn:trip-kg:> .
@prefix uko:  <urn:urban-kg:> .
@prefix fko:  <urn:freight-kg:> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<urn:mobility-label-kg:> rdf:type owl:Ontology ;
    owl:versionIRI <urn:mobility-label-kg:1.7.0> ;
    owl:imports <urn:trip-kg:8.4.0> ;
    owl:imports <urn:urban-kg:15.5.0> ;
    owl:imports <urn:freight-kg:1.2.1> ;
    dcterms:title "Mobility Label Ontology (MLO) v1.7.0"@en ;
    dcterms:description "Comprehensive label taxonomy for the GeoMetis Trip Intelligence and Over-the-Horizon Risk pipelines. Covers transportation planning and fleet management label families with per-user activation profiles and multi-tenant access governance."@en ;
    rdfs:comment "Version 1.7.0 adds Part 9, Training Corpus Admissibility: which tko:TripDataSource provenance classes a model may be trained on, batch provenance homogeneity, and the redistributable-corpus requirement for Platform-scoped artifacts. Version 1.6.0 closes the Appendix A.4 naming-drift register, adds the TimeOfDayWindow constraint taxonomy, the equity/accessibility label family, and trip-purpose / equity / shared-mobility labels, and pins the coordinated-release import set. Version 1.4.0 updated imports to UKO v15.3.0 and TKO v8.2.0, integrated macroscopic flow simulation parameters, and added the Urban Network Analysis model to the registry."@en .


#################################################################
#    PILLAR 1: LABEL DEFINITION CLASS
#    The central schema-layer class. One instance per label type.
#    All controlled vocabulary enumerations used by LabelDefinition
#    properties are introduced immediately before the property
#    that first references them.
#################################################################

mlo:LabelDefinition rdf:type owl:Class ;
    rdfs:label "Label Definition"@en ;
    rdfs:comment "Schema-level description of a mobility label type. Defines the label's name, family, generation mechanism, GKG and telematics dependencies, pipeline stage, temporality, downstream models, and persona applicability. LabelDefinition instances are created and maintained exclusively by the OntologyCurator role."@en .


# --- Identity properties ---

mlo:labelName rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:string ;
    rdfs:label "label name"@en ;
    rdfs:comment "Canonical snake_case identifier for this label. Must be unique within the MLO namespace. Example: 'pedestrian_infrastructure_score'."@en .

mlo:labelDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:string ;
    rdfs:label "label description"@en ;
    rdfs:comment "Human-readable description of what this label represents, how it is used, and any interpretation guidance."@en .


# --- LabelFamily vocabulary (introduced here; full hierarchy in Pillar 4) ---

mlo:LabelFamily rdf:type owl:Class ;
    rdfs:label "Label Family"@en ;
    rdfs:comment "Top-level organizational grouping for LabelDefinitions. A label belongs to exactly one family. Families that are persona-specific are annotated with mlo:familyPersonaScope."@en .

mlo:hasLabelFamily rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:LabelFamily ;
    rdfs:label "has label family"@en ;
    rdfs:comment "The LabelFamily this label belongs to. Each label belongs to exactly one family."@en .


# --- AttachmentGranularity vocabulary ---

mlo:AttachmentGranularity rdf:type owl:Class ;
    rdfs:label "Attachment Granularity"@en ;
    rdfs:comment "The entity type to which a LabelAssignment attaches. Determines the domain of mlo:attachedTo on LabelAssignment instances."@en .

mlo:GRANULARITY_TRIP rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Trip"@en ;
    rdfs:comment "Label attaches to a tko:Trip entity."@en .

mlo:GRANULARITY_LEG rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Leg"@en ;
    rdfs:comment "Label attaches to a tko:RouteLeg or tko:EnrichedLeg entity."@en .

mlo:GRANULARITY_STOP rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Stop"@en ;
    rdfs:comment "Label attaches to a tko:StopEvent entity."@en .

mlo:GRANULARITY_SEGMENT rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Segment"@en ;
    rdfs:comment "Label attaches to a uko:RoadSegment entity."@en .

mlo:GRANULARITY_ROUTE rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Route"@en ;
    rdfs:comment "Label attaches to a tko:Route entity (the full reconstructed route of a trip)."@en .

mlo:GRANULARITY_EVENT rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Event"@en ;
    rdfs:comment "Label attaches to a real-time event (incident, weather episode, construction zone). Not a persistent TKO entity — event labels are time-bounded overlays."@en .

mlo:GRANULARITY_VEHICLE rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Vehicle"@en ;
    rdfs:comment "Label attaches to a vehicle entity. Requires a fleet/vehicle registry extension not yet in TKO or UKO scope."@en .

mlo:GRANULARITY_DRIVER rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Driver"@en ;
    rdfs:comment "Label attaches to a driver/operator entity. Requires a driver registry extension."@en .

mlo:GRANULARITY_FLEET rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Fleet"@en ;
    rdfs:comment "Label attaches to a fleet-level aggregate entity (organizational account or vehicle group)."@en .

mlo:GRANULARITY_TRAVELER rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Traveler"@en ;
    rdfs:comment "Label attaches to a traveler profile entity (used in Transportation Planning persona context)."@en .

mlo:GRANULARITY_TEMPORAL_AGGREGATE rdf:type owl:NamedIndividual, mlo:AttachmentGranularity ;
    rdfs:label "Temporal Aggregate"@en ;
    rdfs:comment "Label attaches to a time-windowed aggregation over trips, stops, or segments. The aggregate entity is identified by an entity URI plus a time window specification."@en .

mlo:hasAttachmentGranularity rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:AttachmentGranularity ;
    rdfs:label "has attachment granularity"@en ;
    rdfs:comment "The entity type to which instances of this label attach."@en .


# --- ValueType vocabulary ---

mlo:ValueType rdf:type owl:Class ;
    rdfs:label "Value Type"@en ;
    rdfs:comment "Controlled vocabulary for the data type of label instance values."@en .

mlo:BINARY rdf:type owl:NamedIndividual, mlo:ValueType ;
    rdfs:label "Binary"@en ;
    rdfs:comment "Yes/No or True/False. Serialized as xsd:boolean."@en .

mlo:CATEGORICAL rdf:type owl:NamedIndividual, mlo:ValueType ;
    rdfs:label "Categorical"@en ;
    rdfs:comment "Unordered set of named values. Serialized as xsd:string from a controlled vocabulary defined in mlo:permittedValues."@en .

mlo:ORDINAL rdf:type owl:NamedIndividual, mlo:ValueType ;
    rdfs:label "Ordinal"@en ;
    rdfs:comment "Ordered set of named values (e.g., Low < Medium < High). Serialized as xsd:string; ordering semantics are defined in mlo:permittedValues ordering."@en .

mlo:NUMERIC_SCORE rdf:type owl:NamedIndividual, mlo:ValueType ;
    rdfs:label "Numeric Score"@en ;
    rdfs:comment "Continuous numeric value, typically normalized to 0–1 or expressed as a percentile. Serialized as xsd:decimal."@en .

mlo:NUMERIC_INDEX rdf:type owl:NamedIndividual, mlo:ValueType ;
    rdfs:label "Numeric Index"@en ;
    rdfs:comment "Unbounded numeric value representing a count, magnitude, or derived quantity. Serialized as xsd:decimal or xsd:integer."@en .

mlo:COMPOSITE rdf:type owl:NamedIndividual, mlo:ValueType ;
    rdfs:label "Composite"@en ;
    rdfs:comment "Structured value combining multiple sub-components. Serialized as a JSON literal or a linked sub-object. Examples: labels with both a categorical tier and a numeric score."@en .

mlo:PROBABILITY rdf:type owl:NamedIndividual, mlo:ValueType ;
    rdfs:label "Probability"@en ;
    rdfs:comment "Numeric value representing a probability (0.0–1.0). Distinct from NUMERIC_SCORE: a probability has strict mathematical interpretation as a likelihood estimate."@en .

mlo:hasValueType rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:ValueType ;
    rdfs:label "has value type"@en ;
    rdfs:comment "The data type classification of this label's value."@en .

mlo:permittedValues rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:string ;
    rdfs:label "permitted values"@en ;
    rdfs:comment "Comma-separated controlled vocabulary of valid label values for CATEGORICAL and ORDINAL labels. For ORDINAL labels, values are listed in ascending order. For NUMERIC_SCORE and NUMERIC_INDEX labels, specifies the range (e.g., '0.0-1.0', '0-100', 'integer ≥ 0'). Null for BINARY labels (values are always true/false)."@en .


# --- GenerationMechanism vocabulary (introduced here; full population in Pillar 3) ---

mlo:GenerationMechanism rdf:type owl:Class ;
    rdfs:label "Generation Mechanism"@en ;
    rdfs:comment "Controlled vocabulary class for label generation mechanisms. Named individuals of this class are attached to LabelDefinition instances via mlo:hasGenerationMechanism."@en .

mlo:hasGenerationMechanism rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:GenerationMechanism ;
    rdfs:label "has generation mechanism"@en ;
    rdfs:comment "The primary mechanism by which this label is computed. A label may have multiple generation mechanisms if it can be produced by alternative methods."@en .

mlo:generationDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:string ;
    rdfs:label "generation description"@en ;
    rdfs:comment "Free-text description of how this label is generated. Should specify the algorithm, rule logic, or model architecture, and identify required data sources."@en .


# --- PipelineStage vocabulary ---

mlo:PipelineStage rdf:type owl:Class ;
    rdfs:label "Pipeline Stage"@en ;
    rdfs:comment "Controlled vocabulary identifying which stage of the SPNSLMAIS Trip Intelligence Pipeline computes a label."@en .

mlo:STAGE_2 rdf:type owl:NamedIndividual, mlo:PipelineStage ;
    rdfs:label "Stage 2 — Map Matching & Route Reconstruction"@en ;
    rdfs:comment "GPS preprocessing, Dressage Kalman filtering, GKG-aware map matching, modality-constrained alternative route generation."@en .

mlo:STAGE_3 rdf:type owl:NamedIndividual, mlo:PipelineStage ;
    rdfs:label "Stage 3 — Feature Augmentation"@en ;
    rdfs:comment "GKG cross-domain feature enrichment, POI resolution, weather/congestion overlays, SPECTRA embedding retrieval."@en .

mlo:STAGE_4 rdf:type owl:NamedIndividual, mlo:PipelineStage ;
    rdfs:label "Stage 4 — Discriminative Label Generation"@en ;
    rdfs:comment "Intent-independent labels produced by discriminative models and rule engines operating on enriched trip features."@en .

mlo:STAGE_5 rdf:type owl:NamedIndividual, mlo:PipelineStage ;
    rdfs:label "Stage 5 — Intent-Dependent Label Generation"@en ;
    rdfs:comment "Intent-dependent labels produced after intent classification. Includes labels whose values depend on knowing the trip's declared purpose."@en .

mlo:STAGE_6 rdf:type owl:NamedIndividual, mlo:PipelineStage ;
    rdfs:label "Stage 6 — Risk Scoring & Assessment"@en ;
    rdfs:comment "Composite risk scoring at segment, stop, and trip levels. Produces TripRiskAssessment instances and populates mlo:RiskTier assignments."@en .

mlo:REAL_TIME rdf:type owl:NamedIndividual, mlo:PipelineStage ;
    rdfs:label "Real-Time"@en ;
    rdfs:comment "Label is produced by a real-time overlay or event feed during active trip execution, not by the post-trip batch pipeline."@en .

mlo:BATCH_AGGREGATE rdf:type owl:NamedIndividual, mlo:PipelineStage ;
    rdfs:label "Batch Aggregate"@en ;
    rdfs:comment "Label is produced by a scheduled batch process aggregating across a historical time window of trip records (e.g., traveler profiles, fleet performance summaries)."@en .

mlo:SETUP_PHASE rdf:type owl:NamedIndividual, mlo:PipelineStage ;
    rdfs:label "Setup Phase"@en ;
    rdfs:comment "Label or score is pre-computed during the System Setup Phase (Section 11) and stored as a static GKG attribute. Consumed at trip processing time without recomputation. Example: segmentRiskScore."@en .

mlo:hasPipelineStage rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:PipelineStage ;
    rdfs:label "has pipeline stage"@en ;
    rdfs:comment "The pipeline stage that computes this label."@en .


# --- Temporality vocabulary ---

mlo:Temporality rdf:type owl:Class ;
    rdfs:label "Temporality"@en ;
    rdfs:comment "Controlled vocabulary describing when a label value is valid and how it ages."@en .

mlo:STATIC rdf:type owl:NamedIndividual, mlo:Temporality ;
    rdfs:label "Static"@en ;
    rdfs:comment "GKG attribute computed at Setup time. Valid until the next GKG refresh cycle. Examples: pedestrian_infrastructure_score, surface_type."@en .

mlo:TRIP_TIME rdf:type owl:NamedIndividual, mlo:Temporality ;
    rdfs:label "Trip-Time"@en ;
    rdfs:comment "Computed per trip during the pipeline's batch processing run. Valid for the duration of the trip record. Examples: trip_intent, schedule_alignment."@en .

mlo:REAL_TIME_TEMPORAL rdf:type owl:NamedIndividual, mlo:Temporality ;
    rdfs:label "Real-Time"@en ;
    rdfs:comment "Produced by a live feed during active trip execution. Has an explicit expiry. Examples: weather_overlay, incident_zone_tag."@en .

mlo:HISTORICAL_AGGREGATE rdf:type owl:NamedIndividual, mlo:Temporality ;
    rdfs:label "Historical Aggregate"@en ;
    rdfs:comment "Requires a lookback window over historical trip records. Valid for the window period and must be recomputed as the window rolls forward. Examples: traveler_active_mobility_ratio, fleet-level performance summaries."@en .

mlo:hasTemporality rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:Temporality ;
    rdfs:label "has temporality"@en ;
    rdfs:comment "When this label's value is valid and how it ages."@en .


#################################################################
#    NEW EXTENSION: MACROSCOPIC FLOW SIMULATION (v1.4.0)
#################################################################

mlo:SimulationParameter rdf:type owl:Class ;
    rdfs:label "Simulation Parameter"@en ;
    rdfs:comment "Parameters dictating how macroscopic flow simulations and macroscopic analytics models generate predictions (e.g., UNA Huff models)."@en .

mlo:huffExponent rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:SimulationParameter ;
    rdfs:range xsd:decimal ;
    rdfs:label "Huff exponent"@en .

mlo:distanceDecayBeta rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:SimulationParameter ;
    rdfs:range xsd:decimal ;
    rdfs:label "distance decay beta"@en .

mlo:decayFunctionType rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:SimulationParameter ;
    rdfs:range xsd:string ;
    rdfs:label "decay function type"@en .


# --- Dependency properties ---

mlo:gkgDependency rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:string ;
    rdfs:label "GKG dependency"@en ;
    rdfs:comment "Comma-separated list of UKO/TKO class or property names that must be present in the GKG for this label to be computed. Example: 'uko:hasSidewalk, uko:hasCrossing, uko:sidewalkCoverage'. A value of 'none' indicates no GKG dependency."@en .

mlo:telematicsDependency rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:string ;
    rdfs:label "telematics dependency"@en ;
    rdfs:comment "Comma-separated list of telematics data streams required for this label. Example: 'GPS trace, OBD-II speed, accelerometer'. A value of 'none' indicates the label is derivable entirely from GKG + pipeline-produced data."@en .

mlo:externalDataDependency rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:string ;
    rdfs:label "external data dependency"@en ;
    rdfs:comment "External data sources or API feeds required for this label beyond the GKG and telematics. Example: 'HERE Traffic API, INRIX congestion feed'. A value of 'none' indicates no external dependency."@en .

mlo:requiredInputLabel rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:LabelDefinition ;
    rdfs:label "required input label"@en ;
    rdfs:comment "Another LabelDefinition that must be computed (ACTIVE or PASSIVE) before this label can be generated. This property defines the label dependency graph used by the profile validator to enforce the PASSIVE state and to reject illegal INACTIVE assignments."@en .


# --- Consumer/producer links ---

mlo:consumedByModel rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:AnalyticsModel ;
    rdfs:label "consumed by model"@en ;
    rdfs:comment "Links a LabelDefinition to the AnalyticsModel instances that use it as an input feature."@en .

mlo:producedByModel rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:AnalyticsModel ;
    rdfs:label "produced by model"@en ;
    rdfs:comment "Links a LabelDefinition to the AnalyticsModel that produces it as a target variable or output label. Inverse of mlo:producesLabel on AnalyticsModel."@en .

mlo:isTargetVariable rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:boolean ;
    rdfs:label "is target variable"@en ;
    rdfs:comment "True when this label is the primary output (target variable) of at least one AnalyticsModel. False when the label is used only as an input feature or intermediate computed value."@en .


# --- PersonaApplicability vocabulary ---

mlo:PersonaApplicability rdf:type owl:Class ;
    rdfs:label "Persona Applicability"@en ;
    rdfs:comment "Three-state classification of a label's relevance to a given persona."@en .

mlo:REQUIRED rdf:type owl:NamedIndividual, mlo:PersonaApplicability ;
    rdfs:label "Required"@en ;
    rdfs:comment "This label must be in the ACTIVE or PASSIVE state in any valid LabelProfile for this persona. It cannot be set INACTIVE."@en .

mlo:OPTIONAL rdf:type owl:NamedIndividual, mlo:PersonaApplicability ;
    rdfs:label "Optional"@en ;
    rdfs:comment "This label is available for this persona and may be ACTIVE, PASSIVE, or INACTIVE depending on the user's LabelProfile."@en .

mlo:INAPPLICABLE rdf:type owl:NamedIndividual, mlo:PersonaApplicability ;
    rdfs:label "Inapplicable"@en ;
    rdfs:comment "This label is not relevant to this persona and must be INACTIVE. The profile validator rejects ACTIVE or PASSIVE assignments for INAPPLICABLE labels."@en .

mlo:LabelPersonaApplicabilityEntry rdf:type owl:Class ;
    rdfs:label "Label Persona Applicability Entry"@en ;
    rdfs:comment "Reified entry linking a LabelDefinition to a UseCasePersona with a PersonaApplicability value (REQUIRED, OPTIONAL, INAPPLICABLE). One entry per (label, persona) pair."@en .

mlo:hasApplicabilityEntry rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range mlo:LabelPersonaApplicabilityEntry ;
    rdfs:label "has applicability entry"@en .

mlo:applicabilityPersona rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelPersonaApplicabilityEntry ;
    rdfs:range mlo:UseCasePersona ;
    rdfs:label "applicability persona"@en .

mlo:applicabilityValue rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelPersonaApplicabilityEntry ;
    rdfs:range mlo:PersonaApplicability ;
    rdfs:label "applicability value"@en .


# --- Lifecycle properties ---

mlo:labelVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:string ;
    rdfs:label "label version"@en ;
    rdfs:comment "Semantic version of this LabelDefinition (e.g., '1.0', '1.1'). Incremented when the definition changes in a backward-compatible way. A major version increment (e.g., 1.x to 2.0) indicates a breaking change in value semantics."@en .

mlo:isDeprecated rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:boolean ;
    rdfs:label "is deprecated"@en ;
    rdfs:comment "True when this label definition has been superseded or retired. Deprecated labels cannot be set ACTIVE in new LabelProfiles, but existing profiles referencing them remain valid until migrated."@en .

mlo:deprecationNote rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelDefinition ;
    rdfs:range xsd:string ;
    rdfs:label "deprecation note"@en ;
    rdfs:comment "When isDeprecated is true: reason for deprecation and successor label name if applicable."@en .


#################################################################
#    PILLAR 2: LABEL ASSIGNMENT CLASS
#    Instance-layer class. One instance per label value on
#    one entity. The ActivationState vocabulary is introduced
#    here as it is first referenced in the Pillar 6 profile
#    layer, but we define it alongside the instance class
#    for conceptual proximity.
#################################################################

mlo:LabelAssignment rdf:type owl:Class ;
    rdfs:label "Label Assignment"@en ;
    rdfs:comment "A reified instance of a mobility label applied to a specific entity. Carries the label value, confidence, provenance, and temporal validity. For frequently queried scalar labels, the value is also stored as a direct datatype property on the entity for performance (see individual LabelDefinition descriptions)."@en .

mlo:forLabel rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range mlo:LabelDefinition ;
    rdfs:label "for label"@en ;
    rdfs:comment "The LabelDefinition this assignment instantiates."@en .

mlo:attachedTo rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:label "attached to"@en ;
    rdfs:comment "The specific entity this label is attached to. Range is polymorphic: tko:Trip, tko:StopEvent, uko:RoadSegment, tko:Route, or other entity per the label's attachment granularity."@en .

mlo:labelValue rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range xsd:string ;
    rdfs:label "label value"@en ;
    rdfs:comment "The computed value of this label assignment, serialized as a string. Numeric values are stored as string representations of their xsd:decimal or xsd:integer values. Boolean values are 'true' or 'false'. Consumers parse according to the LabelDefinition's valueType."@en .

mlo:labelNumericValue rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range xsd:decimal ;
    rdfs:label "label numeric value"@en ;
    rdfs:comment "For NUMERIC_SCORE and NUMERIC_INDEX labels: the numeric value as xsd:decimal. Provided alongside labelValue for direct numeric comparisons without string parsing."@en .

mlo:assignmentConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range xsd:decimal ;
    rdfs:label "assignment confidence"@en ;
    rdfs:comment "Model confidence score for this assignment (0.0–1.0). For RULE_BASED labels this is always 1.0. For SUPERVISED_ML labels this is the model's posterior probability for the assigned class."@en .

mlo:computedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "computed at"@en ;
    rdfs:comment "Timestamp when this assignment was computed."@en .

mlo:computedByModel rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range mlo:AnalyticsModel ;
    rdfs:label "computed by model"@en ;
    rdfs:comment "The AnalyticsModel instance that produced this assignment."@en .

mlo:hasAssignmentRationale rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range tko:LabelRationale ;
    rdfs:label "has assignment rationale"@en ;
    rdfs:comment "Links to a tko:LabelRationale instance (defined in TKO v6.0.0) capturing the mechanism, evidence features, threshold, and human-readable explanation for this assignment."@en .

mlo:validFrom rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "valid from"@en ;
    rdfs:comment "Start of validity window. Relevant for REAL_TIME and HISTORICAL_AGGREGATE labels."@en .

mlo:validUntil rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "valid until"@en ;
    rdfs:comment "End of validity window. Null for TRIP_TIME and STATIC labels, which do not expire."@en .

mlo:pipelineRunId rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelAssignment ;
    rdfs:range xsd:string ;
    rdfs:label "pipeline run ID"@en ;
    rdfs:comment "Identifier of the pipeline execution that produced this assignment. Used for batch provenance and reprocessing audit trails."@en .


#################################################################
#    PILLAR 3: GENERATION MECHANISM — Named Individuals
#    The class was declared above in Pillar 1 where it is first
#    referenced. The full set of named individuals is populated here.
#################################################################

mlo:RULE_BASED rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "Rule-Based"@en ;
    rdfs:comment "Deterministic rule, OWL axiom, or SWRL rule. Label value is fully determined by rule logic; no trained model is involved. Confidence is always 1.0 for correctly fired rules."@en .

mlo:SCORING_FUNCTION rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "Scoring Function"@en ;
    rdfs:comment "Weighted combination of GKG attributes and/or trip features producing a numeric score or ordinal tier. Deterministic given its inputs but parameterized by configurable weights in the Configuration Snapshot."@en .

mlo:GEOSPATIAL_AGGREGATION rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "Geospatial Aggregation"@en ;
    rdfs:comment "Spatial density or proximity query over GKG entities within a defined geographic boundary (census block, corridor, etc.). Results depend on GKG currency."@en .

mlo:GKG_LOOKUP rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "GKG Lookup"@en ;
    rdfs:comment "Direct property retrieval from a GKG entity (UKO segment, POI, transit stop, etc.). Essentially a read operation on the knowledge graph; no computation beyond attribute access."@en .

mlo:SUPERVISED_ML rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "Supervised ML"@en ;
    rdfs:comment "Trained classification or regression model (neural network, gradient boosted trees, etc.) producing a label value from feature inputs. Label carries a model confidence score."@en .

mlo:EXTERNAL_API_LOOKUP rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "External API Lookup"@en ;
    rdfs:comment "Real-time retrieval from an external data provider API (HERE, INRIX, Waze, 511, DOT, municipal crime APIs). Label validity is time-bounded by the API's refresh frequency."@en .

mlo:SENSOR_FUSION rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "Sensor Fusion"@en ;
    rdfs:comment "Combination of multiple telematics sensor streams (accelerometer, GPS, OBD-II, cargo sensors, video). Typically applied in real time or near-real time. Examples: eco_driving_score, contextual_harsh_event_flag."@en .

mlo:LLM_BASED rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "LLM-Based"@en ;
    rdfs:comment "Requires a large language model or generative AI component. Flagged separately from SUPERVISED_ML because of distinct latency, cost, and determinism characteristics. Example: driver_route_risk_compatibility_score narrative explanation."@en .

mlo:HEURISTIC rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "Heuristic"@en ;
    rdfs:comment "Empirical rule or threshold-based logic not formally specified as an OWL axiom. Intermediate between RULE_BASED (formally specified) and SUPERVISED_ML (learned). Typically implemented as a Python function in the pipeline."@en .

mlo:TEMPORAL_AGGREGATION rdf:type owl:NamedIndividual, mlo:GenerationMechanism ;
    rdfs:label "Temporal Aggregation"@en ;
    rdfs:comment "Computed from a time-windowed aggregation over a traveler's or vehicle's historical trip record. Requires a defined lookback period. Examples: traveler_active_mobility_ratio, traveler_active_mobility_temporal_profile."@en .


#################################################################
#    PILLAR 4: LABEL FAMILY HIERARCHY
#    Cross-persona and persona-specific families. The
#    mlo:familyPersonaScope property references UseCasePersona,
#    which is declared fully in Pillar 5.
#################################################################

mlo:familyPersonaScope rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelFamily ;
    rdfs:range mlo:UseCasePersona ;
    rdfs:label "family persona scope"@en ;
    rdfs:comment "Links a LabelFamily to the personas for which it is in scope. When absent, the family is considered cross-persona."@en .

# --- Cross-persona families ---

mlo:TripLevelFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Trip-Level Labels"@en ;
    rdfs:comment "Labels that characterize the trip as a whole: intent, type, completion, productivity."@en .

mlo:LegLevelFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Leg-Level Labels"@en ;
    rdfs:comment "Labels applied to individual route legs within a multi-modal or multi-segment trip."@en .

mlo:StopLevelFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Stop-Level Labels"@en ;
    rdfs:comment "Labels applied to individual stop events: stop type, intent, duration, POI context, curb access."@en .

mlo:SegmentLevelFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Segment-Level Labels"@en ;
    rdfs:comment "Labels applied to road segments in the GKG: risk score, surface type, congestion, speed variability."@en .

mlo:RouteLevelFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Route-Level Labels"@en ;
    rdfs:comment "Labels characterizing the full reconstructed route: route type, safety score, alternative route comparison."@en .

mlo:EventBasedFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Event-Based Labels"@en ;
    rdfs:comment "Labels produced by real-time event overlays: weather, incidents, construction, special events."@en .

# --- Fleet Management persona families ---

mlo:VehicleHealthFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Vehicle Health Labels"@en ;
    rdfs:comment "Labels tracking cumulative mechanical and thermal stress on fleet vehicles."@en .

mlo:DriverBehaviorFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Driver Behavior Labels"@en ;
    rdfs:comment "Labels characterizing driving style, safety events, and driver state."@en .

mlo:OperationalEfficiencyFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Operational Efficiency Labels"@en ;
    rdfs:comment "Labels measuring fleet operational performance: trip chain efficiency, driver-route compatibility, predicted late arrival."@en .

mlo:RegulatoryComplianceFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Regulatory & Compliance Labels"@en ;
    rdfs:comment "Labels tracking regulatory compliance: road restrictions, hours of service, cargo regulations."@en .

mlo:CargoAssetFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Cargo & Asset Monitoring Labels"@en ;
    rdfs:comment "Labels monitoring cargo integrity and asset security."@en .

mlo:VideoIntelligenceFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Video Intelligence Labels"@en ;
    rdfs:comment "Labels produced by AI video analysis of in-cab camera footage."@en .

mlo:EVManagementFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "EV Management Labels"@en ;
    rdfs:comment "Labels specific to electric vehicle fleet management: range sufficiency, charging opportunities, session type."@en .

# --- Transportation Planning persona families ---

mlo:InfrastructureSafetyFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Infrastructure & Safety Labels"@en ;
    rdfs:comment "Labels assessing road infrastructure quality and safety risk for transportation planning purposes."@en .

mlo:ActiveMobilityFamily rdf:type owl:NamedIndividual, mlo:LabelFamily ;
    rdfs:label "Active Mobility Analytics Labels"@en ;
    rdfs:comment "Labels characterizing active mobility (walking, cycling) trip patterns, intent, and traveler adoption."@en .


#################################################################
#    PILLAR 5: USE CASE PERSONA HIERARCHY
#    Two-level hierarchy: domain → fleet vertical specializations.
#################################################################

mlo:UseCasePersona rdf:type owl:Class ;
    rdfs:label "Use Case Persona"@en ;
    rdfs:comment "A named user persona representing a category of SPNSLMAIS customer. Personas define which label families are in scope and establish the default label applicability for new accounts."@en .

# --- Level 1: Domain personas ---

mlo:TransportationPlanningPersona rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:label "Transportation Planning Persona"@en ;
    rdfs:comment "Municipal transportation planners, county mobility analysts, regional planning agencies. Primary concerns: active mobility adoption, infrastructure gap analysis, safety network designation, equity, mode shift."@en .

mlo:FleetManagementPersona rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:label "Fleet Management Persona"@en ;
    rdfs:comment "Parent persona for all fleet operator verticals. Defines the baseline label set shared across all commercial fleet use cases. Specialized by fleet vertical sub-personas."@en .

mlo:InsurancePersona rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:label "Insurance Persona"@en ;
    rdfs:comment "Commercial fleet insurance underwriters and telematics-based insurance product developers. Primary concerns: contextual risk scoring, harsh event contextualization, video evidence, driver profile analysis."@en .

# --- Level 2: Fleet vertical sub-personas ---

mlo:ParcelDeliveryFleet rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:skos:broader mlo:FleetManagementPersona ;
    rdfs:label "Parcel Delivery Fleet"@en ;
    rdfs:comment "High stop-density urban delivery operations (e.g., last-mile parcel, food delivery). Priority labels: curb_access_score, stop_intent, schedule_alignment, trip_completion_status, predicted_late_arrival. Cargo labels relevant only for temperature-sensitive deliveries."@en .

mlo:FieldServiceFleet rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:skos:broader mlo:FleetManagementPersona ;
    rdfs:label "Field Service Fleet"@en ;
    rdfs:comment "Service technician fleets (plumbers, gardeners, HVAC, electricians, handymen). Low stop density, long dwell at service locations, job completion focus. mission_criticality and stop_intent (service_call, inspection) are primary. Cargo and HOS labels typically inapplicable."@en .

mlo:EVFleet rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:skos:broader mlo:FleetManagementPersona ;
    rdfs:label "EV Fleet"@en ;
    rdfs:comment "All-electric or mixed EV/ICE fleet operators. EV Management label family is required. Predictive maintenance labels include thermal and elevation stress on battery. Range and charging optimization is a primary use case."@en .

mlo:RegulatedTruckingFleet rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:skos:broader mlo:FleetManagementPersona ;
    rdfs:label "Regulated Trucking Fleet"@en ;
    rdfs:comment "Commercial motor carriers subject to FMCSA Hours of Service, weight limits, and route restrictions. Regulatory & Compliance labels are required. Vehicle health and load stress labels are critical."@en .

mlo:ColdChainFleet rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:skos:broader mlo:FleetManagementPersona ;
    rdfs:label "Cold Chain Fleet"@en ;
    rdfs:comment "Refrigerated cargo carriers (food, pharmaceuticals, medical supplies). cargo_temperature_compliance is a required label. Inherits from RegulatedTruckingFleet where HOS also applies."@en .

mlo:UtilityFleet rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:skos:broader mlo:FleetManagementPersona ;
    rdfs:label "Utility Fleet"@en ;
    rdfs:comment "Electric, gas, and water utility field crews. Infrastructure access is critical. Emergency dispatch priority and off-road segment handling differentiate this vertical from standard field service."@en .

mlo:TransitFleet rdf:type owl:NamedIndividual, mlo:UseCasePersona ;
    rdfs:skos:broader mlo:FleetManagementPersona ;
    rdfs:label "Transit Fleet"@en ;
    rdfs:comment "Public transit operators (bus, paratransit). Schedule adherence is the primary operational label. Passenger load, ADA compliance, and route coverage metrics supplement the base fleet set."@en .


#################################################################
#    PILLAR 6: LABEL PROFILE AND LABEL ACTIVATION ENTRY
#    The ActivationState vocabulary is introduced here
#    immediately before the class that uses it.
#################################################################

# --- ActivationState vocabulary ---

mlo:ActivationState rdf:type owl:Class ;
    rdfs:label "Activation State"@en ;
    rdfs:comment "Three-state enumeration for a label's activation status within a LabelProfile. Controls whether the label is computed, and if so, whether it is surfaced to the user."@en .

mlo:ACTIVE rdf:type owl:NamedIndividual, mlo:ActivationState ;
    rdfs:label "Active"@en ;
    rdfs:comment "Label is computed and surfaced to the user in outputs, dashboards, and API responses."@en .

mlo:PASSIVE rdf:type owl:NamedIndividual, mlo:ActivationState ;
    rdfs:label "Passive"@en ;
    rdfs:comment "Label is computed because one or more ACTIVE labels in this profile declare it as a required input (mlo:requiredInputLabel), but it is not surfaced to the user. The dependency validator enforces this state when deactivation would break an ACTIVE label's inputs."@en .

mlo:INACTIVE rdf:type owl:NamedIndividual, mlo:ActivationState ;
    rdfs:label "Inactive"@en ;
    rdfs:comment "Label is not computed. Setting a label INACTIVE is only valid when no ACTIVE or PASSIVE label in the profile declares it as a required input. The profile validator rejects INACTIVE assignments that violate the dependency graph."@en .

# --- TaskContext vocabulary ---

mlo:TaskContext rdf:type owl:Class ;
    rdfs:label "Task Context"@en ;
    rdfs:comment "Controlled vocabulary of operational task contexts to which a LabelProfile can be scoped. Two profiles for the same user and persona may activate different label sets when applied to different tasks."@en .

mlo:ROUTE_OPTIMIZATION rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Route Optimization"@en .

mlo:DRIVER_COACHING rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Driver Coaching"@en .

mlo:INSURANCE_UNDERWRITING rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Insurance Underwriting"@en .

mlo:DISPATCH_REVIEW rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Dispatch Review"@en .

mlo:MAINTENANCE_PLANNING rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Maintenance Planning"@en .

mlo:INFRASTRUCTURE_PLANNING rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Infrastructure Planning"@en .

mlo:EQUITY_ANALYSIS rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Equity Analysis"@en .

mlo:ACTIVE_MOBILITY_ANALYSIS rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Active Mobility Analysis"@en .

mlo:EV_FLEET_MANAGEMENT rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "EV Fleet Management"@en .

mlo:COMPLIANCE_MONITORING rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Compliance Monitoring"@en .

mlo:CARGO_MONITORING rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Cargo Monitoring"@en .

mlo:FLEET_COMPOSITION_ANALYSIS rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Fleet Composition Analysis"@en .

mlo:SAFETY_RISK_ASSESSMENT rdf:type owl:NamedIndividual, mlo:TaskContext ;
    rdfs:label "Safety Risk Assessment"@en .

# --- LabelProfile class ---

mlo:LabelProfile rdf:type owl:Class ;
    rdfs:label "Label Profile"@en ;
    rdfs:comment "A named, user-owned, task-scoped configuration specifying the activation state (ACTIVE, PASSIVE, INACTIVE) of every relevant label in the catalog for a specific user and task context. Two users of the same persona may have completely different LabelProfiles. Every LabelProfile is validated against the label dependency graph before activation."@en .

mlo:profileName rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range xsd:string ;
    rdfs:label "profile name"@en ;
    rdfs:comment "Human-readable name for this profile. Example: 'Route Optimization View', 'Driver Coaching Weekly'."@en .

mlo:profileOwnedBy rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range mlo:UserPrincipal ;
    rdfs:label "profile owned by"@en ;
    rdfs:comment "The UserPrincipal who created and owns this profile. Only the owner and EnterpriseAdmin can modify it."@en .

mlo:profileTargetPersona rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range mlo:UseCasePersona ;
    rdfs:label "profile target persona"@en ;
    rdfs:comment "The persona this profile is scoped to. Labels marked INAPPLICABLE for this persona cannot be set ACTIVE in this profile."@en .

mlo:profileTargetTask rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range mlo:TaskContext ;
    rdfs:label "profile target task"@en ;
    rdfs:comment "The operational task context this profile is optimized for."@en .

mlo:hasActivationEntry rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range mlo:LabelActivationEntry ;
    rdfs:label "has activation entry"@en ;
    rdfs:comment "Links this profile to its LabelActivationEntry instances, one per label in scope."@en .

mlo:isDefaultProfile rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range xsd:boolean ;
    rdfs:label "is default profile"@en ;
    rdfs:comment "True when this profile is the account-wide default applied to new users. An OrganizationalAccount has at most one default LabelProfile per persona."@en .

mlo:sharedWithUser rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range mlo:UserPrincipal ;
    rdfs:label "shared with user"@en ;
    rdfs:comment "UserPrincipals who can read and apply this profile but do not own it. Only PowerUser and above can share profiles."@en .

mlo:profileCreatedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range xsd:dateTime ;
    rdfs:label "profile created at"@en .

mlo:profileLastModifiedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range xsd:dateTime ;
    rdfs:label "profile last modified at"@en .

mlo:profileValidationStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range xsd:string ;
    rdfs:label "profile validation status"@en ;
    rdfs:comment "VALID, INVALID, or PENDING_VALIDATION. Set by the profile validator after checking: (1) no ACTIVE label has an INACTIVE required input, (2) no INAPPLICABLE label is set ACTIVE, (3) all REQUIRED labels are ACTIVE or PASSIVE."@en .

mlo:profileValidationErrors rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelProfile ;
    rdfs:range xsd:string ;
    rdfs:label "profile validation errors"@en ;
    rdfs:comment "JSON-serialized list of validation error messages when profileValidationStatus is INVALID."@en .

# --- LabelActivationEntry class ---

mlo:LabelActivationEntry rdf:type owl:Class ;
    rdfs:label "Label Activation Entry"@en ;
    rdfs:comment "A single entry in a LabelProfile specifying the activation state of one label for the profile's user and task context."@en .

mlo:activationForLabel rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelActivationEntry ;
    rdfs:range mlo:LabelDefinition ;
    rdfs:label "activation for label"@en ;
    rdfs:comment "The LabelDefinition this activation entry controls."@en .

mlo:activationState rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelActivationEntry ;
    rdfs:range mlo:ActivationState ;
    rdfs:label "activation state"@en ;
    rdfs:comment "ACTIVE, PASSIVE, or INACTIVE. The profile validator enforces consistency with the label dependency graph."@en .

mlo:overriddenFromDefault rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelActivationEntry ;
    rdfs:range xsd:boolean ;
    rdfs:label "overridden from default"@en ;
    rdfs:comment "True when this entry's activation state differs from the account's default LabelProfile for the same label. Enables audit of per-user customizations relative to the organizational baseline."@en .

mlo:overrideReason rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:LabelActivationEntry ;
    rdfs:range xsd:string ;
    rdfs:label "override reason"@en ;
    rdfs:comment "Optional free-text rationale for the override. Useful for auditing non-standard configurations."@en .

mlo:passiveForcedBy rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:LabelActivationEntry ;
    rdfs:range mlo:LabelDefinition ;
    rdfs:label "passive forced by"@en ;
    rdfs:comment "When activationState is PASSIVE: the LabelDefinition that requires this label as an input, forcing it into the PASSIVE state. Set by the profile validator, not by the user."@en .

#################################################################
#    PILLAR 7: ANALYTICS MODEL CLASS
#    The ModelArchitecture vocabulary is introduced here
#    immediately before the class that uses it.
#################################################################

# --- ModelArchitecture vocabulary ---

mlo:ModelArchitecture rdf:type owl:Class ;
    rdfs:label "Model Architecture"@en ;
    rdfs:comment "Controlled vocabulary for AI/ML model architecture types used in AnalyticsModel instances."@en .

mlo:GRADIENT_BOOSTED_TREES rdf:type owl:NamedIndividual, mlo:ModelArchitecture ;
    rdfs:label "Gradient Boosted Trees"@en ;
    rdfs:comment "XGBoost, LightGBM, or equivalent. Preferred for tabular feature inputs with structured label supervision."@en .

mlo:NEURAL_NETWORK rdf:type owl:NamedIndividual, mlo:ModelArchitecture ;
    rdfs:label "Neural Network"@en ;
    rdfs:comment "Feed-forward, recurrent, or convolutional neural network. Used for complex pattern recognition over sequential or spatial inputs."@en .

mlo:AUTOENCODER rdf:type owl:NamedIndividual, mlo:ModelArchitecture ;
    rdfs:label "Autoencoder"@en ;
    rdfs:comment "Encoder-decoder architecture for unsupervised representation learning. Used in traveler behavior segmentation."@en .

mlo:CNN rdf:type owl:NamedIndividual, mlo:ModelArchitecture ;
    rdfs:label "Convolutional Neural Network"@en ;
    rdfs:comment "Spatial/visual pattern recognition. Used in video intelligence label generation."@en .

mlo:VISION_TRANSFORMER rdf:type owl:NamedIndividual, mlo:ModelArchitecture ;
    rdfs:label "Vision Transformer"@en ;
    rdfs:comment "Attention-based architecture for image/video understanding. Alternative to CNN for video intelligence labels."@en .

mlo:RULES_ENGINE rdf:type owl:NamedIndividual, mlo:ModelArchitecture ;
    rdfs:label "Rules Engine"@en ;
    rdfs:comment "Deterministic rule execution engine. Used for compliance monitoring, schedule alignment, and other formally specifiable decisions."@en .

mlo:SCORING_MODEL rdf:type owl:NamedIndividual, mlo:ModelArchitecture ;
    rdfs:label "Scoring Model"@en ;
    rdfs:comment "Weighted feature combination model. Simpler than a trained ML model; weights are hand-crafted or calibrated from domain expertise."@en .

mlo:LLM_ARCHITECTURE rdf:type owl:NamedIndividual, mlo:ModelArchitecture ;
    rdfs:label "Large Language Model"@en ;
    rdfs:comment "Generative language model. Flagged separately for latency, cost, and determinism considerations."@en .

# --- AnalyticsModel class ---

mlo:AnalyticsModel rdf:type owl:Class ;
    rdfs:label "Analytics Model"@en ;
    rdfs:comment "An AI or algorithmic model registered in the SPNSLMAIS model catalog. Each instance records what labels and features the model consumes, what label it produces, its architecture, and which personas it serves."@en .

mlo:modelName rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range xsd:string ;
    rdfs:label "model name"@en .

mlo:modelDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range xsd:string ;
    rdfs:label "model description"@en .

mlo:hasModelArchitecture rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range mlo:ModelArchitecture ;
    rdfs:label "has model architecture"@en .

mlo:consumesLabel rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range mlo:LabelDefinition ;
    rdfs:label "consumes label"@en ;
    rdfs:comment "Input labels consumed by this model as features."@en .

mlo:producesLabel rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range mlo:LabelDefinition ;
    rdfs:label "produced label"@en ;
    rdfs:comment "The label(s) this model generates as output. Typically the target variable."@en .

mlo:consumesEnhancement rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range xsd:string ;
    rdfs:label "consumes enhancement"@en ;
    rdfs:comment "Comma-separated list of trip enhancements or base attributes consumed by this model beyond labeled data. Example: 'POI Type, Temporal Context, GKG road attributes'."@en .

mlo:modelPersonaScope rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range mlo:UseCasePersona ;
    rdfs:label "model persona scope"@en ;
    rdfs:comment "Personas for which this model is applicable."@en .

mlo:modelTaskContext rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range mlo:TaskContext ;
    rdfs:label "model task context"@en ;
    rdfs:comment "Task contexts this model supports."@en .

mlo:requiresLLM rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range xsd:boolean ;
    rdfs:label "requires LLM"@en ;
    rdfs:comment "True when this model requires an LLM component. Flagged for latency and cost planning."@en .

mlo:modelVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range xsd:string ;
    rdfs:label "model version"@en .

mlo:modelNotes rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:AnalyticsModel ;
    rdfs:range xsd:string ;
    rdfs:label "model notes"@en ;
    rdfs:comment "Implementation notes, recommended architecture, or training data guidance."@en .


#################################################################
#    PILLAR 8: USER PRINCIPAL AND ORGANIZATIONAL ACCOUNT
#    The UserRole vocabulary is introduced here immediately
#    before the class that uses it.
#################################################################

# --- UserRole vocabulary ---

mlo:UserRole rdf:type owl:Class ;
    rdfs:label "User Role"@en ;
    rdfs:comment "Role hierarchy for MLO access governance. Roles determine which operations a UserPrincipal may perform on which MLO object types."@en .

mlo:OntologyCurator rdf:type owl:NamedIndividual, mlo:UserRole ;
    rdfs:label "Ontology Curator"@en ;
    rdfs:comment "Synapse Partners staff. Full write access to schema layer: LabelDefinition, LabelFamily, UseCasePersona, AnalyticsModel registry entries. The only role permitted to create or modify LabelDefinitions, deprecate labels, or alter the persona taxonomy."@en .

mlo:EnterpriseAdmin rdf:type owl:NamedIndividual, mlo:UserRole ;
    rdfs:label "Enterprise Admin"@en ;
    rdfs:comment "Customer system administrator. Can create and modify LabelProfiles, assign roles to users within their account, configure the account's Persona scope, and designate the account's default LabelProfile. Cannot modify LabelDefinitions."@en .

mlo:PowerUser rdf:type owl:NamedIndividual, mlo:UserRole ;
    rdfs:label "Power User"@en ;
    rdfs:comment "Fleet manager, transportation planner lead. Can create new LabelProfiles, activate and deactivate labels within their persona scope, and share profiles with StandardUsers. Cannot create LabelDefinitions or modify the persona taxonomy."@en .

mlo:StandardUser rdf:type owl:NamedIndividual, mlo:UserRole ;
    rdfs:label "Standard User"@en ;
    rdfs:comment "Analyst, dispatcher. Can read LabelAssignments, modify their own LabelProfiles (including activation states), but cannot create new profiles or share them with other users."@en .

mlo:ReadOnlyUser rdf:type owl:NamedIndividual, mlo:UserRole ;
    rdfs:label "Read-Only User"@en ;
    rdfs:comment "Executive, auditor. Read access to LabelAssignments and active profile configurations. No modification rights on any MLO object."@en .

# --- UserPrincipal class ---

mlo:UserPrincipal rdf:type owl:Class ;
    rdfs:label "User Principal"@en ;
    rdfs:comment "A named user within an organizational account. Holds a role that determines which MLO objects the user can read, create, modify, or delete."@en .

mlo:principalId rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:UserPrincipal ;
    rdfs:range xsd:string ;
    rdfs:label "principal ID"@en ;
    rdfs:comment "Unique identifier for this user, corresponding to the user's identity in the customer's authentication system."@en .

mlo:principalDisplayName rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:UserPrincipal ;
    rdfs:range xsd:string ;
    rdfs:label "principal display name"@en .

mlo:hasUserRole rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:UserPrincipal ;
    rdfs:range mlo:UserRole ;
    rdfs:label "has user role"@en ;
    rdfs:comment "The role this principal holds within their account. A principal holds exactly one role."@en .

mlo:scopedToPersona rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:UserPrincipal ;
    rdfs:range mlo:UseCasePersona ;
    rdfs:label "scoped to persona"@en ;
    rdfs:comment "The persona(s) this user is permitted to work within. Must be a subset of the account's licensed personas."@en .

mlo:belongsToAccount rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:UserPrincipal ;
    rdfs:range mlo:OrganizationalAccount ;
    rdfs:label "belongs to account"@en .

mlo:ownsProfile rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:UserPrincipal ;
    rdfs:range mlo:LabelProfile ;
    rdfs:label "owns profile"@en ;
    rdfs:comment "LabelProfiles created and owned by this user."@en .

mlo:canAccessProfile rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:UserPrincipal ;
    rdfs:range mlo:LabelProfile ;
    rdfs:label "can access profile"@en ;
    rdfs:comment "LabelProfiles shared with this user by others. Read-and-apply access but not ownership."@en .

mlo:activeProfile rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:UserPrincipal ;
    rdfs:range mlo:LabelProfile ;
    rdfs:label "active profile"@en ;
    rdfs:comment "The LabelProfile currently active for this user's pipeline runs. Can be changed by the user between sessions."@en .

# --- OrganizationalAccount class ---

mlo:OrganizationalAccount rdf:type owl:Class ;
    rdfs:label "Organizational Account"@en ;
    rdfs:comment "A customer organization account. Owns a set of licensed personas, a set of UserPrincipals, and a default LabelProfile per persona."@en .

mlo:accountId rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:OrganizationalAccount ;
    rdfs:range xsd:string ;
    rdfs:label "account ID"@en .

mlo:accountName rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:OrganizationalAccount ;
    rdfs:range xsd:string ;
    rdfs:label "account name"@en .

mlo:licensedPersona rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:OrganizationalAccount ;
    rdfs:range mlo:UseCasePersona ;
    rdfs:label "licensed persona"@en ;
    rdfs:comment "The persona(s) this account is licensed to use. UserPrincipals in this account can only be scoped to personas listed here."@en .

mlo:hasUserPrincipal rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:OrganizationalAccount ;
    rdfs:range mlo:UserPrincipal ;
    rdfs:label "has user principal"@en .

mlo:accountDefaultProfile rdf:type owl:ObjectProperty ;
    rdfs:domain mlo:OrganizationalAccount ;
    rdfs:range mlo:LabelProfile ;
    rdfs:label "account default profile"@en ;
    rdfs:comment "The baseline LabelProfile applied to new users in this account. Managed by the EnterpriseAdmin role."@en .

mlo:accountCreatedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain mlo:OrganizationalAccount ;
    rdfs:range xsd:dateTime ;
    rdfs:label "account created at"@en .


#################################################################
#    LABEL DEFINITIONS — TRANSPORTATION PLANNING PERSONA
#    Source: Transportation_Planner_Annotation_Taxonomy_Table.xlsx
#    Sheet: Labels Taxonomy
#    All labels in this section are scoped to
#    mlo:TransportationPlanningPersona unless noted otherwise.
#################################################################

# =============================================================================
# Family: Infrastructure & Safety
# =============================================================================

mlo:ld_pedestrian_infrastructure_score rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "pedestrian_infrastructure_score" ;
    mlo:labelDescription "Composite score measuring pedestrian infrastructure quality on a road segment. Combines sidewalk availability, sidewalk continuity, sidewalk condition, crosswalk density, crosswalk quality (signal, RRFB, PHB), buffer presence, and curb ramp availability from GKG attributes. Higher scores indicate better pedestrian infrastructure."@en ;
    mlo:hasLabelFamily mlo:InfrastructureSafetyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:permittedValues "0.0–1.0" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Scoring function applied to GKG attributes: uko:hasSidewalk, uko:hasSidewalkBothSides, uko:sidewalkCoverage, uko:sidewalkCondition, uko:hasCrossing, uko:hasSignalizedCrossing, uko:hasPHB, uko:hasRRFB, uko:hasCurbRamps, uko:hasBuffer. Supplemented with Mapillary street-level imagery analysis where GKG attributes are absent."@en ;
    mlo:gkgDependency "uko:hasSidewalk, uko:hasSidewalkBothSides, uko:sidewalkCoverage, uko:sidewalkCondition, uko:hasCrossing, uko:hasSignalizedCrossing, uko:hasPHB, uko:hasRRFB, uko:hasCurbRamps, uko:hasBuffer, uko:bufferWidth" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Mapillary street imagery (supplemental)" ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_cycling_infrastructure_score rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "cycling_infrastructure_score" ;
    mlo:labelDescription "Composite score measuring cycling infrastructure quality on a road segment. Based on the presence and type of bicycle facility (protected lane, painted lane, bike route, shared path) and the segment's Level of Traffic Stress."@en ;
    mlo:hasLabelFamily mlo:InfrastructureSafetyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:permittedValues "0.0–1.0" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Scoring function on GKG attributes: uko:hasBikeLane, uko:bikeFacilityType (CLASS_I through CLASS_IV hierarchy), uko:levelOfTrafficStress, uko:hasProtectedBikeLane, uko:bikeLaneWidth."@en ;
    mlo:gkgDependency "uko:hasBikeLane, uko:bikeFacilityType, uko:levelOfTrafficStress, uko:hasProtectedBikeLane, uko:bikeLaneWidth" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_traffic_incident_density rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "traffic_incident_density" ;
    mlo:labelDescription "Categorical density classification of historical traffic incidents within a defined geographic area (census block or comparable unit). Captures the relative concentration of all-mode collisions as a planning-level signal."@en ;
    mlo:hasLabelFamily mlo:InfrastructureSafetyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "Low, Medium, High" ;
    mlo:hasGenerationMechanism mlo:GEOSPATIAL_AGGREGATION ;
    mlo:generationDescription "Geospatial aggregation over SWITRS collision records within a defined catchment area. Density thresholds (Low/Medium/High) are calibrated against the county-wide distribution of incident counts per square mile."@en ;
    mlo:gkgDependency "reo:HistoricalIncidentRecord, reo:hasCollisionType, reo:CollisionType" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "SWITRS collision data (integrated into GKG)" ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_vulnerable_road_user_incident_density rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "vulnerable_road_user_incident_density" ;
    mlo:labelDescription "Categorical density classification of historical incidents involving pedestrians and cyclists within a defined geographic area. More targeted than traffic_incident_density: restricted to VRU collision modes."@en ;
    mlo:hasLabelFamily mlo:InfrastructureSafetyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "Low, Medium, High" ;
    mlo:hasGenerationMechanism mlo:GEOSPATIAL_AGGREGATION ;
    mlo:generationDescription "Geospatial aggregation over SWITRS collision records filtered to uko:PEDESTRIAN_COLLISION and uko:BICYCLE_COLLISION modes. Density thresholds calibrated against county VRU incident distribution."@en ;
    mlo:gkgDependency "reo:HistoricalIncidentRecord, reo:isPedestrianCollision, reo:isBicycleCollision, reo:isVulnerableUserCollision" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "SWITRS collision data (integrated into GKG)" ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_segment_traffic_risk_score rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "segment_traffic_risk_score" ;
    mlo:labelDescription "Predictive composite risk score for a road segment combining historical incident density, traffic volumes, road geometry, and VRU exposure factors. The primary target variable for the Infrastructure & Safety Risk Model in the Transportation Planning context."@en ;
    mlo:hasLabelFamily mlo:InfrastructureSafetyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:permittedValues "0.0–1.0" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Predictive model combining: traffic_incident_density, vulnerable_road_user_incident_density, uko:averageDailyTraffic, uko:pedestrianAADT, road geometry attributes. Note: this is the transportation planning variant of segmentRiskScore (UKO v12); they share GKG inputs but have distinct model objectives."@en ;
    mlo:gkgDependency "uko:averageDailyTraffic, uko:annualVMT, uko:pedestrianAADT, uko:p85Speed, uko:onHIN, uko:onPSN" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "SWITRS collision data" ;
    mlo:requiredInputLabel mlo:ld_traffic_incident_density ;
    mlo:requiredInputLabel mlo:ld_vulnerable_road_user_incident_density ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_community_crime_risk_index rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "community_crime_risk_index" ;
    mlo:labelDescription "Geospatial aggregation of specific crime types (theft, assault, robbery) from municipal crime statistics within a defined area. Used as a supplementary safety signal for active mobility safety analysis."@en ;
    mlo:hasLabelFamily mlo:InfrastructureSafetyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:permittedValues "0.0–1.0" ;
    mlo:hasGenerationMechanism mlo:GEOSPATIAL_AGGREGATION ;
    mlo:generationDescription "Geospatial aggregation of municipal crime statistics (theft, assault, property crime) within a configurable catchment radius. Normalized to 0–1 by percentile rank within the study area."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Municipal crime statistics data" ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Active Mobility Analytics
# =============================================================================

mlo:ld_active_mobility_route rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "active_mobility_route" ;
    mlo:labelDescription "Boolean flag indicating whether every segment of the trip's actual route was a designated active mobility facility: sidewalk, shared-use path, dedicated bike lane, or equivalent. A trip with even one non-designated segment is labeled No."@en ;
    mlo:hasLabelFamily mlo:ActiveMobilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "Yes, No" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rule: for all segments s in the reconstructed route, check uko:permittedModalities for WALKING or BICYCLING AND uko:bikeFacilityType != NO_BIKE_FACILITY OR uko:hasSidewalk = true. If all segments pass, label = Yes."@en ;
    mlo:gkgDependency "uko:permittedModalities, uko:bikeFacilityType, uko:hasSidewalk" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_active_mobility_density rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "active_mobility_density" ;
    mlo:labelDescription "Categorical density classification of active mobility trip origins within a defined geographic area (census block or tract). Identifies hotspot zones for active transportation planning."@en ;
    mlo:hasLabelFamily mlo:ActiveMobilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TEMPORAL_AGGREGATE ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "Low, Medium, High" ;
    mlo:hasGenerationMechanism mlo:GEOSPATIAL_AGGREGATION ;
    mlo:generationDescription "Counts active mobility trip origins (trips where active_mobility_route = Yes) within census block or tract boundaries over the analysis period. Thresholds calibrated against the study-area distribution."@en ;
    mlo:gkgDependency "uko:CensusTract boundary geometry" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Geographic boundary data (census tracts, city blocks)" ;
    mlo:requiredInputLabel mlo:ld_active_mobility_route ;
    mlo:hasPipelineStage mlo:BATCH_AGGREGATE ;
    mlo:hasTemporality mlo:HISTORICAL_AGGREGATE ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_active_mobility_intent rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "active_mobility_intent" ;
    mlo:labelDescription "Purpose classification for an active mobility trip. Captures why the traveler made this walking or cycling trip. Specifically trained on active mobility trips — distinct from the general trip_intent label which covers all modes."@en ;
    mlo:hasLabelFamily mlo:ActiveMobilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "Recreation, Commute, Shopping, Dining, Errand, School, Healthcare, Social, Other" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Predictive model trained on active mobility trips using: resolved destination POI type, GKG neighborhood attributes, stop duration, temporal context (time-of-day, day-of-week), route characteristics. Separate model from general intent classifier: active mobility intent patterns differ substantially from motorized trip patterns."@en ;
    mlo:gkgDependency "uko:PointOfInterest type hierarchy, uko:hasSidewalk, uko:bikeFacilityType" ;
    mlo:telematicsDependency "GPS trace" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_active_mobility_route ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_traveler_active_mobility_ratio rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "traveler_active_mobility_ratio" ;
    mlo:labelDescription "Fraction of a traveler's trips during the analysis period that were active mobility trips (active_mobility_route = Yes). Ranges from 0 (no active mobility) to 1 (exclusively active mobility). Used in traveler segmentation and mode shift analysis."@en ;
    mlo:hasLabelFamily mlo:ActiveMobilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRAVELER ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:permittedValues "0.0–1.0" ;
    mlo:hasGenerationMechanism mlo:TEMPORAL_AGGREGATION ;
    mlo:generationDescription "active_mobility_trip_count / total_trip_count for the traveler over the analysis period. Requires mlo:active_mobility_route label to be available for all trips in scope."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "Traveler trip history" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_active_mobility_route ;
    mlo:hasPipelineStage mlo:BATCH_AGGREGATE ;
    mlo:hasTemporality mlo:HISTORICAL_AGGREGATE ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_traveler_active_mobility_temporal_profile rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "traveler_active_mobility_temporal_profile" ;
    mlo:labelDescription "Characterizes the temporal distribution of a traveler's active mobility trips across weekdays and weekends. Assigned by applying predefined rules to the weekday ratio of active mobility trips."@en ;
    mlo:hasLabelFamily mlo:ActiveMobilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRAVELER ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "Primarily Weekday, Primarily Weekend, Evenly Distributed" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Compute weekday_am_ratio = weekday_active_trips / total_active_trips. Rules: Primarily Weekday if ratio ≥ 0.65; Primarily Weekend if ratio ≤ 0.35; Evenly Distributed otherwise. Thresholds configurable in Configuration Snapshot."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "Traveler trip history" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_active_mobility_route ;
    mlo:hasPipelineStage mlo:BATCH_AGGREGATE ;
    mlo:hasTemporality mlo:HISTORICAL_AGGREGATE ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_traveler_primary_active_intent rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "traveler_primary_active_intent" ;
    mlo:labelDescription "Dominant active mobility purpose for a traveler over the analysis period, derived from the modal active_mobility_intent value across their active trips."@en ;
    mlo:hasLabelFamily mlo:ActiveMobilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRAVELER ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "Commuter, Recreational User, Local Shopper" ;
    mlo:hasGenerationMechanism mlo:TEMPORAL_AGGREGATION ;
    mlo:generationDescription "Modal active_mobility_intent across the traveler's active trips, then mapped to three aggregate categories: Commuter (modal intent = Commute or School), Recreational User (modal intent = Recreation or Social), Local Shopper (modal intent = Shopping, Dining, or Errand)."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "Traveler trip history" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_active_mobility_intent ;
    mlo:hasPipelineStage mlo:BATCH_AGGREGATE ;
    mlo:hasTemporality mlo:HISTORICAL_AGGREGATE ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_predicted_pedestrian_flow rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "predicted_pedestrian_flow" ;
    mlo:labelDescription "Macroscopic prediction of pedestrian volume along a network edge, generated by the UNA model."@en ;
    mlo:hasLabelFamily mlo:ActiveMobilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


#################################################################
#    LABEL DEFINITIONS — FLEET MANAGEMENT PERSONA
#    Source: Fleet_Manager_Annotation_Taxonomy_Table.xlsx
#    Sheet: Labels Taxonomy
#################################################################

# =============================================================================
# Family: Trip-Level Labels (Fleet Management)
# =============================================================================

mlo:ld_trip_intent_fleet rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "trip_intent" ;
    mlo:labelDescription "Purpose classification for a commercial fleet trip. Identifies the operational function of the trip within the fleet's mission. Values are fleet-context specific and differ from the Transportation Planning intent vocabulary."@en ;
    mlo:hasLabelFamily mlo:TripLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "service_call, delivery, inspection, detour, idle_loop" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Predictive model using: resolved destination POI type, GKG neighborhood attributes, stop sequence data (number of stops, stop durations, inter-stop distances), temporal context. Fleet-specific intent model trained on labeled commercial trip data."@en ;
    mlo:gkgDependency "uko:PointOfInterest type hierarchy, uko:RoadSegment attributes" ;
    mlo:telematicsDependency "GPS trace, stop sequence data" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_mission_criticality rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "mission_criticality" ;
    mlo:labelDescription "Operational importance classification of a fleet trip, derived from trip intent and destination POI type. Determines dispatch priority and service level expectations."@en ;
    mlo:hasLabelFamily mlo:TripLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "incidental, elective, required" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rules on trip_intent and destination POI type. Required: service_call to critical infrastructure, medical, or emergency POI; or inspection trips. Elective: delivery, scheduled service visit. Incidental: detour, personal stop during work hours."@en ;
    mlo:gkgDependency "uko:PointOfInterest type hierarchy" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_trip_intent_fleet ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_route_type rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "route_type" ;
    mlo:labelDescription "Classification of a trip's route geometry based on the road type composition of its segments. Distinguishes direct routes, circuitous routes with logical reason, and constrained routes forced by network restrictions."@en ;
    mlo:hasLabelFamily mlo:TripLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_ROUTE ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "direct, circuitous, constrained" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
        mlo:generationDescription "Aggregation of road type composition across route segments. Direct: actual distance within X% of geodesic distance. Constrained: route includes segments with uko:maxGrossVehicleWeightKg or uko:verticalClearanceMeters restrictions. Circuitous: actual distance exceeds direct threshold without physical constraints."@en ;
    mlo:gkgDependency "uko:roadClassification, uko:maxGrossVehicleWeightKg, uko:verticalClearanceMeters, uko:permittedModalities" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_schedule_alignment rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "schedule_alignment" ;
    mlo:labelDescription "Compares actual trip timestamps (departure, arrival) with planned schedule data to classify the trip's punctuality."@en ;
    mlo:hasLabelFamily mlo:TripLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "early, on_time, delayed" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rule: on_time if arrival_time within [planned_arrival - early_threshold, planned_arrival + late_threshold]; early if arrived before early_threshold; delayed otherwise. Thresholds configurable per account in Configuration Snapshot."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "GPS timestamps" ;
    mlo:externalDataDependency "Planned schedule data" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_trip_completion_status rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "trip_completion_status" ;
    mlo:labelDescription "Whether a fleet trip was completed as planned, ended early, or deviated from the planned destination."@en ;
    mlo:hasLabelFamily mlo:TripLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "completed, truncated, deviated" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rules: completed if actual destination within destination_proximity_radius of planned destination; truncated if trip ended more than N minutes early and distance to planned destination > threshold; deviated if actual destination differs substantially from planned destination."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "GPS trace" ;
    mlo:externalDataDependency "Planned schedule data" ;
    mlo:requiredInputLabel mlo:ld_exception_type ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_trip_productivity_score rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "trip_productivity_score" ;
    mlo:labelDescription "Composite numeric index measuring the productive output of a fleet trip relative to its duration, distance, and cost. Incorporates stop-level productivity assessments."@en ;
    mlo:hasLabelFamily mlo:TripLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:NUMERIC_INDEX ;
    mlo:permittedValues "numeric index" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Scoring function: f(trip_duration, trip_distance, stop_count, stop_productivity_distribution, trip_cost). Weights configurable per fleet vertical in Configuration Snapshot."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "GPS timestamps, odometer/trip cost data" ;
    mlo:externalDataDependency "Trip cost data" ;
    mlo:requiredInputLabel mlo:ld_stop_productivity ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Stop-Level Labels
# =============================================================================

mlo:ld_stop_type rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "stop_type" ;
    mlo:labelDescription "Classifies a stop event relative to the planned schedule: whether it was an expected stop, an unplanned addition, a route deviation, or an unexplained extended dwell."@en ;
    mlo:hasLabelFamily mlo:StopLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_STOP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "planned, unplanned, detour, unscheduled_dwell" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Compares stop location and timestamp against planned schedule data. Planned: stop within proximity threshold of scheduled waypoint. Detour: stop at a location not on the planned route. Unscheduled_dwell: vehicle stationary for > dwell_threshold minutes without a scheduled stop."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "GPS trace" ;
    mlo:externalDataDependency "Planned schedule data" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_stop_intent rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "stop_intent" ;
    mlo:labelDescription "Purpose classification for an individual stop event within a fleet trip. Distinguishes loading/unloading, active service delivery, driver breaks, idle time, and curb-blocked stops."@en ;
    mlo:hasLabelFamily mlo:StopLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_STOP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "loading, service, break, idle, blocked_curb" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Predictive model using: resolved POI type, GKG curb attributes (curb_access_score), stop duration (dwellTimeSeconds), time-of-day, proximity to known depot/warehouse POIs."@en ;
    mlo:gkgDependency "uko:PointOfInterest type hierarchy, uko:hasOnStreetParking, uko:parkingConfiguration" ;
    mlo:telematicsDependency "GPS dwell detection" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_stop_duration_category rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "stop_duration_category" ;
    mlo:labelDescription "Ordinal categorization of a stop event's dwell time into operational bins. Thresholds are fleet-vertical dependent and configurable."@en ;
    mlo:hasLabelFamily mlo:StopLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_STOP ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "short, medium, long" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rule on dwellTimeSeconds. Default thresholds (configurable per fleet vertical): short < 5 min; medium 5–20 min; long > 20 min."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "GPS dwell detection" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_curb_access_score rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "curb_access_score" ;
    mlo:labelDescription "Categorical rating of curb access feasibility at a stop location. Derived from GKG curb infrastructure attributes and street imagery analysis. Critical for parcel delivery and field service fleet route planning."@en ;
    mlo:hasLabelFamily mlo:StopLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_STOP ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "unavailable, constrained, easy" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Scoring function on GKG attributes at the stop location's adjacent segment: uko:hasOnStreetParking, uko:parkingConfiguration, uko:roadClassification, uko:numberOfLanes, presence of loading zone POI within proximity threshold."@en ;
    mlo:gkgDependency "uko:hasOnStreetParking, uko:parkingConfiguration, uko:roadClassification, uko:numberOfLanes" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Street imagery (Mapillary, supplemental)" ;
    mlo:hasPipelineStage mlo:STAGE_3 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_stop_productivity rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "stop_productivity" ;
    mlo:labelDescription "Operational productivity classification for a stop event. Derived from stop_intent and stop_duration_category. Determines whether the stop contributed to the fleet mission or represents wasted time."@en ;
    mlo:hasLabelFamily mlo:StopLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_STOP ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "idle, incidental, mission_critical" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rules on stop_intent × stop_duration_category: mission_critical if intent ∈ {loading, service}; idle if intent ∈ {idle, blocked_curb} AND duration = long; incidental otherwise."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_stop_intent ;
    mlo:requiredInputLabel mlo:ld_stop_duration_category ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_poi_type rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "POI_type" ;
    mlo:labelDescription "The functional category of the resolved Point of Interest at a stop location. Sourced from the GKG POI taxonomy (UKO). Used as a primary feature in intent models and mission criticality rules."@en ;
    mlo:hasLabelFamily mlo:StopLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_STOP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "business, residential, industrial, depot, government, healthcare, education, retail, food_service, other" ;
    mlo:hasGenerationMechanism mlo:GKG_LOOKUP ;
    mlo:generationDescription "Direct lookup of UKO POI class for the stop's resolved tko:resolvedPOI. The full UKO POI taxonomy is collapsed to the top-level categories listed in permittedValues for fleet management use."@en ;
    mlo:gkgDependency "uko:PointOfInterest, uko:PointOfInterest subclass hierarchy" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_3 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Segment-Level Labels (Fleet Management)
# =============================================================================

mlo:ld_segment_risk_score_fleet rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "segment_risk_score" ;
    mlo:labelDescription "Risk classification for a road segment in the fleet management context. Fleet variant of the segment risk score: ordinal tier derived from uko:segmentRiskScore with fleet-specific risk factor weighting."@en ;
    mlo:hasLabelFamily mlo:SegmentLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "low, medium, high" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Neural network combining: uko:segmentRiskScore (pre-computed in Setup), historical crash data, GKG road geometry attributes, real-time traffic/incident overlays, weather enhancements. Fleet variant weights truck activity and vehicle load stress more heavily than the transportation planning variant."@en ;
    mlo:gkgDependency "uko:segmentRiskScore, uko:onHIN, uko:roadClassification, uko:p85Speed, uko:truckVMTShare" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Historical crash data, real-time traffic overlay, weather overlay" ;
    mlo:hasPipelineStage mlo:STAGE_6 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_surface_type rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "surface_type" ;
    mlo:labelDescription "Road surface material classification for a segment. Used in predictive maintenance models to estimate vehicle wear and in eco-driving calculations."@en ;
    mlo:hasLabelFamily mlo:SegmentLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "asphalt, gravel, unpaved, alley" ;
    mlo:hasGenerationMechanism mlo:GKG_LOOKUP ;
    mlo:generationDescription "Direct lookup of uko:surfaceType from the GKG road segment entity."@en ;
    mlo:gkgDependency "uko:surfaceType" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_3 ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_elevation_variance rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "elevation_variance" ;
    mlo:labelDescription "Classification of topographic variation along a road segment, derived from elevation data. Used in predictive maintenance and EV range modeling."@en ;
    mlo:hasLabelFamily mlo:SegmentLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "flat, moderate, steep" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Statistical variance of elevation samples along the segment from a DEM or Elevation Overlay dataset. Thresholds: flat < 2% grade variance; steep > 6%."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Elevation overlay (DEM)" ;
    mlo:hasPipelineStage mlo:STAGE_3 ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_congestion_profile rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "congestion_profile" ;
    mlo:labelDescription "Characterizes the temporal pattern of traffic congestion on a road segment: whether congestion is reliably present at predictable times, concentrated in peak periods, or irregular."@en ;
    mlo:hasLabelFamily mlo:SegmentLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "consistent, peak_period, irregular" ;
    mlo:hasGenerationMechanism mlo:EXTERNAL_API_LOOKUP ;
    mlo:generationDescription "Derived from real-time traffic data provider (HERE, INRIX) speed ratio data: actual speed / free-flow speed across time-of-day bins. Consistent: always congested. Peak_period: congested only during AM/PM peak windows. Irregular: variable."@en ;
    mlo:gkgDependency "uko:p85Speed, uko:p50Speed" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "HERE Traffic API or INRIX congestion feed" ;
    mlo:hasPipelineStage mlo:STAGE_3 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_construction_presence rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "construction_presence" ;
    mlo:labelDescription "Binary flag indicating whether active construction activity is present on or immediately adjacent to a road segment at the time of the trip."@en ;
    mlo:hasLabelFamily mlo:SegmentLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "yes, no" ;
    mlo:hasGenerationMechanism mlo:EXTERNAL_API_LOOKUP ;
    mlo:generationDescription "Lookup from real-time event data providers: Waze, 511, DOT construction zone APIs."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Waze API, 511, DOT construction zone APIs" ;
    mlo:hasPipelineStage mlo:REAL_TIME ;
    mlo:hasTemporality mlo:REAL_TIME_TEMPORAL ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_speed_variability rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "speed_variability" ;
    mlo:labelDescription "Classification of speed consistency observed along a road segment during the trip. Captures the degree of stop-and-go behavior experienced, which is a direct input to eco-driving and harsh event contextualization."@en ;
    mlo:hasLabelFamily mlo:SegmentLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "stable, inconsistent, high_fluctuation" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Speed variance calculation from the Speed Profile enhancement for the segment. Stable: speed variance < threshold_1. High_fluctuation: speed variance > threshold_2."@en ;
    mlo:gkgDependency "uko:p15Speed, uko:p50Speed, uko:p85Speed" ;
    mlo:telematicsDependency "GPS speed profile" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_3 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_environmental_load rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "environmental_load" ;
    mlo:labelDescription "Categorical classification of the environmental stress conditions experienced on a segment, combining weather and surface type. Used in predictive maintenance modeling."@en ;
    mlo:hasLabelFamily mlo:SegmentLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "neutral, heat, cold, pollution" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Scoring function combining weather_overlay (temperature, precipitation) and surface_type. Heat: ambient temperature > heat_threshold. Cold: temperature < cold_threshold. Pollution: urban canyon + high traffic density."@en ;
    mlo:gkgDependency "uko:surfaceType" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Weather overlay" ;
    mlo:requiredInputLabel mlo:ld_weather_overlay ;
    mlo:requiredInputLabel mlo:ld_surface_type ;
    mlo:hasPipelineStage mlo:STAGE_3 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Event-Based Labels
# =============================================================================

mlo:ld_weather_overlay rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "weather_overlay" ;
    mlo:labelDescription "Primary weather condition category applicable to the trip at the time of travel. Translated from granular weather data into a single dominant category for use in safety scoring, maintenance modeling, and route optimization."@en ;
    mlo:hasLabelFamily mlo:EventBasedFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "neutral, rain, fog, heat, snow, wind" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rules translating detailed weather API data (temperature, precipitation type and rate, visibility, wind speed) into dominant category. Priority order when multiple conditions are present: snow > fog > rain > wind > heat > neutral."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Weather API (OpenWeatherMap, Tomorrow.io, or equivalent)" ;
    mlo:hasPipelineStage mlo:STAGE_3 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_event_zone_tag rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "event_zone_tag" ;
    mlo:labelDescription "Identifies whether the trip route passes through an active special event zone. Affects route planning and arrival time predictions."@en ;
    mlo:hasLabelFamily mlo:EventBasedFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_ROUTE ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "none, parade, protest, marathon, festival, sports_event" ;
    mlo:hasGenerationMechanism mlo:EXTERNAL_API_LOOKUP ;
    mlo:generationDescription "Lookup from real-time event data providers (Ticketmaster, SeatGeek, municipal event calendars, Waze)."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Real-time event APIs" ;
    mlo:hasPipelineStage mlo:REAL_TIME ;
    mlo:hasTemporality mlo:REAL_TIME_TEMPORAL ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_incident_zone_tag rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "incident_zone_tag" ;
    mlo:labelDescription "Identifies whether the trip route passes through an active traffic incident zone."@en ;
    mlo:hasLabelFamily mlo:EventBasedFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_ROUTE ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "none, crash_site, emergency_scene, stalled_vehicle" ;
    mlo:hasGenerationMechanism mlo:EXTERNAL_API_LOOKUP ;
    mlo:generationDescription "Lookup from real-time traffic and incident APIs: Waze, HERE Incidents, TomTom."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Real-time traffic/incident APIs" ;
    mlo:hasPipelineStage mlo:REAL_TIME ;
    mlo:hasTemporality mlo:REAL_TIME_TEMPORAL ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_real_time_deviation_trigger rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "real_time_deviation_trigger" ;
    mlo:labelDescription "Root cause classification of a real-time deviation from the planned route, detected by comparing actual vehicle path with planned route."@en ;
    mlo:hasLabelFamily mlo:EventBasedFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "none, congestion, closure, incident, unknown" ;
    mlo:hasGenerationMechanism mlo:HEURISTIC ;
    mlo:generationDescription "Real-time comparison of GPS position against planned route. When deviation detected, cross-reference with congestion_profile, construction_presence, and incident_zone_tag overlays to classify cause."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "GPS trace, real-time vehicle location" ;
    mlo:externalDataDependency "Planned schedule data" ;
    mlo:requiredInputLabel mlo:ld_congestion_profile ;
    mlo:requiredInputLabel mlo:ld_construction_presence ;
    mlo:requiredInputLabel mlo:ld_incident_zone_tag ;
    mlo:hasPipelineStage mlo:REAL_TIME ;
    mlo:hasTemporality mlo:REAL_TIME_TEMPORAL ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_exception_type rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "exception_type" ;
    mlo:labelDescription "Specific operational exception classification triggered by a route deviation or schedule disruption."@en ;
    mlo:hasLabelFamily mlo:EventBasedFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "none, reroute, dwell_extension, skipped_stop" ;
    mlo:hasGenerationMechanism mlo:HEURISTIC ;
    mlo:generationDescription "Heuristic classification of operational exception from real_time_deviation_trigger. Reroute: vehicle took alternate route. Dwell_extension: stop significantly exceeded planned duration. Skipped_stop: vehicle bypassed a planned waypoint."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "GPS trace" ;
    mlo:externalDataDependency "Planned schedule data" ;
    mlo:requiredInputLabel mlo:ld_real_time_deviation_trigger ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Vehicle Health Labels
# =============================================================================

mlo:ld_vehicle_load_stress rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "vehicle_load_stress" ;
    mlo:labelDescription "Ordinal classification of cumulative mechanical stress experienced by the vehicle during the trip, derived from speed/acceleration patterns, segment type, and elevation."@en ;
    mlo:hasLabelFamily mlo:VehicleHealthFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "low, medium, high" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Scoring model using: GPS-derived acceleration/deceleration magnitude, surface_type distribution across route segments, elevation_variance, total trip distance."@en ;
    mlo:gkgDependency "uko:surfaceType, uko:p85Speed" ;
    mlo:telematicsDependency "GPS speed profile, OBD-II accelerometer" ;
    mlo:externalDataDependency "Elevation overlay" ;
    mlo:requiredInputLabel mlo:ld_surface_type ;
    mlo:requiredInputLabel mlo:ld_elevation_variance ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_thermal_stress_exposure rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "thermal_stress_exposure" ;
    mlo:labelDescription "Cumulative thermal stress experienced by the vehicle during the trip, measured as the heat stress index or cumulative time in adverse temperature conditions."@en ;
    mlo:hasLabelFamily mlo:VehicleHealthFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:NUMERIC_INDEX ;
    mlo:permittedValues "numeric heat index or cumulative minutes in adverse temperature" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Cumulative time spent in conditions where ambient temperature exceeds heat_threshold or falls below cold_threshold, derived from weather_overlay and trip duration."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Weather overlay" ;
    mlo:requiredInputLabel mlo:ld_weather_overlay ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_stop_start_cycles rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "stop_start_cycles" ;
    mlo:labelDescription "Integer count of complete engine stop/start events during the trip. Each cycle contributes to starter motor and battery wear. High counts indicate urban stop-and-go or excessive idling patterns."@en ;
    mlo:hasLabelFamily mlo:VehicleHealthFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:NUMERIC_INDEX ;
    mlo:permittedValues "integer ≥ 0" ;
    mlo:hasGenerationMechanism mlo:SENSOR_FUSION ;
    mlo:generationDescription "Count of engine on/off transitions from telematics OBD-II or ignition sensor data over the trip duration."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "OBD-II ignition/engine state sensor" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_high_altitude_exposure rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "high_altitude_exposure" ;
    mlo:labelDescription "Whether the trip included time or distance above a configured altitude threshold. Relevant for vehicles with turbocharged or altitude-sensitive engines."@en ;
    mlo:hasLabelFamily mlo:VehicleHealthFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:COMPOSITE ;
    mlo:permittedValues "yes/no; if yes, cumulative minutes above threshold" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Cumulative time or distance traveled above altitude_threshold from Elevation Overlay data. Threshold configurable per vehicle type in Configuration Snapshot."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Elevation overlay (DEM)" ;
    mlo:hasPipelineStage mlo:STAGE_3 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_mission_vehicle_alignment rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "mission_vehicle_alignment" ;
    mlo:labelDescription "Assessment of how well matched the assigned vehicle is to the demands of the trip's route and mission. Used in fleet composition analysis and dispatch suitability decisions."@en ;
    mlo:hasLabelFamily mlo:VehicleHealthFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "poor, marginal, good" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Scoring function comparing route difficulty attributes (elevation_variance, surface_type, vehicle_load_stress) against vehicle characteristics (payload capacity, drivetrain type, tow rating)."@en ;
    mlo:gkgDependency "uko:surfaceType" ;
    mlo:telematicsDependency "Vehicle characteristics registry" ;
    mlo:externalDataDependency "Vehicle characteristics data" ;
    mlo:requiredInputLabel mlo:ld_elevation_variance ;
    mlo:requiredInputLabel mlo:ld_vehicle_load_stress ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_eco_driving_score rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "eco_driving_score" ;
    mlo:labelDescription "Composite numeric index measuring the fuel efficiency and emissions impact of a driver's behavior during the trip. Accounts for route context (speed limits, congestion) when evaluating acceleration and braking events."@en ;
    mlo:hasLabelFamily mlo:VehicleHealthFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:permittedValues "0.0–1.0, where 1.0 = most efficient" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Neural network model using: speed profile, acceleration/deceleration events, idle time duration, road speed limits (uko:speedLimit), speed_variability of traversed segments."@en ;
    mlo:gkgDependency "uko:speedLimit, uko:p85Speed" ;
    mlo:telematicsDependency "GPS speed profile, OBD-II fuel consumption (if available)" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_speed_variability ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_estimated_carbon_footprint rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "estimated_carbon_footprint" ;
    mlo:labelDescription "Estimated CO₂ equivalent emissions for the trip in kilograms. Calculated from distance, speed profile, and vehicle fuel/emissions characteristics."@en ;
    mlo:hasLabelFamily mlo:VehicleHealthFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:NUMERIC_INDEX ;
    mlo:permittedValues "numeric kg CO₂e" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Calculation: trip_distance × fuel_consumption_rate × emissions_factor. Vehicle-type specific emission factors from EPA or manufacturer data. Speed profile adjusts fuel consumption rate from highway baseline."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "GPS odometer, OBD-II fuel data (if available)" ;
    mlo:externalDataDependency "Vehicle characteristics, EPA emissions factors" ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_predicted_maintenance_risk rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "predicted_maintenance_risk" ;
    mlo:labelDescription "Predicted likelihood that the vehicle will require unscheduled maintenance in the near term, based on cumulative stress indicators."@en ;
    mlo:hasLabelFamily mlo:VehicleHealthFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_VEHICLE ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "low, medium, high" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Predictive model using cumulative stress labels across recent trip history: contextual_vehicle_stress_index, vehicle_load_stress, thermal_stress_exposure, stop_start_cycles, high_altitude_exposure, and total mileage."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "Telematics trip history, OBD-II fault codes" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_contextual_vehicle_stress_index ;
    mlo:requiredInputLabel mlo:ld_vehicle_load_stress ;
    mlo:requiredInputLabel mlo:ld_thermal_stress_exposure ;
    mlo:hasPipelineStage mlo:BATCH_AGGREGATE ;
    mlo:hasTemporality mlo:HISTORICAL_AGGREGATE ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_contextual_vehicle_stress_index rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "contextual_vehicle_stress_index" ;
    mlo:labelDescription "Composite vehicle stress index fusing elevation, road surface type, and weather conditions experienced during the trip. Provides a single integrated stress signal for maintenance modeling."@en ;
    mlo:hasLabelFamily mlo:VehicleHealthFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:COMPOSITE ;
    mlo:permittedValues "numeric 0.0–1.0 or Low/Medium/High" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Fusion scoring model combining elevation_variance distribution, surface_type composition, and weather_overlay severity across the trip."@en ;
    mlo:gkgDependency "uko:surfaceType" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Elevation overlay, weather overlay" ;
    mlo:requiredInputLabel mlo:ld_elevation_variance ;
    mlo:requiredInputLabel mlo:ld_surface_type ;
    mlo:requiredInputLabel mlo:ld_weather_overlay ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Driver Behavior
# =============================================================================

mlo:ld_contextual_harsh_event_flag rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "contextual_harsh_event_flag" ;
    mlo:labelDescription "Contextualizes a detected harsh driving event (hard brake, sharp corner, rapid acceleration) as either justified by road conditions or unjustified. Prevents penalizing drivers for appropriate emergency responses."@en ;
    mlo:hasLabelFamily mlo:DriverBehaviorFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "Justified, Unjustified" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rules comparing harsh event sensor data against contextual overlays at the event location and timestamp: Real-Time Traffic Overlay (sudden congestion), incident_zone_tag, road segment geometry (sharp curve, merge, intersection). Justified if contextual evidence supports emergency response; Unjustified otherwise."@en ;
    mlo:gkgDependency "uko:roadClassification, uko:p85Speed, uko:onHIN" ;
    mlo:telematicsDependency "Harsh event sensor data (accelerometer, gyroscope)" ;
    mlo:externalDataDependency "Real-time traffic overlay" ;
    mlo:requiredInputLabel mlo:ld_incident_zone_tag ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Operational Efficiency
# =============================================================================

mlo:ld_trip_chain_efficiency rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "trip_chain_efficiency" ;
    mlo:labelDescription "Assessment of whether a multi-stop trip's stop sequence was logically ordered to minimize total travel distance and time, or whether backtracking and inefficient sequencing were present."@en ;
    mlo:hasLabelFamily mlo:OperationalEfficiencyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "poor, suboptimal, optimal" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Scoring function analyzing stop sequence for logical geographic ordering: compares actual stop sequence distance against optimal TSP solution distance. Optimal: within X% of TSP optimum. Poor: exceeds TSP + Y%."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "Stop sequence data, GPS coordinates" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_driver_route_risk_compatibility_score rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "driver_route_risk_compatibility_score" ;
    mlo:labelDescription "Numeric compatibility score matching a driver's historical risk profile against the contextual risk attributes of a planned route. High scores indicate strong match; low scores indicate the driver's history suggests risk on this route type."@en ;
    mlo:hasLabelFamily mlo:OperationalEfficiencyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:permittedValues "0.0–1.0 where 1.0 = perfect compatibility" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Neural network comparing driver's historical profile (contextual_harsh_event_flag rate, eco_driving_score distribution, schedule_alignment history) against planned route's contextual risk attributes (segment_risk_score distribution, congestion_profile, weather_overlay forecast). Requires LLM component for narrative explanation."@en ;
    mlo:gkgDependency "uko:segmentRiskScore, uko:onHIN" ;
    mlo:telematicsDependency "Driver profile (historical trip labels)" ;
    mlo:externalDataDependency "Planned schedule data" ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_predicted_late_arrival rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "predicted_late_arrival" ;
    mlo:labelDescription "Binary prediction of whether the vehicle will arrive at its next planned stop or final destination after the scheduled arrival time, with associated probability."@en ;
    mlo:hasLabelFamily mlo:OperationalEfficiencyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:PROBABILITY ;
    mlo:permittedValues "yes/no with probability 0.0–1.0" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Predictive model using: real-time traffic overlay, event_zone_tag and construction_presence on planned route, historical route travel time distribution, current time relative to planned departure."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "Real-time vehicle location" ;
    mlo:externalDataDependency "Planned schedule data, real-time traffic overlay" ;
    mlo:requiredInputLabel mlo:ld_congestion_profile ;
    mlo:requiredInputLabel mlo:ld_event_zone_tag ;
    mlo:requiredInputLabel mlo:ld_construction_presence ;
    mlo:hasPipelineStage mlo:REAL_TIME ;
    mlo:hasTemporality mlo:REAL_TIME_TEMPORAL ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Regulatory & Compliance
# =============================================================================

mlo:ld_restricted_road_usage rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "restricted_road_usage" ;
    mlo:labelDescription "Binary flag indicating whether the vehicle traversed a road segment for which it is not permitted under the applicable compliance ruleset (weight, height, hazmat, local restrictions)."@en ;
    mlo:hasLabelFamily mlo:RegulatoryComplianceFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "yes, no" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rule: for each segment in reconstructed route, check uko:maxGrossVehicleWeightKg, uko:verticalClearanceMeters, uko:permittedModalities against vehicle characteristics in Compliance Ruleset. Flag yes if any segment fails for this vehicle."@en ;
    mlo:gkgDependency "uko:maxGrossVehicleWeightKg, uko:verticalClearanceMeters, uko:permittedModalities, uko:roadClassification" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "Compliance ruleset, vehicle characteristics" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_hours_of_service_risk rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "hours_of_service_risk" ;
    mlo:labelDescription "Compliance risk classification for FMCSA Hours of Service regulations, based on cumulative driving time within the applicable HOS window."@en ;
    mlo:hasLabelFamily mlo:RegulatoryComplianceFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_DRIVER ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "compliant, warning, violation" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rule: track cumulative on-duty and driving time against HOS ruleset thresholds. Warning: within N minutes of limit. Violation: limit exceeded."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "Cumulative driving time from ELD/telematics" ;
    mlo:externalDataDependency "Compliance ruleset (FMCSA HOS regulations)" ;
    mlo:hasPipelineStage mlo:REAL_TIME ;
    mlo:hasTemporality mlo:REAL_TIME_TEMPORAL ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: EV Management
# =============================================================================

mlo:ld_ev_range_sufficiency rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "ev_range_sufficiency" ;
    mlo:labelDescription "Prediction of whether the vehicle's current state of charge is sufficient to complete the planned route including all stops, given terrain and weather conditions."@en ;
    mlo:hasLabelFamily mlo:EVManagementFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:ORDINAL ;
    mlo:permittedValues "Insufficient, Marginal, Sufficient" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Predictive model using: EV battery SoC at trip start, planned route geometry length, elevation_variance across route, weather_overlay (temperature affects battery range), historical energy consumption rate for vehicle type."@en ;
    mlo:gkgDependency "uko:annualVMT" ;
    mlo:telematicsDependency "EV battery SoC sensor" ;
    mlo:externalDataDependency "Planned schedule data, weather overlay, elevation overlay" ;
    mlo:requiredInputLabel mlo:ld_elevation_variance ;
    mlo:requiredInputLabel mlo:ld_weather_overlay ;
    mlo:hasPipelineStage mlo:REAL_TIME ;
    mlo:hasTemporality mlo:REAL_TIME_TEMPORAL ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_charging_opportunity_missed rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "charging_opportunity_missed" ;
    mlo:labelDescription "Binary flag indicating whether the vehicle passed a compatible charging station with sufficient dwell opportunity but did not charge, when the battery SoC was below an optimal charging threshold."@en ;
    mlo:hasLabelFamily mlo:EVManagementFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "Yes, No" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rules: identify charging station POIs within proximity threshold of the trip route (GKG query on uko:EVChargingStation); check if SoC was below charging_threshold when passing; check if dwell time at adjacent stop exceeded minimum_charging_dwell. All three conditions true → missed opportunity."@en ;
    mlo:gkgDependency "uko:PointOfInterest (EVChargingStation subclass)" ;
    mlo:telematicsDependency "EV battery SoC sensor" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_charging_session_type rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "charging_session_type" ;
    mlo:labelDescription "Classification of an EV charging session by location type and charger level. Used in EV fleet optimization and operational planning."@en ;
    mlo:hasLabelFamily mlo:EVManagementFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_STOP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "Depot - Level 2, Public - DC Fast Charge, Opportunistic - Level 2" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rules on stop dwell time combined with GKG query to identify the POI type. Depot: stop at fleet home base POI with charger. DC Fast Charge: public DCFC POI + dwell < 45 min. Opportunistic Level 2: non-depot L2 charger POI."@en ;
    mlo:gkgDependency "uko:PointOfInterest (EVChargingStation subclass, charger level attributes)" ;
    mlo:telematicsDependency "EV battery SoC sensor, dwell detection" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_5 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Video Intelligence
# =============================================================================

mlo:ld_driver_state_detected rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "driver_state_detected" ;
    mlo:labelDescription "Driver state classification from AI analysis of in-cab camera footage. Detects distraction, drowsiness, and compliance violations."@en ;
    mlo:hasLabelFamily mlo:VideoIntelligenceFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:CATEGORICAL ;
    mlo:permittedValues "Attentive, Distracted - Cell Phone, Drowsy, Smoking, No Seatbelt" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "CNN or Vision Transformer applied to video clip ingestion enhancement. Frame-level classifications aggregated to trip-level dominant state."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "In-cab camera video clip ingestion" ;
    mlo:externalDataDependency "AI Video Analysis Model (external service or embedded)" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "true"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_video_evidence_available rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "video_evidence_available" ;
    mlo:labelDescription "Binary flag indicating whether a video clip time-synchronized with a harsh event or compliance incident exists in the system."@en ;
    mlo:hasLabelFamily mlo:VideoIntelligenceFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "Yes, No" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Check for existence of video clip record with timestamp within ±N seconds of harsh_event timestamp."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "In-cab camera video clip ingestion, harsh event sensor data" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_contextual_harsh_event_flag ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Family: Cargo & Asset Monitoring
# =============================================================================

mlo:ld_cargo_temperature_compliance rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "cargo_temperature_compliance" ;
    mlo:labelDescription "Whether cargo temperature remained within the required compliance range throughout the trip. Critical for perishable food, pharmaceutical, and medical supply fleets."@en ;
    mlo:hasLabelFamily mlo:CargoAssetFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "In Range, Out of Range" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rules: compare cargo temperature sensor readings against compliance ruleset temperature range. Any reading outside the range during the trip flags the trip as Out of Range."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "Cargo temperature sensor" ;
    mlo:externalDataDependency "Compliance ruleset (temperature range requirements)" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_unauthorized_door_opening rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "unauthorized_door_opening" ;
    mlo:labelDescription "Binary flag indicating whether a cargo door was opened at a location outside defined authorized geofences."@en ;
    mlo:hasLabelFamily mlo:CargoAssetFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_TRIP ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "Yes, No" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Rules: door opening event detected from cargo door sensor; vehicle GPS position at event time checked against geofence definitions. Unauthorized if position is outside all authorized geofences."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "Cargo door status sensor, GPS" ;
    mlo:externalDataDependency "Geofence definitions" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Cross-persona route choice labels (used in Transportation Planning
# Route Choice Analysis Model)
# =============================================================================

mlo:ld_shortest_route rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "shortest_route" ;
    mlo:labelDescription "Binary flag indicating whether the actual route taken was the geodesically shortest viable route between origin and destination."@en ;
    mlo:hasLabelFamily mlo:RouteLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_ROUTE ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "Yes, No" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Compare actual route distance against GraphHopper shortest-path alternative. Flag Yes if within X% of minimum distance."@en ;
    mlo:gkgDependency "uko:RoadSegment geometry" ;
    mlo:telematicsDependency "GPS trace" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_fastest_route rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "fastest_route" ;
    mlo:labelDescription "Binary flag indicating whether the actual route taken was the lowest-travel-time route given conditions at trip time."@en ;
    mlo:hasLabelFamily mlo:RouteLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_ROUTE ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "Yes, No" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Compare actual route travel time against GraphHopper fastest-path alternative using congestion_profile inputs."@en ;
    mlo:gkgDependency "uko:p85Speed, uko:p50Speed" ;
    mlo:telematicsDependency "GPS timestamps" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_congestion_profile ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_safest_route rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "safest_route" ;
    mlo:labelDescription "Binary flag indicating whether the actual route taken was the lowest-risk alternative available, as measured by the weighted mean segmentRiskScore."@en ;
    mlo:hasLabelFamily mlo:RouteLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_ROUTE ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "Yes, No" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Compare actual route's mean uko:segmentRiskScore against Stage 2 alternative routes. Flag Yes if actual route score is within X% of minimum-risk alternative."@en ;
    mlo:gkgDependency "uko:segmentRiskScore, uko:onHIN" ;
    mlo:telematicsDependency "GPS trace" ;
    mlo:externalDataDependency "none" ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_congested_route rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "congested_route" ;
    mlo:labelDescription "Binary flag indicating whether the actual route traversed a significant proportion of segments classified as peak_period or consistent congestion."@en ;
    mlo:hasLabelFamily mlo:RouteLevelFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_ROUTE ;
    mlo:hasValueType mlo:BINARY ;
    mlo:permittedValues "Yes, No" ;
    mlo:hasGenerationMechanism mlo:RULE_BASED ;
    mlo:generationDescription "Flag Yes if more than congestion_threshold (default 30%) of route segments have congestion_profile = peak_period or consistent."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_congestion_profile ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


#################################################################
#    ACTIVE MOBILITY SEGMENT RISK LABELS
#    These labels appear in the Transportation Planning model
#    registry but were not in the taxonomy table — inferred
#    from the Infrastructure & Safety Risk Model inputs.
#################################################################

mlo:ld_active_mobility_segment_risk_score rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "active_mobility_segment_risk_score" ;
    mlo:labelDescription "Composite risk score for a road segment specific to active mobility users (pedestrians and cyclists). Distinct from the general segment_traffic_risk_score: weights VRU-specific factors (pedestrian AADT, cycling infrastructure absence, HIN designation) more heavily."@en ;
    mlo:hasLabelFamily mlo:InfrastructureSafetyFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_SEGMENT ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:permittedValues "0.0–1.0" ;
    mlo:hasGenerationMechanism mlo:SUPERVISED_ML ;
    mlo:generationDescription "Predictive model with VRU-weighted inputs: vulnerable_road_user_incident_density, pedestrian_infrastructure_score, cycling_infrastructure_score, uko:pedestrianAADT, uko:onHIN, uko:p85Speed."@en ;
    mlo:gkgDependency "uko:pedestrianAADT, uko:onHIN, uko:p85Speed, uko:hasSidewalk, uko:bikeFacilityType" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "SWITRS VRU collision data" ;
    mlo:requiredInputLabel mlo:ld_vulnerable_road_user_incident_density ;
    mlo:requiredInputLabel mlo:ld_pedestrian_infrastructure_score ;
    mlo:requiredInputLabel mlo:ld_cycling_infrastructure_score ;
    mlo:hasPipelineStage mlo:SETUP_PHASE ;
    mlo:hasTemporality mlo:STATIC ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:ld_active_mobility_route_risk_score rdf:type owl:NamedIndividual, mlo:LabelDefinition ;
    mlo:labelName "active_mobility_route_risk_score" ;
    mlo:labelDescription "Aggregated risk score for an active mobility trip's entire route. Mean of active_mobility_segment_risk_score across all segments traversed."@en ;
    mlo:hasLabelFamily mlo:ActiveMobilityFamily ;
    mlo:hasAttachmentGranularity mlo:GRANULARITY_ROUTE ;
    mlo:hasValueType mlo:NUMERIC_SCORE ;
    mlo:permittedValues "0.0–1.0" ;
    mlo:hasGenerationMechanism mlo:SCORING_FUNCTION ;
    mlo:generationDescription "Weighted mean of active_mobility_segment_risk_score across the reconstructed route segments."@en ;
    mlo:gkgDependency "none" ;
    mlo:telematicsDependency "none" ;
    mlo:externalDataDependency "none" ;
    mlo:requiredInputLabel mlo:ld_active_mobility_segment_risk_score ;
    mlo:requiredInputLabel mlo:ld_active_mobility_route ;
    mlo:hasPipelineStage mlo:STAGE_4 ;
    mlo:hasTemporality mlo:TRIP_TIME ;
    mlo:isTargetVariable "false"^^xsd:boolean ;
    mlo:labelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


#################################################################
#    PILLAR 7: ANALYTICS MODEL POPULATION
#    Source: Transportation_Planner_Annotation_Taxonomy_Table.xlsx
#             Sheet: Transportation Planning AI Models
#           Fleet_Manager_Annotation_Taxonomy_Table.xlsx
#             Sheet: Fleet Management AI Models Detail
#################################################################

# =============================================================================
# Transportation Planning Models
# =============================================================================

mlo:model_active_mobility_hotspot rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Active Mobility Hotspot Model" ;
    mlo:modelDescription "Identifies geographic areas with high active mobility trip origin density. Produces spatial hotspot maps for transportation planning investment prioritization."@en ;
    mlo:hasModelArchitecture mlo:GEOSPATIAL_AGGREGATION ;
    mlo:consumesLabel mlo:ld_active_mobility_route ;
    mlo:consumesLabel mlo:ld_active_mobility_density ;
    mlo:consumesEnhancement "Geographic Boundary Data (census tracts, city blocks), Home_Census_Tract base attribute" ;
    mlo:modelPersonaScope mlo:TransportationPlanningPersona ;
    mlo:modelTaskContext mlo:ACTIVE_MOBILITY_ANALYSIS ;
    mlo:modelTaskContext mlo:INFRASTRUCTURE_PLANNING ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_active_mobility_intent rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Active Mobility Intent Model" ;
    mlo:modelDescription "Classifies the purpose of active mobility trips. Used to understand why people walk and cycle, informing infrastructure design that serves actual travel needs."@en ;
    mlo:hasModelArchitecture mlo:NEURAL_NETWORK ;
    mlo:consumesLabel mlo:ld_active_mobility_route ;
    mlo:consumesLabel mlo:ld_traveler_primary_active_intent ;
    mlo:producesLabel mlo:ld_active_mobility_intent ;
    mlo:consumesEnhancement "POI Type, GKG Attributes, Stop Duration, Stop Sequence Data, Temporal Context" ;
    mlo:modelPersonaScope mlo:TransportationPlanningPersona ;
    mlo:modelTaskContext mlo:ACTIVE_MOBILITY_ANALYSIS ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_urban_network_analysis rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Urban Network Analysis (UNA) Model" ;
    mlo:modelDescription "Macroscopic pedestrian flow prediction model leveraging Huff destination choice models and gravity-based distance decay over the UKO multiplex graph."@en ;
    mlo:hasModelArchitecture mlo:SCORING_MODEL ;
    mlo:producesLabel mlo:ld_predicted_pedestrian_flow ;
    mlo:modelPersonaScope mlo:TransportationPlanningPersona ;
    mlo:modelTaskContext mlo:ACTIVE_MOBILITY_ANALYSIS ;
    mlo:modelTaskContext mlo:INFRASTRUCTURE_PLANNING ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_infrastructure_safety_risk rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Infrastructure & Safety Risk Model" ;
    mlo:modelDescription "Predicts segment-level safety risk for transportation planning purposes. Integrates collision history, traffic volumes, and road geometry with active mobility exposure factors."@en ;
    mlo:hasModelArchitecture mlo:NEURAL_NETWORK ;
    mlo:consumesLabel mlo:ld_segment_traffic_risk_score ;
    mlo:consumesLabel mlo:ld_traffic_incident_density ;
    mlo:consumesLabel mlo:ld_vulnerable_road_user_incident_density ;
    mlo:consumesLabel mlo:ld_community_crime_risk_index ;
    mlo:consumesLabel mlo:ld_pedestrian_infrastructure_score ;
    mlo:consumesLabel mlo:ld_cycling_infrastructure_score ;
    mlo:consumesLabel mlo:ld_active_mobility_segment_risk_score ;
    mlo:consumesLabel mlo:ld_active_mobility_route_risk_score ;
    mlo:producesLabel mlo:ld_segment_traffic_risk_score ;
    mlo:consumesEnhancement "Historical Traffic Incident Data, Municipal Crime Statistics Data, Vehicle Traffic Volume Data, Road Segment Geometry" ;
    mlo:modelPersonaScope mlo:TransportationPlanningPersona ;
    mlo:modelTaskContext mlo:SAFETY_RISK_ASSESSMENT ;
    mlo:modelTaskContext mlo:INFRASTRUCTURE_PLANNING ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_infrastructure_gap_analysis rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Infrastructure Gap Analysis Model" ;
    mlo:modelDescription "Identifies geographic gaps in pedestrian and cycling infrastructure relative to active mobility demand. Prioritizes infrastructure investment locations."@en ;
    mlo:hasModelArchitecture mlo:SCORING_MODEL ;
    mlo:consumesLabel mlo:ld_pedestrian_infrastructure_score ;
    mlo:consumesLabel mlo:ld_cycling_infrastructure_score ;
    mlo:consumesLabel mlo:ld_active_mobility_density ;
    mlo:consumesLabel mlo:ld_traveler_primary_active_intent ;
    mlo:consumesEnhancement "Sidewalk & Crosswalk Data, Bike Lane Network Data, Geographic Boundary Data" ;
    mlo:modelPersonaScope mlo:TransportationPlanningPersona ;
    mlo:modelTaskContext mlo:INFRASTRUCTURE_PLANNING ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_traveler_behavior_segmentation rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Traveler Behavior Segmentation Model" ;
    mlo:modelDescription "Learns rich, dense traveler representations using autoencoders trained on behavioral label distributions. Enables population-level mode shift analysis and equity-aware program targeting."@en ;
    mlo:hasModelArchitecture mlo:AUTOENCODER ;
    mlo:consumesLabel mlo:ld_traveler_active_mobility_ratio ;
    mlo:consumesLabel mlo:ld_traveler_active_mobility_temporal_profile ;
    mlo:consumesLabel mlo:ld_traveler_primary_active_intent ;
    mlo:consumesEnhancement "Traveler Trip History, Household_Income_Bracket, Vehicle_Ownership_Status, Age_Group base attributes" ;
    mlo:modelPersonaScope mlo:TransportationPlanningPersona ;
    mlo:modelTaskContext mlo:ACTIVE_MOBILITY_ANALYSIS ;
    mlo:modelTaskContext mlo:EQUITY_ANALYSIS ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelNotes "Autoencoder approach (neural network encoder-decoder) to learn dense traveler embeddings. Unsupervised: no labeled target variable. Produces traveler embedding vectors for clustering and downstream analysis."@en ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_route_choice_analysis rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Route Choice Analysis Model" ;
    mlo:modelDescription "Analyzes revealed route preferences by comparing actual routes against available alternatives. Identifies systematic route choice patterns for transportation demand modeling."@en ;
    mlo:hasModelArchitecture mlo:SCORING_MODEL ;
    mlo:consumesLabel mlo:ld_shortest_route ;
    mlo:consumesLabel mlo:ld_fastest_route ;
    mlo:consumesLabel mlo:ld_safest_route ;
    mlo:consumesLabel mlo:ld_congested_route ;
    mlo:consumesEnhancement "Alternative Routes (Stage 2 output), Trip Duration, Trip Distance, Congestion Profile" ;
    mlo:modelPersonaScope mlo:TransportationPlanningPersona ;
    mlo:modelTaskContext mlo:INFRASTRUCTURE_PLANNING ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_active_mobility_adoption rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Active Mobility Adoption Model" ;
    mlo:modelDescription "Models the likelihood of traveler mode shift toward active transportation. Inputs traveler segmentation outputs and demographic base attributes."@en ;
    mlo:hasModelArchitecture mlo:NEURAL_NETWORK ;
    mlo:consumesLabel mlo:ld_traveler_active_mobility_ratio ;
    mlo:consumesLabel mlo:ld_traveler_active_mobility_temporal_profile ;
    mlo:consumesEnhancement "Traveler Trip History, demographic base attributes" ;
    mlo:modelPersonaScope mlo:TransportationPlanningPersona ;
    mlo:modelTaskContext mlo:ACTIVE_MOBILITY_ANALYSIS ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_population_segmentation rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Population Segmentation Model" ;
    mlo:modelDescription "Segments the traveler population by mobility behavior patterns for equity analysis and program targeting."@en ;
    mlo:hasModelArchitecture mlo:AUTOENCODER ;
    mlo:consumesLabel mlo:ld_traveler_active_mobility_ratio ;
    mlo:consumesLabel mlo:ld_traveler_active_mobility_temporal_profile ;
    mlo:consumesEnhancement "Demographic base attributes, Census tract data" ;
    mlo:modelPersonaScope mlo:TransportationPlanningPersona ;
    mlo:modelTaskContext mlo:EQUITY_ANALYSIS ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .


# =============================================================================
# Fleet Management Models
# =============================================================================

mlo:model_service_prioritization rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Service Prioritization Model" ;
    mlo:modelDescription "Prioritizes fleet service requests and dispatches by combining trip intent with mission criticality and destination context. Enables intelligent dispatch allocation."@en ;
    mlo:hasModelArchitecture mlo:RULES_ENGINE ;
    mlo:consumesLabel mlo:ld_trip_intent_fleet ;
    mlo:consumesLabel mlo:ld_mission_criticality ;
    mlo:consumesLabel mlo:ld_stop_intent ;
    mlo:consumesLabel mlo:ld_poi_type ;
    mlo:consumesEnhancement "POI Type, Temporal Context (time-of-day, day-of-week)" ;
    mlo:modelPersonaScope mlo:FleetManagementPersona ;
    mlo:modelPersonaScope mlo:ParcelDeliveryFleet ;
    mlo:modelPersonaScope mlo:FieldServiceFleet ;
    mlo:modelTaskContext mlo:DISPATCH_REVIEW ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_route_planning_optimization rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Route Planning & Optimization Model" ;
    mlo:modelDescription "Optimizes fleet route assignments by balancing efficiency, safety, and operational constraints. Core routing model for fleet operations."@en ;
    mlo:hasModelArchitecture mlo:NEURAL_NETWORK ;
    mlo:consumesLabel mlo:ld_route_type ;
    mlo:consumesLabel mlo:ld_curb_access_score ;
    mlo:consumesLabel mlo:ld_segment_risk_score_fleet ;
    mlo:consumesLabel mlo:ld_congestion_profile ;
    mlo:consumesLabel mlo:ld_construction_presence ;
    mlo:consumesLabel mlo:ld_stop_intent ;
    mlo:consumesLabel mlo:ld_stop_productivity ;
    mlo:consumesLabel mlo:ld_trip_chain_efficiency ;
    mlo:consumesLabel mlo:ld_event_zone_tag ;
    mlo:consumesLabel mlo:ld_poi_type ;
    mlo:consumesEnhancement "Road Segment Geometry (GKG), POI Detection, Vehicle Characteristics" ;
    mlo:modelPersonaScope mlo:FleetManagementPersona ;
    mlo:modelTaskContext mlo:ROUTE_OPTIMIZATION ;
    mlo:requiresLLM "false"^^xsd:boolean ;
    mlo:modelVersion "1.0" ;
    mlo:isDeprecated "false"^^xsd:boolean .

mlo:model_dispatch_performance rdf:type owl:NamedIndividual, mlo:AnalyticsModel ;
    mlo:modelName "Dispatch Performance Model" ;
