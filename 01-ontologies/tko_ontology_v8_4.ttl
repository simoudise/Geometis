###############################################################################
###############################################################################
#
#    TKO v5 EXTENSIONS FOR NEUROSYMBOLIC URBAN MOBILITY SYSTEM
#    Architecture v5.0.0 Compliance
#
###############################################################################
###############################################################################

###############################################################################
#    EXTENSION: TEMPORAL AGGREGATION
#    Source: Architecture v5.0.0 Section 3.2.1
#    Purpose: Enable school safety and temporal pattern analysis
###############################################################################

# =============================================================================
# Part 1: Time Period Linkage
# =============================================================================

tko:tripTimePeriod rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range uko:TimePeriod ;
    rdfs:label "trip time period"@en ;
    rdfs:comment "Time period classification for this trip (links to UKO TimePeriod instances)."@en .

tko:departureTimePeriod rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf tko:tripTimePeriod ;
    rdfs:domain tko:Trip ;
    rdfs:range uko:TimePeriod ;
    rdfs:label "departure time period"@en ;
    rdfs:comment "Time period when trip departure occurred."@en .

tko:arrivalTimePeriod rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf tko:tripTimePeriod ;
    rdfs:domain tko:Trip ;
    rdfs:range uko:TimePeriod ;
    rdfs:label "arrival time period"@en ;
    rdfs:comment "Time period when trip arrival occurred."@en .

# =============================================================================
# Part 2: School Period Flags
# =============================================================================

tko:duringSchoolArrival rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "during school arrival"@en ;
    rdfs:comment "Trip occurred during school arrival period (7:30-8:30 AM on school days)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "temporal_context"^^xsd:string .

tko:duringSchoolDismissal rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "during school dismissal"@en ;
    rdfs:comment "Trip occurred during school dismissal period (2:30-3:30 PM on school days)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "temporal_context"^^xsd:string .

tko:duringSchoolLateDismissal rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "during school late dismissal"@en ;
    rdfs:comment "Trip occurred during school late dismissal period (4:30-5:30 PM)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "temporal_context"^^xsd:string .

tko:isSchoolRelatedTrip rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "is school related trip"@en ;
    rdfs:comment "Trip is related to school activities (drop-off, pick-up, school commute)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "trip_purpose"^^xsd:string .

# =============================================================================
# Part 3: Peak Period Flags
# =============================================================================

tko:duringAMPeak rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "during AM peak"@en ;
    rdfs:comment "Trip occurred during AM peak period (6:00-9:00 AM weekdays)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "temporal_context"^^xsd:string .

tko:duringPMPeak rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "during PM peak"@en ;
    rdfs:comment "Trip occurred during PM peak period (4:00-7:00 PM weekdays)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "temporal_context"^^xsd:string .

tko:duringOffPeak rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "during off peak"@en ;
    rdfs:comment "Trip occurred during off-peak hours."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "temporal_context"^^xsd:string .

tko:isWeekendTrip rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "is weekend trip"@en ;
    rdfs:comment "Trip occurred on Saturday or Sunday."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "temporal_context"^^xsd:string .

tko:isHolidayTrip rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "is holiday trip"@en ;
    rdfs:comment "Trip occurred on a holiday."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "temporal_context"^^xsd:string .

# =============================================================================
# Part 4: Temporal Aggregation Classes
# =============================================================================

tko:TemporalTripAggregate rdf:type owl:Class ;
    rdfs:label "Temporal Trip Aggregate"@en ;
    rdfs:comment "Aggregation of trips for a specific time period and location."@en .

tko:HourlyAggregate rdf:type owl:Class ;
    rdfs:subClassOf tko:TemporalTripAggregate ;
    rdfs:label "Hourly Aggregate"@en ;
    rdfs:comment "Trip aggregation for a one-hour period."@en .

tko:DailyAggregate rdf:type owl:Class ;
    rdfs:subClassOf tko:TemporalTripAggregate ;
    rdfs:label "Daily Aggregate"@en ;
    rdfs:comment "Trip aggregation for a full day."@en .

tko:WeeklyAggregate rdf:type owl:Class ;
    rdfs:subClassOf tko:TemporalTripAggregate ;
    rdfs:label "Weekly Aggregate"@en ;
    rdfs:comment "Trip aggregation for a week."@en .

### Aggregation Properties ###

tko:aggregateTimePeriod rdf:type owl:ObjectProperty ;
    rdfs:domain tko:TemporalTripAggregate ;
    rdfs:range uko:TimePeriod ;
    rdfs:label "aggregate time period"@en ;
    rdfs:comment "Time period for this aggregation."@en .

tko:aggregateLocation rdf:type owl:ObjectProperty ;
    rdfs:domain tko:TemporalTripAggregate ;
    rdfs:range uko:GeographicFeature ;
    rdfs:label "aggregate location"@en ;
    rdfs:comment "Geographic area for this aggregation."@en .

tko:tripCount rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TemporalTripAggregate ;
    rdfs:range xsd:integer ;
    rdfs:label "trip count"@en ;
    rdfs:comment "Number of trips in this aggregate."@en .

tko:averageSpeed rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TemporalTripAggregate ;
    rdfs:range xsd:decimal ;
    rdfs:label "average speed"@en ;
    rdfs:comment "Average trip speed in this aggregate."@en .

tko:averageDuration rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TemporalTripAggregate ;
    rdfs:range xsd:duration ;
    rdfs:label "average duration"@en ;
    rdfs:comment "Average trip duration in this aggregate."@en .

tko:congestionIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TemporalTripAggregate ;
    rdfs:range xsd:decimal ;
    rdfs:label "congestion index"@en ;
    rdfs:comment "Congestion index derived from trips (ratio to free-flow)."@en .

# =============================================================================
# END OF TEMPORAL AGGREGATION EXTENSION
# =============================================================================


###############################################################################
#    EXTENSION: FIRST MILE / LAST MILE TRANSIT ACCESS
#    Source: Architecture v5.0.0 Section 3.2.2
#    Purpose: Model transit access patterns for BART/bus integration
###############################################################################

# =============================================================================
# Part 1: Transit Access Segment Classes
# =============================================================================

tko:FirstMileToTransit rdf:type owl:Class ;
    rdfs:subClassOf tko:FirstMile ;
    rdfs:label "First Mile to Transit"@en ;
    rdfs:comment "First mile segment from origin to transit stop/station."@en .

tko:LastMileFromTransit rdf:type owl:Class ;
    rdfs:subClassOf tko:LastMile ;
    rdfs:label "Last Mile from Transit"@en ;
    rdfs:comment "Last mile segment from transit stop/station to destination."@en .

tko:FirstMileToBus rdf:type owl:Class ;
    rdfs:subClassOf tko:FirstMileToTransit ;
    rdfs:label "First Mile to Bus"@en ;
    rdfs:comment "First mile segment to a bus stop."@en .

tko:FirstMileToRail rdf:type owl:Class ;
    rdfs:subClassOf tko:FirstMileToTransit ;
    rdfs:label "First Mile to Rail"@en ;
    rdfs:comment "First mile segment to a rail station (BART, light rail)."@en .

tko:FirstMileToBART rdf:type owl:Class ;
    rdfs:subClassOf tko:FirstMileToRail ;
    rdfs:label "First Mile to BART"@en ;
    rdfs:comment "First mile segment specifically to a BART station."@en .

tko:LastMileFromBus rdf:type owl:Class ;
    rdfs:subClassOf tko:LastMileFromTransit ;
    rdfs:label "Last Mile from Bus"@en ;
    rdfs:comment "Last mile segment from a bus stop."@en .

tko:LastMileFromRail rdf:type owl:Class ;
    rdfs:subClassOf tko:LastMileFromTransit ;
    rdfs:label "Last Mile from Rail"@en ;
    rdfs:comment "Last mile segment from a rail station."@en .

tko:LastMileFromBART rdf:type owl:Class ;
    rdfs:subClassOf tko:LastMileFromRail ;
    rdfs:label "Last Mile from BART"@en ;
    rdfs:comment "Last mile segment specifically from a BART station."@en .

# =============================================================================
# Part 2: Transit Access Object Properties
# =============================================================================

tko:accessesTransitStop rdf:type owl:ObjectProperty ;
    rdfs:domain tko:FirstMileToTransit ;
    rdfs:range uko:TransitStop ;
    rdfs:label "accesses transit stop"@en ;
    rdfs:comment "Transit stop accessed by this first mile segment."@en .

tko:departsTransitStop rdf:type owl:ObjectProperty ;
    rdfs:domain tko:LastMileFromTransit ;
    rdfs:range uko:TransitStop ;
    rdfs:label "departs transit stop"@en ;
    rdfs:comment "Transit stop from which this last mile segment departs."@en .

tko:accessesBARTStation rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf tko:accessesTransitStop ;
    rdfs:domain tko:FirstMileToBART ;
    rdfs:range uko:TransitStop ;
    rdfs:label "accesses BART station"@en ;
    rdfs:comment "BART station accessed by this first mile segment."@en .

tko:departsBARTStation rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf tko:departsTransitStop ;
    rdfs:domain tko:LastMileFromBART ;
    rdfs:range uko:TransitStop ;
    rdfs:label "departs BART station"@en ;
    rdfs:comment "BART station from which this last mile segment departs."@en .

tko:accessesBusStop rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf tko:accessesTransitStop ;
    rdfs:domain tko:FirstMileToBus ;
    rdfs:range uko:TransitStop ;
    rdfs:label "accesses bus stop"@en ;
    rdfs:comment "Bus stop accessed by this first mile segment."@en .

tko:departsBusStop rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf tko:departsTransitStop ;
    rdfs:domain tko:LastMileFromBus ;
    rdfs:range uko:TransitStop ;
    rdfs:label "departs bus stop"@en ;
    rdfs:comment "Bus stop from which this last mile segment departs."@en .

# =============================================================================
# Part 3: First/Last Mile Data Properties
# =============================================================================

tko:firstMileDistance rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:FirstMile ;
    rdfs:range xsd:decimal ;
    rdfs:label "first mile distance"@en ;
    rdfs:comment "Distance of first mile segment in meters."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "first_last_mile"^^xsd:string .

tko:lastMileDistance rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:LastMile ;
    rdfs:range xsd:decimal ;
    rdfs:label "last mile distance"@en ;
    rdfs:comment "Distance of last mile segment in meters."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "first_last_mile"^^xsd:string .

tko:firstMileDuration rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:FirstMile ;
    rdfs:range xsd:duration ;
    rdfs:label "first mile duration"@en ;
    rdfs:comment "Duration of first mile segment."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "duration"^^xsd:string ;
    tko:featureGroup "first_last_mile"^^xsd:string .

tko:lastMileDuration rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:LastMile ;
    rdfs:range xsd:duration ;
    rdfs:label "last mile duration"@en ;
    rdfs:comment "Duration of last mile segment."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "duration"^^xsd:string ;
    tko:featureGroup "first_last_mile"^^xsd:string .

tko:firstMileMode rdf:type owl:ObjectProperty ;
    rdfs:domain tko:FirstMile ;
    rdfs:range tko:TravelModality ;
    rdfs:label "first mile mode"@en ;
    rdfs:comment "Mode of travel for first mile segment."@en .

tko:lastMileMode rdf:type owl:ObjectProperty ;
    rdfs:domain tko:LastMile ;
    rdfs:range tko:TravelModality ;
    rdfs:label "last mile mode"@en ;
    rdfs:comment "Mode of travel for last mile segment."@en .

tko:firstMileWalkable rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:FirstMileToTransit ;
    rdfs:range xsd:boolean ;
    rdfs:label "first mile walkable"@en ;
    rdfs:comment "First mile distance is walkable (typically <800m or <10 min)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "first_last_mile"^^xsd:string .

tko:lastMileWalkable rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:LastMileFromTransit ;
    rdfs:range xsd:boolean ;
    rdfs:label "last mile walkable"@en ;
    rdfs:comment "Last mile distance is walkable (typically <800m or <10 min)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "first_last_mile"^^xsd:string .

# =============================================================================
# Part 4: Transit Integration Quality
# =============================================================================

tko:transitWaitTime rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:MultimodalTrip ;
    rdfs:range xsd:duration ;
    rdfs:label "transit wait time"@en ;
    rdfs:comment "Total wait time for transit during multimodal trip."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "duration"^^xsd:string ;
    tko:featureGroup "transit_quality"^^xsd:string .

tko:transferCount rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:MultimodalTrip ;
    rdfs:range xsd:integer ;
    rdfs:label "transfer count"@en ;
    rdfs:comment "Number of transfers during multimodal trip."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "transit_quality"^^xsd:string .

tko:totalTransitTime rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:MultimodalTrip ;
    rdfs:range xsd:duration ;
    rdfs:label "total transit time"@en ;
    rdfs:comment "Total time spent on transit vehicles."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "duration"^^xsd:string ;
    tko:featureGroup "transit_quality"^^xsd:string .

tko:transitShareOfTrip rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:MultimodalTrip ;
    rdfs:range xsd:decimal ;
    rdfs:label "transit share of trip"@en ;
    rdfs:comment "Fraction of trip distance covered by transit (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "transit_quality"^^xsd:string .

# =============================================================================
# END OF FIRST MILE / LAST MILE EXTENSION
# =============================================================================


###############################################################################
#    EXTENSION: ENHANCED TKO↔UKO LINKING
#    Source: Architecture v5.0.0 Section 4
#    Purpose: Enable cross-ontology reasoning and feature extraction
###############################################################################

# =============================================================================
# Part 1: Route-to-Infrastructure Links
# =============================================================================

tko:routeOnHIN rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Route ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "route on HIN"@en ;
    rdfs:comment "Route traverses a High Injury Network corridor."@en .

tko:routeOnPSN rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Route ;
    rdfs:range uko:ProactiveSafetyNetwork ;
    rdfs:label "route on PSN"@en ;
    rdfs:comment "Route traverses a Proactive Safety Network corridor."@en .

tko:segmentOnRoad rdf:type owl:ObjectProperty ;
    rdfs:domain tko:RouteSegment ;
    rdfs:range uko:RoadSegment ;
    rdfs:label "segment on road"@en ;
    rdfs:comment "Route segment maps to a specific road segment in UKO."@en .

tko:segmentOnHIN rdf:type owl:ObjectProperty ;
    rdfs:domain tko:RouteSegment ;
    rdfs:range uko:HighInjuryNetwork ;
    rdfs:label "segment on HIN"@en ;
    rdfs:comment "Route segment is on a High Injury Network."@en .

tko:crossesIntersection rdf:type owl:ObjectProperty ;
    rdfs:domain tko:RouteSegment ;
    rdfs:range uko:Intersection ;
    rdfs:label "crosses intersection"@en ;
    rdfs:comment "Route segment crosses this intersection."@en .

# =============================================================================
# Part 2: Route Safety Properties
# =============================================================================

tko:routeHINFraction rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "route HIN fraction"@en ;
    rdfs:comment "Fraction of route distance on High Injury Network (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_safety"^^xsd:string .

tko:routePSNFraction rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "route PSN fraction"@en ;
    rdfs:comment "Fraction of route distance on Proactive Safety Network (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_safety"^^xsd:string .

tko:routeSafetyScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "route safety score"@en ;
    rdfs:comment "Composite safety score for the route (0-100, higher = safer)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_safety"^^xsd:string .

tko:routeCollisionRisk rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "route collision risk"@en ;
    rdfs:comment "Estimated collision risk based on historical data and route characteristics."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_safety"^^xsd:string .

tko:routeVulnerableUserScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "route vulnerable user score"@en ;
    rdfs:comment "Aggregate vulnerable user score from PSN along route."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_safety"^^xsd:string .

tko:schoolZoneCrossings rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:integer ;
    rdfs:label "school zone crossings"@en ;
    rdfs:comment "Number of school zones crossed by route."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "route_safety"^^xsd:string .

# =============================================================================
# Part 3: Route Infrastructure Properties
# =============================================================================

tko:routeSidewalkCoverage rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "route sidewalk coverage"@en ;
    rdfs:comment "Fraction of route with adjacent sidewalks (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_infrastructure"^^xsd:string .

tko:routeBikeLaneCoverage rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "route bike lane coverage"@en ;
    rdfs:comment "Fraction of route with bike lanes (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_infrastructure"^^xsd:string .

tko:routeProtectedBikeLaneCoverage rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "route protected bike lane coverage"@en ;
    rdfs:comment "Fraction of route with protected bike lanes (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_infrastructure"^^xsd:string .

tko:routeLightingCoverage rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "route lighting coverage"@en ;
    rdfs:comment "Fraction of route with adequate lighting (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_infrastructure"^^xsd:string .

tko:signalizedIntersectionCount rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:integer ;
    rdfs:label "signalized intersection count"@en ;
    rdfs:comment "Number of signalized intersections along route."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "route_infrastructure"^^xsd:string .

tko:unsignalizedCrossingCount rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:integer ;
    rdfs:label "unsignalized crossing count"@en ;
    rdfs:comment "Number of unsignalized crossings along route."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "route_infrastructure"^^xsd:string .

# =============================================================================
# Part 4: Route Classification Properties
# =============================================================================

tko:dominantRoadClass rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Route ;
    rdfs:range uko:FunctionalClassification ;
    rdfs:label "dominant road class"@en ;
    rdfs:comment "Most common road classification along route."@en .

tko:arterialFraction rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "arterial fraction"@en ;
    rdfs:comment "Fraction of route on arterial roads (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_type"^^xsd:string .

tko:localStreetFraction rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "local street fraction"@en ;
    rdfs:comment "Fraction of route on local streets (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_type"^^xsd:string .

tko:averageLaneCount rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "average lane count"@en ;
    rdfs:comment "Average number of lanes along route."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_type"^^xsd:string .

tko:averageSpeedLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "average speed limit"@en ;
    rdfs:comment "Average posted speed limit along route in MPH."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "route_type"^^xsd:string .

tko:maxSpeedLimit rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:integer ;
    rdfs:label "max speed limit"@en ;
    rdfs:comment "Maximum posted speed limit along route in MPH."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "route_type"^^xsd:string .

# =============================================================================
# Part 5: Endpoint-to-POI Enhanced Links
# =============================================================================

tko:originNearSchool rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Origin ;
    rdfs:range xsd:boolean ;
    rdfs:label "origin near school"@en ;
    rdfs:comment "Trip origin is within walking distance of a school."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "endpoint_context"^^xsd:string .

tko:destinationNearSchool rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Destination ;
    rdfs:range xsd:boolean ;
    rdfs:label "destination near school"@en ;
    rdfs:comment "Trip destination is within walking distance of a school."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "endpoint_context"^^xsd:string .

tko:originNearTransit rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Origin ;
    rdfs:range xsd:boolean ;
    rdfs:label "origin near transit"@en ;
    rdfs:comment "Trip origin is within walking distance of transit."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "endpoint_context"^^xsd:string .

tko:destinationNearTransit rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Destination ;
    rdfs:range xsd:boolean ;
    rdfs:label "destination near transit"@en ;
    rdfs:comment "Trip destination is within walking distance of transit."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "endpoint_context"^^xsd:string .

tko:originTransitAccessQuality rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Origin ;
    rdfs:range xsd:string ;
    rdfs:label "origin transit access quality"@en ;
    rdfs:comment "Transit access quality at origin: HIGH, MEDIUM, LOW, NONE."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "endpoint_context"^^xsd:string .

tko:destinationTransitAccessQuality rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Destination ;
    rdfs:range xsd:string ;
    rdfs:label "destination transit access quality"@en ;
    rdfs:comment "Transit access quality at destination: HIGH, MEDIUM, LOW, NONE."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "endpoint_context"^^xsd:string .

# =============================================================================
# Part 6: Equity Context Links
# =============================================================================

tko:originInEPC rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Origin ;
    rdfs:range xsd:boolean ;
    rdfs:label "origin in EPC"@en ;
    rdfs:comment "Trip origin is in an Equity Priority Community."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "equity_context"^^xsd:string .

tko:destinationInEPC rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Destination ;
    rdfs:range xsd:boolean ;
    rdfs:label "destination in EPC"@en ;
    rdfs:comment "Trip destination is in an Equity Priority Community."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "equity_context"^^xsd:string .

tko:routeCrossesEPC rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:boolean ;
    rdfs:label "route crosses EPC"@en ;
    rdfs:comment "Route traverses an Equity Priority Community."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "equity_context"^^xsd:string .

tko:epcFraction rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Route ;
    rdfs:range xsd:decimal ;
    rdfs:label "EPC fraction"@en ;
    rdfs:comment "Fraction of route through Equity Priority Communities (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "equity_context"^^xsd:string .

# =============================================================================
# END OF ENHANCED TKO↔UKO LINKING EXTENSION
# =============================================================================


###############################################################################
#    EXTENSION: SCHOOL TRIP TYPES
#    Source: Architecture v5.0.0 Scenario 1
#    Purpose: Model school-related trips for safety analysis
###############################################################################

# =============================================================================
# Part 1: School Trip Classes
# =============================================================================

tko:SchoolTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:Trip ;
    rdfs:label "School Trip"@en ;
    rdfs:comment "Trip related to school activities."@en .

tko:SchoolDropOffTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:SchoolTrip ;
    rdfs:label "School Drop-Off Trip"@en ;
    rdfs:comment "Trip to drop off a student at school."@en .

tko:SchoolPickUpTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:SchoolTrip ;
    rdfs:label "School Pick-Up Trip"@en ;
    rdfs:comment "Trip to pick up a student from school."@en .

tko:SchoolCommuteTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:SchoolTrip ;
    rdfs:label "School Commute Trip"@en ;
    rdfs:comment "Student commuting to or from school independently."@en .

tko:SchoolWalkingTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:SchoolCommuteTrip ;
    rdfs:label "School Walking Trip"@en ;
    rdfs:comment "Student walking to or from school."@en .

tko:SchoolBikingTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:SchoolCommuteTrip ;
    rdfs:label "School Biking Trip"@en ;
    rdfs:comment "Student biking to or from school."@en .

tko:SchoolBusTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:SchoolCommuteTrip ;
    rdfs:label "School Bus Trip"@en ;
    rdfs:comment "Student taking school bus to or from school."@en .

tko:AfterSchoolActivityTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:SchoolTrip ;
    rdfs:label "After School Activity Trip"@en ;
    rdfs:comment "Trip from school to after-school activity."@en .

# =============================================================================
# Part 2: School Trip Properties
# =============================================================================

tko:associatedSchool rdf:type owl:ObjectProperty ;
    rdfs:domain tko:SchoolTrip ;
    rdfs:range uko:School ;
    rdfs:label "associated school"@en ;
    rdfs:comment "School associated with this school trip."@en .

tko:schoolGradeLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:SchoolTrip ;
    rdfs:range xsd:string ;
    rdfs:label "school grade level"@en ;
    rdfs:comment "Grade level of the school: ELEMENTARY, MIDDLE, HIGH."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "school_context"^^xsd:string .

tko:schoolTripType rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:SchoolTrip ;
    rdfs:range xsd:string ;
    rdfs:label "school trip type"@en ;
    rdfs:comment "Type of school trip: DROP_OFF, PICK_UP, COMMUTE, ACTIVITY."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "school_context"^^xsd:string .

tko:isEscortedTrip rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:SchoolTrip ;
    rdfs:range xsd:boolean ;
    rdfs:label "is escorted trip"@en ;
    rdfs:comment "Student is escorted by adult (vs independent travel)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "school_context"^^xsd:string .

tko:walkingRouteToSchool rdf:type owl:ObjectProperty ;
    rdfs:domain tko:SchoolWalkingTrip ;
    rdfs:range tko:Route ;
    rdfs:label "walking route to school"@en ;
    rdfs:comment "The walking route taken to school."@en .

tko:schoolWalkingSafetyScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:SchoolWalkingTrip ;
    rdfs:range xsd:decimal ;
    rdfs:label "school walking safety score"@en ;
    rdfs:comment "Safety score for this school walking route (0-100)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "school_safety"^^xsd:string .

# =============================================================================
# Part 3: School Zone Conflict Detection
# =============================================================================

tko:conflictsWithSchoolZone rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "conflicts with school zone"@en ;
    rdfs:comment "Trip passes through active school zone during school hours."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "school_safety"^^xsd:string .

tko:schoolZoneConflictCount rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:integer ;
    rdfs:label "school zone conflict count"@en ;
    rdfs:comment "Number of school zones traversed during active hours."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "school_safety"^^xsd:string .

# =============================================================================
# END OF SCHOOL TRIP TYPES EXTENSION
# =============================================================================

###############################################################################
#    EXTENSION: TRANSIT EQUITY TRIP TYPES
#    Source: Architecture v5.0.0 Scenario 2
#    Purpose: Model transit-dependent and equity-related trip patterns
###############################################################################

# =============================================================================
# Part 1: Transit Dependency Classes
# =============================================================================

tko:TransitDependentTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:Trip ;
    rdfs:label "Transit Dependent Trip"@en ;
    rdfs:comment "Trip by a traveler dependent on transit (zero-car household)."@en .

tko:ZeroCarHouseholdTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:TransitDependentTrip ;
    rdfs:label "Zero Car Household Trip"@en ;
    rdfs:comment "Trip from a zero-vehicle household."@en .

tko:SeniorTransitTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:TransitDependentTrip ;
    rdfs:label "Senior Transit Trip"@en ;
    rdfs:comment "Transit trip by a senior citizen."@en .

tko:DisabilityTransitTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:TransitDependentTrip ;
    rdfs:label "Disability Transit Trip"@en ;
    rdfs:comment "Transit trip by a person with disability."@en .

tko:LowIncomeTransitTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:TransitDependentTrip ;
    rdfs:label "Low Income Transit Trip"@en ;
    rdfs:comment "Transit trip from a low-income household."@en .

# =============================================================================
# Part 2: Transit Dependency Properties
# =============================================================================

tko:isTransitDependent rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "is transit dependent"@en ;
    rdfs:comment "Traveler is dependent on transit (no car access)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "equity_context"^^xsd:string .

tko:householdVehicles rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:integer ;
    rdfs:label "household vehicles"@en ;
    rdfs:comment "Number of vehicles in traveler's household."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "traveler_context"^^xsd:string .

tko:householdIncome rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:string ;
    rdfs:label "household income"@en ;
    rdfs:comment "Household income bracket: LOW, MODERATE, MIDDLE, HIGH."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "traveler_context"^^xsd:string .

tko:transitAccessGap rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "transit access gap"@en ;
    rdfs:comment "Gap between transit need and access (derived metric)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "equity_context"^^xsd:string .

# =============================================================================
# Part 3: Essential Service Access
# =============================================================================

tko:EssentialServiceTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:Trip ;
    rdfs:label "Essential Service Trip"@en ;
    rdfs:comment "Trip to access essential services (healthcare, grocery)."@en .

tko:HealthcareAccessTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:EssentialServiceTrip ;
    rdfs:label "Healthcare Access Trip"@en ;
    rdfs:comment "Trip to access healthcare services."@en .

tko:GroceryAccessTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:EssentialServiceTrip ;
    rdfs:label "Grocery Access Trip"@en ;
    rdfs:comment "Trip to access grocery stores."@en .

tko:PharmacyAccessTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:EssentialServiceTrip ;
    rdfs:label "Pharmacy Access Trip"@en ;
    rdfs:comment "Trip to access pharmacy."@en .

tko:isEssentialServiceTrip rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "is essential service trip"@en ;
    rdfs:comment "Trip is for essential service access."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "trip_purpose"^^xsd:string .

tko:essentialServiceType rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:EssentialServiceTrip ;
    rdfs:range xsd:string ;
    rdfs:label "essential service type"@en ;
    rdfs:comment "Type of essential service: HEALTHCARE, GROCERY, PHARMACY, GOVERNMENT."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "trip_purpose"^^xsd:string .

# =============================================================================
# END OF TRANSIT EQUITY TRIP TYPES EXTENSION
# =============================================================================


###############################################################################
#    EXTENSION: CONGESTION AND CONTEXT
#    Source: Architecture v5.0.0 Section 3.2.1
#    Purpose: Congestion metrics and environmental context
###############################################################################

# =============================================================================
# Part 1: Segment Congestion Properties
# =============================================================================

tko:segmentCongestionLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSegment ;
    rdfs:range xsd:string ;
    rdfs:label "segment congestion level"@en ;
    rdfs:comment "Congestion level: FREE_FLOW, LIGHT, MODERATE, HEAVY, SEVERE."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "congestion"^^xsd:string .

tko:speedRatioToFreeFlow rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "speed ratio to free flow"@en ;
    rdfs:comment "Ratio of actual speed to free-flow speed (1.0 = no congestion)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "congestion"^^xsd:string .

tko:segmentActualSpeed rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "segment actual speed"@en ;
    rdfs:comment "Actual travel speed on segment in MPH."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "segment_performance"^^xsd:string .

tko:segmentFreeFlowSpeed rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSegment ;
    rdfs:range xsd:decimal ;
    rdfs:label "segment free flow speed"@en ;
    rdfs:comment "Free-flow speed on segment in MPH."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "segment_performance"^^xsd:string .

tko:segmentDelaySeconds rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSegment ;
    rdfs:range xsd:integer ;
    rdfs:label "segment delay seconds"@en ;
    rdfs:comment "Delay on segment due to congestion in seconds."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "congestion"^^xsd:string .

# =============================================================================
# Part 2: Congestion Classification
# =============================================================================

tko:CongestionCategory rdf:type owl:Class ;
    rdfs:label "Congestion Category"@en ;
    rdfs:comment "Classification of congestion levels."@en .

tko:FREE_FLOW rdf:type owl:NamedIndividual, tko:CongestionCategory ;
    rdfs:label "Free Flow"@en ;
    rdfs:comment "No congestion, travel at free-flow speeds."@en ;
    tko:speedRatioMin "0.90"^^xsd:decimal .

tko:LIGHT_CONGESTION rdf:type owl:NamedIndividual, tko:CongestionCategory ;
    rdfs:label "Light Congestion"@en ;
    rdfs:comment "Light congestion, minor delays."@en ;
    tko:speedRatioMin "0.70"^^xsd:decimal ;
    tko:speedRatioMax "0.90"^^xsd:decimal .

tko:MODERATE_CONGESTION rdf:type owl:NamedIndividual, tko:CongestionCategory ;
    rdfs:label "Moderate Congestion"@en ;
    rdfs:comment "Moderate congestion, noticeable delays."@en ;
    tko:speedRatioMin "0.50"^^xsd:decimal ;
    tko:speedRatioMax "0.70"^^xsd:decimal .

tko:HEAVY_CONGESTION rdf:type owl:NamedIndividual, tko:CongestionCategory ;
    rdfs:label "Heavy Congestion"@en ;
    rdfs:comment "Heavy congestion, significant delays."@en ;
    tko:speedRatioMin "0.30"^^xsd:decimal ;
    tko:speedRatioMax "0.50"^^xsd:decimal .

tko:SEVERE_CONGESTION rdf:type owl:NamedIndividual, tko:CongestionCategory ;
    rdfs:label "Severe Congestion"@en ;
    rdfs:comment "Severe congestion, stop-and-go traffic."@en ;
    tko:speedRatioMax "0.30"^^xsd:decimal .

tko:hasCongestionCategory rdf:type owl:ObjectProperty ;
    rdfs:domain tko:RouteSegment ;
    rdfs:range tko:CongestionCategory ;
    rdfs:label "has congestion category"@en ;
    rdfs:comment "Congestion category for this segment."@en .

tko:speedRatioMin rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:CongestionCategory ;
    rdfs:range xsd:decimal ;
    rdfs:label "speed ratio minimum"@en ;
    rdfs:comment "Minimum speed ratio for this category."@en .

tko:speedRatioMax rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:CongestionCategory ;
    rdfs:range xsd:decimal ;
    rdfs:label "speed ratio maximum"@en ;
    rdfs:comment "Maximum speed ratio for this category."@en .

# =============================================================================
# Part 3: Trip-Level Congestion
# =============================================================================

tko:tripCongestionIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "trip congestion index"@en ;
    rdfs:comment "Overall congestion index for the trip (weighted average)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_performance"^^xsd:string .

tko:tripDelayMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "trip delay minutes"@en ;
    rdfs:comment "Total delay due to congestion in minutes."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_performance"^^xsd:string .

tko:congestedSegmentCount rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:integer ;
    rdfs:label "congested segment count"@en ;
    rdfs:comment "Number of segments with moderate or higher congestion."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "trip_performance"^^xsd:string .

tko:congestedDistanceFraction rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "congested distance fraction"@en ;
    rdfs:comment "Fraction of trip distance with congestion (0-1)."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_performance"^^xsd:string .

# =============================================================================
# Part 4: Weather Context
# =============================================================================

tko:tripWeatherCondition rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:WeatherCondition ;
    rdfs:label "trip weather condition"@en ;
    rdfs:comment "Weather condition during the trip."@en .

tko:weatherType rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:string ;
    rdfs:label "weather type"@en ;
    rdfs:comment "Weather type: CLEAR, CLOUDY, RAIN, HEAVY_RAIN, FOG, SNOW."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "environmental_context"^^xsd:string .

tko:temperatureFahrenheit rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "temperature fahrenheit"@en ;
    rdfs:comment "Temperature during trip in Fahrenheit."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "environmental_context"^^xsd:string .

tko:precipitationIntensity rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "precipitation intensity"@en ;
    rdfs:comment "Precipitation intensity in inches/hour."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "environmental_context"^^xsd:string .

tko:visibility rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "visibility"@en ;
    rdfs:comment "Visibility in miles."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "environmental_context"^^xsd:string .

tko:isDaylight rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "is daylight"@en ;
    rdfs:comment "Trip occurred during daylight hours."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "environmental_context"^^xsd:string .

# =============================================================================
# END OF CONGESTION AND CONTEXT EXTENSION
# =============================================================================

###############################################################################
#    EXTENSION: NEUROSYMBOLIC FEATURE ANNOTATIONS
#    Source: Architecture v5.0.0 Section 7
#    Purpose: Metadata for feature extraction and path-aware embeddings
###############################################################################

# =============================================================================
# Part 1: Feature Extraction Metadata Properties
# =============================================================================

tko:featureExtraction rdf:type owl:AnnotationProperty ;
    rdfs:label "feature extraction"@en ;
    rdfs:comment "Indicates property should be extracted as a feature for ML models."@en .

tko:featureType rdf:type owl:AnnotationProperty ;
    rdfs:label "feature type"@en ;
    rdfs:comment "Data type for feature: numeric, categorical, boolean, duration, text."@en .

tko:featureGroup rdf:type owl:AnnotationProperty ;
    rdfs:label "feature group"@en ;
    rdfs:comment "Grouping for related features in embedding generation."@en .

tko:featureImportance rdf:type owl:AnnotationProperty ;
    rdfs:label "feature importance"@en ;
    rdfs:comment "Relative importance weight for this feature (0-1)."@en .

tko:requiresNormalization rdf:type owl:AnnotationProperty ;
    rdfs:label "requires normalization"@en ;
    rdfs:comment "Feature requires normalization before use."@en .

tko:defaultValue rdf:type owl:AnnotationProperty ;
    rdfs:label "default value"@en ;
    rdfs:comment "Default value when feature is missing."@en .

# =============================================================================
# Part 2: Path-Aware Embedding Support
# =============================================================================

tko:PathSignature rdf:type owl:Class ;
    rdfs:label "Path Signature"@en ;
    rdfs:comment "Signature representing the characteristics of a path/route for embedding."@en .

tko:hasPathSignature rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Route ;
    rdfs:range tko:PathSignature ;
    rdfs:label "has path signature"@en ;
    rdfs:comment "Path signature computed for this route."@en .

tko:signatureVector rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:PathSignature ;
    rdfs:range xsd:string ;
    rdfs:label "signature vector"@en ;
    rdfs:comment "Serialized embedding vector for this path signature."@en .

tko:signatureDimension rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:PathSignature ;
    rdfs:range xsd:integer ;
    rdfs:label "signature dimension"@en ;
    rdfs:comment "Dimensionality of the signature vector."@en .

tko:signatureModel rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:PathSignature ;
    rdfs:range xsd:string ;
    rdfs:label "signature model"@en ;
    rdfs:comment "Model used to generate this signature: GeoRotatE, ComplEx, etc."@en .

tko:signatureVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:PathSignature ;
    rdfs:range xsd:string ;
    rdfs:label "signature version"@en ;
    rdfs:comment "Version of the embedding model."@en .

# =============================================================================
# Part 3: Route Similarity Support
# =============================================================================

tko:RouteSimilarity rdf:type owl:Class ;
    rdfs:label "Route Similarity"@en ;
    rdfs:comment "Similarity measurement between two routes."@en .

tko:sourceRoute rdf:type owl:ObjectProperty ;
    rdfs:domain tko:RouteSimilarity ;
    rdfs:range tko:Route ;
    rdfs:label "source route"@en ;
    rdfs:comment "Source route in similarity comparison."@en .

tko:targetRoute rdf:type owl:ObjectProperty ;
    rdfs:domain tko:RouteSimilarity ;
    rdfs:range tko:Route ;
    rdfs:label "target route"@en ;
    rdfs:comment "Target route in similarity comparison."@en .

tko:similarityScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSimilarity ;
    rdfs:range xsd:decimal ;
    rdfs:label "similarity score"@en ;
    rdfs:comment "Similarity score (0-1, higher = more similar)."@en .

tko:similarityType rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSimilarity ;
    rdfs:range xsd:string ;
    rdfs:label "similarity type"@en ;
    rdfs:comment "Type of similarity: GEOMETRIC, SEMANTIC, FUNCTIONAL, COMBINED."@en .

tko:geometricSimilarity rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSimilarity ;
    rdfs:range xsd:decimal ;
    rdfs:label "geometric similarity"@en ;
    rdfs:comment "Geometric/spatial similarity score (0-1)."@en .

tko:semanticSimilarity rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSimilarity ;
    rdfs:range xsd:decimal ;
    rdfs:label "semantic similarity"@en ;
    rdfs:comment "Semantic similarity based on infrastructure types (0-1)."@en .

tko:functionalSimilarity rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteSimilarity ;
    rdfs:range xsd:decimal ;
    rdfs:label "functional similarity"@en ;
    rdfs:comment "Functional similarity based on trip characteristics (0-1)."@en .

# =============================================================================
# Part 4: Processing Metadata
# =============================================================================

tko:ProcessingMetadata rdf:type owl:Class ;
    rdfs:label "Processing Metadata"@en ;
    rdfs:comment "Metadata about trip processing and enhancement."@en .

tko:hasProcessingMetadata rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:ProcessingMetadata ;
    rdfs:label "has processing metadata"@en ;
    rdfs:comment "Processing metadata for this trip."@en .

tko:processingTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ProcessingMetadata ;
    rdfs:range xsd:dateTime ;
    rdfs:label "processing timestamp"@en ;
    rdfs:comment "When this trip was processed."@en .

tko:processingPipeline rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ProcessingMetadata ;
    rdfs:range xsd:string ;
    rdfs:label "processing pipeline"@en ;
    rdfs:comment "Pipeline version that processed this trip."@en .

tko:mapMatchingConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ProcessingMetadata ;
    rdfs:range xsd:decimal ;
    rdfs:label "map matching confidence"@en ;
    rdfs:comment "Confidence score for map matching (0-1)."@en .

tko:poiMatchingConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ProcessingMetadata ;
    rdfs:range xsd:decimal ;
    rdfs:label "POI matching confidence"@en ;
    rdfs:comment "Confidence score for POI matching (0-1)."@en .

tko:intentPredictionConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ProcessingMetadata ;
    rdfs:range xsd:decimal ;
    rdfs:label "intent prediction confidence"@en ;
    rdfs:comment "Confidence score for intent prediction (0-1)."@en .

tko:dataQualityScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ProcessingMetadata ;
    rdfs:range xsd:decimal ;
    rdfs:label "data quality score"@en ;
    rdfs:comment "Overall data quality score for this trip (0-1)."@en .

# =============================================================================
# END OF NEUROSYMBOLIC FEATURE ANNOTATIONS EXTENSION
# =============================================================================
###############################################################################
#    END OF TKO v5.0.0 BASE CONTENT (preserved verbatim in v6.0.0)
###############################################################################



###############################################################################
#    EXTENSION: TRIP INTELLIGENCE PIPELINE SUPPORT
#    Source: Architecture v5.0.0 Sections 10.2 (Stage 2), 10.4/10.5 (Stages 4–5),
#             and 10.6 (Stage 6)
#    Purpose: Label rationale traceability, stop event profiling, trip risk
#             assessment framework, and GPS preprocessing metadata.
#    Added in TKO v6.0.0
###############################################################################


# =============================================================================
# Part 1: Intent Classification — Direct Trip Properties
# =============================================================================
# Stage 5 specifies that intentClass and intentConfidence are first-class fields
# on the trip entity itself, not only embedded within label rationales.
# Note: tko:intentConfidence already exists on tko:TripIntent (domain).
# These properties add direct trip-level intent classification results.

tko:intentClass rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:string ;
    rdfs:label "intent class"@en ;
    rdfs:comment "The predicted intent class for this trip as a direct string value on the trip entity. Values drawn from the TKO intent hierarchy controlled vocabulary (e.g., 'CommutingTrip', 'SchoolDropoffTrip', 'FreightDelivery', 'PersonalErrand'). Stored as a direct trip property for efficient retrieval by downstream consumers that need the intent label without traversing the TripIntent subgraph. Populated in Stage 5 (intent classification) and retained through Stage 6."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "intent_classification"^^xsd:string .

tko:intentClassConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "intent class confidence"@en ;
    rdfs:comment "Model confidence score for the intentClass assignment (0.0–1.0). Direct trip-level property, parallel to tko:intentClass. Distinct from tko:intentConfidence which is scoped to the TripIntent subgraph. Populated in Stage 5 by the intent classification model."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "intent_classification"^^xsd:string .


# =============================================================================
# Part 2: GPS Preprocessing Metadata
# =============================================================================
# Reflects whether the Dressage Kalman filtering step was applied during
# Stage 2 preprocessing. Relevant for interpreting map matching confidence:
# a high-confidence match on a preprocessed trace is more reliable than
# the same score on a raw trace.

tko:gpsPreprocessingApplied rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:boolean ;
    rdfs:label "GPS preprocessing applied"@en ;
    rdfs:comment "True if the Dressage Trajectory Intelligence Kalman filtering step was applied to the raw GPS trace during Stage 2 preprocessing. False if Stage 2 operated on coordinate pairs only (no raw GPS trace available). Used to contextualize map matching confidence scores: the same confidence value has different interpretations depending on whether the trace was preprocessed."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "processing_metadata"^^xsd:string .

tko:gpsTracePointCount rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:integer ;
    rdfs:label "GPS trace point count"@en ;
    rdfs:comment "Number of GPS trace observations in the raw trace for this trip. Zero when only coordinate pairs are available. Used alongside gpsPreprocessingApplied to assess the richness of the trajectory data underlying the route reconstruction."@en .

tko:kalmanUncertaintyRadius rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "Kalman uncertainty radius"@en ;
    rdfs:comment "Mean per-observation uncertainty radius in meters from the Dressage Kalman filtering step. Reflects the average positional confidence of the cleaned trace. Higher values indicate GPS signal degradation (urban canyons, multipath). Null when gpsPreprocessingApplied is false."@en .


# =============================================================================
# Part 3: Label Rationale Class
# =============================================================================
# Reifies the rationale sub-object introduced in Stages 4 and 5 as a TKO class.
# Each behavioral label assignment on a TKO trip entity becomes an instance of
# tko:LabelRationale linked to the TripLabel via tko:hasRationale.
# This enables full traceability: any consumer can determine exactly which
# mechanism, features, and thresholds produced each label.

tko:LabelRationale rdf:type owl:Class ;
    rdfs:label "Label Rationale"@en ;
    rdfs:comment "Rationale record for a behavioral label assignment on a trip. Captures the mechanism (rule-based or model-based), the evidence features and their observed values, the decision threshold applied, and the confidence of the assignment. Linked from tko:TripLabel via tko:hasRationale. Provides full traceability for every label: a Linxup customer or auditor can reconstruct exactly why a label was or was not assigned to a specific trip."@en .

tko:hasRationale rdf:type owl:ObjectProperty ;
    rdfs:domain tko:TripLabel ;
    rdfs:range tko:LabelRationale ;
    rdfs:label "has rationale"@en ;
    rdfs:comment "Links a TripLabel instance to its LabelRationale. One-to-one: each label assignment has exactly one rationale record."@en .

tko:labelMechanism rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:LabelRationale ;
    rdfs:range xsd:string ;
    rdfs:label "label mechanism"@en ;
    rdfs:comment "Mechanism by which this label was assigned. Controlled vocabulary: RULE_BASED (deterministic OWL axiom or SWRL rule fired), MODEL_BASED (ML model output), HYBRID (rule triggered by model score), MANUAL (human override). Used to distinguish deterministic assignments (which have no confidence interval) from probabilistic ones."@en .

tko:labelEvidence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:LabelRationale ;
    rdfs:range xsd:string ;
    rdfs:label "label evidence"@en ;
    rdfs:comment "JSON-serialized key-value map of the feature names and their observed values that contributed to this label assignment. Example: '{\"tripDistanceKm\": 0.8, \"destinationPOIType\": \"School\", \"departureTimePeriod\": \"SCHOOL_ARRIVAL\", \"isRecurring\": true}'. Stored as a string literal for compactness; consumers parse as JSON. Enables post-hoc inspection of which feature combination triggered the label."@en .

tko:labelThreshold rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:LabelRationale ;
    rdfs:range xsd:decimal ;
    rdfs:label "label threshold"@en ;
    rdfs:comment "The decision threshold applied to the model score or rule condition to assign this label (0.0–1.0). For RULE_BASED mechanisms this is null (rules fire deterministically). For MODEL_BASED mechanisms this is the configured confidence cutoff above which the label is applied. For HYBRID mechanisms this is the threshold on the triggering model score. Stored to support threshold sensitivity analysis."@en .

tko:labelRationaleText rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:LabelRationale ;
    rdfs:range xsd:string ;
    rdfs:label "label rationale text"@en ;
    rdfs:comment "Human-readable natural language summary of the rationale, suitable for display in a driver coaching interface or audit log. Example: 'Labeled as school pickup trip because destination matches Contra Costa Elementary, departure time is within SCHOOL_DISMISSAL window, and this pattern recurs on weekdays.' Generated by the label explanation module in Stage 5."@en .


# =============================================================================
# Part 4: Stop Event Class
# =============================================================================
# Represents a single parking or dwell event within a multi-stop trip.
# Introduced by Stage 2 (stop profile construction) and enriched in Stage 6
# (stop-vicinity risk scoring). The existing tko:IntermediateStop models a
# geographic endpoint in a trip's structure; tko:StopEvent models a specific
# dwell instance with duration, resolved POI, and risk attributes.
# These are complementary — StopEvent is the Stage 6 risk-enriched view of
# what IntermediateStop describes structurally.

tko:StopEvent rdf:type owl:Class ;
    rdfs:label "Stop Event"@en ;
    rdfs:comment "A single parking or dwell event within a multi-stop trip. Captures the stop location, dwell duration, resolved point of interest, and risk attributes of the stop's road environment. Populated in Stage 2 from the stop profile extracted from the base trip record, and enriched with risk scores in Stage 6. Ordered stops within a trip are linked via tko:hasStopEvent with sequence controlled by tko:stopSequence."@en .

tko:hasStopEvent rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:StopEvent ;
    rdfs:label "has stop event"@en ;
    rdfs:comment "Links a trip to one of its stop events. A trip may have zero or more stop events; a trip with no stops (direct origin-to-destination) has zero StopEvent instances. Stop ordering is captured by tko:stopSequence on each StopEvent."@en .

tko:stopSequence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:integer ;
    rdfs:label "stop sequence"@en ;
    rdfs:comment "Ordinal position of this stop within the trip's stop sequence (1-based). Used to reconstruct the stop order when iterating over tko:hasStopEvent links."@en .

tko:stopLat rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "stop latitude"@en ;
    rdfs:comment "WGS84 latitude of the stop location in decimal degrees. Sourced from the GPS trace stop detection or from the base trip stop coordinates."@en .

tko:stopLon rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "stop longitude"@en ;
    rdfs:comment "WGS84 longitude of the stop location in decimal degrees."@en .

tko:dwellTimeSeconds rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:integer ;
    rdfs:label "dwell time seconds"@en ;
    rdfs:comment "Duration of the stop event in seconds. Distinct from tko:dwellTime (domain: IntermediateStop, range: xsd:duration) — this property uses an integer seconds representation for compatibility with the Stage 6 output schema and numerical feature extraction. A stop with dwellTimeSeconds < 120 is typically a traffic pause rather than an intentional stop; Stage 2 filters these out before constructing the stop profile."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "stop_profile"^^xsd:string .

tko:resolvedPOI rdf:type owl:ObjectProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range uko:PointOfInterest ;
    rdfs:label "resolved POI"@en ;
    rdfs:comment "The UKO PointOfInterest entity resolved for this stop location. Populated by Stage 3's POI resolution step. Null if no POI was resolved within the configured proximity threshold (default: 50 meters). When resolved, this link enables cross-ontology feature extraction from the UKO POI subgraph: POI type, category, distance to transit, HIN adjacency, and census tract demographics."@en .

tko:poiResolutionDistance rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "POI resolution distance"@en ;
    rdfs:comment "Distance in meters between the stop location and the resolved POI. Null when resolvedPOI is null. Used to assess resolution confidence: a resolution distance of 5 meters is highly reliable; 45 meters warrants caution."@en .

tko:parkedNearDestination rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:boolean ;
    rdfs:label "parked near destination"@en ;
    rdfs:comment "True if this stop event is the final stop of the trip and is within the configured destination proximity radius (default: 100 meters of the declared destination). Distinguishes the trip-terminating stop — which is the primary stop-vicinity risk assessment target — from en-route intermediate stops."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "stop_profile"^^xsd:string .

tko:stopRiskScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "stop risk score"@en ;
    rdfs:comment "Stage 6 stop-vicinity risk score for this stop event (0.0–1.0). Computed from the UKO attributes of the road segment containing or immediately adjacent to the stop location: onHIN, roadClassification, p85Speed, truckVMTShare, and parking legitimacy (designated parking vs. double-parking on arterial). Higher values indicate greater risk to the driver during the stop-related pedestrian exposure window."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "stop_risk"^^xsd:string .

tko:parkingRoadClass rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:string ;
    rdfs:label "parking road class"@en ;
    rdfs:comment "Road functional classification of the segment where this stop event occurs (from uko:roadClassification). Values: SURFACE_HIGHWAY, PRINCIPAL_ARTERIAL, MAJOR_ARTERIAL, MINOR_ARTERIAL, COLLECTOR, LOCAL. Used in Stage 6 stop-vicinity risk scoring: stops on arterials receive higher base risk scores than stops on local streets, reflecting the greater pedestrian exposure hazard of alighting from a vehicle adjacent to high-speed traffic."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "stop_risk"^^xsd:string .

tko:parkingHINAdjacent rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:boolean ;
    rdfs:label "parking HIN adjacent"@en ;
    rdfs:comment "True if the stop event occurs on or adjacent to a High Injury Network (HIN) segment (from uko:onHIN on the parking segment). Used in Stage 6 stop-vicinity risk scoring as a binary risk amplifier: stops on HIN segments receive an elevated risk score regardless of road class, reflecting the segment's documented collision history."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "boolean"^^xsd:string ;
    tko:featureGroup "stop_risk"^^xsd:string .

tko:parkingIsDesignated rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:StopEvent ;
    rdfs:range xsd:boolean ;
    rdfs:label "parking is designated"@en ;
    rdfs:comment "True if the stop occurs in a designated parking area (on-street parking zone, parking lot, or loading zone). False indicates a stop on a travel lane, bus stop, or other non-parking location. Used in Stage 6 stop-vicinity risk scoring: non-designated stops on arterials are the highest-risk stop configurations."@en .


# =============================================================================
# Part 5: Trip Risk Assessment Class and RiskTier Enumeration
# =============================================================================
# The risk_assessment object from Stage 6 is rich enough to warrant its own
# TKO class rather than being flattened onto the trip entity directly.
# This preserves queryability of individual risk factors while keeping the
# trip entity clean.

tko:RiskTier rdf:type owl:Class ;
    rdfs:label "Risk Tier"@en ;
    rdfs:comment "Qualitative risk tier classification for trip or segment risk scores. Five-level enumeration derived from population-relative percentile thresholds configured in the Configuration Snapshot."@en .

tko:RISK_LOW rdf:type owl:NamedIndividual, tko:RiskTier ;
    rdfs:label "Low Risk"@en ;
    rdfs:comment "Risk score in the 0–20th percentile of the trip population. Route and stop environments are below-average risk for the fleet."@en .

tko:RISK_MODERATE rdf:type owl:NamedIndividual, tko:RiskTier ;
    rdfs:label "Moderate Risk"@en ;
    rdfs:comment "Risk score in the 20–50th percentile of the trip population. Route or stop environments present typical risk for the fleet."@en .

tko:RISK_ELEVATED rdf:type owl:NamedIndividual, tko:RiskTier ;
    rdfs:label "Elevated Risk"@en ;
    rdfs:comment "Risk score in the 50–80th percentile of the trip population. Route or stop environments are above-average risk and may warrant driver coaching attention."@en .

tko:RISK_HIGH rdf:type owl:NamedIndividual, tko:RiskTier ;
    rdfs:label "High Risk"@en ;
    rdfs:comment "Risk score in the 80–95th percentile of the trip population. Route or stop environments are significantly above average; driver coaching is recommended."@en .

tko:RISK_CRITICAL rdf:type owl:NamedIndividual, tko:RiskTier ;
    rdfs:label "Critical Risk"@en ;
    rdfs:comment "Risk score at or above the 95th percentile of the trip population. Route or stop environments are among the highest-risk in the fleet; immediate driver coaching or route review is indicated."@en .

# HISTORICAL RISK ASSESSMENT — populated in Stage 6 after GPS data is processed.
# For PROSPECTIVE risk during an active trip, see reo:ActiveRouteRisk (REO v1).
tko:TripRiskAssessment rdf:type owl:Class ;
    rdfs:label "Trip Risk Assessment"@en ;
    rdfs:comment "Comprehensive risk assessment for a trip produced by Stage 6 of the Trip Intelligence Pipeline. Captures route-level risk (aggregated from pre-computed GKG segment scores), stop-level risk (from stop event profiles), a composite trip risk score, and a qualitative risk tier relative to the fleet population. Linked from the trip entity via tko:hasRiskAssessment."@en .

tko:hasRiskAssessment rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:TripRiskAssessment ;
    rdfs:label "has risk assessment"@en ;
    rdfs:comment "Links a trip to its Stage 6 risk assessment. One-to-one: each processed trip has at most one risk assessment."@en .

tko:routeRiskScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "route risk score"@en ;
    rdfs:comment "Composite route risk score (0.0–1.0), computed as the weighted mean of the uko:segmentRiskScore values for all segments in the trip's actual reconstructed route. Weights are configurable (default: uniform). Represents the inherent hazard level of the road environment the driver traversed, independent of driving behavior."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_risk"^^xsd:string .

tko:maxSegmentRiskScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "max segment risk score"@en ;
    rdfs:comment "Maximum uko:segmentRiskScore among all segments in the actual route. Identifies the highest-risk individual segment encountered on the trip; useful for targeted infrastructure improvement recommendations."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_risk"^^xsd:string .

tko:highRiskSegmentCount rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:integer ;
    rdfs:label "high risk segment count"@en ;
    rdfs:comment "Number of segments in the actual route with uko:segmentRiskTier of HIGH or CRITICAL. Used as a count-based alternative to the continuous route risk score for threshold-based alerting."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "integer"^^xsd:string ;
    tko:featureGroup "trip_risk"^^xsd:string .

tko:maxStopRisk rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "max stop risk"@en ;
    rdfs:comment "Maximum tko:stopRiskScore among all stop events in this trip. Used to surface the single most dangerous stop environment for driver coaching prioritization."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_risk"^^xsd:string .

tko:meanStopRisk rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "mean stop risk"@en ;
    rdfs:comment "Mean tko:stopRiskScore across all stop events in this trip. Null when the trip has no stop events. Represents the average hazard level of the driver's stop-related pedestrian exposure windows across the trip."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_risk"^^xsd:string .

tko:tripRiskScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "trip risk score"@en ;
    rdfs:comment "Composite trip risk score (0.0–1.0), combining routeRiskScore and maxStopRisk with configurable weights (default: 0.6 route / 0.4 stop). This is the primary risk metric surfaced to fleet managers and driver coaching systems. Used as the basis for riskTier assignment."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_risk"^^xsd:string .

tko:hasRiskTier rdf:type owl:ObjectProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range tko:RiskTier ;
    rdfs:label "has risk tier"@en ;
    rdfs:comment "The qualitative risk tier assigned to this trip based on the tripRiskScore's population-relative percentile. Links to one of the five tko:RiskTier individuals: RISK_LOW, RISK_MODERATE, RISK_ELEVATED, RISK_HIGH, RISK_CRITICAL."@en .

tko:riskTierLowerPctile rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "risk tier lower percentile"@en ;
    rdfs:comment "Lower percentile bound of the risk tier assigned to this trip (e.g., 80.0 for RISK_HIGH). Stored alongside the tier label to support sensitivity analysis and tier boundary review."@en .

tko:riskTierUpperPctile rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "risk tier upper percentile"@en ;
    rdfs:comment "Upper percentile bound of the risk tier assigned to this trip (e.g., 95.0 for RISK_HIGH). Null for RISK_CRITICAL, which has no upper bound."@en .

tko:populationSnapshotDate rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:date ;
    rdfs:label "population snapshot date"@en ;
    rdfs:comment "Date of the trip population snapshot used to compute the percentile thresholds for risk tier assignment. The risk tier of a given trip is relative to the fleet population at this snapshot date; as the population changes, tier assignments may shift without the underlying risk score changing. Used to support longitudinal risk trend analysis."@en .

tko:riskScoredAt rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "risk scored at"@en ;
    rdfs:comment "Timestamp when this risk assessment was computed. Used to assess data currency and to sequence risk score refreshes when GKG segment risk scores are updated."@en .

tko:alternateRouteRiskScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "alternate route risk score"@en ;
    rdfs:comment "Mean routeRiskScore across all alternative routes generated in Stage 2 for this trip. Null when no alternative routes were generated. Enables the counterfactual risk comparison: was the actual route safer or more dangerous than the credible alternatives? A tripRiskScore substantially higher than alternateRouteRiskScore is a strong driver coaching signal."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_risk"^^xsd:string .

tko:bestAlternativeRiskScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "best alternative risk score"@en ;
    rdfs:comment "Minimum routeRiskScore among all alternative routes generated in Stage 2. Null when no alternatives were generated. Represents the lowest-risk credible alternative the driver could have taken. When bestAlternativeRiskScore is significantly below routeRiskScore, this trip is a candidate for route recommendation coaching."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "numeric"^^xsd:string ;
    tko:featureGroup "trip_risk"^^xsd:string .


# =============================================================================
# Part 6: Modality Property Verification and Supplement
# =============================================================================
# tko:hasModality already exists (line 258 in TKO v5) as an object property
# from Trip to TravelModality. These supplements ensure the modality value
# is also available as a direct string for Stage 2 SPARQL-based feasibility
# filtering against uko:permittedModalities.

tko:modalityString rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:string ;
    rdfs:label "modality string"@en ;
    rdfs:comment "The trip's declared modality as a plain string value from the TKO modality controlled vocabulary, mirroring the tko:hasModality object property. Stored redundantly to support direct string comparison against uko:permittedModalities during Stage 2 SPARQL-based feasibility filtering without requiring subgraph traversal. Values: DRIVING, MOTORCYCLE, WALKING, BICYCLING, RIDE_HAILING, SCOOTER, BIKE_SHARE, BUS, RAIL, LIGHT_RAIL, SUBWAY, HEAVY_TRUCK, LIGHT_COMMERCIAL."@en ;
    tko:featureExtraction "true"^^xsd:boolean ;
    tko:featureType "categorical"^^xsd:string ;
    tko:featureGroup "trip_context"^^xsd:string .


# =============================================================================
# END OF TRIP INTELLIGENCE PIPELINE SUPPORT EXTENSION
# =============================================================================


# =============================================================================
# Part 7: Dispatched Trip and Dynamic Route Monitoring Architecture (v7.0.0)
# =============================================================================
# This part introduces the classes and properties needed to support prospective,
# dynamic route risk monitoring — the "airline operations center" model in which
# a dispatcher assigns a route before departure and the Dynamic Risk Monitor
# continuously re-evaluates event-weighted risk along that assigned route while
# the vehicle is in transit.
#
# Key design distinction:
#   tko:TripRiskAssessment  — HISTORICAL. Populated in Stage 6 of the Trip
#                             Intelligence Pipeline after a trip is completed and
#                             GPS data has been processed. Reflects the actual
#                             route taken, scored against static segment risk.
#
#   reo:ActiveRouteRisk     — PROSPECTIVE. Maintained in the GKG Event Layer by
#                             the Dynamic Risk Monitor during an active trip.
#                             Reflects the assigned route, scored against current
#                             and forecast events weighted by FleetEventSensitivity.
#
# The two objects are complementary. The historical assessment feeds the Learning
# Phase. The active route risk drives real-time dispatcher alerts.
# =============================================================================


# ---------------------------------------------------------------------------
# 7.1  AssignedRoute
# ---------------------------------------------------------------------------

tko:AssignedRoute rdf:type owl:Class ;
    rdfs:label "Assigned Route"@en ;
    rdfs:comment "A dispatcher-assigned route for a DispatchedTrip, expressed as an ordered sequence of uko:RoadSegment URNs. Distinct from the GPS-reconstructed actual route (tko:hasRoute). The AssignedRoute is the primary spatial input to the Dynamic Risk Monitor, which maps active reo:Event instances onto assigned segments via reo:affectsSegment to compute reo:ActiveRouteRisk. Populated by the dispatch system at the time a trip is assigned."@en .

tko:hasAssignedRoute rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:AssignedRoute ;
    rdfs:label "has assigned route"@en ;
    rdfs:comment "Links a Trip to its dispatcher-assigned route. Present only for DispatchedTrips. When both tko:hasAssignedRoute and tko:hasRoute are present on the same trip, the assigned route represents the dispatcher's plan and the actual route represents what the driver traversed; deviations between the two are operationally significant."@en .

tko:assignedSegmentSequence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:AssignedRoute ;
    rdfs:range xsd:string ;
    rdfs:label "assigned segment sequence"@en ;
    rdfs:comment "Ordered JSON array of GKG segment URNs representing the dispatcher-assigned traversal sequence. Format: ['urn:seg:A1', 'urn:seg:A2', ...]. Stored as a compact string for efficient retrieval by the Dynamic Risk Monitor without requiring subgraph traversal."@en .

tko:assignedRouteTotalDistanceMeters rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:AssignedRoute ;
    rdfs:range xsd:decimal ;
    rdfs:label "assigned route total distance (meters)"@en ;
    rdfs:comment "Summed length of all segments in the assigned route, in meters."@en .

tko:assignedRouteEstimatedDurationSeconds rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:AssignedRoute ;
    rdfs:range xsd:integer ;
    rdfs:label "assigned route estimated duration (seconds)"@en ;
    rdfs:comment "Estimated traversal time computed at dispatch time from GKG segment speed profiles and modality. Used by the Dynamic Risk Monitor to project which segments the vehicle will occupy at which future times, enabling spatio-temporal event intersection."@en .

tko:dispatchTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:AssignedRoute ;
    rdfs:range xsd:dateTime ;
    rdfs:label "dispatch timestamp"@en ;
    rdfs:comment "ISO 8601 timestamp at which the dispatcher confirmed and transmitted this route assignment to the driver."@en .

tko:routingEngineRef rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:AssignedRoute ;
    rdfs:range xsd:string ;
    rdfs:label "routing engine reference"@en ;
    rdfs:comment "Identifier of the routing system or dispatcher that generated the assigned route. Values: 'GRAPHHOPPER', 'HERE_FLEET', 'MANUAL_DISPATCHER', 'DISPATCH_SYSTEM_V2'. Supports audit traceability."@en .

tko:assignedRouteGKGNetworkVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:AssignedRoute ;
    rdfs:range xsd:string ;
    rdfs:label "GKG network version used for routing"@en ;
    rdfs:comment "Version identifier of the GKG road layer snapshot used to compute this assigned route. Mirrors the uko:gkgNetworkExportVersion pattern. Allows detection of route staleness when the GKG road network is updated after dispatch."@en .


# ---------------------------------------------------------------------------
# 7.2  VehicleClass
# ---------------------------------------------------------------------------

tko:VehicleClass rdf:type owl:Class ;
    rdfs:label "Vehicle Class"@en ;
    rdfs:comment "A controlled vocabulary class representing the physical and operational classification of a fleet vehicle. VehicleClass is the primary determinant of which reo:FleetEventSensitivity profiles apply during Dynamic Risk Monitor evaluation. A fleet manager may register a vehicle with a specific VehicleClass, or the class may be inferred from tko:CargoProfile and intent."@en .

tko:hasVehicleClass rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:VehicleClass ;
    rdfs:label "has vehicle class"@en ;
    rdfs:comment "Links a Trip to the VehicleClass of the vehicle performing it. Together with tko:CargoProfile and tko:TripIntent, determines the applicable reo:FleetEventSensitivity instances for dynamic route risk scoring."@en .

# VehicleClass named individuals

tko:PASSENGER_CAR rdf:type owl:NamedIndividual, tko:VehicleClass ;
    rdfs:label "Passenger Car"@en ;
    rdfs:comment "Standard passenger automobile. GVW < 8,500 lbs. Standard road access; no height, weight, or CDL restrictions."@en .

tko:LIGHT_COMMERCIAL_VEHICLE rdf:type owl:NamedIndividual, tko:VehicleClass ;
    rdfs:label "Light Commercial Vehicle"@en ;
    rdfs:comment "Cargo vans, pickup trucks, and light delivery vehicles. GVW 8,500–14,000 lbs. Includes Class 1–3 trucks. Subject to weight limits on restricted bridges but generally road-unrestricted."@en .

tko:HEAVY_TRUCK rdf:type owl:NamedIndividual, tko:VehicleClass ;
    rdfs:label "Heavy Truck"@en ;
    rdfs:comment "Class 7–8 commercial trucks. GVW > 26,000 lbs. Requires CDL and Hours of Service (HOS) compliance. Subject to weight (uko:maxWeightTons), height (uko:maxHeightMeters), and road class restrictions. Wind and ice events have elevated safety impact due to high center of gravity."@en .

tko:ARMORED_VEHICLE rdf:type owl:NamedIndividual, tko:VehicleClass ;
    rdfs:label "Armored Vehicle"@en ;
    rdfs:comment "Armored cash-in-transit or high-value cargo vehicle. Operates under specialized security routing protocols. Route predictability is a security liability; SecurityEvents in REO carry CRITICAL alertPriority for armored vehicle trips. Safety weight dominates over ETA weight in FleetEventSensitivity profiles."@en .

tko:EMERGENCY_VEHICLE rdf:type owl:NamedIndividual, tko:VehicleClass ;
    rdfs:label "Emergency Vehicle"@en ;
    rdfs:comment "Ambulances, fire apparatus, and law enforcement vehicles operating under emergency response conditions. Both safety and ETA weights are elevated. Road closure events and severe congestion carry CRITICAL alertPriority."@en .

tko:REFRIGERATED_TRUCK rdf:type owl:NamedIndividual, tko:VehicleClass ;
    rdfs:label "Refrigerated Truck"@en ;
    rdfs:comment "Temperature-controlled cargo truck (reefer). Subject to HEAVY_TRUCK road restrictions. Extreme heat events and long delays that compromise refrigeration unit operation are operationally significant beyond standard safety considerations."@en .

tko:MOTORCYCLE rdf:type owl:NamedIndividual, tko:VehicleClass ;
    rdfs:label "Motorcycle"@en ;
    rdfs:comment "Two-wheeled motorized vehicle. High sensitivity to weather events (rain, ice, wind) and road hazard events (debris, potholes). Safety weight dominates over ETA weight."@en .

tko:RIDESHARE_VEHICLE rdf:type owl:NamedIndividual, tko:VehicleClass ;
    rdfs:label "Rideshare Vehicle"@en ;
    rdfs:comment "Passenger vehicle operating for a TNC (Transportation Network Company). Sensitivity profile similar to PASSENGER_CAR with higher ETA weight due to passenger experience metrics."@en .

tko:BICYCLE rdf:type owl:NamedIndividual, tko:VehicleClass ;
    rdfs:label "Bicycle"@en ;
    rdfs:comment "Human-powered bicycle, including e-bikes. Highest weather sensitivity of all vehicle classes. Restricted to dedicated bike infrastructure where available."@en .


# ---------------------------------------------------------------------------
# 7.3  CargoProfile
# ---------------------------------------------------------------------------

tko:CargoProfile rdf:type owl:Class ;
    rdfs:label "Cargo Profile"@en ;
    rdfs:comment "Describes the nature, value, handling requirements, and security classification of cargo carried on a commercial trip. The CargoProfile is the secondary determinant (after VehicleClass and TripIntent) of reo:FleetEventSensitivity weights. High cargoValueTier shifts safetyWeight upward; temperatureControlled=true makes weather events operationally significant; securityLevel=MAXIMUM makes SecurityEvents CRITICAL priority."@en .

tko:hasCargoProfile rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:CargoProfile ;
    rdfs:label "has cargo profile"@en ;
    rdfs:comment "Links a commercial or logistics Trip to its CargoProfile. Absent for passenger, personal, and recreational trips. Required for FleetManagementIntent subclasses where cargo characteristics determine event sensitivity."@en .

tko:cargoClass rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:CargoProfile ;
    rdfs:range xsd:string ;
    rdfs:label "cargo class"@en ;
    rdfs:comment "Operational cargo classification. Not a formal taxonomy; values are deployment-specific. Representative values: GENERAL_FREIGHT, PERISHABLE_FOOD, PERISHABLE_PHARMA, HAZMAT_CLASS_3, HAZMAT_CLASS_6, CURRENCY_AND_VALUABLES, PRECIOUS_METALS, MEDICAL_SUPPLIES, ELECTRONICS_HIGH_VALUE, CONSTRUCTION_MATERIALS, RETAIL_PARCELS, RESTAURANT_MEALS."@en .

tko:cargoValueTier rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:CargoProfile ;
    rdfs:range xsd:string ;
    rdfs:label "cargo value tier"@en ;
    rdfs:comment "Relative monetary value tier of the cargo. Controlled vocabulary: LOW (standard retail parcels, bulk materials), MODERATE (electronics, machinery), HIGH (medical devices, jewelry), CRITICAL (currency, precious metals, classified materials). Value tier directly influences reo:rerouteThreshold in FleetEventSensitivity; CRITICAL cargo has lower thresholds, triggering reroute recommendations earlier."@en .

tko:temperatureControlled rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:CargoProfile ;
    rdfs:range xsd:boolean ;
    rdfs:label "temperature controlled"@en ;
    rdfs:comment "True when the cargo requires active temperature control (refrigerated or frozen) during transport. When true, weather events that elevate ambient temperature (ExtremeHeatEvent) and route delays that extend exposure time are assigned elevated operational significance beyond their road safety implications."@en .

tko:securityLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:CargoProfile ;
    rdfs:range xsd:string ;
    rdfs:label "security level"@en ;
    rdfs:comment "Required security classification for the cargo movement. Controlled vocabulary: STANDARD (general commercial), ENHANCED (pharmaceuticals, electronics), HIGH (financial instruments, high-value goods), MAXIMUM (currency, armored car movements). securityLevel=MAXIMUM causes reo:SecurityEvent instances to carry CRITICAL alertPriority in the applicable FleetEventSensitivity profile."@en .

tko:hazmatClass rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:CargoProfile ;
    rdfs:range xsd:string ;
    rdfs:label "hazmat class"@en ;
    rdfs:comment "DOT Hazmat classification, where applicable. Format: 'CLASS_N' (e.g., 'CLASS_3' for flammable liquids, 'CLASS_6_1' for toxic materials, 'CLASS_9' for miscellaneous). Null for non-hazmat cargo. Hazmat class influences which road segments are permissible and elevates the safety impact of accident and road closure events."@en .

tko:cargoWeightKg rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:CargoProfile ;
    rdfs:range xsd:decimal ;
    rdfs:label "cargo weight (kg)"@en ;
    rdfs:comment "Declared cargo weight in kilograms. Used in combination with tko:VehicleClass to check uko:maxWeightTons compliance on candidate route segments during Alternative Route Generation."@en .


# ---------------------------------------------------------------------------
# 7.4  DispatchedTrip and ActiveTripSession
# ---------------------------------------------------------------------------

tko:DispatchedTrip rdf:type owl:Class ;
    rdfs:subClassOf tko:Trip ;
    rdfs:label "Dispatched Trip"@en ;
    rdfs:comment "A Trip that was assigned by a dispatcher prior to departure, carrying a tko:hasAssignedRoute, tko:hasVehicleClass, and optionally a tko:hasCargoProfile. DispatchedTrips are eligible for prospective dynamic route risk monitoring by the Dynamic Risk Monitor Knowledge Agent, which maintains a reo:ActiveRouteRisk instance for each in-progress DispatchedTrip. The distinction between DispatchedTrip and Trip parallels the distinction between reo:ActiveRouteRisk (prospective) and tko:TripRiskAssessment (historical)."@en .

tko:dispatcherId rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range xsd:string ;
    rdfs:label "dispatcher ID"@en ;
    rdfs:comment "Identifier of the dispatcher or dispatch system that assigned this trip. Used for audit trails and post-event analysis of dispatch decisions."@en .

tko:dispatchSystemRef rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range xsd:string ;
    rdfs:label "dispatch system reference"@en ;
    rdfs:comment "External identifier in the calling fleet management system (e.g., 'ORDER_20260315_0042'). Allows correlation between SPNSLMAIS records and the operator's own dispatch log."@en .

tko:plannedDepartureTime rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range xsd:dateTime ;
    rdfs:label "planned departure time"@en ;
    rdfs:comment "Dispatcher-assigned planned departure timestamp. Used as the T0 for ETA projection in the Dynamic Risk Monitor when no GPS position updates are available."@en .

tko:plannedArrivalTime rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range xsd:dateTime ;
    rdfs:label "planned arrival time"@en ;
    rdfs:comment "Expected delivery or arrival time at the final destination, as set by the dispatcher. Breach of this window triggers an ETA risk alert in the Dynamic Risk Monitor."@en .

# --- ActiveTripSession ---

tko:ActiveTripSession rdf:type owl:Class ;
    rdfs:label "Active Trip Session"@en ;
    rdfs:comment "A lightweight session record maintained by the Dynamic Risk Monitor for a DispatchedTrip that is currently in progress. Tracks estimated progress along the AssignedRoute and the timestamp of the most recent reo:ActiveRouteRisk recalculation. Lifecycle: AWAITING_DEPARTURE → IN_PROGRESS → COMPLETED | ABORTED. Not persisted to the GKG historical layer; stored in Redis during trip execution with TTL equal to the trip's planned duration plus a configurable buffer."@en .

tko:sessionTripRef rdf:type owl:ObjectProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range tko:DispatchedTrip ;
    rdfs:label "session trip reference"@en ;
    rdfs:comment "Links the ActiveTripSession to its associated DispatchedTrip."@en .

tko:sessionStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:string ;
    rdfs:label "session status"@en ;
    rdfs:comment "Current lifecycle state. Controlled vocabulary: AWAITING_DEPARTURE (trip assigned, vehicle not yet departed), IN_PROGRESS (vehicle en route on assigned route), COMPLETED (vehicle reached final destination), ABORTED (trip cancelled or vehicle significantly off-route)."@en .

tko:estimatedCurrentSegmentIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:integer ;
    rdfs:label "estimated current segment index"@en ;
    rdfs:comment "Zero-based index into the AssignedRoute's tko:assignedSegmentSequence array, identifying the segment where the vehicle is currently estimated to be. Updated on GPS position report (if available) or elapsed-time projection using tko:assignedRouteEstimatedDurationSeconds."@en .

tko:lastRiskRecalculationTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:dateTime ;
    rdfs:label "last risk recalculation timestamp"@en ;
    rdfs:comment "Timestamp of the most recent reo:ActiveRouteRisk computation for this trip by the Dynamic Risk Monitor. Recalculation is triggered by: (1) event feed update affecting assigned route segments, (2) GPS position report, (3) periodic timer (configurable, default 5 minutes)."@en .

tko:sessionCreatedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:dateTime ;
    rdfs:label "session created at"@en ;
    rdfs:comment "Timestamp at which the ActiveTripSession was created, corresponding to dispatch confirmation."@en .

tko:gpsLastReportTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:dateTime ;
    rdfs:label "GPS last report timestamp"@en ;
    rdfs:comment "Timestamp of the most recent GPS position report received for this vehicle. When this timestamp is more than the configured GPS staleness threshold (default: 10 minutes) older than the current time, the Dynamic Risk Monitor switches to elapsed-time projection for segment index estimation."@en .

tko:gpsLastReportLat rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:decimal ;
    rdfs:label "GPS last report latitude"@en ;
    rdfs:comment "WGS84 latitude of the most recent GPS position report."@en .

tko:gpsLastReportLon rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:decimal ;
    rdfs:label "GPS last report longitude"@en ;
    rdfs:comment "WGS84 longitude of the most recent GPS position report."@en .

# ---------------------------------------------------------------------------
# 7.4.1  Driver Profile (v8.1.0)
# ---------------------------------------------------------------------------
tko:DriverProfile rdf:type owl:Class ;
    rdfs:label "Driver Profile"@en ;
    rdfs:comment "Maintains rolling 90-day aggregates for driver behavior metrics."@en .

tko:hasDriverProfile rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range tko:DriverProfile ;
    rdfs:label "has driver profile"@en ;
    rdfs:comment "Links a DispatchedTrip to the historical performance profile of the assigned driver."@en .

tko:hardBrakingRate rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverProfile ;
    rdfs:range xsd:decimal ;
    rdfs:label "hard braking rate"@en ;
    rdfs:comment "Rolling 90-day aggregate rate of hard braking events."@en .

tko:speedingRate rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverProfile ;
    rdfs:range xsd:decimal ;
    rdfs:label "speeding rate"@en ;
    rdfs:comment "Rolling 90-day aggregate speeding rate."@en .

tko:ecoDrivingScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverProfile ;
    rdfs:range xsd:decimal ;
    rdfs:label "eco driving score"@en ;
    rdfs:comment "Rolling 90-day aggregate eco-driving score."@en .

# ---------------------------------------------------------------------------
# 7.5  New FleetManagementIntent Subclasses
# ---------------------------------------------------------------------------
# Added in v7.0.0 to support cargo-differentiated fleet event sensitivity.
# These subclasses extend the existing LogisticsIntent and FieldServiceIntent
# hierarchies established in TKO v5.

tko:HighValueFreightHauling rdfs:subClassOf tko:LogisticsIntent ;
    rdfs:label "High Value Freight Hauling"@en ;
    rdfs:comment "Freight hauling trip where tko:cargoValueTier is HIGH or CRITICAL. Safety weight dominates over ETA weight in applicable reo:FleetEventSensitivity profiles. Weather events and road hazard events carry elevated alertPriority compared to standard FreightHauling."@en .

tko:RefrigeratedFreightHauling rdfs:subClassOf tko:LogisticsIntent ;
    rdfs:label "Refrigerated Freight Hauling"@en ;
    rdfs:comment "Freight hauling trip where tko:temperatureControlled is true. Weather events affecting road safety and extreme heat events affecting cargo integrity are both operationally significant. Subject to HEAVY_TRUCK or REFRIGERATED_TRUCK vehicle class restrictions."@en .

tko:ArmoredCarService rdfs:subClassOf tko:LogisticsIntent ;
    rdfs:label "Armored Car Service"@en ;
    rdfs:comment "Armored vehicle trip for cash-in-transit, precious metals, or classified materials movement between financial institutions, ATMs, vaults, or secure facilities. Route predictability is a security liability; reo:SecurityEvents carry CRITICAL alertPriority. Safety weight is maximum; ETA weight is subordinate. Vehicle class: ARMORED_VEHICLE. Cargo security level: MAXIMUM."@en .

tko:EmergencyMedicalSupplyRun rdfs:subClassOf tko:LogisticsIntent ;
    rdfs:label "Emergency Medical Supply Run"@en ;
    rdfs:comment "Emergency delivery of medical supplies, blood products, organs, or pharmaceuticals where both timing and cargo integrity are critical. Both safetyWeight and etaWeight are elevated. Road closure and severe congestion events carry CRITICAL alertPriority. May use EMERGENCY_VEHICLE vehicle class depending on operator certification."@en .

tko:IntercityFreightHauling rdfs:subClassOf tko:FreightHauling ;
    rdfs:label "Intercity Freight Hauling"@en ;
    rdfs:comment "Long-haul freight movement between cities (typically >50 miles). Weather events along the entire route corridor are operationally significant because the driver may be several hours away from the affected segments at dispatch time. The Dynamic Risk Monitor performs spatio-temporal event projection for intercity trips."@en .

tko:IntracityFreightHauling rdfs:subClassOf tko:FreightHauling ;
    rdfs:label "Intracity Freight Hauling"@en ;
    rdfs:comment "Short-haul freight movement within a city or metropolitan area (typically <50 miles). Congestion and incident events near the immediate route are more operationally significant than distant weather events."@en .


# =============================================================================
# END OF TKO DISPATCHED TRIP AND DYNAMIC ROUTE MONITORING EXTENSION
# =============================================================================


# =============================================================================
# Part 8: Hours of Service (HOS) Compliance Layer  (TKO v7.1)
# =============================================================================
# Introduced in TKO v7.1 to support legally compliant reroute recommendations
# in the Fleet Intelligence Application.
#
# Background: FMCSA Hours of Service regulations (49 CFR Part 395) are the
# hardest constraints in commercial trucking. A reroute recommendation that
# would cause a driver to exceed their legal driving window is not just
# suboptimal — it is illegal and creates federal liability for the fleet
# operator. Any routing AI that operates without HOS data is producing
# recommendations that may be physically impossible to execute.
#
# HOS data is sourced exclusively from the fleet's Electronic Logging Device
# (ELD) via the telematics provider API (Samsara, Geotab, Motive, etc.).
# SPNSLMAIS reads HOS data via a read-only API integration; it does not
# write to or modify ELD records.
#
# Key FMCSA rules represented:
#   - 11-hour driving limit (property-carrying CDL): max 11 hours driving
#     after 10 consecutive hours off duty
#   - 14-hour on-duty window: may not drive beyond 14 consecutive hours after
#     coming on duty
#   - 30-minute rest break: required after 8 cumulative hours of driving
#   - 60/70-hour limit: 60 hours on duty in 7 days OR 70 hours in 8 days
#   - Sleeper berth provisions: split-sleeper rules for team drivers
#
# Design note: TKO models the HOS state for the DRIVER assigned to a
# DispatchedTrip, not for the vehicle. A vehicle has no HOS state;
# only a licensed CDL driver does.
# =============================================================================

# ---------------------------------------------------------------------------
# 8.1  DriverHOSRecord class
# ---------------------------------------------------------------------------

tko:DriverHOSRecord rdf:type owl:Class ;
    rdfs:label "Driver HOS Record"@en ;
    rdfs:comment "A point-in-time snapshot of a commercial truck driver's Hours of Service status, sourced from the fleet's Electronic Logging Device (ELD) via telematics API. The HOSRecord captures the driver's current duty status, remaining legal driving and on-duty time, and cycle usage at the moment the record was fetched. It is linked to a DispatchedTrip and is the authoritative input to the HOS compliance check performed by the Fleet Intelligence Application before any reroute recommendation is issued. HOSRecord instances are ephemeral: they are created when a DispatchedTrip session is initialized and updated on each monitoring cycle with a fresh API fetch. They are not persisted to the GKG historical layer."@en ;
    rdfs:isDefinedBy <urn:trip-kg:> .

tko:hasDriverHOSRecord rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range tko:DriverHOSRecord ;
    rdfs:label "has driver HOS record"@en ;
    rdfs:comment "Links a DispatchedTrip to the most recently fetched DriverHOSRecord for the driver assigned to that trip. Updated on each Active Trip Monitoring cycle. Null if the fleet's telematics system does not provide HOS API access or the driver is exempt from ELD requirements (e.g., short-haul exemption under 49 CFR 395.1(e))."@en .

# ---------------------------------------------------------------------------
# 8.2  HOS duty status enumeration
# ---------------------------------------------------------------------------

tko:HOSDutyStatus rdf:type owl:Class ;
    rdfs:label "HOS Duty Status"@en ;
    rdfs:comment "Controlled vocabulary for FMCSA-defined duty status categories, as recorded by the driver's ELD. These are the four standard FMCSA log line statuses per 49 CFR Part 395."@en .

tko:HOS_OFF_DUTY rdf:type owl:NamedIndividual, tko:HOSDutyStatus ;
    rdfs:label "Off Duty"@en ;
    rdfs:comment "Driver is off duty. Hours off duty count toward the 10-consecutive-hour reset period required before a new 11-hour driving window begins."@en .

tko:HOS_SLEEPER_BERTH rdf:type owl:NamedIndividual, tko:HOSDutyStatus ;
    rdfs:label "Sleeper Berth"@en ;
    rdfs:comment "Driver is in the sleeper berth. May be combined with off-duty time under split sleeper berth provisions (49 CFR 395.1(g)) to restart the driving window."@en .

tko:HOS_DRIVING rdf:type owl:NamedIndividual, tko:HOSDutyStatus ;
    rdfs:label "Driving"@en ;
    rdfs:comment "Driver is actively operating the vehicle. Counts against the 11-hour driving limit and the 14-hour on-duty window."@en .

tko:HOS_ON_DUTY_NOT_DRIVING rdf:type owl:NamedIndividual, tko:HOSDutyStatus ;
    rdfs:label "On Duty - Not Driving"@en ;
    rdfs:comment "Driver is on duty but not driving (e.g., loading, fueling, pre-trip inspection, waiting at shipper). Counts against the 14-hour on-duty window but not the 11-hour driving limit."@en .

# ---------------------------------------------------------------------------
# 8.3  DriverHOSRecord data properties
# ---------------------------------------------------------------------------

tko:driverEldId rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:string ;
    rdfs:label "driver ELD ID"@en ;
    rdfs:comment "The ELD-assigned driver identifier from the telematics system. Used to correlate HOS records across monitoring cycles and across trips. Format varies by telematics provider (e.g., Samsara driver ID, Geotab driver key)."@en .

tko:hosRecordTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "HOS record timestamp"@en ;
    rdfs:comment "The UTC timestamp at which this HOS record was fetched from the telematics ELD API. The Fleet Intelligence Application treats HOS records older than the configured staleness threshold (default: 5 minutes) as potentially stale and re-fetches before issuing a reroute recommendation."@en .

tko:currentDutyStatus rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range tko:HOSDutyStatus ;
    rdfs:label "current duty status"@en ;
    rdfs:comment "The driver's current FMCSA duty status at the time the HOS record was fetched. One of the four tko:HOSDutyStatus named individuals."@en .

tko:remainingDriveTimeMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:integer ;
    rdfs:label "remaining drive time (minutes)"@en ;
    rdfs:comment "Number of minutes of legal driving time remaining in the current 11-hour window (property-carrying driver) or 10-hour window (passenger-carrying driver). Zero means the driver must stop immediately. The Fleet Intelligence Application's HOS compliance check evaluates whether a proposed reroute's additional driving time falls within this limit. A reroute requiring more additional driving time than this value is HOS-infeasible and must be rejected or combined with a mandatory parking stop."@en .

tko:remainingOnDutyTimeMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:integer ;
    rdfs:label "remaining on-duty time (minutes)"@en ;
    rdfs:comment "Number of minutes remaining in the driver's 14-hour on-duty window. The on-duty window begins when the driver comes on duty after a 10-consecutive-hour off-duty period. When this reaches zero, the driver cannot drive regardless of remaining drive time. The 14-hour clock cannot be extended and does not pause for non-driving on-duty activities."@en .

tko:remainingCycleTimeMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:integer ;
    rdfs:label "remaining cycle time (minutes)"@en ;
    rdfs:comment "Number of minutes of on-duty time remaining in the driver's 7-day (60-hour) or 8-day (70-hour) cycle. When this reaches zero, the driver must take a 34-hour restart before driving again. Cycle time is the longest-horizon HOS constraint and is most relevant for multi-day route planning rather than single-trip rerouting."@en .

tko:minutesDrivenSinceLastBreak rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:integer ;
    rdfs:label "minutes driven since last break"@en ;
    rdfs:comment "Cumulative driving minutes since the driver's last rest break of 30 minutes or longer. The FMCSA 30-minute rest break rule (49 CFR 395.3(a)(3)(ii)) requires a 30-minute break after 8 cumulative hours of driving. When this value reaches 480 minutes (8 hours), the driver must take a 30-minute break before driving further. This constraint is more likely to bind during long continuous drives and is operationally distinct from the 11-hour window."@en .

tko:hosExemptionType rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:string ;
    rdfs:label "HOS exemption type"@en ;
    rdfs:comment "Applicable FMCSA HOS exemption, if any. Controlled vocabulary: 'SHORT_HAUL' (49 CFR 395.1(e) — driver returns to home terminal daily, no ELD required); 'AGRICULTURAL' (seasonal agricultural commodity exemption); 'OILFIELD' (oilfield operations exemption); 'ADVERSE_DRIVING' (one additional driving hour permitted in genuine adverse weather conditions per 49 CFR 395.1(b)(1)); 'EMERGENCY' (emergency declaration waiver — state or federal); null for standard regulated drivers. Exemption type affects which HOS limits apply and whether ELD data is available."@en .

tko:adverseDrivingConditionInvoked rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "adverse driving condition invoked"@en ;
    rdfs:comment "True if the dispatcher has invoked the Adverse Driving Conditions exemption (49 CFR 395.1(b)(1)) for this trip, granting the driver an additional 2 hours of driving time (raising the effective limit from 11 to 13 hours) due to genuine unexpected adverse weather encountered en route. This exemption requires that conditions were not foreseeable at the trip's start. The Fleet Intelligence Application records this flag when the dispatcher invokes the exemption during a Route Risk Analysis session."@en .

tko:hosDataSource rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:string ;
    rdfs:label "HOS data source"@en ;
    rdfs:comment "Identifier of the telematics system from which this HOS record was fetched. Values: 'SAMSARA' (Samsara Fleet API v1); 'GEOTAB' (Geotab MyGeotab SDK HOS endpoint); 'MOTIVE' (Motive ELD API); 'OMNITRACS' (Omnitracs IVG platform); 'TRIMBLE' (Trimble TMT ELD); 'MANUAL' (dispatcher manually entered HOS data — lower confidence). The data source informs the confidence weight assigned to the HOS record: ELD-sourced records are authoritative; MANUAL entries require dispatcher attestation."@en .

tko:hosDataConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DriverHOSRecord ;
    rdfs:range xsd:decimal ;
    rdfs:label "HOS data confidence"@en ;
    rdfs:comment "Confidence score [0.0–1.0] for the accuracy of this HOS record. ELD API sources receive 0.95 (high — minor latency tolerance). Records older than the staleness threshold receive a decayed score. MANUAL entries receive 0.70. Records flagged by the ELD as 'UNVERIFIED' (driver has not certified the log) receive 0.80."@en .

# ---------------------------------------------------------------------------
# 8.4  HOS compliance properties on DispatchedTrip and AssignedRoute
# ---------------------------------------------------------------------------

tko:hosComplianceStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range xsd:string ;
    rdfs:label "HOS compliance status"@en ;
    rdfs:comment "Current HOS compliance assessment for this dispatched trip given the driver's current HOS record and the estimated remaining drive time on the assigned route. Controlled vocabulary: 'COMPLIANT' (driver has sufficient remaining drive and on-duty time to complete the assigned route); 'MARGINAL' (driver will exhaust drive or on-duty time within 30 minutes of estimated arrival — monitoring elevated); 'REQUIRES_BREAK' (driver has reached 8 cumulative driving hours and must take a 30-minute break before completing the route); 'NONCOMPLIANT' (driver cannot legally complete the assigned route without violating HOS limits — immediate dispatcher alert required); 'UNKNOWN' (HOS record unavailable or stale)."@en .

tko:estimatedRouteCompletionMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range xsd:integer ;
    rdfs:label "estimated route completion time (minutes)"@en ;
    rdfs:comment "Estimated total driving minutes from the vehicle's current position to the final destination on the assigned route, computed by the Active Trip Monitoring pipeline using current GKG segment speeds and remaining segment sequence. Used by the HOS compliance check to compare against tko:remainingDriveTimeMinutes."@en .

tko:hosConstrainedRerouteAvailable rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range xsd:boolean ;
    rdfs:label "HOS-constrained reroute available"@en ;
    rdfs:comment "True if the Fleet Intelligence Application has identified at least one alternative route that satisfies both the route risk threshold and the driver's current HOS constraints. False means all candidate alternative routes are infeasible given the driver's remaining drive time. When false and hosComplianceStatus is NONCOMPLIANT, the recommended action is a mandatory stop at the nearest tko-linked uko:TruckParkingFacility."@en .

tko:recommendedParkingFacilityRef rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range xsd:string ;
    rdfs:label "recommended parking facility reference"@en ;
    rdfs:comment "GKG URI of the uko:TruckParkingFacility recommended for an HOS rest stop when the driver cannot legally complete the current or alternative route without a mandatory rest break. The recommended facility is the nearest compliant facility along the route with available parking, operational fuel (if needed), and refrigerant access (for reefer trucks). Null if hosComplianceStatus is COMPLIANT."@en .

# ---------------------------------------------------------------------------
# 8.5  HOS-aware monitoring cycle properties on ActiveTripSession
# ---------------------------------------------------------------------------

tko:hosLastFetchTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:dateTime ;
    rdfs:label "HOS last fetch timestamp"@en ;
    rdfs:comment "Timestamp of the most recent successful HOS record fetch from the telematics ELD API for this session's driver. Used to assess HOS data currency. When the interval between hosLastFetchTimestamp and the current monitoring cycle timestamp exceeds the configured staleness threshold (default: 5 minutes), the monitoring cycle triggers a fresh HOS fetch before computing route risk and HOS compliance."@en .

tko:hosAlertSent rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:boolean ;
    rdfs:label "HOS alert sent"@en ;
    rdfs:comment "True if a HOS compliance alert has been sent to the dispatcher for this session. Used to prevent duplicate alert delivery on consecutive monitoring cycles. Reset to false when hosComplianceStatus returns to COMPLIANT."@en .

tko:tripAbortReason rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:ActiveTripSession ;
    rdfs:range xsd:string ;
    rdfs:label "trip abort reason"@en ;
    rdfs:comment "Reason code for trip termination when sessionStatus = ABORTED. Controlled vocabulary: 'MECHANICAL_FAILURE' (vehicle breakdown requiring repair); 'DRIVER_INCIDENT' (driver unable to continue — medical, accident, misconduct); 'CARGO_ISSUE' (cargo damage, spillage, temperature excursion requiring abort); 'DISPATCHER_RECALL' (trip cancelled or redirected by dispatcher); 'ROUTE_IMPASSABLE' (assigned route blocked, no viable alternative found); 'HOS_EXHAUSTION' (driver reached HOS limit before completing route — mandatory rest); 'UNKNOWN' (reason not recorded)."@en .

# =============================================================================
# END OF TKO v7.1 HOURS OF SERVICE COMPLIANCE EXTENSION
# =============================================================================

###############################################################################
###############################################################################
#
#    TKO v8.0 EXTENSION: OVER-THE-HORIZON RISK MODEL
#    Purpose: Classes and properties supporting the OHR prospective risk
#             model — multi-dimensional risk vector, route comparison
#             serving pattern, dispatch decision record, dispatcher override
#             feedback loop, and remediation action taxonomy.
#
#    Key design distinction (preserved from v7.0):
#      tko:TripRiskAssessment — HISTORICAL. Post-trip Stage 6 output.
#                               Reflects actual route, static segment risk.
#      tko:TripRiskVector     — PROSPECTIVE. OHR model output. Computed
#                               pre-departure and updated in-trip (Instance
#                               Types 1 and 2). Reflects assigned/candidate
#                               route, dynamic weather/traffic/driver state.
#    The two objects are complementary and must not be conflated.
#
###############################################################################
###############################################################################

# =============================================================================
# Part 1: RiskDimension Enumeration
# Nine named individuals covering all OHR output dimensions.
# =============================================================================

tko:RiskDimension rdf:type owl:Class ;
    rdfs:label "Risk Dimension"@en ;
    rdfs:comment "Named individuals representing the nine over-the-horizon risk dimensions produced by the OHR model. Each dimension is scored [0.0, 1.0] with an associated confidence interval on a tko:TripRiskVector."@en .

tko:DIM_WEATHER_ROAD rdf:type owl:NamedIndividual, tko:RiskDimension ;
    rdfs:label "R1 — Weather-Road Risk"@en ;
    rdfs:comment "R1: Probability of weather-induced incident (ice, flooding, low visibility, high wind) along future route segments at projected arrival times. Primary input: Corridor Weather Severity Index (CWSI), Chain Control Probability, Time-to-Freeze Score. Elevated for night departures traversing mountain pass segments."@en .

tko:DIM_CARGO_INTEGRITY rdf:type owl:NamedIndividual, tko:RiskDimension ;
    rdfs:label "R2 — Cargo Integrity Risk"@en ;
    rdfs:comment "R2: Probability of cargo loss, spoilage, temperature excursion, or physical damage. Primary input: fko:PerishabilityProfile, refrigeration unit health, forecast ambient temperature along route, planned duration. Dominant dimension for reefer and pharmaceutical loads."@en .

tko:DIM_DRIVER_FATIGUE rdf:type owl:NamedIndividual, tko:RiskDimension ;
    rdfs:label "R3 — Driver Fatigue Risk"@en ;
    rdfs:comment "R3: Probability of fatigue-related impairment event before trip completion. Primary input: Compound Fatigue Risk Score (HOS position × circadian time-of-day risk × cumulative hours × days on assignment). Highest from 02:00–06:00 AM and 14:00–16:00 PM at trip segments."@en .

tko:DIM_CONGESTION_DELAY rdf:type owl:NamedIndividual, tko:RiskDimension ;
    rdfs:label "R4 — Congestion/Delay Risk"@en ;
    rdfs:comment "R4: Probability of severe delay (>configured % of planned duration) affecting time-sensitive cargo. Primary input: historical congestion by corridor and hour, special events, predicted destination traffic density at ETA."@en .

tko:DIM_INFRASTRUCTURE rdf:type owl:NamedIndividual, tko:RiskDimension ;
    rdfs:label "R5 — Infrastructure Risk"@en ;
    rdfs:comment "R5: Probability of route-blocking constraint — bridge weight violation, tunnel height restriction, mountain pass closure. Primary input: Weight Violation Risk Score (NBI data), Height/Width Clearance Risk, Grade Risk Score. Hard blocks are flagged as CRITICAL regardless of probability."@en .

tko:DIM_REGULATORY_COMPLIANCE rdf:type owl:NamedIndividual, tko:RiskDimension ;
    rdfs:label "R6 — Regulatory/Compliance Risk"@en ;
    rdfs:comment "R6: Probability of HOS violation, weigh station overweight event, or permit gap. Primary input: Projected HOS Margin at Destination, state weight restriction status, oversize permit compliance."@en .

tko:DIM_SECURITY_THEFT rdf:type owl:NamedIndividual, tko:RiskDimension ;
    rdfs:label "R7 — Security/Theft Risk"@en ;
    rdfs:comment "R7: Probability of cargo theft incident by route segment. Primary input: uko:CargoTheftHotspotZone exposure fraction, cargo value percentile, time-of-day theft risk peak. Dominant for high-value cargo (electronics, pharmaceuticals, currency)."@en .

tko:DIM_DESTINATION rdf:type owl:NamedIndividual, tko:RiskDimension ;
    rdfs:label "R8 — Destination Risk"@en ;
    rdfs:comment "R8: Probability of unable-to-deliver scenario at destination — dock congestion, appointment miss, access restriction, or receiving facility closed. Primary input: On-Time Delivery Probability, historical dock wait time, HOS Window at Destination."@en .

tko:DIM_MECHANICAL rdf:type owl:NamedIndividual, tko:RiskDimension ;
    rdfs:label "R9 — Mechanical Risk"@en ;
    rdfs:comment "R9: Probability of en-route breakdown requiring roadside assistance or fleet swap. Primary input: historical breakdown rate per 100K miles, active engine fault codes, days since last PM, tire pressure deviation, reefer unit fault history."@en .


# =============================================================================
# Part 2: DimensionScore — per-dimension score record
# =============================================================================

tko:DimensionScore rdf:type owl:Class ;
    rdfs:label "Dimension Score"@en ;
    rdfs:comment "A score record for a single OHR risk dimension on a TripRiskVector. Captures the dimension identity, the probability score, the confidence interval, and the primary feature driving the score (for Tier 3 explanation generation). One DimensionScore instance per dimension per TripRiskVector."@en .

tko:hasDimensionScore rdf:type owl:ObjectProperty ;
    rdfs:domain tko:TripRiskVector ;
    rdfs:range tko:DimensionScore ;
    rdfs:label "has dimension score"@en ;
    rdfs:comment "Links a TripRiskVector to one of its nine DimensionScore records. A fully-populated TripRiskVector has exactly nine DimensionScore instances (one per RiskDimension named individual)."@en .

tko:scoreDimension rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DimensionScore ;
    rdfs:range tko:RiskDimension ;
    rdfs:label "score dimension"@en ;
    rdfs:comment "Links a DimensionScore to the RiskDimension named individual it represents. Used to look up the correct DimensionScore when constructing the Tier 2 dispatcher risk profile."@en .

tko:dimensionProbability rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DimensionScore ;
    rdfs:range xsd:decimal ;
    rdfs:label "dimension probability"@en ;
    rdfs:comment "The calibrated probability score for this risk dimension [0.0–1.0]. Calibrated meaning a score of 0.7 implies the trip class has a ~70% adverse outcome rate in holdout data for this dimension. Produced by Platt scaling or isotonic regression applied to the raw model output."@en .

tko:dimensionConfidenceLow rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DimensionScore ;
    rdfs:range xsd:decimal ;
    rdfs:label "dimension confidence interval lower bound"@en ;
    rdfs:comment "Lower bound of the 90% confidence interval for this dimension's probability score. When this interval is wide (upper - lower > 0.3), the system should flag score uncertainty and widen its triage threshold before alerting the dispatcher."@en .

tko:dimensionConfidenceHigh rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DimensionScore ;
    rdfs:range xsd:decimal ;
    rdfs:label "dimension confidence interval upper bound"@en ;
    rdfs:comment "Upper bound of the 90% confidence interval for this dimension's probability score."@en .

tko:dimensionRiskTier rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DimensionScore ;
    rdfs:range tko:RiskTier ;
    rdfs:label "dimension risk tier"@en ;
    rdfs:comment "The qualitative tier (LOW/MODERATE/ELEVATED/HIGH/CRITICAL) assigned to this dimension's probability score. Tier thresholds are cargo-class-dependent: a probability of 0.6 may be HIGH for pharmaceutical cargo and MODERATE for dry van general freight."@en .

tko:dimensionPrimaryDriver rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DimensionScore ;
    rdfs:range xsd:string ;
    rdfs:label "dimension primary driver"@en ;
    rdfs:comment "JSON-serialized SHAP explanation for this dimension's score: the top-3 features and their contribution magnitudes. Example: '{\"features\": [{\"name\": \"chain_control_probability\", \"value\": 0.82, \"contribution\": 0.41}, {\"name\": \"arrival_hour\", \"value\": 2, \"contribution\": 0.28}]}'. Consumed by the Tier 3 explanation generator to produce the natural-language dispatcher briefing."@en .


# =============================================================================
# Part 3: TripRiskVector — the OHR model output object
# =============================================================================

tko:TripRiskVector rdf:type owl:Class ;
    rdfs:label "Trip Risk Vector"@en ;
    rdfs:comment "The prospective multi-dimensional risk structure produced by the Over-the-Horizon Risk model for a DispatchedTrip. Contains nine DimensionScore instances (R1–R9), the cargo-weighted Composite Trip Risk Score (CTRS), accumulated exposure units, and departure time sensitivity metadata. Linked from a DispatchedTrip via tko:hasTripRiskVector. Updated continuously during active trips (Instance Type 2) by the FDA Standing Agent. Distinct from tko:TripRiskAssessment (historical, Stage 6, single scalar)."@en .

tko:hasTripRiskVector rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range tko:TripRiskVector ;
    rdfs:label "has trip risk vector"@en ;
    rdfs:comment "Links a DispatchedTrip to its current OHR TripRiskVector. Updated in place on each monitoring cycle by the FDA Standing Agent. For completed trips, the final TripRiskVector is archived alongside the TripRiskAssessment to support retrospective comparison between prospective and historical risk assessments."@en .

tko:compositeTripRiskScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskVector ;
    rdfs:range xsd:decimal ;
    rdfs:label "Composite Trip Risk Score (CTRS)"@en ;
    rdfs:comment "The cargo-type-weighted linear combination of R1–R9 dimension probabilities. Weights are determined by the fko:CargoCTRSWeights instance for the cargo class of the associated FreightLoad. CTRS is the Tier 1 triage instrument: a single scalar that sorts dispatch queue entries by aggregate risk level. CTRS alone is insufficient for dispatcher decisions; it must be accompanied by the Tier 2 DimensionScore breakdown."@en .

tko:exposureUnits rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskVector ;
    rdfs:range xsd:decimal ;
    rdfs:label "exposure units"@en ;
    rdfs:comment "The integral of the cargo-weighted CTRS over route segment miles: CTRS value at each 5-mile corridor segment multiplied by that segment's distance, summed over the full planned route. Units: risk-miles. This is the consumer-facing metric displayed in the dispatcher interface. A route adaptation that reduces exposure units from 7.8 to 1.6 has rewritten 6.2 exposure units. The quantity is auditable: each segment's contribution can be verified from its CTRS × distance computation."@en .

tko:departureTimeRiskDifferential rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskVector ;
    rdfs:range xsd:decimal ;
    rdfs:label "departure time risk differential"@en ;
    rdfs:comment "Delta in CTRS between the planned departure time and the nearest lower-risk departure window (±6 hours). A large positive differential (e.g., 0.4) flags departure time as the primary actionable lever: delaying departure can reduce risk as much as rerouting, at zero incremental distance cost. Used to populate the 'Delay Departure' remediation recommendation in Tier 3."@en .

tko:riskVectorComputedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskVector ;
    rdfs:range xsd:dateTime ;
    rdfs:label "risk vector computed at"@en ;
    rdfs:comment "Timestamp of the most recent computation of this TripRiskVector. Used to assess data currency. When the interval between this timestamp and the current monitoring cycle exceeds the configured staleness threshold (default: 5 minutes for in-trip; 30 minutes pre-departure), the FDA Standing Agent triggers a fresh computation."@en .

tko:riskVectorComputationType rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskVector ;
    rdfs:range xsd:string ;
    rdfs:label "risk vector computation type"@en ;
    rdfs:comment "Computation context that produced this TripRiskVector. Controlled vocabulary: PRE_DEPARTURE (Instance Type 1 — computed at dispatch time using departure-time-anchored features); IN_TRIP_UPDATE (Instance Type 2 — rolling corridor snapshot for remaining route); ROUTE_COMPARISON (parallel evaluation of candidate routes for dispatch decision). PRE_DEPARTURE and ROUTE_COMPARISON vectors are archived with the DispatchDecision. IN_TRIP_UPDATE vectors overwrite the previous vector on the ActiveTripSession."@en .

tko:riskVectorSpectraVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripRiskVector ;
    rdfs:range xsd:string ;
    rdfs:label "SPECTRA version used"@en ;
    rdfs:comment "Version identifier of the SPECTRA embedding model used to compute route corridor embeddings for the Stage 2 TFT model input. Must match the SPECTRA version recorded in the Model Registry Configuration Snapshot for the active OHR model deployment. Mismatch triggers a model version warning."@en .


# =============================================================================
# Part 4: RouteOption — candidate route for dispatch comparison
# =============================================================================

tko:RouteOption rdf:type owl:Class ;
    rdfs:label "Route Option"@en ;
    rdfs:comment "A candidate route evaluated at dispatch time as part of the route comparison serving pattern. A DispatchDecision evaluates N RouteOptions in parallel (typically 2–3) and selects one. Each RouteOption carries its own TripRiskVector computed for that specific corridor. The set of RouteOptions is the Tier 2 route comparison table shown to the dispatcher."@en .

tko:routeOptionLabel rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range xsd:string ;
    rdfs:label "route option label"@en ;
    rdfs:comment "Display label for this route option in the dispatcher interface. Examples: 'Route A', 'Route B', 'Route C'. Assigned sequentially at evaluation time."@en .

tko:routeOptionTag rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range xsd:string ;
    rdfs:label "route option tag"@en ;
    rdfs:comment "Characterization tag based on the route's position on the risk-cost-time frontier. Controlled vocabulary: SAFEST (lowest CTRS among all options), FASTEST (shortest ETA), CHEAPEST (lowest estimated cost), RECOMMENDED (model-recommended given current OptimizationGoal), BALANCED (Pareto-optimal across all three objectives). A single RouteOption may carry multiple tags (e.g., SAFEST + RECOMMENDED when OptimizationGoal = MINIMIZE_RISK)."@en .

tko:routeOptionETAMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range xsd:integer ;
    rdfs:label "route option ETA (minutes from departure)"@en ;
    rdfs:comment "Estimated travel time in minutes from planned departure to destination for this route option, computed by the routing engine (OSRM truck profile) using current traffic conditions."@en .

tko:routeOptionDistanceMeters rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range xsd:decimal ;
    rdfs:label "route option distance (meters)"@en ;
    rdfs:comment "Total route distance in meters for this option."@en .

tko:routeOptionCostUSD rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range xsd:decimal ;
    rdfs:label "route option estimated cost (USD)"@en ;
    rdfs:comment "Estimated incremental cost in USD for this route option, incorporating fuel cost (distance × MPG × fuel price), toll charges, and HOS impact cost (marginal overtime if ETA pushes driver into restricted hours)."@en .

tko:routeOptionCTRS rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range xsd:decimal ;
    rdfs:label "route option CTRS"@en ;
    rdfs:comment "The Composite Trip Risk Score for this route option, computed by the OHR pre-departure model for the specific corridor and departure time. Used as the primary sort key when OptimizationGoal = MINIMIZE_RISK."@en .

tko:routeOptionExposureUnits rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range xsd:decimal ;
    rdfs:label "route option exposure units"@en ;
    rdfs:comment "Accumulated exposure units for this route option. The difference in exposureUnits between the highest-risk and lowest-risk option is the maximum achievable exposure reduction by rerouting — the 'exposure units saved' metric."@en .

tko:hasRouteOptionRiskVector rdf:type owl:ObjectProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range tko:TripRiskVector ;
    rdfs:label "has route option risk vector"@en ;
    rdfs:comment "Links this RouteOption to the TripRiskVector computed for it during the ROUTE_COMPARISON computation pass. Enables Tier 2 per-dimension breakdown for any candidate route, not only the selected one."@en .

tko:isModelRecommended rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range xsd:boolean ;
    rdfs:label "is model recommended"@en ;
    rdfs:comment "True if this RouteOption is the model's top recommendation given the current OptimizationGoal. Exactly one RouteOption in a DispatchDecision should have isModelRecommended = true."@en .

tko:routeOptionSegmentSequence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RouteOption ;
    rdfs:range xsd:string ;
    rdfs:label "route option segment sequence"@en ;
    rdfs:comment "Ordered JSON array of GKG segment URNs for this candidate route, parallel to tko:assignedSegmentSequence on AssignedRoute. Format: ['urn:seg:A1', 'urn:seg:A2', ...]. Populated by the OSRM truck-profile routing engine."@en .


# =============================================================================
# Part 5: OptimizationGoal — dispatcher-configurable objective
# =============================================================================

tko:OptimizationGoal rdf:type owl:Class ;
    rdfs:label "Optimization Goal"@en ;
    rdfs:comment "The dispatcher's stated objective for route selection in a given DispatchDecision. Determines which RouteOption receives the RECOMMENDED tag and influences the order in which RouteOptions are presented in the Tier 2 comparison panel. Configurable per fleet, per cargo class, or per individual dispatch."@en .

tko:MINIMIZE_RISK rdf:type owl:NamedIndividual, tko:OptimizationGoal ;
    rdfs:label "Minimize Risk"@en ;
    rdfs:comment "Select the route with the lowest CTRS. Default goal for temperature-sensitive cargo (fko:TemperatureSensitivityClass FROZEN or REFRIGERATED), hazmat loads (fko:HazmatClass CLASS_3 or higher), and high-value cargo (fko:cargoValueTier HIGH or CRITICAL)."@en .

tko:MINIMIZE_COST rdf:type owl:NamedIndividual, tko:OptimizationGoal ;
    rdfs:label "Minimize Cost"@en ;
    rdfs:comment "Select the route with the lowest estimated routeOptionCostUSD. Appropriate for standard dry van general freight with no time-sensitivity or cargo risk premium."@en .

tko:MINIMIZE_TIME rdf:type owl:NamedIndividual, tko:OptimizationGoal ;
    rdfs:label "Minimize Time"@en ;
    rdfs:comment "Select the route with the shortest routeOptionETAMinutes. Appropriate for time-critical loads where appointment adherence is the primary constraint."@en .

tko:WEIGHTED_BLEND rdf:type owl:NamedIndividual, tko:OptimizationGoal ;
    rdfs:label "Weighted Blend"@en ;
    rdfs:comment "Select the Pareto-optimal route balancing all three objectives (risk, cost, time) with fleet-configurable weights. Default for mixed fleets without a single dominant objective. Weight configuration is stored in the Model Registry Configuration Snapshot."@en .


# =============================================================================
# Part 6: DispatchDecision — formal record of the dispatch event
# =============================================================================

tko:DispatchDecision rdf:type owl:Class ;
    rdfs:label "Dispatch Decision"@en ;
    rdfs:comment "A formal record capturing the complete state of a dispatch event: the candidate routes evaluated, the optimization goal in effect, the route selected, and whether the selection matched the model recommendation. Every dispatched trip produces exactly one DispatchDecision. DispatchDecision instances are archived to NebulaGraph Trip History Subgraph 2 alongside the LabeledTrip. They are the primary source for the Instance Type 4 (Dispatcher Override) training dataset."@en .

tko:hasDispatchDecision rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range tko:DispatchDecision ;
    rdfs:label "has dispatch decision"@en ;
    rdfs:comment "Links a DispatchedTrip to its DispatchDecision. One-to-one: each DispatchedTrip has exactly one DispatchDecision record."@en .

tko:hasEvaluatedRouteOption rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DispatchDecision ;
    rdfs:range tko:RouteOption ;
    rdfs:label "has evaluated route option"@en ;
    rdfs:comment "Links the DispatchDecision to each RouteOption that was evaluated (typically 2–3). Multiple values expected."@en .

tko:hasSelectedRouteOption rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DispatchDecision ;
    rdfs:range tko:RouteOption ;
    rdfs:label "has selected route option"@en ;
    rdfs:comment "Links the DispatchDecision to the single RouteOption that was actually dispatched. For non-override decisions, this is the RouteOption where isModelRecommended = true. For DispatcherOverride decisions, this may be any evaluated RouteOption."@en .

tko:hasDecisionOptimizationGoal rdf:type owl:ObjectProperty ;
    rdfs:domain tko:DispatchDecision ;
    rdfs:range tko:OptimizationGoal ;
    rdfs:label "has decision optimization goal"@en ;
    rdfs:comment "The OptimizationGoal in effect at the time of this dispatch decision. May differ from the fleet default if the dispatcher explicitly changed the goal for this trip."@en .

tko:decisionTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchDecision ;
    rdfs:range xsd:dateTime ;
    rdfs:label "decision timestamp"@en ;
    rdfs:comment "ISO 8601 timestamp at which the dispatcher confirmed the route selection and triggered vehicle dispatch."@en .

tko:isOverride rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchDecision ;
    rdfs:range xsd:boolean ;
    rdfs:label "is override"@en ;
    rdfs:comment "True if the dispatcher selected a RouteOption that was not the model recommendation (isModelRecommended = false on the selected option). All override decisions must be recorded as tko:DispatcherOverride instances (subclass) to enable Instance Type 4 training data extraction."@en .

tko:decisionModelCTRS rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatchDecision ;
    rdfs:range xsd:decimal ;
    rdfs:label "model-recommended CTRS at decision time"@en ;
    rdfs:comment "The CTRS of the model-recommended RouteOption at the time of this decision. Stored separately to support counterfactual analysis: if the dispatcher overrode to a higher-CTRS option and an adverse outcome occurred, the delta between this value and the selected option's CTRS is the attributable risk cost of the override."@en .


# =============================================================================
# Part 7: DispatcherOverride — the feedback signal
# =============================================================================

tko:DispatcherOverride rdf:type owl:Class ;
    rdfs:subClassOf tko:DispatchDecision ;
    rdfs:label "Dispatcher Override"@en ;
    rdfs:comment "A DispatchDecision in which the dispatcher selected a RouteOption that was not the model recommendation. DispatcherOverride instances are the highest-quality feedback signal available for OHR model improvement. BETTER-outcome overrides are systematic model failure cases (features or interactions the model underweights) and receive elevated weight in retraining batches. WORSE-outcome overrides validate the model and provide dispatcher training calibration data. NEUTRAL-outcome overrides indicate that the risk difference between options was immaterial at this CTRS level."@en .

tko:overrideType rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatcherOverride ;
    rdfs:range xsd:string ;
    rdfs:label "override type"@en ;
    rdfs:comment "Classification of the override action. Controlled vocabulary: ROUTE_CHANGE (dispatcher selected a different corridor than recommended); DRIVER_SWAP (dispatcher assigned a different driver than the model's suggested optimal, based on fatigue state); DEPARTURE_DELAY (dispatcher deferred departure beyond the model's recommended window); OPTIMIZATION_GOAL_CHANGE (dispatcher switched from fleet-default optimization goal to a different objective); MANUAL_ROUTE (dispatcher entered a custom route not among the evaluated RouteOptions)."@en .

tko:overrideRationale rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatcherOverride ;
    rdfs:range xsd:string ;
    rdfs:label "override rationale"@en ;
    rdfs:comment "Free-text or structured rationale provided by the dispatcher for the override, if captured. Examples: 'Driver knows this route well', 'Shipper requested I-80 only', 'Weather forecast changed since model ran'. This text is processed by an NLP model to extract structured rationale categories for training data enrichment."@en .

tko:overrideOutcome rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatcherOverride ;
    rdfs:range xsd:string ;
    rdfs:label "override outcome"@en ;
    rdfs:comment "Retrospective assessment of the override decision after trip completion. Controlled vocabulary: BETTER (actual outcome was better than the model-recommended option's projected outcome — the override was justified); WORSE (actual outcome was worse than the model-recommended projection — the model was correct); NEUTRAL (outcomes were materially equivalent — insufficient signal to update model weights). Filled in by the TLP Stage 5 outcome label pipeline after the trip completes and actual outcome labels are computed."@en .

tko:overrideModelRankSelected rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:DispatcherOverride ;
    rdfs:range xsd:integer ;
    rdfs:label "override model rank of selected option"@en ;
    rdfs:comment "The rank of the selected RouteOption in the model's recommendation ordering (1 = top recommendation, 2 = second, etc.). For standard overrides this is typically 2 or 3. A value of 1 indicates the dispatcher selected the top-recommended option and isOverride should be false — this would indicate a data integrity error."@en .


# =============================================================================
# Part 8: RemediationAction — intervention taxonomy
# =============================================================================

tko:RemediationAction rdf:type owl:Class ;
    rdfs:label "Remediation Action"@en ;
    rdfs:comment "An intervention recommended or executed in response to an elevated risk dimension on a TripRiskVector. Six intervention types cover the full space of dispatcher-executable actions. RemediationActions are linked from a TripRiskVector and archived with the DispatchDecision. They serve as the SOP lookup in the Tier 3 dispatcher interface."@en .

tko:hasRemediationAction rdf:type owl:ObjectProperty ;
    rdfs:domain tko:TripRiskVector ;
    rdfs:range tko:RemediationAction ;
    rdfs:label "has remediation action"@en ;
    rdfs:comment "Links a TripRiskVector to a recommended RemediationAction for one or more elevated dimensions. Multiple RemediationActions may be linked to a single TripRiskVector (one per elevated dimension type). Presented to the dispatcher in priority order by projected exposure reduction."@en .

tko:remediationType rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RemediationAction ;
    rdfs:range xsd:string ;
    rdfs:label "remediation type"@en ;
    rdfs:comment "The intervention category. Controlled vocabulary: DELAY_DEPARTURE (defer dispatch until weather window clears or driver completes rest; addresses R1 time-dependent risk and R3 fatigue); DRIVER_SWAP (assign a driver with lower R3 score and more HOS remaining from the fleet roster); REROUTE (substitute a lower-risk corridor; addresses R1, R4, R5, R7); CARGO_INTERVENTION (pre-condition reefer unit, verify temperature setpoint, add monitoring checkpoint; addresses R2); DESTINATION_ADJUSTMENT (advance-notice to dock, reschedule appointment, extend receiving window; addresses R4, R8); SPEED_ADVISORY (in-cab advisory specifying reduced speed through high-risk segments or mandatory check-in; addresses R1 compound with R3)."@en .

tko:remediationTriggerDimension rdf:type owl:ObjectProperty ;
    rdfs:domain tko:RemediationAction ;
    rdfs:range tko:RiskDimension ;
    rdfs:label "remediation trigger dimension"@en ;
    rdfs:comment "The RiskDimension named individual whose elevated score triggered this RemediationAction recommendation. Used to establish the causal chain in the Tier 3 explanation: 'R3 (Driver Fatigue) is elevated → Recommended action: DELAY_DEPARTURE until driver completes 10-hour reset'."@en .

tko:remediationProjectedExposureReduction rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RemediationAction ;
    rdfs:range xsd:decimal ;
    rdfs:label "remediation projected exposure reduction"@en ;
    rdfs:comment "Estimated reduction in exposure units if this RemediationAction is executed. Computed by the Intervention Simulator (GKG Reasoner counterfactual path) for REROUTE and DELAY_DEPARTURE actions; estimated from historical action-outcome data for DRIVER_SWAP and CARGO_INTERVENTION. Used to prioritize the presentation order of multiple RemediationActions to the dispatcher."@en .

tko:remediationExplanationText rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RemediationAction ;
    rdfs:range xsd:string ;
    rdfs:label "remediation explanation text"@en ;
    rdfs:comment "Natural-language Tier 3 explanation generated for this RemediationAction. Example: 'Weather risk is critical because I-80 Segment 4 (Donner Summit) will have an 82% probability of R-2 chain control at your driver's projected arrival of 02:40 AM, and the driver will have 1.6 hours of HOS remaining at that point. Recommended action: delay departure by 6 hours, which reduces exposure units from 7.8 to 1.6 and brings the driver to Donner Summit at 08:40 AM in daylight with full HOS.'"@en .

tko:remediationExecuted rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RemediationAction ;
    rdfs:range xsd:boolean ;
    rdfs:label "remediation executed"@en ;
    rdfs:comment "True if the dispatcher confirmed execution of this RemediationAction. False if the action was recommended but the dispatcher did not execute it (either overriding to a different action or ignoring the recommendation). Used to compute remediation adoption rates for fleet operations analytics."@en .

tko:remediationExecutedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:RemediationAction ;
    rdfs:range xsd:dateTime ;
    rdfs:label "remediation executed at"@en ;
    rdfs:comment "Timestamp at which the dispatcher confirmed execution of this remediation. Null when remediationExecuted = false."@en .


# =============================================================================
# END OF TKO v8.0 OVER-THE-HORIZON RISK MODEL EXTENSION
# =============================================================================

#################################################################
#    TKO v8.3.0 EXTENSIONS (coordinated release 2026-06-10)
#################################################################

# =============================================================================
# TKO v8.3 Part A: TRIP PURPOSE - ORTHOGONAL DIMENSION
#
# Design decision (resolves the v8.2-era design fork): TripPurpose is an
# ORTHOGONAL dimension alongside tko:TripIntent, not a new TripIntent
# subclass family. Rationale: intent is the classified activity signature of
# the trip (what the trip operationally looks like - the patented Trip Intent
# Classifier's output space), while purpose is the societal demand category
# the trip serves. The MIT Mobility-of-Care research shows exactly why the
# two must not be conflated: a chained trip escorting a child to school on
# the way to work can carry a commute-like intent signature while serving a
# care purpose, and collapsing purpose into the intent hierarchy would erase
# the distinction that makes care travel visible to planners. Mobility of
# Care is the dominant purpose category in the MIT transit data, outpacing
# commute - yet it is invisible in intent-only taxonomies.
#
# Cardinality: a trip carries at most one primary purpose
# (tko:hasTripPurpose) and any number of secondary purposes
# (tko:hasSecondaryTripPurpose), supporting trip-chaining without losing the
# primary demand attribution. Purpose assignment is a Stage 4 labeling
# operation (rule-based from anchor activities, with model assistance where
# anchors are ambiguous); the MLO label ld_trip_purpose governs its
# activation and persona scope.
#
# This dimension gates the Intervention Simulator value case: purpose-
# conditioned demand elasticities (Part B) let headway and service-change
# counterfactuals be computed per purpose segment rather than as a single
# aggregate response.
# =============================================================================

tko:TripPurpose rdf:type owl:Class ;
    rdfs:label "Trip Purpose"@en ;
    rdfs:comment "Enumeration class for the societal demand category a trip serves. Orthogonal to tko:TripIntent: intent classifies the activity signature, purpose classifies the demand the trip satisfies. Members are named individuals so purposes can serve as TDL constraint vocabulary."@en .

tko:COMMUTE rdf:type owl:NamedIndividual, tko:TripPurpose ;
    rdfs:label "Commute"@en ;
    rdfs:comment "Travel between home and the primary work or study location."@en .

tko:WORK_RELATED rdf:type owl:NamedIndividual, tko:TripPurpose ;
    rdfs:label "Work-Related Business"@en ;
    rdfs:comment "Travel in the course of work other than the home-work commute (client visits, deliveries performed personally, off-site meetings)."@en .

tko:EDUCATION rdf:type owl:NamedIndividual, tko:TripPurpose ;
    rdfs:label "Education"@en ;
    rdfs:comment "Travel to or from an educational activity by the student themselves (escorting a student is MOBILITY_OF_CARE)."@en .

tko:MOBILITY_OF_CARE rdf:type owl:NamedIndividual, tko:TripPurpose ;
    rdfs:label "Mobility of Care"@en ;
    rdfs:comment "Travel performed to sustain the household and care for others: escorting children or dependents (including school escort), accompanying others to medical appointments, household-serving shopping and errands, and caregiving visits. Aggregates demand that legacy purpose taxonomies scatter across 'shopping', 'errands', and 'other', rendering it invisible. Identified in the MIT transit research as the dominant purpose category in observed transit demand, outpacing commute. Care trips are disproportionately chained, off-peak, and short-hop - properties with direct service-design consequences (headway sensitivity, midday service levels, stop spacing). First-class membership in this taxonomy is what allows the Intervention Simulator to evaluate service changes against care-travel demand explicitly."@en .

tko:PERSONAL_BUSINESS rdf:type owl:NamedIndividual, tko:TripPurpose ;
    rdfs:label "Personal Business"@en ;
    rdfs:comment "Personal administrative or service activities for oneself (banking, government offices, personal appointments other than medical)."@en .

tko:PERSONAL_MEDICAL rdf:type owl:NamedIndividual, tko:TripPurpose ;
    rdfs:label "Personal Medical"@en ;
    rdfs:comment "Travel to or from medical or health services for oneself (accompanying another person to care is MOBILITY_OF_CARE)."@en .

tko:SOCIAL_RECREATION rdf:type owl:NamedIndividual, tko:TripPurpose ;
    rdfs:label "Social / Recreation"@en ;
    rdfs:comment "Discretionary social, leisure, recreation, and dining travel."@en .

tko:RETURN_HOME rdf:type owl:NamedIndividual, tko:TripPurpose ;
    rdfs:label "Return Home"@en ;
    rdfs:comment "Homebound leg whose outbound demand attribution belongs to another purpose. Used when the analysis convention requires explicit home-return coding; chained-tour analyses typically attribute the return leg to the tour's primary purpose instead."@en .

tko:GOODS_MOVEMENT rdf:type owl:NamedIndividual, tko:TripPurpose ;
    rdfs:label "Goods Movement"@en ;
    rdfs:comment "Commercial freight and goods-delivery demand. Applies to fleet trips; the operational detail of such trips lives in the DispatchedTrip model and FKO cargo attributes."@en .

tko:hasTripPurpose rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:TripPurpose ;
    rdfs:label "has trip purpose"@en ;
    rdfs:comment "The primary societal demand category this trip serves. At most one value per trip. Assigned at Stage 4 by the purpose-labeling rule set (anchor-activity based, model-assisted for ambiguous anchors), governed by the MLO label ld_trip_purpose."@en .

tko:hasSecondaryTripPurpose rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:TripPurpose ;
    rdfs:label "has secondary trip purpose"@en ;
    rdfs:comment "Additional purposes served by a chained trip beyond the primary purpose (e.g., a COMMUTE-primary trip with a MOBILITY_OF_CARE school-escort link). Multiple values permitted."@en .

tko:purposeAssignmentConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range xsd:decimal ;
    rdfs:label "purpose assignment confidence"@en ;
    rdfs:comment "Confidence (0.0-1.0) of the primary purpose assignment. Rule-based anchor matches carry 1.0; model-assisted assignments carry the model confidence."@en .

# =============================================================================
# TKO v8.3 Part B: PURPOSE-CONDITIONED HEADWAY ELASTICITY
# (Seattle SoundCast template. The elasticity attaches to the PURPOSE, not to
#  a route or stop: the empirical finding motivating this release is that
#  demand response to service frequency differs sharply by purpose segment -
#  care travel, being chained and schedule-constrained, responds to midday
#  headway improvements that aggregate commute-weighted elasticities wash
#  out. The Intervention Simulator multiplies a candidate headway change by
#  the per-purpose elasticity over the purpose-segmented demand baseline to
#  produce auditable ridership counterfactuals.)
# =============================================================================

tko:headwayElasticity rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripPurpose ;
    rdfs:range xsd:decimal ;
    rdfs:label "headway elasticity"@en ;
    rdfs:comment "Arc elasticity of trip demand for this purpose with respect to service headway (negative: demand rises as headway falls). Curated from activity-based model estimates (Seattle SoundCast template) and local validation; values are expert-curated Causal Effect Library companions, never learned by the automated Learning Mode cycle. Consumed by the Intervention Simulator for headway-change counterfactuals, segmented by purpose."@en .

tko:headwayElasticitySource rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripPurpose ;
    rdfs:range xsd:string ;
    rdfs:label "headway elasticity source"@en ;
    rdfs:comment "Citation for the elasticity estimate in use (model system, estimation vintage, transfer adjustments). Provenance anchor mirroring uko:effectSourceCitation."@en .

###############################################################################
#    PART 14: TRIP CORPUS PROVENANCE
#
#    Added v8.4.0. A base trip arrives in a corpus, and the corpus determines
#    what its identifier means. Client fleet traces resolve against a fleet
#    registry; licensed probe traces carry vendor-scoped pseudonyms that must
#    NOT resolve against any registry. Trip Labeling Pipeline Stage 1 selects
#    its identifier check from the provenance class assigned here.
###############################################################################

tko:TripDataSource rdf:type owl:Class ;
    rdfs:subClassOf uko:DataSource ;
    rdfs:label "Trip Data Source"@en ;
    rdfs:comment "The corpus in which a base trip was delivered, and the terms under which it was obtained. Named individuals of this class are the trip provenance classes. Subclass of uko:DataSource so that trip corpora and GKG feature sources share a single provenance vocabulary."@en .

tko:CLIENT_FLEET rdf:type owl:NamedIndividual, tko:TripDataSource ;
    rdfs:label "Client Fleet"@en ;
    rdfs:comment "Telematics traces from vehicles in the client's own fleet."@en .

tko:CLIENT_TRAVELER_PANEL rdf:type owl:NamedIndividual, tko:TripDataSource ;
    rdfs:label "Client Traveler Panel"@en ;
    rdfs:comment "Traces from a client-operated traveler panel or household travel survey. This is the only provenance class that may carry the survey-derived demographic attributes bound to a traveler identifier."@en .

tko:LICENSED_PROBE rdf:type owl:NamedIndividual, tko:TripDataSource ;
    rdfs:label "Licensed Probe"@en ;
    rdfs:comment "Connected-vehicle or probe traces licensed from a vendor independently of any client engagement. Identifiers are vendor-scoped pseudonyms. An identifier that resolves against a client registry indicates identifiable data has entered a corpus contracted to be pseudonymous, and is a quarantine condition rather than a success."@en .

tko:REFERENCE_CORPUS rdf:type owl:NamedIndividual, tko:TripDataSource ;
    rdfs:label "Reference Corpus"@en ;
    rdfs:comment "Synthetic or reference traces used to stand up a pre-client installation. Identifiers are synthetic by construction."@en .

tko:hasTripDataSource rdf:type owl:ObjectProperty ;
    rdfs:domain tko:Trip ;
    rdfs:range tko:TripDataSource ;
    rdfs:label "has trip data source"@en ;
    rdfs:comment "Assigned at Trip Labeling Pipeline Stage 1 from the delivery manifest, before any quality check, and carried forward unchanged through Levels 2 and 3. uko:hasDataSource cannot serve this role because its rdfs:domain is uko:GeographicFeature and a trip is not one."@en .

### Identifier resolution policy ###

tko:IdentifierResolutionPolicy rdf:type owl:Class ;
    rdfs:label "Identifier Resolution Policy"@en ;
    rdfs:comment "Named individuals stating what the Stage 1 identifier-completeness check must verify for a given trip corpus."@en .

tko:RESOLVE_AGAINST_REGISTRY rdf:type owl:NamedIndividual, tko:IdentifierResolutionPolicy ;
    rdfs:label "Resolve Against Registry"@en ;
    rdfs:comment "The identifier must resolve against the client fleet or traveler registry. Unresolvable identifiers are quarantined. Resolvable but previously unseen identifiers are ingested and flagged for identifier record creation."@en .

tko:PSEUDONYMOUS_STABLE rdf:type owl:NamedIndividual, tko:IdentifierResolutionPolicy ;
    rdfs:label "Pseudonymous Stable"@en ;
    rdfs:comment "The identifier must be present and stable within the delivery batch, and must not resolve against any client registry. Absence or instability quarantines the trip. Resolution against a registry quarantines the trip and raises a data-handling exception."@en .

tko:SYNTHETIC_IDENTIFIER rdf:type owl:NamedIndividual, tko:IdentifierResolutionPolicy ;
    rdfs:label "Synthetic Identifier"@en ;
    rdfs:comment "The identifier is synthetic and must be present and marked as such. No registry resolution is attempted."@en .

tko:hasIdentifierResolutionPolicy rdf:type owl:ObjectProperty ;
    rdfs:domain tko:TripDataSource ;
    rdfs:range tko:IdentifierResolutionPolicy ;
    rdfs:label "has identifier resolution policy"@en ;
    rdfs:comment "Binds a provenance class to the Stage 1 identifier check that applies to it."@en .

tko:CLIENT_FLEET tko:hasIdentifierResolutionPolicy tko:RESOLVE_AGAINST_REGISTRY .
tko:CLIENT_TRAVELER_PANEL tko:hasIdentifierResolutionPolicy tko:RESOLVE_AGAINST_REGISTRY .
tko:LICENSED_PROBE tko:hasIdentifierResolutionPolicy tko:PSEUDONYMOUS_STABLE .
tko:REFERENCE_CORPUS tko:hasIdentifierResolutionPolicy tko:SYNTHETIC_IDENTIFIER .

### Corpus terms ###

tko:sourceVendorName rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripDataSource ;
    rdfs:range xsd:string ;
    rdfs:label "source vendor name"@en ;
    rdfs:comment "The party from which the corpus was obtained. Null for tko:REFERENCE_CORPUS."@en .

tko:sourceLicenseIdentifier rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripDataSource ;
    rdfs:range xsd:string ;
    rdfs:label "source license identifier"@en ;
    rdfs:comment "The agreement under which the corpus was obtained, as a citable reference. Provenance anchor for the permitted-use flags below."@en .

tko:permitsModelTraining rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripDataSource ;
    rdfs:range xsd:boolean ;
    rdfs:label "permits model training"@en ;
    rdfs:comment "Whether the governing agreement permits using the corpus to train or fine-tune models. A false value makes the corpus inadmissible to any training batch."@en .

tko:permitsDerivativeRedistribution rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripDataSource ;
    rdfs:range xsd:boolean ;
    rdfs:label "permits derivative redistribution"@en ;
    rdfs:comment "Whether the governing agreement permits distributing derived artifacts, including trained weights and embedding columns, beyond the installation in which they were produced. A Platform-scoped artifact is a redistributed derivative; a corpus with a false value here may contribute only to installation-scoped artifacts."@en .

tko:sourceCoveragePeriodStart rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripDataSource ;
    rdfs:range xsd:date ;
    rdfs:label "source coverage period start"@en .

tko:sourceCoveragePeriodEnd rdf:type owl:DatatypeProperty ;
    rdfs:domain tko:TripDataSource ;
    rdfs:range xsd:date ;
    rdfs:label "source coverage period end"@en .

###############################################################################
#    END OF TKO v8.4.0 ONTOLOGY
###############################################################################
