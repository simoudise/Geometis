### Intent-to-Preference Axioms ###
# These axioms state that if a trip belongs to one of the classes
# defined above, it implies a certain route preference.

# Healthcare Axioms
tko:HospitalVisitTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:FastestRoute 
] .

tko:DoctorVisitTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:FastestRoute 
] .

tko:DentistVisitTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:ShortestRoute 
] .

tko:EmergencyTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:FastestRoute 
] .

# Business Axioms
tko:CommuteToWorkTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:ShortestRoute 
] .

tko:CommuteFromWorkTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:ShortestRoute 
] .

tko:BusinessMeetingTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:FastestRoute 
] .

tko:BusinessDinnerTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:ScenicRoute 
] .

# Recreation Axioms
tko:ParkVisitTrip rdfs:subClassOf [ 
    rdf:type owl:Restriction ; 
    owl:onProperty tko:hasRoutePreference ; 
    owl:hasValue tko:ScenicRoute 
] .

tko:GymVisitTrip rdfs:subClassOf [ 
