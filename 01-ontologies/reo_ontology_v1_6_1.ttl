#################################################################
#
#    Route Event Ontology (REO)
#    Version 1.6.0 - Neurosymbolic Urban Mobility System
#
#    Purpose: Formal vocabulary for transportation events and their
#    operational significance across fleet types. Models:
#    - Event type hierarchy (weather, traffic incidents, law enforcement,
#      security, roadwork, special events)
#    - Event lifecycle (REPORTED → CONFIRMED → ACTIVE → RESOLVING →
#      RESOLVED → ARCHIVED)
#    - Spatio-temporal event footprints (GeoSPARQL + segment adjacency)
#    - Inter-event causal and correlation relations
#    - Fleet-event sensitivity matrix: per-intent, per-persona operational
#      weights (safetyWeight, etaWeight, costWeight) and reroute thresholds
#
#    Synapse Partners, LLC
#
#    Import graph (acyclic):
#    UKO v15.5.0 ← (imported by) REO v1.6.1
#    TKO v8.4.0  ← (imported by) REO v1.6.1
#    MLO v1.7.0  ← (imported by) REO v1.6.1
#    REO is the terminal ontology in the import chain.
#
#    Change Log:
#    - v1.6.1: Coordinated release 2026-09-19 (release set: UKO v15.5.0, TKO v8.4.0,
#              FKO v1.2.1, MLO v1.7.0, REO v1.6.1). Import alignment only; no new
#              terms. Realigns to TKO v8.4.0 (Trip Corpus Provenance) and MLO v1.7.0
#              (Training Corpus Admissibility).
#    - v1.6.0: Coordinated release 2026-06-10 (release set: UKO v15.5.0, TKO v8.3.0,
#              FKO v1.2.0, MLO v1.6.0, REO v1.6.0).
#              (1) Adds reo:AirQualityEvent (CARB/AirNow advisories; episodic
#                  companion to the static uko:pm25Concentration baseline) with
#                  aqiValue, pollutantType, advisoryLevel.
#              (2) Adds reo:PublicSafetyEvent (Sevtsuk/Basu active-mobility
#                  safety: incidents conditioning pedestrian route choice).
#              (3) Adds reo:LaneClosureEvent and re-parents the existing
#                  reo:PartialLaneClosureEvent under it, resolving the
#                  Architecture V12 511-connector reference
#                  (reo:LaneClosureEvent) to a declared class.
#              (4) Formalizes reo:isPedestrianCollision, reo:isBicycleCollision,
#                  and reo:isVulnerableUserCollision as booleans on
#                  reo:HistoricalIncidentRecord, closing the Appendix A.4
#                  collision-flag drift items jointly with MLO v1.6.0 (whose
#                  gkgDependency references now point at these REO terms).
#              (5) Updates import pins to the coordinated release.
#              Considered, not added: MDS shared-mobility event classes - the
#              GBFS/MDS extension lands as static/availability vocabulary in
#              UKO v15.5; no live-event REO counterpart is required by any
#              registered agent at this release.
#    - v1.5.0: Aligned imports with UKO v15.3.0, MLO v1.4.0, and TKO v8.2.0. 
#              Added reo:PedestrianFacilityClosureEvent, reo:CrowdCongestionEvent, 
#              and reo:affectsPedestrianEdge to support dynamic event routing 
#              on the new pedestrian multiplex graph.
#    - v1.4.0: Deprecates reo:ActiveRouteRisk in favor of tko:TripRiskVector 
#              to resolve dual-agent truth collisions. Updates compoundConditionKey
#              to 2D format to align with TLP Stage 3 logic. Updates imports.
#    - v1.3.0: Adds OHR weather event types (WindAdvisoryEvent, IceFormationEvent,
#              ChainControlIssuanceEvent) and DisabledVehicleEvent.
#    - v1.1.0: Adds HistoricalIncidentRecord, Collision taxonomies, PCF factors,
#              VRU accident events, and CompoundConditionHazardEvent.
#    - v1.0.0: Initial release. Full event taxonomy, FleetEventSensitivity matrix.
#
#################################################################

@prefix :    <urn:route-event-kg:> .
@prefix reo: <urn:route-event-kg:> .
@prefix uko: <urn:urban-kg:> .
@prefix tko: <urn:trip-kg:> .
@prefix mlo: <urn:mobility-label-kg:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<urn:route-event-kg:> rdf:type owl:Ontology ;
    owl:versionIRI <urn:route-event-kg:1.6.1> ;
    owl:imports <urn:urban-kg:15.5.0> ;
    owl:imports <urn:trip-kg:8.4.0> ;
    owl:imports <urn:mobility-label-kg:1.7.0> ;
    dcterms:title "Route Event Ontology (REO) v1.6.1"@en ;
    dcterms:description "Formal vocabulary for transportation events and their operational significance for fleet routing decisions. REO connects the static road network knowledge in UKO, the behavioral trip knowledge in TKO, and the fleet persona definitions in MLO to support dynamic, prospective route risk monitoring. The central design artifact is reo:FleetEventSensitivity, which encodes how each combination of event type, fleet persona, and trip intent should weight safety, ETA, and cost considerations — and at what risk tier threshold the dispatcher should receive a reroute recommendation."@en ;
    rdfs:comment "v1.6.1 is a coordinated-release import alignment (TKO v8.4.0, MLO v1.7.0, release set 2026-09-19); no new terms. v1.6.0 adds air-quality and public-safety event classes, the LaneClosureEvent hierarchy fix, and the formalized collision flags on HistoricalIncidentRecord; pins the coordinated-release import set. v1.5.0 updated imports for the UNA multiplex graph integration and introduced active mobility event classes."@en ;
    dcterms:creator "Synapse Partners, LLC"@en ;
    dcterms:rights "Confidential and Proprietary to Synapse Partners, LLC"@en .

#################################################################
#    PART 1: CORE EVENT CLASS HIERARCHY
#################################################################
# Design principle: the hierarchy is organized by the CAUSE of the event,
# not its operational impact. A single WeatherEvent can affect ETA (via road
# closure), safety (via ice), and cargo integrity (via temperature). The
# operational interpretation is in FleetEventSensitivity, not in the event class.
#################################################################

# ---------------------------------------------------------------------------
# Root class
# ---------------------------------------------------------------------------

reo:Event rdf:type owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "The root class for all transportation-relevant events in REO. An Event is a time-bounded occurrence in the physical world that has a spatial footprint on the road network and may affect the safety, timeliness, or cost of one or more active DispatchedTrips. Events are ephemeral: they are created when reported, progress through a lifecycle, and are archived after resolution. Archived events contribute to the GKG's historical incident record, which informs static segment risk scores."@en .

reo:RouteEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:Event ;
    rdfs:label "Route Event"@en ;
    rdfs:comment "An Event with a defined spatial footprint that intersects one or more uko:RoadSegments or uko:PedestrianNetworkEdges. RouteEvents are the primary input to the Dynamic Risk Monitor's segment-event intersection computation."@en .

# ---------------------------------------------------------------------------
# 1.1  Weather Events
# ---------------------------------------------------------------------------

reo:WeatherEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RouteEvent ;
    rdfs:label "Weather Event"@en ;
    rdfs:comment "An adverse atmospheric condition that affects the safety or traversability of road segments. Weather events have spatially extended footprints (polygonal or corridor-shaped) and time-varying severity. Their operational significance depends on vehicle class: ice events are CRITICAL for motorcycles and bicycles, HIGH for heavy trucks, MODERATE for passenger cars. Sourced from meteorological models (NOAA NWS, Tomorrow.io) and verified by traffic sensor data."@en .

reo:FogEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Fog Event"@en ;
    rdfs:comment "Reduced visibility due to fog or mist. Characterized by visibility distance in meters. Dense fog (visibility < 100m) is particularly hazardous for heavy trucks and high-speed routes."@en .

reo:IcyRoadwayEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Icy Roadway Event"@en ;
    rdfs:comment "Ice or black ice formation on road surfaces due to freezing temperatures, freezing rain, or refreezing after snow treatment. Highest relative safety impact of any weather event type, particularly for two-wheeled vehicles and heavy trucks. Sourced from road weather information system (RWIS) sensors and meteorological models."@en .

reo:HighWindEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "High Wind Event"@en ;
    rdfs:comment "Wind speeds exceeding safe thresholds for specific vehicle classes. Particularly hazardous for high-profile vehicles (heavy trucks, refrigerated trucks, armored vehicles). Bridge segments may have lower wind thresholds than surface roads."@en .

reo:HeavyPrecipitationEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Heavy Precipitation Event"@en ;
    rdfs:comment "Intense rainfall, snowfall, or mixed precipitation reducing road surface traction and visibility. Parent class for precipitation subtypes."@en .

reo:HeavyRainEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:HeavyPrecipitationEvent ;
    rdfs:label "Heavy Rain Event"@en ;
    rdfs:comment "Rainfall intensity exceeding the threshold for hydroplaning risk (typically >0.5 inches/hour). Reduces effective friction, increases stopping distances, and may cause ponding."@en .

reo:SnowEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:HeavyPrecipitationEvent ;
    rdfs:label "Snow Event"@en ;
    rdfs:comment "Snowfall resulting in snow accumulation on road surfaces. Severity characterized by accumulation rate (inches/hour) and total depth. Combined with IcyRoadwayEvent when surface temperatures are below freezing."@en .

reo:SleetEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:HeavyPrecipitationEvent ;
    rdfs:label "Sleet Event"@en ;
    rdfs:comment "Ice pellet precipitation that creates slick surface conditions similar to freezing rain. High safety impact comparable to IcyRoadwayEvent."@en .

reo:FreezingRainEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:HeavyPrecipitationEvent ;
    rdfs:label "Freezing Rain Event"@en ;
    rdfs:comment "Rain that freezes on contact with road surfaces below 0°C, forming glaze ice. The most dangerous precipitation type; creates invisible black ice across large corridor footprints."@en .

reo:FloodingEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Flooding Event"@en ;
    rdfs:comment "Standing or flowing water on road surfaces exceeding safe traversal depth. May completely block segments (full closure) or reduce speed and increase hazard. Particularly severe in underpasses and low-lying corridors."@en .

reo:ReducedVisibilityEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Reduced Visibility Event"@en ;
    rdfs:comment "Generic reduced visibility that does not qualify as FogEvent (e.g., smoke from wildfire, dust storm, heavy spray from trucks). Characterized by visibility distance in meters."@en .

reo:ExtremeHeatEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Extreme Heat Event"@en ;
    rdfs:comment "Ambient temperatures exceeding safe thresholds for temperature-sensitive cargo (>35°C) or vehicle operation. Primarily significant for refrigerated freight trips where cargo integrity may be compromised during extended delays."@en .

reo:ExtremeColdEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Extreme Cold Event"@en ;
    rdfs:comment "Ambient temperatures below freezing that increase the probability of IcyRoadwayEvent and may affect vehicle starting, brake performance, and fuel efficiency. A precursor indicator for road ice formation."@en .

# ---------------------------------------------------------------------------
# 1.2  Traffic Incident Events
# ---------------------------------------------------------------------------

reo:TrafficIncidentEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RouteEvent ;
    rdfs:label "Traffic Incident Event"@en ;
    rdfs:comment "An unplanned occurrence on the road network that disrupts normal traffic flow and/or creates safety hazards. Includes accidents, hazards, and road closures. Sourced from crowdsourced reports (Waze for Cities API), traffic management center feeds, and law enforcement broadcasts."@en .

reo:AccidentEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:TrafficIncidentEvent ;
    rdfs:label "Accident Event"@en ;
    rdfs:comment "A vehicle collision or road accident. Affects traffic flow by reducing available lanes and creates safety hazards from debris, emergency vehicles, and driver distraction (rubbernecking). Parent class for severity subclasses."@en .

reo:MinorAccidentEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:AccidentEvent ;
    rdfs:label "Minor Accident Event"@en ;
    rdfs:comment "Accident involving only property damage or minor injury. Typically affects one lane; cleared within 30–90 minutes. Causes moderate congestion impact."@en .

reo:MajorAccidentEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:AccidentEvent ;
    rdfs:label "Major Accident Event"@en ;
    rdfs:comment "Accident involving serious injuries, fatalities, or multiple vehicles. Often results in full lane blockage or road closure. May persist 2–6 hours. Causes severe congestion upstream."@en .

reo:MultiVehiclePileupEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:AccidentEvent ;
    rdfs:label "Multi-Vehicle Pileup Event"@en ;
    rdfs:comment "Chain-reaction accident involving 5 or more vehicles. Frequently triggered by WeatherEvents (fog, ice). Extended road closure. Dispatchers should reroute all active trips traversing affected segments immediately."@en .

reo:CongestionEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:TrafficIncidentEvent ;
    rdfs:label "Congestion Event"@en ;
    rdfs:comment "Non-incident traffic congestion exceeding normal operational thresholds for the time period. Affects ETA but not necessarily safety. The most operationally significant event type for food delivery and time-sensitive intracity fleet operations."@en .

reo:ModerateCongestionEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:CongestionEvent ;
    rdfs:label "Moderate Congestion Event"@en ;
    rdfs:comment "Traffic flow at 50–70% of free-flow speed. Speed index < 0.7. ETA increase of 10–25% over baseline. Triggers reroute recommendation for meal delivery fleets; informational alert for long-haul freight."@en .

reo:SevereCongestionEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:CongestionEvent ;
    rdfs:label "Severe Congestion Event"@en ;
    rdfs:comment "Traffic flow at 30–50% of free-flow speed. Speed index < 0.5. ETA increase of 25–60% over baseline. Triggers reroute recommendation for most fleet types. Source: Waze congestion reports, traffic speed feeds."@en .

reo:TrafficQueueEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:CongestionEvent ;
    rdfs:label "Traffic Queue Event"@en ;
    rdfs:comment "Complete stop-and-go conditions or traffic stoppage. Speed index < 0.2. Triggers immediate reroute recommendation for all time-sensitive fleet types. May also indicate an upstream AccidentEvent or RoadClosureEvent."@en .

reo:CrowdCongestionEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:CongestionEvent ;
    rdfs:label "Crowd Congestion Event"@en ;
    rdfs:comment "Severe pedestrian or active mobility congestion. Affects pedestrian network edges (e.g., sidewalks near stadiums post-game). Impacts active mobility routing and macroscopic UNA predictions."@en .

reo:RoadHazardEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:TrafficIncidentEvent ;
    rdfs:label "Road Hazard Event"@en ;
    rdfs:comment "Physical object or condition on the road surface creating danger or obstruction, not resulting from an accident. Sourced primarily from crowdsourced reports (Waze hazard category). Point-source spatial footprint."@en .

reo:DebrisOnRoadEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadHazardEvent ;
    rdfs:label "Debris on Road Event"@en ;
    rdfs:comment "Foreign material (cargo spill, fallen tree, structural debris) on the road surface. Point-source. Safety significance varies by debris type; high significance for motorcycles and bicycles."@en .

reo:PotholeEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadHazardEvent ;
    rdfs:label "Pothole Event"@en ;
    rdfs:comment "Road surface deterioration creating a hazardous depression. Significant for motorcycles, bicycles, and light commercial vehicles. Lower significance for heavy trucks with robust suspension."@en .

reo:ObjectOnRoadwayEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadHazardEvent ;
    rdfs:label "Object on Roadway Event"@en ;
    rdfs:comment "A large, identifiable object (tire, furniture, animal carcass) blocking part of the road. May require lane change; safety hazard especially at high speed."@en .

reo:SmokeOnRoadwayEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadHazardEvent ;
    rdfs:label "Smoke on Roadway Event"@en ;
    rdfs:comment "Smoke from a vehicle fire, wildfire, or industrial incident reducing visibility on specific road segments. May coexist with ReducedVisibilityEvent."@en .

reo:RoadClosureEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:TrafficIncidentEvent ;
    rdfs:label "Road Closure Event"@en ;
    rdfs:comment "Full or partial closure of a road segment making it unavailable for normal traffic. Closures require the Dynamic Risk Monitor to flag affected trips for mandatory rerouting, as the assigned route is no longer traversable."@en .

reo:LaneClosureEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadClosureEvent ;
    rdfs:label "Lane Closure Event"@en ;
    rdfs:comment "Closure of one or more lanes of a road segment. Added at v1.6.0 as the parent of reo:PartialLaneClosureEvent so that the 511 Traffic Management connector mapping (Architecture V12 Section 8: reo:RoadworkEvent, reo:LaneClosureEvent, reo:RoadClosureEvent) resolves to a declared class; 511 lane-closure records that do not distinguish partial-versus-rolling configurations are typed at this level, while records with explicit partial configuration are typed reo:PartialLaneClosureEvent."@en .

reo:PartialLaneClosureEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:LaneClosureEvent ;
    rdfs:label "Partial Lane Closure Event"@en ;
    rdfs:comment "One or more lanes closed while others remain open. Reduces capacity and may cause upstream congestion but does not block the route entirely. ETA impact varies by lane configuration and traffic volume."@en .

reo:FullRoadClosureEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadClosureEvent ;
    rdfs:label "Full Road Closure Event"@en ;
    rdfs:comment "All lanes of a road segment closed. Triggers mandatory reroute recommendation for all active trips with this segment in their AssignedRoute."@en .

reo:BridgeClosureEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadClosureEvent ;
    rdfs:label "Bridge Closure Event"@en ;
    rdfs:comment "Closure of a bridge, potentially isolating a geographic area for specific vehicle classes. Particularly significant for heavy trucks if the only alternative route has weight restrictions."@en .

reo:TunnelClosureEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadClosureEvent ;
    rdfs:label "Tunnel Closure Event"@en ;
    rdfs:comment "Closure of a road tunnel. May have disproportionate impact on freight routing if the tunnel provides the only feasible alternative to a mountain or water crossing."@en .

reo:PedestrianFacilityClosureEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadClosureEvent ;
    rdfs:label "Pedestrian Facility Closure Event"@en ;
    rdfs:comment "Closure of a sidewalk, crosswalk, or pedestrian bridge. Disables routing along the affected uko:PedestrianNetworkEdge for active mobility users."@en .

# ---------------------------------------------------------------------------
# 1.3  Roadwork Events
# ---------------------------------------------------------------------------

reo:RoadworkEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RouteEvent ;
    rdfs:label "Roadwork Event"@en ;
    rdfs:comment "Planned or ongoing road construction, maintenance, or utility work affecting road segment availability or capacity. Roadwork events are often scheduled in advance (distinguishing them from TrafficIncidentEvents) and may have a known end time, enabling the Dynamic Risk Monitor to project when the segment will clear. Source: municipal permit databases, 511 systems, Waze for Cities roadwork feed."@en .

reo:PlannedRoadworkEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadworkEvent ;
    rdfs:label "Planned Roadwork Event"@en ;
    rdfs:comment "Scheduled maintenance or construction work with a published start and end time. High temporal predictability; the Dynamic Risk Monitor can pre-compute route impacts for upcoming shifts. Often includes time windows (e.g., nighttime lane closures)."@en .

reo:ActiveRoadworkEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadworkEvent ;
    rdfs:label "Active Roadwork Event"@en ;
    rdfs:comment "Roadwork currently in progress. May be a transition from PlannedRoadworkEvent when construction begins, or an unscheduled emergency repair."@en .

reo:EmergencyRoadworkEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadworkEvent ;
    rdfs:label "Emergency Roadwork Event"@en ;
    rdfs:comment "Unscheduled emergency road repair (pipe burst, structural failure, utility emergency). No advance notice; high disruption. Source: 911 dispatch feeds and utility company alerts."@en .

# ---------------------------------------------------------------------------
# 1.4  Law Enforcement Events
# ---------------------------------------------------------------------------

reo:LawEnforcementEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RouteEvent ;
    rdfs:label "Law Enforcement Event"@en ;
    rdfs:comment "Presence or activity of law enforcement on or near a road segment. Affects vehicle speeds and may indicate proximity to another incident. Waze's 'police' and 'cop trap' categories map to this class. Relevant to fleet compliance monitoring and, at higher sensitivity, to armored car security routing."@en .

reo:SpeedEnforcementEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:LawEnforcementEvent ;
    rdfs:label "Speed Enforcement Event"@en ;
    rdfs:comment "Active speed enforcement (radar/laser, speed camera, or officer with radar). Reduces vehicle speed near the event location. Informational for most fleet types; may trigger compliance alerts for fleets with HOS or speed-governed vehicles."@en .

reo:CheckpointEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:LawEnforcementEvent ;
    rdfs:label "Checkpoint Event"@en ;
    rdfs:comment "Law enforcement checkpoint (DUI checkpoint, commercial vehicle inspection, border crossing). Causes significant delay; may require heavy trucks to stop for inspection. Operationally significant for time-sensitive and hazmat fleets."@en .

reo:EmergencyResponseEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:LawEnforcementEvent ;
    rdfs:label "Emergency Response Event"@en ;
    rdfs:comment "Active law enforcement response, fire department, or EMS response in progress near a road segment. Typically co-occurs with AccidentEvent or RoadClosureEvent. Emergency vehicles in the area may affect safe passage."@en .

reo:PolicePresenceEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:LawEnforcementEvent ;
    rdfs:label "Police Presence Event"@en ;
    rdfs:comment "Police vehicle visible on or near a road segment without an active enforcement action. Sourced from crowdsourced reports (Waze 'cop' category). Generally informational unless fleet type has compliance sensitivity."@en .

# ---------------------------------------------------------------------------
# 1.5  Security Events
# ---------------------------------------------------------------------------

reo:SecurityEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RouteEvent ;
    rdfs:label "Security Event"@en ;
    rdfs:comment "A security-relevant incident or condition affecting the physical safety of vehicle and cargo outside of traffic-related causes. Security events are operationally significant primarily for high-security fleet types (ARMORED_VEHICLE, HIGH security level cargo). They are not crowdsourced (Waze does not carry this category) but may be sourced from law enforcement broadcasts, private security intelligence feeds, or fleet operator reports."@en .

reo:CriminalActivityReportEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:SecurityEvent ;
    rdfs:label "Criminal Activity Report Event"@en ;
    rdfs:comment "Report of criminal activity (robbery, carjacking, theft) in the vicinity of a route segment. CRITICAL alertPriority for ARMORED_VEHICLE and HIGH/MAXIMUM security cargo. HIGH alertPriority for LIGHT_COMMERCIAL and PASSENGER_CAR in high-value goods delivery."@en .

reo:VehicleTheftRiskEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:SecurityEvent ;
    rdfs:label "Vehicle Theft Risk Event"@en ;
    rdfs:comment "Elevated risk of cargo theft or vehicle theft at a specific location (e.g., unsecured parking in a high-theft zone). Relevant for parked stop events in multi-stop commercial routes."@en .

reo:HighRiskCorridorEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:SecurityEvent ;
    rdfs:label "High Risk Corridor Event"@en ;
    rdfs:comment "A route corridor designated as high-risk by fleet security intelligence, typically due to a pattern of incidents rather than a single event. Longer duration than individual incident events. May trigger route redesign rather than reroute of individual trips."@en .

reo:SuspiciousVehicleEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:SecurityEvent ;
    rdfs:label "Suspicious Vehicle Event"@en ;
    rdfs:comment "Report of a suspicious vehicle following or positioned near a high-value cargo vehicle. CRITICAL alertPriority for ARMORED_VEHICLE. Triggers immediate dispatcher notification."@en .

# ---------------------------------------------------------------------------
# 1.6  Special Events
# ---------------------------------------------------------------------------

reo:SpecialEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RouteEvent ;
    rdfs:label "Special Event"@en ;
    rdfs:comment "A planned or anticipated gathering of large numbers of people causing significant traffic disruption around a venue or corridor. Special events have predictable timing and spatial footprints, making them high-confidence candidates for pre-trip route planning. Source: 511 systems, venue permit databases, municipal event calendars."@en .

reo:SportingEventTrafficEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:SpecialEvent ;
    rdfs:label "Sporting Event Traffic Event"@en ;
    rdfs:comment "Traffic disruption caused by a major sporting event (stadium arrival/departure). Pre- and post-event congestion windows are predictable from event schedule. Affects ETA for fleet operations in the vicinity."@en .

reo:ConcertOrFestivalTrafficEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:SpecialEvent ;
    rdfs:label "Concert or Festival Traffic Event"@en ;
    rdfs:comment "Traffic disruption caused by a concert, festival, or large entertainment event. Similar to sporting event pattern but often with longer post-event dispersal."@en .

reo:PublicDemonstrationEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:SpecialEvent ;
    rdfs:label "Public Demonstration Event"@en ;
    rdfs:comment "Permitted or unpermitted public demonstration, march, or rally causing road closures or detours. Less predictable timing than sporting events; may have security co-occurrence."@en .

reo:VIPMovementEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:SpecialEvent ;
    rdfs:label "VIP Movement Event"@en ;
    rdfs:comment "Presidential, dignitary, or high-security convoy movement requiring temporary road closures along the route corridor. Short duration but can cause sudden and complete blockage of primary arteries."@en .

#################################################################
#    PART 2: EVENT LIFECYCLE
#################################################################

reo:EventLifecycleState rdf:type owl:Class ;
    rdfs:label "Event Lifecycle State"@en ;
    rdfs:comment "Named individuals representing the stages in an event's lifecycle. The Dynamic Risk Monitor uses lifecycle state to determine whether an event should be included in route risk computation and at what confidence weight."@en .

reo:REPORTED rdf:type owl:NamedIndividual, reo:EventLifecycleState ;
    rdfs:label "Reported"@en ;
    rdfs:comment "Event has been reported by a source but not yet verified. Included in route risk computation at reduced confidence weight (0.4). Source: crowdsourced reports (Waze), unverified user submissions."@en .

reo:CONFIRMED rdf:type owl:NamedIndividual, reo:EventLifecycleState ;
    rdfs:label "Confirmed"@en ;
    rdfs:comment "Event has been confirmed by a second independent source or by sensor data. Included in route risk computation at full confidence. Source: secondary crowdsource confirmation, traffic sensor agreement, official broadcast."@en .

reo:ACTIVE rdf:type owl:NamedIndividual, reo:EventLifecycleState ;
    rdfs:label "Active"@en ;
    rdfs:comment "Event is currently in progress. This is the primary state for real-time route risk computation. Events in ACTIVE state are queried first by the Dynamic Risk Monitor."@en .

reo:RESOLVING rdf:type owl:NamedIndividual, reo:EventLifecycleState ;
    rdfs:label "Resolving"@en ;
    rdfs:comment "Event is in the process of being cleared but has not yet fully resolved. Included in route risk at reduced weight (0.6). Trips already en route may still encounter residual impact."@en .

reo:RESOLVED rdf:type owl:NamedIndividual, reo:EventLifecycleState ;
    rdfs:label "Resolved"@en ;
    rdfs:comment "Event has fully cleared. Excluded from real-time route risk computation. Retained in the GKG Event Layer for a configurable hold period (default: 2 hours) before archival, to catch delayed crowdsource confirmations."@en .

reo:ARCHIVED rdf:type owl:NamedIndividual, reo:EventLifecycleState ;
    rdfs:label "Archived"@en ;
    rdfs:comment "Event has been moved to the GKG historical incident record. Contributes to updating static uko:segmentRiskScore values via the Learning Phase. No longer part of real-time queries."@en .

reo:hasLifecycleState rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range reo:EventLifecycleState ;
    rdfs:label "has lifecycle state"@en ;
    rdfs:comment "Links an Event to its current lifecycle state. Indexed in the GKG Event Layer for efficient queries of the form: retrieve all events with lifecycleState = ACTIVE affecting segments in a given route."@en .

#################################################################
#    PART 3: EVENT SPATIO-TEMPORAL FOOTPRINT
#################################################################

# ---------------------------------------------------------------------------
# 3.1  Spatial properties
# ---------------------------------------------------------------------------

reo:affectsSegment rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range uko:RoadSegment ;
    rdfs:label "affects segment"@en ;
    rdfs:comment "Links an Event to each uko:RoadSegment within its spatial footprint. This is the load-bearing property for vehicular route intersection computation."@en .

reo:affectsPedestrianEdge rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range uko:PedestrianNetworkEdge ;
    rdfs:label "affects pedestrian edge"@en ;
    rdfs:comment "Links an Event directly to a uko:PedestrianNetworkEdge (sidewalk, crosswalk, footpath) in the multiplex graph. Allows the dynamic risk monitor to specifically target active mobility disruptions."@en .

reo:hasSpatialFootprintGeometry rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range geo:Geometry ;
    rdfs:label "has spatial footprint geometry"@en ;
    rdfs:comment "Links an Event to a GeoSPARQL geometry representing its geographic extent. For weather events this is typically a polygon; for traffic incidents a point or short linestring; for congestion a linestring along the affected corridor. Used by the event ingestion pipeline to automatically compute reo:affectsSegment links via spatial intersection against the GKG road layer."@en .

reo:hasEpicenter rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range geo:Point ;
    rdfs:label "has epicenter"@en ;
    rdfs:comment "The geographic point representing the center or origin of the event. For point-source events (accidents, hazards) this is the event location. For area events (weather, congestion) this is the centroid of the footprint."@en .

reo:affectsCorridorName rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:string ;
    rdfs:label "affects corridor name"@en ;
    rdfs:comment "Human-readable name of a major route corridor affected by this event (e.g., 'I-80 EB between SR-4 and Bay Bridge'). Supplements the formal reo:affectsSegment links for dispatcher-facing alert messaging."@en .

reo:spatialExtentKm rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:decimal ;
    rdfs:label "spatial extent (km)"@en ;
    rdfs:comment "Approximate spatial extent of the event's footprint in kilometers (for linear events: length of affected corridor; for area events: longest dimension). Used for quick filtering of events likely to affect short vs. long trips."@en .

# ---------------------------------------------------------------------------
# 3.2  Temporal properties
# ---------------------------------------------------------------------------

reo:reportedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:dateTime ;
    rdfs:label "reported at"@en .

reo:confirmedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:dateTime ;
    rdfs:label "confirmed at"@en .

reo:activeSince rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:dateTime ;
    rdfs:label "active since"@en .

reo:estimatedClearanceTime rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:dateTime ;
    rdfs:label "estimated clearance time"@en ;
    rdfs:comment "ISO 8601 timestamp of the estimated event resolution. This is the key temporal input for spatio-temporal event projection by the Dynamic Risk Monitor. If the vehicle will not reach the affected segment until after estimatedClearanceTime, the event does not contribute to route risk. Updated dynamically as the event evolves."@en .

reo:actualClearanceTime rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:dateTime ;
    rdfs:label "actual clearance time"@en .

reo:eventDurationMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:integer ;
    rdfs:label "event duration (minutes)"@en .

# ---------------------------------------------------------------------------
# 3.3  Severity properties
# ---------------------------------------------------------------------------

reo:severityScore rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:decimal ;
    rdfs:label "severity score"@en ;
    rdfs:comment "Continuous severity measure on the range [0.0, 1.0] where 1.0 represents the maximum observed severity for this event subclass. For WeatherEvents: derived from meteorological parameters (visibility distance, wind speed, precipitation rate). For TrafficIncidentEvents: derived from lane blockage fraction and confirmed injury severity. For CongestionEvents: derived from speed index relative to free-flow."@en .

reo:laneBlockageFraction rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:TrafficIncidentEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "lane blockage fraction"@en .

reo:visibilityMeters rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:WeatherEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "visibility (meters)"@en .

reo:windSpeedKph rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:WeatherEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "wind speed (km/h)"@en .

reo:precipitationRateMmPerHour rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:WeatherEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "precipitation rate (mm/hr)"@en .

reo:speedIndexAtEpicenter rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:CongestionEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "speed index at epicenter"@en .


#################################################################
#    PART 4: INTER-EVENT RELATIONS
#################################################################

reo:causesCongestion rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range reo:CongestionEvent ;
    rdfs:label "causes congestion"@en ;
    rdfs:comment "Asserts that an event is the primary cause of a downstream CongestionEvent. Established by the event ingestion pipeline when a new CongestionEvent appears within the spatial and temporal window of an existing event. Example: AccidentEvent A causes SevereCongestionEvent C 2 km upstream."@en .

reo:exacerbatedBy rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range reo:Event ;
    rdfs:label "exacerbated by"@en ;
    rdfs:comment "Asserts that a concurrent event amplifies the impact of this event. Example: FogEvent exacerbatedBy ExtremeColdEvent — the cold makes black ice more likely under the fog. The reo:severityScore of the primary event should be adjusted upward in the presence of exacerbating events."@en .

reo:coOccursWith rdf:type owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range reo:Event ;
    rdfs:label "co-occurs with"@en ;
    rdfs:comment "Asserts statistically frequent co-occurrence of two event types in the same spatial and temporal vicinity, without implying causation. Symmetric. Example: MultiVehiclePileupEvent coOccursWith IcyRoadwayEvent. Used by the Dynamic Risk Monitor to infer the probability of an unreported companion event when one is confirmed."@en .

reo:hasPrecedingEvent rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range reo:Event ;
    rdfs:label "has preceding event"@en ;
    rdfs:comment "Links an event to an earlier event that triggered or preceded it in a causal chain. Example: MajorAccidentEvent hasPrecedingEvent IcyRoadwayEvent. Used to establish compound event chains for root cause analysis in the Learning Phase."@en .

reo:hasSucceedingEvent rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range reo:Event ;
    rdfs:label "has succeeding event"@en ;
    rdfs:comment "Links an event to a downstream event it caused or preceded. Inverse of reo:hasPrecedingEvent."@en .

reo:triggeredAlertFor rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range tko:DispatchedTrip ;
    rdfs:label "triggered alert for"@en ;
    rdfs:comment "Records that this event instance triggered a reroute or safety alert for a specific DispatchedTrip. Maintained in the GKG Event Layer for post-trip analysis and dispatcher performance monitoring."@en .


#################################################################
#    PART 5: EVENT SOURCE AND CONFIDENCE
#################################################################

reo:EventSource rdf:type owl:Class ;
    rdfs:label "Event Source"@en ;
    rdfs:comment "Named individuals representing the provenance of an event report. EventSource determines the base confidence weight applied to the event in route risk computation before the event's lifecycle state adjustments are applied."@en .

reo:CROWDSOURCED rdf:type owl:NamedIndividual, reo:EventSource ;
    rdfs:label "Crowdsourced"@en .

reo:CROWDSOURCED_CONFIRMED rdf:type owl:NamedIndividual, reo:EventSource ;
    rdfs:label "Crowdsourced Confirmed"@en .

reo:OFFICIAL_GOVERNMENT rdf:type owl:NamedIndividual, reo:EventSource ;
    rdfs:label "Official Government"@en .

reo:METEOROLOGICAL_MODEL rdf:type owl:NamedIndividual, reo:EventSource ;
    rdfs:label "Meteorological Model"@en .

reo:SENSOR_INFERRED rdf:type owl:NamedIndividual, reo:EventSource ;
    rdfs:label "Sensor Inferred"@en .

reo:VERIFIED_OPERATOR rdf:type owl:NamedIndividual, reo:EventSource ;
    rdfs:label "Verified Operator"@en .

reo:SECURITY_INTELLIGENCE rdf:type owl:NamedIndividual, reo:EventSource ;
    rdfs:label "Security Intelligence"@en .

reo:hasEventSource rdf:type owl:ObjectProperty ;
    rdfs:domain reo:Event ;
    rdfs:range reo:EventSource ;
    rdfs:label "has event source"@en .

reo:sourceConfidenceScore rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:decimal ;
    rdfs:label "source confidence score"@en ;
    rdfs:comment "Composite confidence score [0.0, 1.0] incorporating EventSource base confidence and lifecycle state adjustment."@en .

reo:externalEventId rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:string ;
    rdfs:label "external event ID"@en .

reo:lastUpdatedAt rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:dateTime ;
    rdfs:label "last updated at"@en .

reo:eventTTLSeconds rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:Event ;
    rdfs:range xsd:integer ;
    rdfs:label "event TTL (seconds)"@en .


#################################################################
#    PART 6: FLEET EVENT SENSITIVITY MATRIX
#################################################################

reo:FleetEventSensitivity rdf:type owl:Class ;
    rdfs:label "Fleet Event Sensitivity"@en ;
    rdfs:comment "A reified configuration instance encoding how a specific combination of event type, fleet persona, and trip intent should be weighted in the Dynamic Risk Monitor's route risk computation. The three weights (safetyWeight, etaWeight, costWeight) sum to 1.0 and express the relative operational priority when the event type occurs. The rerouteThreshold determines at which tko:RiskTier the dispatcher receives a reroute recommendation. Named FleetEventSensitivity individuals constitute the operational policy for a fleet."@en .

reo:forEventType rdf:type owl:ObjectProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range reo:Event ;
    rdfs:label "for event type"@en .

reo:forFleetPersona rdf:type owl:ObjectProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range mlo:UseCasePersona ;
    rdfs:label "for fleet persona"@en .

reo:forTripIntent rdf:type owl:ObjectProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range tko:TripIntent ;
    rdfs:label "for trip intent"@en .

reo:forVehicleClass rdf:type owl:ObjectProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range tko:VehicleClass ;
    rdfs:label "for vehicle class"@en .

reo:safetyWeight rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range xsd:decimal ;
    rdfs:label "safety weight"@en .

reo:etaWeight rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range xsd:decimal ;
    rdfs:label "ETA weight"@en .

reo:costWeight rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range xsd:decimal ;
    rdfs:label "cost weight"@en .

reo:rerouteThreshold rdf:type owl:ObjectProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range tko:RiskTier ;
    rdfs:label "reroute threshold"@en .

reo:alertPriority rdf:type owl:ObjectProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range reo:AlertPriority ;
    rdfs:label "alert priority"@en .

reo:sensitivityLabel rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range xsd:string ;
    rdfs:label "sensitivity label"@en .

reo:sensitivityRationale rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:FleetEventSensitivity ;
    rdfs:range xsd:string ;
    rdfs:label "sensitivity rationale"@en .


#################################################################
#    PART 7: ALERT PRIORITY
#################################################################

reo:AlertPriority rdf:type owl:Class ;
    rdfs:label "Alert Priority"@en ;
    rdfs:comment "Named individuals representing the urgency level of dispatcher notifications generated by the Dynamic Risk Monitor."@en .

reo:PRIORITY_CRITICAL rdf:type owl:NamedIndividual, reo:AlertPriority ;
    rdfs:label "Critical"@en .

reo:PRIORITY_HIGH rdf:type owl:NamedIndividual, reo:AlertPriority ;
    rdfs:label "High"@en .

reo:PRIORITY_INFORMATIONAL rdf:type owl:NamedIndividual, reo:AlertPriority ;
    rdfs:label "Informational"@en .

reo:PRIORITY_SUPPRESS rdf:type owl:NamedIndividual, reo:AlertPriority ;
    rdfs:label "Suppress"@en .

#################################################################
#    PART 8: ACTIVE ROUTE RISK (DEPRECATED)
#################################################################
# Deprecated in v1.4.0 to resolve dual-agent truth collisions.
# All active, prospective risk tracking is now deferred to the
# tko:TripRiskVector computed by the OHR Model.
#################################################################

reo:ActiveRouteRisk rdf:type owl:Class ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:label "Active Route Risk (DEPRECATED)"@en ;
    rdfs:comment "DEPRECATED in v1.4.0. Formerly a prospective, continuously updated risk assessment for an in-progress DispatchedTrip. Superseded entirely by tko:TripRiskVector (R1-R9 OHR Model) to prevent dual-agent truth collisions during active tracking."@en .

reo:hasActiveRouteRisk rdf:type owl:ObjectProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain tko:DispatchedTrip ;
    rdfs:range reo:ActiveRouteRisk ;
    rdfs:label "has active route risk (DEPRECATED)"@en .

reo:activeRouteRiskScore rdf:type owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range xsd:decimal ;
    rdfs:label "active route risk score (DEPRECATED)"@en .

reo:hasActiveRiskTier rdf:type owl:ObjectProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range tko:RiskTier ;
    rdfs:label "has active risk tier (DEPRECATED)"@en .

reo:segmentEventRiskVector rdf:type owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range xsd:string ;
    rdfs:label "segment event risk vector (DEPRECATED)"@en .

reo:contributingEventCount rdf:type owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range xsd:integer ;
    rdfs:label "contributing event count (DEPRECATED)"@en .

reo:sensitivityProfileApplied rdf:type owl:ObjectProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range reo:FleetEventSensitivity ;
    rdfs:label "sensitivity profile applied (DEPRECATED)"@en .

reo:computedAt rdf:type owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range xsd:dateTime ;
    rdfs:label "computed at (DEPRECATED)"@en .

reo:expiresAt rdf:type owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range xsd:dateTime ;
    rdfs:label "expires at (DEPRECATED)"@en .

reo:rerouteRecommendationActive rdf:type owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range xsd:boolean ;
    rdfs:label "reroute recommendation active (DEPRECATED)"@en .

reo:alertGeneratedAt rdf:type owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range xsd:dateTime ;
    rdfs:label "alert generated at (DEPRECATED)"@en .

reo:estimatedETADelay rdf:type owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:domain reo:ActiveRouteRisk ;
    rdfs:range xsd:integer ;
    rdfs:label "estimated ETA delay (DEPRECATED)"@en .


#################################################################
#    PART 9: FLEET EVENT SENSITIVITY NAMED INDIVIDUALS
#################################################################

# --- INTERCITY FREIGHT: WEATHER EVENTS ---

reo:FES_IntercityFreight_WeatherIce rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:IcyRoadwayEvent ;
    reo:forTripIntent tko:IntercityFreightHauling ;
    reo:forVehicleClass tko:HEAVY_TRUCK ;
    reo:safetyWeight "0.90"^^xsd:decimal ;
    reo:etaWeight "0.08"^^xsd:decimal ;
    reo:costWeight "0.02"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_MODERATE ;
    reo:alertPriority reo:PRIORITY_CRITICAL ;
    reo:sensitivityLabel "Intercity Freight — Ice Events"@en ;
    reo:sensitivityRationale "Loaded Class 8 trucks have a center of gravity and stopping distance profile that makes ice catastrophically dangerous."@en .

reo:FES_IntercityFreight_WeatherFog rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:FogEvent ;
    reo:forTripIntent tko:IntercityFreightHauling ;
    reo:forVehicleClass tko:HEAVY_TRUCK ;
    reo:safetyWeight "0.80"^^xsd:decimal ;
    reo:etaWeight "0.15"^^xsd:decimal ;
    reo:costWeight "0.05"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_ELEVATED ;
    reo:alertPriority reo:PRIORITY_CRITICAL ;
    reo:sensitivityLabel "Intercity Freight — Dense Fog"@en .

reo:FES_IntercityFreight_HighWind rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:HighWindEvent ;
    reo:forTripIntent tko:IntercityFreightHauling ;
    reo:forVehicleClass tko:HEAVY_TRUCK ;
    reo:safetyWeight "0.85"^^xsd:decimal ;
    reo:etaWeight "0.10"^^xsd:decimal ;
    reo:costWeight "0.05"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_ELEVATED ;
    reo:alertPriority reo:PRIORITY_CRITICAL ;
    reo:sensitivityLabel "Intercity Freight — High Wind"@en .

reo:FES_IntercityFreight_Congestion rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:CongestionEvent ;
    reo:forTripIntent tko:IntercityFreightHauling ;
    reo:safetyWeight "0.25"^^xsd:decimal ;
    reo:etaWeight "0.50"^^xsd:decimal ;
    reo:costWeight "0.25"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_HIGH ;
    reo:alertPriority reo:PRIORITY_HIGH ;
    reo:sensitivityLabel "Intercity Freight — Congestion"@en .

# --- ARMORED CAR SERVICE ---

reo:FES_ArmoredCar_SecurityEvent rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:SecurityEvent ;
    reo:forTripIntent tko:ArmoredCarService ;
    reo:forVehicleClass tko:ARMORED_VEHICLE ;
    reo:safetyWeight "0.95"^^xsd:decimal ;
    reo:etaWeight "0.04"^^xsd:decimal ;
    reo:costWeight "0.01"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_LOW ;
    reo:alertPriority reo:PRIORITY_CRITICAL ;
    reo:sensitivityLabel "Armored Car — Security Events"@en .

reo:FES_ArmoredCar_TrafficIncident rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:TrafficIncidentEvent ;
    reo:forTripIntent tko:ArmoredCarService ;
    reo:forVehicleClass tko:ARMORED_VEHICLE ;
    reo:safetyWeight "0.80"^^xsd:decimal ;
    reo:etaWeight "0.15"^^xsd:decimal ;
    reo:costWeight "0.05"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_MODERATE ;
    reo:alertPriority reo:PRIORITY_HIGH ;
    reo:sensitivityLabel "Armored Car — Traffic Incidents"@en .

reo:FES_ArmoredCar_RoadClosure rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:RoadClosureEvent ;
    reo:forTripIntent tko:ArmoredCarService ;
    reo:forVehicleClass tko:ARMORED_VEHICLE ;
    reo:safetyWeight "0.85"^^xsd:decimal ;
    reo:etaWeight "0.12"^^xsd:decimal ;
    reo:costWeight "0.03"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_LOW ;
    reo:alertPriority reo:PRIORITY_CRITICAL ;
    reo:sensitivityLabel "Armored Car — Road Closure"@en .

# --- FOOD DELIVERY ---

reo:FES_FoodDelivery_SevereCongestion rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:SevereCongestionEvent ;
    reo:forTripIntent tko:FoodDeliveryTrip ;
    reo:safetyWeight "0.10"^^xsd:decimal ;
    reo:etaWeight "0.85"^^xsd:decimal ;
