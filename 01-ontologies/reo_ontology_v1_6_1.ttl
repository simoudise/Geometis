    reo:rerouteThreshold tko:RISK_LOW ;
    reo:alertPriority reo:PRIORITY_HIGH ;
    reo:sensitivityLabel "Food Delivery — Severe Congestion"@en .

reo:FES_FoodDelivery_ModerateCongestion rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:ModerateCongestionEvent ;
    reo:forTripIntent tko:FoodDeliveryTrip ;
    reo:safetyWeight "0.10"^^xsd:decimal ;
    reo:etaWeight "0.82"^^xsd:decimal ;
    reo:costWeight "0.08"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_MODERATE ;
    reo:alertPriority reo:PRIORITY_HIGH ;
    reo:sensitivityLabel "Food Delivery — Moderate Congestion"@en .

reo:FES_FoodDelivery_TrafficQueue rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:TrafficQueueEvent ;
    reo:forTripIntent tko:FoodDeliveryTrip ;
    reo:safetyWeight "0.08"^^xsd:decimal ;
    reo:etaWeight "0.88"^^xsd:decimal ;
    reo:costWeight "0.04"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_LOW ;
