#################################################################
#    PART 14: NEW EVENT SUBCLASSES FROM ACCIDENT DATA ANALYSIS
#################################################################

# ---------------------------------------------------------------------------
# 14.1 Vehicle-Pedestrian and Vehicle-Bicyclist accident event classes
# ---------------------------------------------------------------------------

reo:VehiclePedestrianAccidentEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:AccidentEvent ;
    rdfs:label "Vehicle-Pedestrian Accident Event"@en ;
    rdfs:comment "A live accident event involving a vehicle and a pedestrian. Subclass of reo:AccidentEvent introduced in REO v1.1 to reflect the significant operational difference between Vehicle-Pedestrian collisions (SWITRS dph_col_grp_description = 'Vehicle-Pedestrian') and vehicle-only collisions. Fleet operators in dense pedestrian areas should treat this event type with elevated safetyWeight regardless of cargo type. In the FleetEventSensitivity matrix, all vehicle classes receive safetyWeight ≥ 0.65 for this event type."@en .

reo:VehicleBicyclistAccidentEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:AccidentEvent ;
    rdfs:label "Vehicle-Bicyclist Accident Event"@en ;
    rdfs:comment "A live accident event involving a vehicle and a bicyclist. Subclass of reo:AccidentEvent introduced in REO v1.1 to reflect the Three Feet for Safety Act (CVC 21760) compliance dimension. Particularly relevant for HEAVY_TRUCK and REFRIGERATED_TRUCK fleet operators on corridors with bicycle infrastructure, where the vehicle's physical width creates a non-trivial lane-sharing constraint. Alert priority is PRIORITY_HIGH for vehicles with width > 2.5m."@en .

# ---------------------------------------------------------------------------
# 14.2 CompoundConditionHazardEvent (UPDATED TO 2D KEY IN v1.4.0)
# ---------------------------------------------------------------------------

reo:CompoundConditionHazardEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RouteEvent ;
    rdfs:label "Compound Condition Hazard Event"@en ;
    rdfs:comment "A synthesized hazard event generated by the Dynamic Risk Monitor when a live reo:WeatherEvent co-occurs with a segment whose uko:compoundConditionRiskMap entry for the current weather × road surface combination exceeds a configurable threshold (default: 1.5× baseline). This event class represents the intersection of a static geographic risk attribute (the historical compound condition multiplier) with a live condition — addressing the ADAS + weather gap identified in the architectural analysis. CompoundConditionHazardEvents are not produced by external Event Feed Connectors; they are synthesized internally by the Dynamic Risk Monitor during monitoring cycles and do not have an reo:externalEventId. They are assigned reo:hasEventSource = reo:SENSOR_INFERRED with a sourceConfidenceScore that reflects the historical data quality of the underlying compoundConditionRiskMap entry. The event's severityScore is computed as: baseWeatherSeverity × compoundConditionMultiplier, capped at 1.0."@en .

reo:baseWeatherEventId rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:CompoundConditionHazardEvent ;
    rdfs:range xsd:string ;
    rdfs:label "base weather event ID"@en ;
    rdfs:comment "The reo:externalEventId of the live WeatherEvent that triggered synthesis of this CompoundConditionHazardEvent. Used to track the causal chain and to expire the CompoundConditionHazardEvent when the triggering WeatherEvent resolves."@en .

reo:compoundConditionMultiplier rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:CompoundConditionHazardEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "compound condition multiplier"@en ;
    rdfs:comment "The historically-observed accident rate multiplier from uko:compoundConditionRiskMap (or uko:intersectionCompoundConditionRiskMap) for the specific weather × road surface combination present when this event was synthesized. Example: a multiplier of 2.8 means the current conditions are historically associated with 2.8× the baseline accident rate on this segment."@en .

# Format updated to 2D `{weather_1}::{road_surface}`
reo:compoundConditionKey rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:CompoundConditionHazardEvent ;
    rdfs:range xsd:string ;
    rdfs:label "compound condition key"@en ;
    rdfs:comment "The compound condition lookup key that produced the multiplier. Format: '{weather_1}::{road_surface}' (e.g., 'Raining::Wet'). Updated to 2D in v1.4.0 to align with TLP Stage 3 logic. Stored for auditability."@en .

#################################################################
#    PART 15: NEW DATA PROPERTIES ON EXISTING EVENT CLASSES
#################################################################

reo:hasCollisionType rdf:type owl:ObjectProperty ;
    rdfs:domain reo:AccidentEvent ;
    rdfs:range reo:CollisionType ;
    rdfs:label "has collision type"@en ;
    rdfs:comment "Links a live accident event to its collision type classification. Set from real-time feed data (where available) or from historical incident records matched to the same location. Used by the Dynamic Risk Monitor to apply collision-type-specific risk weights."@en .

reo:hasWeatherConditionAtEvent rdf:type owl:ObjectProperty ;
    rdfs:domain reo:RouteEvent ;
    rdfs:range reo:WeatherCondition ;
    rdfs:label "has weather condition at event"@en ;
    rdfs:comment "The weather condition observed at the event location. Derived from the co-occurring WeatherEvent in the Event Layer (if present) or from the Event Feed Connector's weather metadata. Used to look up the applicable compound condition risk multiplier from uko:compoundConditionRiskMap."@en .

reo:hasRoadSurfaceCondition rdf:type owl:ObjectProperty ;
    rdfs:domain reo:RouteEvent ;
    rdfs:range reo:RoadSurfaceCondition ;
    rdfs:label "has road surface condition"@en ;
    rdfs:comment "The road surface condition at the event location. May be inferred from weather (raining → wet surface after configurable lag) or supplied by the Event Feed Connector."@en .

reo:hasLightingCondition rdf:type owl:ObjectProperty ;
    rdfs:domain reo:RouteEvent ;
    rdfs:range reo:LightingCondition ;
    rdfs:label "has lighting condition"@en ;
    rdfs:comment "The lighting condition at the event location and time. Derived from local time + sunrise/sunset computation for the segment's coordinates, or from Event Feed Connector metadata."@en .

reo:hasCollisionCausationFactor rdf:type owl:ObjectProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range reo:CollisionCausationFactor ;
    rdfs:label "has collision causation factor"@en ;
    rdfs:comment "Links a historical incident record to its primary collision causation factor (PCF). Used to populate uko:segmentPCFDistribution and uko:intersectionPCFDistribution during the Historical Incident Data Ingestion Pipeline."@en .

#################################################################
#    PART 16: HISTORICAL INCIDENT RECORD CLASS
#################################################################

reo:HistoricalIncidentRecord rdf:type owl:Class ;
    rdfs:label "Historical Incident Record"@en ;
    rdfs:comment "An archival police-reported vehicle collision record ingested from an official collision database (SWITRS for California, NYPD MV-104 for New York, or equivalent). HistoricalIncidentRecord is distinct from live RouteEvent subclasses: it is a durable historical data point, not an ephemeral event. It is stored in the NebulaGraph GKG trip history subgraph alongside tko:Trip records, linked to uko:RoadSegment and uko:IntersectionNode via reo:affectsSegment and reo:atIntersectionNode. It is never read by the Dynamic Risk Monitor at runtime; it is consumed only by the Historical Incident Data Ingestion Pipeline during Setup and Learning Phase to compute aggregated analytics properties."@en ;
    rdfs:isDefinedBy <urn:route-event-kg:> .

# Core record identification
reo:incidentId rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "incident ID"@en ;
    rdfs:comment "Source system unique identifier for the collision record. In SWITRS: case_id_pkey. Format varies by jurisdiction. Used as the deduplication key during ingestion."@en .

reo:incidentSourceSystem rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "incident source system"@en ;
    rdfs:comment "Identifier of the source collision database. Expected values: 'SWITRS_CA' (California SWITRS via UC Berkeley SafeTREC TIMS), 'NYPD_MV104' (New York City open data), 'OPENDATA_CITY_{cityName}'. Used to apply jurisdiction-specific field mappings during ingestion."@en .

reo:incidentDatetime rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:dateTime ;
    rdfs:label "incident datetime"@en ;
    rdfs:comment "Date and time of the collision. Maps to SWITRS collision_datetime. Used for temporal analytics (time-of-day and day-of-week patterns)."@en .

reo:incidentYear rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:integer ;
    rdfs:label "incident year"@en ;
    rdfs:comment "Calendar year of the collision. Maps to SWITRS accident_year. Used for year-range filtering during analytics computation."@en .

reo:incidentTimeCategory rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "incident time category"@en ;
    rdfs:comment "Time-of-day category from SWITRS time_cat field (e.g., '6:01 pm to 10:00 pm'). Used to compute uko:segmentIncidentTimePattern and uko:intersectionTimePattern."@en .

reo:incidentDayOfWeek rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "incident day of week"@en ;
    rdfs:comment "Day of week of the collision. Maps to SWITRS day_of_week."@en .

# Location
reo:incidentLatitude rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:decimal ;
    rdfs:label "incident latitude"@en ;
    rdfs:comment "WGS-84 latitude of the collision point. Maps to SWITRS tb_latitude."@en .

reo:incidentLongitude rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:decimal ;
    rdfs:label "incident longitude"@en ;
    rdfs:comment "WGS-84 longitude of the collision point. Maps to SWITRS tb_longitude."@en .

reo:incidentPrimaryRoad rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "incident primary road"@en ;
    rdfs:comment "Primary road name at the collision location. Maps to SWITRS primary_rd."@en .

reo:incidentSecondaryRoad rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "incident secondary road"@en ;
    rdfs:comment "Cross-street name at the collision location. Maps to SWITRS secondary_rd. Null for midblock incidents."@en .

reo:isAtIntersection rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "is at intersection"@en ;
    rdfs:comment "True if the collision occurred at or within 20 feet of an intersection. Derived from SWITRS intersection field ('Intersection <= 20ft' → true; 'Midblock > 20ft' → false). Determines whether the record is matched to a uko:IntersectionNode (true) or a uko:RoadSegment midblock (false)."@en .

reo:cnnIntersectionKey rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "CNN intersection key"@en ;
    rdfs:comment "San Francisco CNN intersection foreign key from SWITRS cnn_intrsctn_fkey. Populated only for SF records. Used for exact-match spatial linking to uko:IntersectionNode."@en .

reo:cnnSegmentKey rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "CNN segment key"@en ;
    rdfs:comment "San Francisco CNN segment foreign key from SWITRS cnn_sgmt_fkey. Populated only for midblock SF records. Used for exact-match spatial linking to uko:RoadSegment."@en .

reo:matchConfidence rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:decimal ;
    rdfs:label "match confidence"@en ;
    rdfs:comment "Confidence score [0.0–1.0] assigned to the spatial match between this incident record and its linked GKG entity (uko:RoadSegment or uko:IntersectionNode). CNN_KEY match → 1.0; road name pair match → 0.65–0.85; coordinate proximity match → distance-based [0.5–1.0]. Records with matchConfidence < 0.60 are excluded from analytics aggregation."@en .

reo:atIntersectionNode rdf:type owl:ObjectProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range uko:IntersectionNode ;
    rdfs:label "at intersection node"@en ;
    rdfs:comment "Links a historical incident record that occurred at an intersection to the matching uko:IntersectionNode in the GKG. Populated by the Historical Incident Data Ingestion Pipeline spatial matching step. Null for midblock records."@en .

# Conditions at time of incident
reo:incidentWeatherCondition rdf:type owl:ObjectProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range reo:WeatherCondition ;
    rdfs:label "incident weather condition"@en ;
    rdfs:comment "Weather condition at the time of the collision. Maps to SWITRS weather_1. Used to compute the compound condition risk map."@en .

reo:incidentRoadSurface rdf:type owl:ObjectProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range reo:RoadSurfaceCondition ;
    rdfs:label "incident road surface"@en ;
    rdfs:comment "Road surface condition at the time of the collision. Maps to SWITRS road_surface."@en .

reo:incidentLighting rdf:type owl:ObjectProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range reo:LightingCondition ;
    rdfs:label "incident lighting"@en ;
    rdfs:comment "Lighting condition at the time of the collision. Maps to SWITRS lighting."@en .

reo:incidentRoadCondition rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "incident road condition"@en ;
    rdfs:comment "Additional road condition notes beyond surface type. Maps to SWITRS road_cond_1 (e.g., 'Obstruction on Roadway', 'No Unusual Condition'). Stored as a string rather than a controlled enumeration due to variability across jurisdictions."@en .

# Collision characteristics
reo:incidentCollisionType rdf:type owl:ObjectProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range reo:CollisionType ;
    rdfs:label "incident collision type"@en ;
    rdfs:comment "Physical collision type. Maps to SWITRS type_of_collision, normalized to reo:CollisionType individuals."@en .

reo:incidentSeverity rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "incident severity"@en ;
    rdfs:comment "Collision severity from SWITRS collision_severity field. Values: 'Injury (Complaint of Pain)', 'Injury (Other Visible)', 'Injury (Severe)', 'Fatal', 'Property Damage Only'."@en .

reo:incidentCollisionGroup rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "incident collision group"@en ;
    rdfs:comment "DPH collision group description (dph_col_grp_description) from SWITRS. Values: 'Vehicle(s) Only Involved', 'Vehicle-Pedestrian', 'Vehicle-Bicycle', 'Bicycle Only'."@en .

reo:numberKilled rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:integer ;
    rdfs:label "number killed"@en ;
    rdfs:comment "Number of fatalities. Maps to SWITRS number_killed."@en .

reo:numberInjured rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:integer ;
    rdfs:label "number injured"@en ;
    rdfs:comment "Number of injured parties. Maps to SWITRS number_injured."@en .

reo:motorVehicleInvolvedWith rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "motor vehicle involved with"@en ;
    rdfs:comment "Object or party the vehicle collided with. Maps to SWITRS mviw (e.g., 'Pedestrian', 'Bicycle', 'Parked Motor Vehicle', 'Fixed Object'). Supplements incidentCollisionGroup for finer-grained classification."@en .

reo:party1Type rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "party 1 type"@en ;
    rdfs:comment "Type of the first party in the collision. Maps to SWITRS party1_type (Driver, Bicyclist, Pedestrian). Party 1 is typically the at-fault or initiating party."@en .

reo:party2Type rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "party 2 type"@en ;
    rdfs:comment "Type of the second party in the collision. Maps to SWITRS party2_type."@en .

reo:party1MovementPreAccident rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "party 1 movement pre-accident"@en ;
    rdfs:comment "Movement of party 1 immediately before the collision. Maps to SWITRS party1_move_pre_acc (e.g., 'Making Left Turn', 'Proceeding Straight', 'Backing'). Used in PCF-movement pattern analytics."@en .

reo:party2MovementPreAccident rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "party 2 movement pre-accident"@en ;
    rdfs:comment "Movement of party 2 immediately before the collision. Maps to SWITRS party2_move_pre_acc."@en .

reo:controlDevice rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "control device"@en ;
    rdfs:comment "Traffic control device present at the collision location. Maps to SWITRS control_device ('Functioning', 'None', 'Not Stated'). Intersections with control_device = 'None' have a different PCF profile than signalized intersections."@en .

reo:analysisNeighborhood rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "analysis neighborhood"@en ;
    rdfs:comment "Neighborhood name from SWITRS analysis_neighborhood field. City-specific administrative unit used for geographic aggregation. Null for jurisdictions that do not supply neighborhood data."@en .

reo:geocodeSource rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:string ;
    rdfs:label "geocode source"@en ;
    rdfs:comment "Source system used to assign geographic coordinates to the record. Maps to SWITRS geocode_source (e.g., 'SFPD-CROSSROADS'). Used to assess coordinate precision."@en .

#################################################################
#    PART 17: NEW EVENT SOURCE INDIVIDUAL
#################################################################

reo:HISTORICAL_POLICE_RECORD rdf:type owl:NamedIndividual, reo:EventSource ;
    rdfs:label "Historical Police Record"@en ;
    reo:sourceConfidenceScore "1.0"^^xsd:decimal ;
    rdfs:comment "Event source for reo:HistoricalIncidentRecord instances ingested from official police collision databases (SWITRS, NYPD MV-104, etc.). Confidence score = 1.0 because these are official government records, not crowdsourced reports. Note: this source is used exclusively for HistoricalIncidentRecord population during the Historical Incident Data Ingestion Pipeline; it is never used as the hasEventSource on live RouteEvent instances."@en .

#################################################################
#    PART 18: NEW FLEET EVENT SENSITIVITY INSTANCES
#         (vehicle-pedestrian and vehicle-bicyclist events)
#################################################################

reo:FES_HeavyTruck_VehiclePedestrian rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forVehicleClass tko:HEAVY_TRUCK ;
    reo:forEventType reo:VehiclePedestrianAccidentEvent ;
    reo:safetyWeight "0.88"^^xsd:decimal ;
    reo:etaWeight "0.09"^^xsd:decimal ;
    reo:costWeight "0.03"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_LOW ;
    reo:alertPriority reo:PRIORITY_CRITICAL ;
    reo:sensitivityLabel "Heavy Truck / Vehicle-Pedestrian Event"@en ;
    reo:sensitivityRationale "Heavy trucks have poor forward visibility for pedestrians at close range and long stopping distances. A Vehicle-Pedestrian accident event on a heavy truck route triggers maximum safety response with reroute at the lowest risk tier."@en .

reo:FES_RefrigeratedTruck_VehiclePedestrian rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forVehicleClass tko:REFRIGERATED_TRUCK ;
    reo:forEventType reo:VehiclePedestrianAccidentEvent ;
    reo:safetyWeight "0.85"^^xsd:decimal ;
    reo:etaWeight "0.10"^^xsd:decimal ;
    reo:costWeight "0.05"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_LOW ;
    reo:alertPriority reo:PRIORITY_CRITICAL ;
    reo:sensitivityLabel "Refrigerated Truck / Vehicle-Pedestrian Event"@en ;
    reo:sensitivityRationale "Same pedestrian vulnerability profile as HEAVY_TRUCK with slight weight redistribution to ETA (time-sensitive cargo)."@en .

reo:FES_HeavyTruck_VehicleBicyclist rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forVehicleClass tko:HEAVY_TRUCK ;
    reo:forEventType reo:VehicleBicyclistAccidentEvent ;
    reo:safetyWeight "0.85"^^xsd:decimal ;
    reo:etaWeight "0.10"^^xsd:decimal ;
    reo:costWeight "0.05"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_LOW ;
    reo:alertPriority reo:PRIORITY_CRITICAL ;
    reo:sensitivityLabel "Heavy Truck / Vehicle-Bicyclist Event"@en ;
    reo:sensitivityRationale "Heavy trucks are governed by CVC 21760 (Three Feet for Safety Act). A vehicle-bicyclist incident on a heavy truck route triggers immediate high-priority alert because the truck's physical width makes three-foot clearance difficult on narrow streets."@en .

reo:FES_PassengerCar_VehiclePedestrian rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forVehicleClass tko:PASSENGER_CAR ;
    reo:forEventType reo:VehiclePedestrianAccidentEvent ;
    reo:safetyWeight "0.75"^^xsd:decimal ;
    reo:etaWeight "0.18"^^xsd:decimal ;
    reo:costWeight "0.07"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_MODERATE ;
    reo:alertPriority reo:PRIORITY_HIGH ;
    reo:sensitivityLabel "Passenger Car / Vehicle-Pedestrian Event"@en ;
    reo:sensitivityRationale "Passenger cars have better visibility than heavy trucks; reroute threshold is RISK_MODERATE rather than RISK_LOW. Still a high-priority alert due to scene management delays."@en .

reo:FES_Default_CompoundCondition rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forEventType reo:CompoundConditionHazardEvent ;
    reo:safetyWeight "0.70"^^xsd:decimal ;
    reo:etaWeight "0.20"^^xsd:decimal ;
    reo:costWeight "0.10"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_ELEVATED ;
    reo:alertPriority reo:PRIORITY_HIGH ;
    reo:sensitivityLabel "Default / Compound Condition Hazard"@en ;
    reo:sensitivityRationale "Default sensitivity for CompoundConditionHazardEvent (weather + road condition + lighting compound hazard). High safetyWeight because the compound multiplier indicates historically elevated accident probability. Reroute at RISK_ELEVATED because the underlying weather condition is likely affecting multiple segments simultaneously — selective rerouting is warranted."@en .

###############################################################################
#    PART 19: OHR WEATHER EVENT TYPES (REO v1.3)
###############################################################################

# ---------------------------------------------------------------------------
# 19.1  WindAdvisoryEvent
# ---------------------------------------------------------------------------

reo:WindAdvisoryEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Wind Advisory Event"@en ;
    rdfs:comment "A wind advisory, high wind warning, or wind watch issued by NWS or state DOT for a specific highway corridor or geographic zone. Distinct from the general reo:HighWindEvent (which captures wind conditions detected from telematics or sensor data) in that WindAdvisoryEvent is a formally issued government advisory with a named corridor scope. This makes it the authoritative R1 input for the chain_control_probability computation in the OHR model. Source: NWS CAP alert feed, Caltrans Chain Control System."@en .

reo:windAdvisoryType rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:WindAdvisoryEvent ;
    rdfs:range xsd:string ;
    rdfs:label "wind advisory type"@en ;
    rdfs:comment "The NWS product code for this advisory. Controlled vocabulary: WIND_ADVISORY (sustained 25–39 mph or gusts 35–57 mph), HIGH_WIND_WATCH (conditions favorable for high winds in next 12–48 hours), HIGH_WIND_WARNING (sustained >= 40 mph or gusts >= 58 mph), EXTREME_WIND_WARNING (gusts >= 115 mph — rare, typically associated with hurricanes). Each type maps to a different R1 contribution weight in the OHR model."@en .

reo:windAdvisorySpeedMph rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:WindAdvisoryEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "wind advisory speed (mph)"@en ;
    rdfs:comment "Forecast sustained wind speed in miles per hour for this advisory. Used as a continuous feature input to R1 alongside the binary advisory type. Particularly significant for high-profile vehicles (HEAVY_TRUCK, REFRIGERATED_TRUCK) where wind speeds > 40 mph on exposed bridge and pass segments create crosswind rollover risk."@en .

reo:windAdvisoryGustMph rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:WindAdvisoryEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "wind advisory gust speed (mph)"@en ;
    rdfs:comment "Forecast maximum gust speed in miles per hour. Gust speeds are more operationally significant than sustained speeds for vehicle stability: a gust of 65 mph can destabilize an empty 53-foot trailer even when sustained speeds are 40 mph."@en .

reo:windAdvisoryAffectedHighway rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:WindAdvisoryEvent ;
    rdfs:range xsd:string ;
    rdfs:label "wind advisory affected highway"@en ;
    rdfs:comment "Highway identifier and milepost range affected by this wind advisory. Example: 'I-80 MM 80–120 (Truckee to Reno)', 'US-395 Topaz Summit'. Parsed to identify affected GKG uko:RoadSegment URNs via the reo:affectsSegment property."@en .


# ---------------------------------------------------------------------------
# 19.2  IceFormationEvent
# ---------------------------------------------------------------------------

reo:IceFormationEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Ice Formation Event"@en ;
    rdfs:comment "Detection or prediction of ice formation on specific road segments, sourced from RWIS (Road Weather Information System) sensor data indicating road surface temperature at or below 32°F combined with moisture. Distinct from the general reo:IcyRoadwayEvent (which is typically crowdsourced or condition-inferred) in that IceFormationEvent is sensor-confirmed or model-predicted at segment granularity. This segment-level precision is required for accurate Corridor Weather Severity Index (CWSI) computation in the OHR Stage 1 Segment Risk Model."@en .

reo:roadSurfaceTemperatureF rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:IceFormationEvent ;
    rdfs:range xsd:decimal ;
    rdfs:label "road surface temperature (°F)"@en ;
    rdfs:comment "Road surface temperature in degrees Fahrenheit at the time of this event, sourced from RWIS sensor or road weather model. The primary discriminator between IceFormationEvent (surface at or below 32°F with moisture) and ExtremeColdEvent (air temperature low but surface may not yet be frozen). Values below 20°F indicate deep freeze conditions that persist despite treatment."@en .

reo:moisturePresent rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:IceFormationEvent ;
    rdfs:range xsd:boolean ;
    rdfs:label "moisture present"@en ;
    rdfs:comment "True if road surface moisture is confirmed by RWIS sensor (resistance or microwave technology), indicating active ice formation conditions. False when surface temperature is below freezing but road is dry — lower R1 contribution because ice has not formed despite cold."@en .

reo:iceFormationSource rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:IceFormationEvent ;
    rdfs:range xsd:string ;
    rdfs:label "ice formation source"@en ;
    rdfs:comment "Data source for this ice formation detection. Controlled vocabulary: RWIS_SENSOR (confirmed by Road Weather Information System sensor — highest confidence), ROAD_WEATHER_MODEL (predicted by pavement temperature forecast model — CONFIRMED lifecycle state at 0.8 confidence), FLEET_TELEMATICS (inferred from multiple fleet vehicles reporting low friction on this segment — REPORTED state at 0.6 confidence), CALTRANS_BROADCAST (issued by Caltrans Maintenance via radio — CONFIRMED state)."@en .

reo:treatmentApplied rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:IceFormationEvent ;
    rdfs:range xsd:boolean ;
    rdfs:label "treatment applied"@en ;
    rdfs:comment "True if road maintenance has applied anti-icing or de-icing treatment (salt, brine, sand) to this segment. When true, the R1 contribution is reduced by a configurable factor (default: 0.4× multiplier) because treatment reduces but does not eliminate ice hazard. Populated from DOT maintenance management system broadcast when available."@en .


# ---------------------------------------------------------------------------
# 19.3  ChainControlIssuanceEvent
# ---------------------------------------------------------------------------

reo:ChainControlIssuanceEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:WeatherEvent ;
    rdfs:label "Chain Control Issuance Event"@en ;
    rdfs:comment "A formal chain control or traction requirement issuance by a state DOT for a specific mountain pass or highway segment. This is the live-event counterpart of uko:WeatherConditionalOperationalConstraint, which models the static possibility that chain control can be imposed on a given segment. ChainControlIssuanceEvent records when it WAS issued. The distinction is operationally critical: the static UKO constraint is used at Stage 3 feature augmentation to compute Chain Control Probability; the live REO event triggers immediate R1 elevation and dispatcher alert for any active trip whose AssignedRoute traverses the affected segment. Source: Caltrans CHIS (Chain Control Information System), CDOT, NDOT chain control APIs."@en .

reo:chainControlTier rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:ChainControlIssuanceEvent ;
    rdfs:range xsd:string ;
    rdfs:label "chain control tier"@en ;
    rdfs:comment "The traction tier in effect for this issuance. Controlled vocabulary per California Traction Law (Vehicle Code 27465): R1 (one traction device required on drive axle — snow tires or chains), R2 (chains required on all non-exempt vehicles — 4WD/AWD exemption applies), R3 (chains required on ALL vehicles including 4WD/AWD — most severe). Class 8 trucks are typically chain-required at R1 and above. R3 closes most passes to all commercial traffic."@en .

reo:affectedPassName rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:ChainControlIssuanceEvent ;
    rdfs:range xsd:string ;
    rdfs:label "affected pass name"@en ;
    rdfs:comment "Human-readable name of the affected mountain pass or highway segment. Examples: 'Donner Pass (I-80 MM 180–195)', 'Echo Summit (US-50 MM 80–90)', 'Eisenhower Tunnel (I-70 MM 213)'. Used to populate the Tier 3 natural-language explanation for the dispatcher."@en .

reo:issuanceTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:ChainControlIssuanceEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "issuance timestamp"@en ;
    rdfs:comment "ISO 8601 timestamp at which the chain control was formally issued by the state DOT. Used to compute how long the requirement has been in effect, which informs the probability that it will remain in force at the projected arrival time of an active trip."@en .

reo:estimatedLiftTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:ChainControlIssuanceEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "estimated lift timestamp"@en ;
    rdfs:comment "Estimated timestamp at which the chain control is expected to be lifted, based on forecast weather clearing. Null when no lift time is forecast (R3 with storm of indefinite duration). Used by the DELAY_DEPARTURE remediation generator to recommend an optimal revised departure time that routes the truck through the pass after chain control lifts."@en .

reo:affectsAllCommercialVehicles rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:ChainControlIssuanceEvent ;
    rdfs:range xsd:boolean ;
    rdfs:label "affects all commercial vehicles"@en ;
    rdfs:comment "True when chain control tier is R2 or higher for commercial vehicles, meaning all Class 6-8 trucks must carry and be prepared to install chains. False for R1 snow tire requirements where some vehicles may be exempt. Used to determine whether the REROUTE or DELAY_DEPARTURE remediation is appropriate: when this is true and the fleet vehicle is not equipped with chains, the segment is effectively impassable and rerouting is required regardless of driver preference."@en .


# ---------------------------------------------------------------------------
# 19.4  DisabledVehicleEvent 
# ---------------------------------------------------------------------------

reo:DisabledVehicleEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RoadHazardEvent ;
    rdfs:label "Disabled Vehicle Event"@en ;
    rdfs:comment "A vehicle that has become disabled on the roadway or shoulder, creating a hazard or obstruction. Sources: Waze hazard category 'Hazard_On_Road_Car_Stopped', Caltrans TMC incident feeds, fleet telematics breakdown reports. Distinct from AccidentEvent (which involves a collision) — a disabled vehicle may be a mechanical failure, flat tire, or fuel exhaustion. Operationally significant for heavy trucks because the wide footprint of a disabled Class 8 trailer can block a lane entirely on two-lane mountain roads."@en .

reo:disabledVehicleClassEstimate rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:DisabledVehicleEvent ;
    rdfs:range xsd:string ;
    rdfs:label "disabled vehicle class estimate"@en ;
    rdfs:comment "Estimated class of the disabled vehicle, where determinable from the source report. Controlled vocabulary: PASSENGER_CAR, LIGHT_COMMERCIAL, HEAVY_TRUCK, MOTORCYCLE, UNKNOWN. Heavy truck disablements on mountain roads and narrow highway segments receive elevated R1/R4 contribution because recovery operations (tow truck, wheel chock deployment) can block the roadway for 30–90 minutes."@en .

reo:expectedClearanceMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:DisabledVehicleEvent ;
    rdfs:range xsd:integer ;
    rdfs:label "expected clearance time (minutes)"@en ;
    rdfs:comment "Estimated time in minutes until the disabled vehicle is removed and the segment returns to normal operation. Derived from historical clearance time distributions by vehicle class and location. Used in R4 (Congestion/Delay Risk) computation: a disabled Class 8 truck on a two-lane mountain segment with 60-minute clearance time has significant ETA impact for any trip routed through that segment."@en .


# ---------------------------------------------------------------------------
# 19.5  FES instances for new event types 
# ---------------------------------------------------------------------------

reo:FES_HeavyTruck_WindAdvisory rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forVehicleClass tko:HEAVY_TRUCK ;
    reo:forEventType reo:WindAdvisoryEvent ;
    reo:safetyWeight "0.82"^^xsd:decimal ;
    reo:etaWeight "0.12"^^xsd:decimal ;
    reo:costWeight "0.06"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_ELEVATED ;
    reo:alertPriority reo:PRIORITY_HIGH ;
    reo:sensitivityLabel "Heavy Truck / Wind Advisory"@en ;
    reo:sensitivityRationale "High-profile heavy trucks (empty 53-ft trailers) are particularly susceptible to crosswind rollover on exposed bridge decks and mountain pass segments. A HIGH_WIND_WARNING for a segment on the assigned route requires reroute consideration. WIND_ADVISORY triggers monitoring and speed advisory."@en .

reo:FES_RefrigeratedTruck_WindAdvisory rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forVehicleClass tko:REFRIGERATED_TRUCK ;
    reo:forEventType reo:WindAdvisoryEvent ;
    reo:safetyWeight "0.80"^^xsd:decimal ;
    reo:etaWeight "0.14"^^xsd:decimal ;
    reo:costWeight "0.06"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_ELEVATED ;
    reo:alertPriority reo:PRIORITY_HIGH ;
    reo:sensitivityLabel "Refrigerated Truck / Wind Advisory"@en ;
    reo:sensitivityRationale "Reefer trailers are typically fully loaded and have slightly lower wind instability risk than empty dry vans, but refrigeration unit exposure adds cargo risk if the truck is delayed or forced to idle in extreme wind. ETA weight elevated relative to HEAVY_TRUCK because cargo sensitivity is time-dependent."@en .

reo:FES_HeavyTruck_IceFormation rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forVehicleClass tko:HEAVY_TRUCK ;
    reo:forEventType reo:IceFormationEvent ;
    reo:safetyWeight "0.90"^^xsd:decimal ;
    reo:etaWeight "0.07"^^xsd:decimal ;
    reo:costWeight "0.03"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_LOW ;
    reo:alertPriority reo:PRIORITY_CRITICAL ;
    reo:sensitivityLabel "Heavy Truck / Ice Formation"@en ;
    reo:sensitivityRationale "A sensor-confirmed IceFormationEvent on a Class 8 truck route requires immediate response. Long stopping distances and jackknife risk on ice make this the highest-safety-weight event type for heavy trucks. Reroute threshold is RISK_LOW: even a modest probability of ice formation triggers a reroute recommendation unless the driver is equipped with chains and has confirmed readiness."@en .

reo:FES_HeavyTruck_ChainControl rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forVehicleClass tko:HEAVY_TRUCK ;
    reo:forEventType reo:ChainControlIssuanceEvent ;
    reo:safetyWeight "0.75"^^xsd:decimal ;
    reo:etaWeight "0.20"^^xsd:decimal ;
    reo:costWeight "0.05"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_MODERATE ;
    reo:alertPriority reo:PRIORITY_HIGH ;
    reo:sensitivityLabel "Heavy Truck / Chain Control Issuance"@en ;
    reo:sensitivityRationale "A ChainControlIssuanceEvent on an assigned route requires confirmation that the truck is equipped with chains and the driver is trained to install them. R3 tier implies the truck can proceed with chains — thus safetyWeight is lower than IceFormationEvent and ETAWeight is elevated (chain installation adds 20–45 minutes to route time). When affectsAllCommercialVehicles=true and chains are not confirmed, rerouteThreshold falls to RISK_LOW and the recommended action shifts to REROUTE or DELAY_DEPARTURE."@en .

reo:FES_HeavyTruck_DisabledVehicle rdf:type owl:NamedIndividual, reo:FleetEventSensitivity ;
    reo:forVehicleClass tko:HEAVY_TRUCK ;
    reo:forEventType reo:DisabledVehicleEvent ;
    reo:safetyWeight "0.55"^^xsd:decimal ;
    reo:etaWeight "0.35"^^xsd:decimal ;
    reo:costWeight "0.10"^^xsd:decimal ;
    reo:rerouteThreshold tko:RISK_ELEVATED ;
    reo:alertPriority reo:PRIORITY_MODERATE ;
    reo:sensitivityLabel "Heavy Truck / Disabled Vehicle"@en ;
    reo:sensitivityRationale "A disabled Class 8 truck on a narrow two-lane or single-lane mountain road segment can fully block heavy truck passage for the duration of recovery. ETA impact dominates over safety for this event type. When disabledVehicleClassEstimate=HEAVY_TRUCK on a narrow segment, alertPriority escalates to PRIORITY_HIGH."@en .

#################################################################
#    REO v1.6.0 EXTENSIONS (coordinated release 2026-06-10)
#################################################################

# =============================================================================
# REO v1.6 SECTION A: AIR QUALITY EVENTS
# (Episodic companion to the static uko:pm25Concentration tract baseline
#  added in UKO v15.5. The static property carries annual-mean exposure for
#  equity analysis; this event class carries advisory-grade episodic
#  elevations - wildfire smoke, Spare the Air days, and the documented
#  SF-to-Contra-Costa PM2.5 wind-transport pattern affecting the target
#  geography. Sources: CARB, AirNow, BAAQMD advisories.)
# =============================================================================

reo:AirQualityEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RouteEvent ;
    rdfs:label "Air Quality Event"@en ;
    rdfs:comment "An episodic degraded-air-quality condition or advisory affecting a geographic footprint: wildfire smoke intrusion, regional pollutant transport, stagnation episodes, or agency-issued health advisories. Distinct from the static uko:pm25Concentration baseline: the baseline informs long-run equity exposure analysis, while AirQualityEvent instances inform time-bound conditions - active-mobility advisability (the Active Mobility Safety Score Agent suppresses walking/cycling recommendation scores during heavy-smoke events), school-adjacent analysis windows, and outdoor-exposure-sensitive planner scenarios."@en .

reo:aqiValue rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:AirQualityEvent ;
    rdfs:range xsd:integer ;
    rdfs:label "AQI value"@en ;
    rdfs:comment "US EPA Air Quality Index value reported for the event (0-500 scale)."@en .

reo:pollutantType rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:AirQualityEvent ;
    rdfs:range xsd:string ;
    rdfs:label "pollutant type"@en ;
    rdfs:comment "Primary pollutant of the event. Controlled vocabulary: PM25, PM10, OZONE, NO2, SO2, CO."@en .

reo:advisoryLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:AirQualityEvent ;
    rdfs:range xsd:string ;
    rdfs:label "advisory level"@en ;
    rdfs:comment "AQI health-advisory category in effect. Controlled vocabulary: MODERATE, UNHEALTHY_SENSITIVE_GROUPS, UNHEALTHY, VERY_UNHEALTHY, HAZARDOUS."@en .

# =============================================================================
# REO v1.6 SECTION B: PUBLIC SAFETY EVENTS
# (Sevtsuk/Basu active-mobility safety integration: perceived and actual
#  security conditions are a measured determinant of pedestrian route choice,
#  independent of traffic safety. Works with the existing
#  reo:affectsPedestrianEdge linkage - domain reo:Event - to target
#  pedestrian-network edges. Consumed by the Active Mobility Safety Score
#  Agent alongside uko:streetlightCoverage; routing responses remain the
#  application developer's concern per the established deferral.)
# =============================================================================

reo:PublicSafetyEvent rdf:type owl:Class ;
    rdfs:subClassOf reo:RouteEvent ;
    rdfs:label "Public Safety Event"@en ;
    rdfs:comment "A security or public-order incident affecting the advisability of traversing a location, principally for pedestrians and cyclists: reported crimes against persons, active police activity, hazardous encampment conditions, or jurisdiction-issued safety advisories. Modeled as a RouteEvent so the standard footprint, validity-window, and severity machinery applies; typically linked to the pedestrian layer via reo:affectsPedestrianEdge rather than to vehicular segments. Historical aggregation of these events feeds the perceived-safety component of active-mobility safety scoring; live instances inform time-bound advisories."@en .

reo:publicSafetyEventType rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:PublicSafetyEvent ;
    rdfs:range xsd:string ;
    rdfs:label "public safety event type"@en ;
    rdfs:comment "Controlled vocabulary: CRIME_AGAINST_PERSON, PROPERTY_CRIME, POLICE_ACTIVITY, HAZARDOUS_CONDITION, SAFETY_ADVISORY."@en .

# =============================================================================
# REO v1.6 SECTION C: FORMALIZED COLLISION FLAGS ON HISTORICAL INCIDENT RECORD
# (Closes the four collision-flag items of the Appendix A.4 naming-drift
#  register, jointly with MLO v1.6. The flags were previously materialized
#  by HIDIP at Stage 4 as contracted columns referenced by MLO under the
#  uko: namespace; they are formalized HERE because collision modeling lives
#  in REO - no uko:Collision class exists. The collision-mode reference
#  resolves to the existing reo:hasCollisionType / reo:CollisionType
#  taxonomy; the three booleans below are convenience derivations from the
#  typed VRU event classes, declared so the schema generator emits them and
#  the GKG Reasoner Agent can use the MLO-referenced names as literal nGQL
#  parameters.)
# =============================================================================

reo:isPedestrianCollision rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "is pedestrian collision"@en ;
    rdfs:comment "True when the collision involved a pedestrian. Derivation: the record's event typing includes reo:VehiclePedestrianAccidentEvent (SWITRS pedestrian-involvement flags at HIDIP Stage 4)."@en .

reo:isBicycleCollision rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "is bicycle collision"@en ;
    rdfs:comment "True when the collision involved a bicyclist. Derivation: the record's event typing includes reo:VehicleBicyclistAccidentEvent."@en .

reo:isVulnerableUserCollision rdf:type owl:DatatypeProperty ;
    rdfs:domain reo:HistoricalIncidentRecord ;
    rdfs:range xsd:boolean ;
    rdfs:label "is vulnerable road user collision"@en ;
    rdfs:comment "True when the collision involved any vulnerable road user. Derivation: disjunction over the VRU accident event types (pedestrian OR bicyclist OR other VRU classes such as motorcyclist where the jurisdictional definition includes them), per the Appendix A.4 resolution. Materialized as a convenience boolean because no single REO event class covers the disjunction."@en .

###############################################################################
#    END OF REO v1.6.0 ONTOLOGY
###############################################################################
